<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>EtherSandbox</RootNamespace>
    <AssemblyName>EtherComponentSandbox</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged — no Package.appxmanifest required -->
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>false</SelfContained>
    <!-- Legacy sandbox is a second host of Gallery sources; exclude generated outputs and
         the separately built repository projects before SDK default globs create XAML items. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**;tests\**;src\Ether.DesignSystem.Foundation\**;src\Ether.DesignSystem.Controls\**;samples\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_BREAK_ON_UNHANDLED_EXCEPTION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="src\Ether.DesignSystem.Foundation\Ether.DesignSystem.Foundation.csproj" />
    <ProjectReference Include="src\Ether.DesignSystem.Controls\Ether.DesignSystem.Controls.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <Manifest Include="$(ApplicationManifest)"/>
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="samples\Ether.DesignSystem.Gallery\App.xaml">
      <Link>App.xaml</Link>
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Compile Include="samples\Ether.DesignSystem.Gallery\App.xaml.cs">
      <Link>App.xaml.cs</Link>
      <DependentUpon>App.xaml</DependentUpon>
    </Compile>
    <Compile Include="samples\Ether.DesignSystem.Gallery\ComponentCatalog.cs">
      <Link>ComponentCatalog.cs</Link>
    </Compile>
    <Page Include="samples\Ether.DesignSystem.Gallery\MainWindow.xaml">
      <Link>MainWindow.xaml</Link>
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="samples\Ether.DesignSystem.Gallery\MainWindow.xaml.cs">
      <Link>MainWindow.xaml.cs</Link>
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </Compile>
    <Page Include="samples\Ether.DesignSystem.Gallery\Views\**\*.xaml">
      <Link>Views\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="samples\Ether.DesignSystem.Gallery\Views\**\*.cs">
      <Link>Views\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <Page Include="samples\Ether.DesignSystem.Gallery\GalleryControls\**\*.xaml">
      <Link>GalleryControls\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="samples\Ether.DesignSystem.Gallery\GalleryControls\**\*.cs">
      <Link>GalleryControls\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="samples\Ether.DesignSystem.Gallery\Converters\*.cs">
      <Link>Converters\%(Filename)%(Extension)</Link>
    </Compile>
    <Page Include="samples\Ether.DesignSystem.Gallery\Resources\Visuals\*.xaml">
      <Link>Resources\Visuals\%(Filename)%(Extension)</Link>
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <PRIResource Include="samples\Ether.DesignSystem.Gallery\Strings\en-US\Resources.resw">
      <Link>Strings\en-US\Resources.resw</Link>
    </PRIResource>
  </ItemGroup>

  <!-- Fonts — local copies for host-root token URIs -->
  <ItemGroup>
    <Content Include="Fonts\Instrument_Sans\InstrumentSans-VariableFont_wdth,wght.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Fonts\Inter\Inter-VariableFont_opsz,wght.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Icons\Sparkles.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Icons\ArrowDropDown.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Icons\ArrowRightAlt.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Icons\dds2\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
