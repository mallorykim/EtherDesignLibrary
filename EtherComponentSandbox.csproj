<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>EtherSandbox</RootNamespace>
    <AssemblyName>EtherComponentSandbox</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged — no Package.appxmanifest required -->
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_BREAK_ON_UNHANDLED_EXCEPTION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Updated to latest Windows App SDK / BuildTools -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1"/>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270"/>
    <!-- WinUI3 colored shadows (replaces WPF DropShadowEffect). Media brings Win2D + Extensions. -->
    <PackageReference Include="CommunityToolkit.WinUI.Media" Version="8.2.250402"/>
    <PackageReference Include="CommunityToolkit.WinUI.Extensions" Version="8.2.250402"/>
    <Manifest Include="$(ApplicationManifest)"/>
  </ItemGroup>

  <ItemGroup>
    <Page Remove="src\App\App.xaml" />
    <ApplicationDefinition Include="src\App\App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Page Update="src\App\MainWindow.xaml;src\Controls\**\*.xaml;src\Themes\**\*.xaml;src\Views\**\*.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
      <Link>%(Filename)%(Extension)</Link>
    </Page>
    <Compile Update="src\App\App.xaml.cs">
      <DependentUpon>App.xaml</DependentUpon>
    </Compile>
    <Compile Update="src\App\MainWindow.xaml.cs">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <!-- Fonts — local copies -->
  <ItemGroup>
    <Content Include="Fonts\Instrument_Sans\InstrumentSans-VariableFont_wdth,wght.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Fonts\Inter\Inter-VariableFont_opsz,wght.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Icons\Sparkles.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Icons\ArrowDropDown.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Icons\dds2\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
