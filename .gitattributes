# Force all text files to normalize line endings automatically
* text=auto

# Explicitly enforce CRLF for source and config files (suitable for Windows/.NET projects)
*.cs text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.slnx text eol=crlf
*.json text eol=crlf
*.xml text eol=crlf
*.config text eol=crlf
*.resw text eol=crlf

# Binary files should never be modified
*.png binary
*.jpg binary
*.dll binary
*.exe binary
