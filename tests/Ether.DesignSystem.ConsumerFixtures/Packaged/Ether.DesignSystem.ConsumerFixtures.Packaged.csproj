<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Ether.DesignSystem.ConsumerFixtures.Packaged</AssemblyName>
    <RootNamespace>Ether.DesignSystem.ConsumerFixtures.Packaged</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <SelfContained>false</SelfContained>
    <IsPackable>false</IsPackable>
    <!-- MSIX tooling cannot parse the frozen comma-named font file names. -->
    <EtherDesignSystemFoundationIncludeHostRootFonts>false</EtherDesignSystemFoundationIncludeHostRootFonts>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pin the exact preview version. Verify-ConsumerFixtures.ps1 (Assert-EtherPackageReferences)
         asserts this literal equals Directory.Build.props' EtherDesignSystemPreviewVersion, so a
         version bump that forgets this file fails the gate rather than drifting silently. -->
    <PackageReference Include="Ether.DesignSystem.Controls" VersionOverride="0.1.0-preview.4" />
    <PackageReference Include="Ether.DesignSystem.Interactions" VersionOverride="0.1.0-preview.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Assets\StoreLogo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Square44x44Logo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Square150x150Logo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\RuntimeVerification*.cs">
      <Link>%(Filename)%(Extension)</Link>
    </Compile>
    <!-- Golden PNGs are source-controlled test assets. Keep the packaged fixture
         aligned with the unpackaged consumer's in-process baseline comparer. -->
    <Content Include="..\VisualBaselines\**\*.png"
             Link="VisualBaselines\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
