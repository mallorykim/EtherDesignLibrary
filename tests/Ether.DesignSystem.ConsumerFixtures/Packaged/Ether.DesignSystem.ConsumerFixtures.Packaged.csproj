<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Ether.DesignSystem.ConsumerFixtures.Packaged</AssemblyName>
    <RootNamespace>Ether.DesignSystem.ConsumerFixtures.Packaged</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <!-- Test fixture: never emit an MSIX symbol (.appxsym) package. -->
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <SelfContained>false</SelfContained>
    <IsPackable>false</IsPackable>
    <!-- MSIX tooling cannot parse the frozen comma-named font file names. -->
    <EtherDesignSystemFoundationIncludeHostRootFonts>false</EtherDesignSystemFoundationIncludeHostRootFonts>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pin the exact preview version. Verify-ConsumerFixtures.ps1 (Assert-EtherPackageReferences)
         asserts this literal equals Directory.Build.props' EtherDesignSystemPreviewVersion, so a
         version bump that forgets this file fails the gate rather than drifting silently. -->
    <PackageReference Include="Ether.DesignSystem.Controls" VersionOverride="0.1.0-preview.7" />
    <PackageReference Include="Ether.DesignSystem.Interactions" VersionOverride="0.1.0-preview.7" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Assets\StoreLogo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Square44x44Logo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Square150x150Logo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\RuntimeVerification*.cs">
      <Link>%(Filename)%(Extension)</Link>
    </Compile>
    <!-- Golden PNGs are source-controlled test assets. Keep the packaged fixture
         aligned with the unpackaged consumer's in-process baseline comparer. -->
    <Content Include="..\VisualBaselines\**\*.png"
             Link="VisualBaselines\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The WindowsAppSDK MSIX targets warn "mspdbcmf.exe could not be found. A symbols package
       will not be generated" whenever the package payload contains .pdb files and the CI runner
       lacks full MSVC tooling. AppxSymbolPackageEnabled=false does NOT gate that warning: it lives
       in _EnsurePdbCmfExeFullPath, a DependsOnTargets dependency that runs regardless of whether a
       symbol package is produced. The real switch is the @(PDBPayload) item, sourced from the .pdb
       files in @(AppxPackagePayload). This throwaway fixture is produced but never installed or
       debugged, so drop every .pdb from the payload before the recipe is calculated: @(PDBPayload)
       stays empty, the warning's condition (@(PDBPayload) != '') is false, and the .msix is
       unchanged (private symbols are excluded from the package by default anyway). -->
  <Target Name="_EtherDropPdbPayloadForSymbolFreeFixture"
          BeforeTargets="_CalculateInputsForGenerateAppxPackageRecipe">
    <ItemGroup>
      <AppxPackagePayload Remove="@(AppxPackagePayload)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
