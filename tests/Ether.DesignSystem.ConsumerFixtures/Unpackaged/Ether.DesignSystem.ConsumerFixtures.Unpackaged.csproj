<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Ether.DesignSystem.ConsumerFixtures.Unpackaged</AssemblyName>
    <RootNamespace>Ether.DesignSystem.ConsumerFixtures.Unpackaged</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>false</SelfContained>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pin the exact preview version. Verify-ConsumerFixtures.ps1 (Assert-EtherPackageReferences)
         asserts this literal equals Directory.Build.props' EtherDesignSystemPreviewVersion, so a
         version bump that forgets this file fails the gate rather than drifting silently. -->
    <PackageReference Include="Ether.DesignSystem.Controls" VersionOverride="0.1.0-preview.5" />
    <PackageReference Include="Ether.DesignSystem.Interactions" VersionOverride="0.1.0-preview.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\RuntimeVerification*.cs">
      <Link>%(Filename)%(Extension)</Link>
    </Compile>
    <!-- Golden PNGs are source-controlled test assets. They are copied beside the
         unpackaged consumer so the fixture compares decoded pixels in-process. -->
    <Content Include="..\VisualBaselines\**\*.png"
             Link="VisualBaselines\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
