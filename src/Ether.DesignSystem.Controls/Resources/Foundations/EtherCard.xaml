<!--
    EtherCard.xaml = Ether Design System � Content Card (3 types)
    ==============================================================

    USAGE
      Normal card (standard content surface):
        <Border Style="{StaticResource EtherCardNormal}">
            [ your content here ]
        </Border>

      Intelligence card (AI=powered content, dark background):
        <Border Style="{StaticResource EtherCardIntelligence}">
            [ content on dark bg ]
        </Border>

      Callout Wrapper (Intelligence Insight = gradient border + header + inner card):
        Paste the EtherCalloutWrapper block from the EXAMPLE STRUCTURE below.
        It is a composite = not a single Style = because it wraps a visible header
        bar and an inner card body in one unit.

    THREE TYPES (Figma source: ursRC201v8IiVeafliI45F � node 58074:1903)

      NORMAL
        Background    BackgroundSurfaceRaised (#FFF5F7F8 L / #FF1E2025 D)
        Border        2 px BorderDefault
        CornerRadius  8 (radius/control)
        Size          390�220 min (content stretches)

      INTELLIGENCE
        Background    BackgroundCardIntelligence (#FF000000 = mode=invariant)
        Border        2 px AiAccentPurple
        CornerRadius  8 (radius/control)
        Size          390�220 min

      CALLOUT WRAPPER
        Outer shell   gradient border shell (intelligence gradient) � radius 10
        Header strip  px=12, py=8 � label "Intelligence Insight" 12px Instrument Sans SemiBold
                      white text + right=arrow icon
        Inner body    BackgroundCanvas � radius 8 � size 390�220

    TOKENS
      Normal bg:       BackgroundSurfaceRaised  (ThemeResource)
      Normal border:   BorderDefault            (ThemeResource)
      Intel bg:        BackgroundCardIntelligence (StaticResource)
      Intel border:    AiAccentPurple           (ThemeResource)
      Label (insight): TextOnStaticDark (always white = use literal White)
      Insight label:   Instrument Sans SemiBold 12 px
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="EtherCardBodyFill" ResourceKey="BackgroundSurfaceRaised"/>
            <StaticResource x:Key="EtherCardShellFill" ResourceKey="BackgroundCardIntelligence"/>
            <StaticResource x:Key="EtherCardIntelligenceOutlineBrush" ResourceKey="AiAccentPurple"/>
            <LinearGradientBrush x:Key="EtherCardCalloutOuterGradient"
                                 StartPoint="0.366,1" EndPoint="0.634,0">
                <GradientStop Color="#141414" Offset="0.66111"/>
                <GradientStop Color="#3B6FC7" Offset="0.68456"/>
                <GradientStop Color="#0EB2FF" Offset="0.84627"/>
                <GradientStop Color="#0015FF" Offset="0.88997"/>
                <GradientStop Color="#141414" Offset="0.91688"/>
            </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <StaticResource x:Key="EtherCardBodyFill" ResourceKey="BackgroundSurfaceRaised"/>
            <StaticResource x:Key="EtherCardShellFill" ResourceKey="BackgroundCardIntelligence"/>
            <StaticResource x:Key="EtherCardIntelligenceOutlineBrush" ResourceKey="AiAccentPurple"/>
            <LinearGradientBrush x:Key="EtherCardCalloutOuterGradient"
                                 StartPoint="0.366,1" EndPoint="0.634,0">
                <GradientStop Color="#141414" Offset="0.66111"/>
                <GradientStop Color="#3B6FC7" Offset="0.68456"/>
                <GradientStop Color="#0EB2FF" Offset="0.84627"/>
                <GradientStop Color="#0015FF" Offset="0.88997"/>
                <GradientStop Color="#141414" Offset="0.91688"/>
            </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="EtherCardBodyFill" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="EtherCardShellFill" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="EtherCardIntelligenceOutlineBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <LinearGradientBrush x:Key="EtherCardCalloutOuterGradient"
                                 StartPoint="0.366,1" EndPoint="0.634,0">
                <GradientStop Color="{ThemeResource SystemColorHighlightColor}" Offset="0"/>
                <GradientStop Color="{ThemeResource SystemColorHighlightColor}" Offset="1"/>
            </LinearGradientBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ===================================
         NORMAL CARD
    ======================================= -->
    <Style x:Key="EtherCardNormal" TargetType="Border">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderBrush"     Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius"    Value="10"/>
        <Setter Property="MinWidth"        Value="392"/>
        <Setter Property="MinHeight"       Value="172"/>
        <Setter Property="Padding"         Value="{StaticResource Padding0}"/>
    </Style>

    <Style x:Key="EtherCardNormalBody" TargetType="Border">
        <Setter Property="Background"      Value="{ThemeResource EtherCardBodyFill}"/>
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMd}"/>
        <Setter Property="MinHeight"       Value="168"/>
        <Setter Property="Padding"         Value="{StaticResource Padding20}"/>
    </Style>

    <!-- ===================================
         INTELLIGENCE CARD
    ======================================= -->
    <Style x:Key="EtherCardIntelligence" TargetType="Border">
        <Setter Property="Background"      Value="{ThemeResource EtherCardShellFill}"/>
        <Setter Property="BorderBrush"     Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius"    Value="10"/>
        <Setter Property="MinWidth"        Value="392"/>
        <Setter Property="MinHeight"       Value="130"/>
        <Setter Property="Padding"         Value="0"/>
    </Style>

    <Style x:Key="EtherCardIntelligenceBody" TargetType="Border">
        <Setter Property="Background"      Value="{ThemeResource EtherCardShellFill}"/>
        <Setter Property="BorderBrush"     Value="{ThemeResource EtherCardIntelligenceOutlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMd}"/>
        <Setter Property="MinHeight"       Value="130"/>
        <Setter Property="Padding"         Value="{StaticResource Padding20}"/>
    </Style>

    <Style x:Key="EtherCardCalloutShell" TargetType="Border">
        <Setter Property="Background"      Value="{ThemeResource EtherCardCalloutOuterGradient}"/>
        <Setter Property="BorderBrush"     Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius"    Value="10"/>
        <Setter Property="MinWidth"        Value="394"/>
        <Setter Property="MinHeight"       Value="206"/>
        <Setter Property="Padding"         Value="2,0,2,2"/>
    </Style>

    <Style x:Key="EtherCardCalloutBody" TargetType="Border">
        <Setter Property="Background"      Value="{ThemeResource EtherCardBodyFill}"/>
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMd}"/>
        <Setter Property="MinHeight"       Value="172"/>
        <Setter Property="Padding"         Value="{StaticResource Padding20}"/>
    </Style>

    <!-- ===================================
         CALLOUT WRAPPER EXAMPLE STRUCTURE
         Paste this entire block into your page.
         Replace the Slot comment with actual card content.

