             <Border.Background>
                 <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                     <GradientStop Color="#141414" Offset="0.00"/>
                     <GradientStop Color="#3B6FC7" Offset="0.30"/>
                     <GradientStop Color="#0EB2FF" Offset="0.65"/>
                     <GradientStop Color="#0015FF" Offset="0.85"/>
                     <GradientStop Color="#141414" Offset="1.00"/>
                 </LinearGradientBrush>
             </Border.Background>
             <StackPanel Orientation="Vertical">
                 <Grid Padding="12,8,12,8">
                     <TextBlock Text="Intelligence Insight"
                                FontFamily="{StaticResource InstrumentSans}"
                                FontSize="12" FontWeight="SemiBold"
                                Foreground="White"
                                VerticalAlignment="Center"/>
                     <TextBlock Text="?"
                                HorizontalAlignment="Right"
                                Foreground="White"
                                VerticalAlignment="Center"/>
                 </Grid>
                 <Border Background="{ThemeResource BackgroundCanvas}"
                         CornerRadius="8" MinWidth="390" MinHeight="220"
                         Padding="20">
                     [ Slot: your card content here ]
                 </Border>
             </StackPanel>
         </Border>
    ======================================= -->

</ResourceDictionary>
