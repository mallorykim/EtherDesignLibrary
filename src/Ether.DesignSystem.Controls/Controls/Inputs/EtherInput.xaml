<!--
    Ether Design System InputContainer (single-line text field)

    Figma source: ursRC201v8IiVeafliI45F
      Light set 62102:10891 · Dark specimens 62110:12110–12114

    STATES
      Default / Hover / Active (focus) / Filled / Disabled
      Default, Hover, Filled, Disabled have no stroke. Active is a 1 px
      Blue500 (Light) / Blue400 (Dark) inside stroke on the same 1 px border
      so focus does not jump layout. Disabled is Default colours at 50 %.
      Filled uses the Default fill; typed text is text/primary, placeholder
      is text/secondary. Button-Send is hidden in Figma and is not templated.

    Light/Dark component brushes bind Color to primitive StaticResources.
    High Contrast uses Windows SystemColor*. Layout follows WinUI 3
    DefaultTextBoxStyle (Windows App SDK generic.xaml): BorderElement carries
    MinHeight; ContentElement and placeholder use Margin=BorderThickness then
    Padding. MinHeight is 48. Padding is 16,12 — Figma 16 horizontal, 12
    vertical. The 14 px line keeps ~22 px (48 − 2 − 12 − 12) so descenders
    are not clipped. Placeholder is a TextBlock centered in that same padded
    slot so it sits on the same midline as typed TextBoxView text. Corner
    radius uses RadiusMd (Figma 8px), template-bound like DefaultTextBoxStyle.

    LOCATION
      This dictionary lives beside its class (Controls/EtherInput.cs) and is
      merged explicitly from App.xaml. See the "Mechanism refinement" note in
      docs/superpowers/plans/2026-08-06-self-contained-component-authoring-plan.md.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ether.DesignSystem.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="EtherInputFillDefaultBrush" Color="{StaticResource AlphaGray40}"/>
            <SolidColorBrush x:Key="EtherInputFillHoverBrush" Color="{StaticResource AlphaGray15}"/>
            <SolidColorBrush x:Key="EtherInputBorderBrush" Color="{StaticResource AlphaWhite0}"/>
            <SolidColorBrush x:Key="EtherInputBorderFocusBrush" Color="{StaticResource Blue500}"/>
            <SolidColorBrush x:Key="EtherInputForegroundBrush" Color="{StaticResource Gray1000}"/>
            <SolidColorBrush x:Key="EtherInputPlaceholderBrush" Color="{StaticResource AlphaBlack70}"/>
            <SolidColorBrush x:Key="EtherInputSelectionHighlightBrush" Color="{StaticResource Blue600}"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="EtherInputFillDefaultBrush" Color="{StaticResource AlphaBlack40}"/>
            <SolidColorBrush x:Key="EtherInputFillHoverBrush" Color="{StaticResource AlphaBlack50}"/>
            <SolidColorBrush x:Key="EtherInputBorderBrush" Color="{StaticResource AlphaBlack0}"/>
            <SolidColorBrush x:Key="EtherInputBorderFocusBrush" Color="{StaticResource Blue400}"/>
            <SolidColorBrush x:Key="EtherInputForegroundBrush" Color="{StaticResource Gray0}"/>
            <SolidColorBrush x:Key="EtherInputPlaceholderBrush" Color="{StaticResource AlphaWhite70}"/>
            <SolidColorBrush x:Key="EtherInputSelectionHighlightBrush" Color="{StaticResource Blue600}"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="EtherInputFillDefaultBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="EtherInputFillHoverBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="EtherInputBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="EtherInputBorderFocusBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherInputForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="EtherInputPlaceholderBrush" Color="{ThemeResource SystemColorGrayTextColor}"/>
            <SolidColorBrush x:Key="EtherInputSelectionHighlightBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <ControlTemplate x:Key="EtherInputTemplate" TargetType="controls:EtherInput">
        <Grid x:Name="LayoutRoot">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition From="Normal" To="PointerOver" GeneratedDuration="0:0:0.12">
                            <VisualTransition.GeneratedEasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                        <VisualTransition From="PointerOver" To="Normal" GeneratedDuration="0:0:0.12">
                            <VisualTransition.GeneratedEasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                    </VisualStateGroup.Transitions>

                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Target="BorderElement.Background" Value="{ThemeResource EtherInputFillDefaultBrush}"/>
                            <Setter Target="BorderElement.BorderBrush" Value="{ThemeResource EtherInputBorderBrush}"/>
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <!-- Hover: AlphaGray15 / AlphaBlack50 fill; no visible stroke. -->
                            <Setter Target="BorderElement.Background" Value="{ThemeResource EtherInputFillHoverBrush}"/>
                            <Setter Target="BorderElement.BorderBrush" Value="{ThemeResource EtherInputBorderBrush}"/>
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <!-- Active: Default fill; 1 px Blue500 / Blue400 stroke. -->
                            <Setter Target="BorderElement.Background" Value="{ThemeResource EtherInputFillDefaultBrush}"/>
                            <Setter Target="BorderElement.BorderBrush" Value="{ThemeResource EtherInputBorderFocusBrush}"/>
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <!-- Whole control at 50%; fill and stroke stay on Default. -->
                            <Setter Target="LayoutRoot.Opacity" Value="0.5"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- WinUI DefaultTextBoxStyle: BorderElement owns MinHeight; the editor
                 and placeholder sit in the same cell with Margin=BorderThickness
                 so padding is inside the stroke, not on top of it. -->
            <Border x:Name="BorderElement"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    BackgroundSizing="InnerBorderEdge"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    MinWidth="{TemplateBinding MinWidth}"
                    MinHeight="{TemplateBinding MinHeight}"
                    Control.IsTemplateFocusTarget="True"/>

            <ScrollViewer x:Name="ContentElement"
                          Margin="{TemplateBinding BorderThickness}"
                          Padding="{TemplateBinding Padding}"
                          Foreground="{TemplateBinding Foreground}"
                          HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                          VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                          IsHorizontalRailEnabled="{TemplateBinding ScrollViewer.IsHorizontalRailEnabled}"
                          IsVerticalRailEnabled="{TemplateBinding ScrollViewer.IsVerticalRailEnabled}"
                          IsDeferredScrollingEnabled="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                          AutomationProperties.AccessibilityView="Raw"
                          ZoomMode="Disabled"
                          IsTabStop="False"/>

            <!-- Same Margin+Padding slot as ContentElement. TextBlock top-aligns inside
                 that slot; TextBoxView does not. Center the placeholder so Default and
                 typed text share the field's horizontal midline. -->
            <Grid Margin="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  IsHitTestVisible="False">
                <TextBlock x:Name="PlaceholderTextContentPresenter"
                           VerticalAlignment="Center"
                           Text="{TemplateBinding PlaceholderText}"
                           TextAlignment="{TemplateBinding TextAlignment}"
                           Foreground="{TemplateBinding PlaceholderForeground}"
                           FontFamily="{TemplateBinding FontFamily}"
                           FontSize="{TemplateBinding FontSize}"
                           FontWeight="{TemplateBinding FontWeight}"
                           TextWrapping="{TemplateBinding TextWrapping}"
                           Style="{StaticResource EtherSingleLineTextBlockStyle}"
                           IsHitTestVisible="False"/>
            </Grid>
        </Grid>
    </ControlTemplate>

    <!-- Same-class precedent: EtherDropdown's Figma trigger floor is 130 px. -->
    <x:Double x:Key="InputMinWidth">130</x:Double>

    <Style x:Key="DefaultEtherInputStyle" TargetType="controls:EtherInput">
        <Setter Property="Background" Value="{ThemeResource EtherInputFillDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource EtherInputBorderBrush}"/>
        <Setter Property="PlaceholderForeground" Value="{ThemeResource EtherInputPlaceholderBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource EtherInputForegroundBrush}"/>
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource EtherInputSelectionHighlightBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
        <Setter Property="FontSize" Value="{StaticResource Size14}"/>
        <Setter Property="FontWeight" Value="{StaticResource WeightRegular}"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
        <Setter Property="BackgroundSizing" Value="InnerBorderEdge"/>
        <Setter Property="MinWidth" Value="{StaticResource InputMinWidth}"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="AcceptsReturn" Value="False"/>
        <Setter Property="UseSystemFocusVisuals" Value="False"/>
        <Setter Property="HighContrastAdjustment" Value="None"/>
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Auto"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="Template" Value="{StaticResource EtherInputTemplate}"/>
    </Style>

    <Style TargetType="controls:EtherInput" BasedOn="{StaticResource DefaultEtherInputStyle}"/>

</ResourceDictionary>
