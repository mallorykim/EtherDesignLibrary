<!--
    Ether Design System Steering Bar

    A draggable slider-like control with a rounded track, gradient progress fill,
    glass thumb, and optional title/value labels. Supports continuous dragging or
    custom stops with snapping.

    DefaultEtherSteeringBarStyle owns the default setters; the implicit style is
    BasedOn that key. Colour-bearing values live in EtherSteeringBar* Light/Dark/
    HighContrast dictionaries. The template does not use literal hex. Thumb size,
    fill width, stop markers, and PreviewStatus opacity stay code-driven so
    pointer/keyboard interaction is not rewritten onto VisualStateManager.

    LOCATION
      This dictionary lives beside its class (Controls/EtherSteeringBar.xaml.cs)
      and is merged from Controls Generic.xaml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="EtherSteeringBarTrackBrush" ResourceKey="background/track" />
            <StaticResource x:Key="EtherSteeringBarTitleForegroundBrush" ResourceKey="text/primary" />
            <StaticResource x:Key="EtherSteeringBarValueForegroundBrush" ResourceKey="TextSecondary" />
            <LinearGradientBrush x:Key="EtherSteeringBarFillBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#0021F3" Offset="0.00" />
                <GradientStop Color="#0015FF" Offset="0.33" />
                <GradientStop Color="#0EB2FF" Offset="0.67" />
                <GradientStop Color="#40E1FD" Offset="1.00" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="EtherSteeringBarThumbShadowFarBrush" Color="#06000000" />
            <SolidColorBrush x:Key="EtherSteeringBarThumbShadowNearBrush" Color="#0D000000" />
            <SolidColorBrush x:Key="EtherSteeringBarThumbBorderBrush" Color="#BFC7D0D8" />
            <LinearGradientBrush x:Key="EtherSteeringBarThumbFillBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFFDFEFF" Offset="0.00" />
                <GradientStop Color="#FFF8FDFF" Offset="0.42" />
                <GradientStop Color="#FFF2F7F9" Offset="1.00" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="EtherSteeringBarThumbHighlightBrush" Center="0.32,0.14" RadiusX="1.0" RadiusY="0.85">
                <GradientStop Color="#7AFFFFFF" Offset="0.00" />
                <GradientStop Color="#24E7F8FF" Offset="0.58" />
                <GradientStop Color="#00FFFFFF" Offset="1.00" />
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="EtherSteeringBarThumbSheenBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#00BFEFFF" Offset="0.00" />
                <GradientStop Color="#AA82ECFF" Offset="0.52" />
                <GradientStop Color="#00BFEFFF" Offset="1.00" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="EtherSteeringBarThumbTopHighlightBrush" Color="#5AFFFFFF" />
            <SolidColorBrush x:Key="EtherSteeringBarThumbDisabledFillBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="EtherSteeringBarStopMarkerActiveBrush" Color="#D9FFFFFF" />
            <SolidColorBrush x:Key="EtherSteeringBarStopMarkerInactiveBrush" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="EtherSteeringBarStopMarkerDisabledActiveBrush" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="EtherSteeringBarStopMarkerDisabledInactiveBrush" Color="#33FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <StaticResource x:Key="EtherSteeringBarTrackBrush" ResourceKey="background/track" />
            <StaticResource x:Key="EtherSteeringBarTitleForegroundBrush" ResourceKey="text/primary" />
            <StaticResource x:Key="EtherSteeringBarValueForegroundBrush" ResourceKey="TextSecondary" />
            <LinearGradientBrush x:Key="EtherSteeringBarFillBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#0021F3" Offset="0.00" />
                <GradientStop Color="#0015FF" Offset="0.33" />
                <GradientStop Color="#0EB2FF" Offset="0.67" />
                <GradientStop Color="#40E1FD" Offset="1.00" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="EtherSteeringBarThumbShadowFarBrush" Color="#06000000" />
            <SolidColorBrush x:Key="EtherSteeringBarThumbShadowNearBrush" Color="#0D000000" />
            <SolidColorBrush x:Key="EtherSteeringBarThumbBorderBrush" Color="#BFC7D0D8" />
            <LinearGradientBrush x:Key="EtherSteeringBarThumbFillBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFFDFEFF" Offset="0.00" />
                <GradientStop Color="#FFF8FDFF" Offset="0.42" />
                <GradientStop Color="#FFF2F7F9" Offset="1.00" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="EtherSteeringBarThumbHighlightBrush" Center="0.32,0.14" RadiusX="1.0" RadiusY="0.85">
                <GradientStop Color="#7AFFFFFF" Offset="0.00" />
                <GradientStop Color="#24E7F8FF" Offset="0.58" />
                <GradientStop Color="#00FFFFFF" Offset="1.00" />
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="EtherSteeringBarThumbSheenBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#00BFEFFF" Offset="0.00" />
                <GradientStop Color="#AA82ECFF" Offset="0.52" />
                <GradientStop Color="#00BFEFFF" Offset="1.00" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="EtherSteeringBarThumbTopHighlightBrush" Color="#5AFFFFFF" />
            <SolidColorBrush x:Key="EtherSteeringBarThumbDisabledFillBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="EtherSteeringBarStopMarkerActiveBrush" Color="#D9FFFFFF" />
            <SolidColorBrush x:Key="EtherSteeringBarStopMarkerInactiveBrush" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="EtherSteeringBarStopMarkerDisabledActiveBrush" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="EtherSteeringBarStopMarkerDisabledInactiveBrush" Color="#33FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="EtherSteeringBarTrackBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="EtherSteeringBarTitleForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EtherSteeringBarValueForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <LinearGradientBrush x:Key="EtherSteeringBarFillBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="{ThemeResource SystemColorHighlightColor}" Offset="0.00" />
                <GradientStop Color="{ThemeResource SystemColorHighlightColor}" Offset="0.33" />
                <GradientStop Color="{ThemeResource SystemColorHighlightColor}" Offset="0.67" />
                <GradientStop Color="{ThemeResource SystemColorHighlightColor}" Offset="1.00" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="EtherSteeringBarThumbShadowFarBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EtherSteeringBarThumbShadowNearBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EtherSteeringBarThumbBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <LinearGradientBrush x:Key="EtherSteeringBarThumbFillBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{ThemeResource SystemColorButtonFaceColor}" Offset="0.00" />
                <GradientStop Color="{ThemeResource SystemColorButtonFaceColor}" Offset="0.42" />
                <GradientStop Color="{ThemeResource SystemColorButtonFaceColor}" Offset="1.00" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="EtherSteeringBarThumbHighlightBrush" Center="0.32,0.14" RadiusX="1.0" RadiusY="0.85">
                <GradientStop Color="{ThemeResource SystemColorHighlightColor}" Offset="0.00" />
                <GradientStop Color="{ThemeResource SystemColorHighlightColor}" Offset="0.58" />
                <GradientStop Color="{ThemeResource SystemColorWindowColor}" Offset="1.00" />
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="EtherSteeringBarThumbSheenBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="{ThemeResource SystemColorHighlightColor}" Offset="0.00" />
                <GradientStop Color="{ThemeResource SystemColorHighlightColor}" Offset="0.52" />
                <GradientStop Color="{ThemeResource SystemColorHighlightColor}" Offset="1.00" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="EtherSteeringBarThumbTopHighlightBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherSteeringBarThumbDisabledFillBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="EtherSteeringBarStopMarkerActiveBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherSteeringBarStopMarkerInactiveBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="EtherSteeringBarStopMarkerDisabledActiveBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="EtherSteeringBarStopMarkerDisabledInactiveBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="DefaultEtherSteeringBarStyle" TargetType="controls:EtherSteeringBar">
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="HighContrastAdjustment" Value="None" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Value" Value="0" />
        <Setter Property="ShowTitle" Value="True" />
        <Setter Property="ShowValue" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:EtherSteeringBar">
                    <Grid x:Name="LayoutRoot">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="LabelStates">
                                <VisualState x:Name="BothLabelsVisible">
                                    <VisualState.Setters>
                                        <Setter Target="LabelRow.Visibility" Value="Visible" />
                                        <Setter Target="TitleText.Visibility" Value="Visible" />
                                        <Setter Target="ValueLabel.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="TitleOnly">
                                    <VisualState.Setters>
                                        <Setter Target="LabelRow.Visibility" Value="Visible" />
                                        <Setter Target="TitleText.Visibility" Value="Visible" />
                                        <Setter Target="ValueLabel.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="ValueOnly">
                                    <VisualState.Setters>
                                        <Setter Target="LabelRow.Visibility" Value="Visible" />
                                        <Setter Target="TitleText.Visibility" Value="Collapsed" />
                                        <Setter Target="ValueLabel.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="LabelsHidden">
                                    <VisualState.Setters>
                                        <Setter Target="LabelRow.Visibility" Value="Collapsed" />
                                        <Setter Target="TitleText.Visibility" Value="Collapsed" />
                                        <Setter Target="ValueLabel.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid x:Name="LabelRow" Margin="0,0,0,8">
                            <ContentPresenter x:Name="TitleText"
                                              Content="{TemplateBinding Title}"
                                              HorizontalAlignment="Left"
                                              FontFamily="{StaticResource InstrumentSans}"
                                              FontSize="{StaticResource Size14}"
                                              FontWeight="{StaticResource WeightSemibold}"
                                              Foreground="{ThemeResource EtherSteeringBarTitleForegroundBrush}" />
                            <ContentPresenter x:Name="ValueLabel"
                                              HorizontalAlignment="Right"
                                              FontFamily="{StaticResource InstrumentSans}"
                                              FontSize="{StaticResource Size14}"
                                              FontWeight="{StaticResource WeightSemibold}"
                                              Foreground="{ThemeResource EtherSteeringBarValueForegroundBrush}" />
                        </Grid>

                        <Grid x:Name="InteractionSurface"
                              Grid.Row="1"
                              Height="{StaticResource Spacing16}"
                              Background="Transparent">
                            <Border x:Name="TrackBackground"
                                    Height="{StaticResource Spacing4}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource EtherSteeringBarTrackBrush}"
                                    CornerRadius="{StaticResource RadiusXs}" />

                            <Border x:Name="FillBorder"
                                    Width="{StaticResource Spacing0}"
                                    Height="{StaticResource Spacing4}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource EtherSteeringBarFillBrush}"
                                    CornerRadius="{StaticResource RadiusXs}"
                                    IsHitTestVisible="False" />

                            <Canvas x:Name="StopMarkersHost"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    IsHitTestVisible="False" />

                            <Grid x:Name="ThumbHost"
                                  Width="{StaticResource Spacing20}"
                                  Height="{StaticResource Spacing12}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Margin="0,1,0,0"
                                  IsHitTestVisible="False">
                                <Border x:Name="ShadowFar"
                                        Margin="-2,0,-2,-2"
                                        CornerRadius="{StaticResource RadiusSm}"
                                        Background="{ThemeResource EtherSteeringBarThumbShadowFarBrush}"
                                        Translation="0,2,0" />
                                <Border x:Name="ShadowNear"
                                        Margin="0,0,0,-1"
                                        CornerRadius="{StaticResource RadiusSm}"
                                        Background="{ThemeResource EtherSteeringBarThumbShadowNearBrush}"
                                        Translation="0,0.8,0" />

                                <Border x:Name="ThumbBorder"
                                        BorderBrush="{ThemeResource EtherSteeringBarThumbBorderBrush}"
                                        BorderThickness="0.5"
                                        CornerRadius="3">
                                    <Border x:Name="ThumbFill"
                                            CornerRadius="3">
                                        <Grid>
                                            <Border CornerRadius="3"
                                                    Background="{ThemeResource EtherSteeringBarThumbFillBrush}" />
                                            <Border Margin="0.5"
                                                    CornerRadius="{StaticResource RadiusXs}"
                                                    Background="{ThemeResource EtherSteeringBarThumbHighlightBrush}" />
                                            <Border Margin="1.8,1.6,1.8,4.6"
                                                    CornerRadius="{StaticResource RadiusSm}"
                                                    Opacity="0.9"
                                                    Background="{ThemeResource EtherSteeringBarThumbSheenBrush}" />
                                            <Border Margin="0.7,0.7,0.7,0"
                                                    VerticalAlignment="Top"
                                                    Height="{StaticResource Spacing2}"
                                                    CornerRadius="1"
                                                    Background="{ThemeResource EtherSteeringBarThumbTopHighlightBrush}"
                                                    IsHitTestVisible="False" />
                                        </Grid>
                                    </Border>
                                </Border>

                                <Border x:Name="ThumbDisabledShell"
                                        BorderBrush="{ThemeResource EtherSteeringBarThumbBorderBrush}"
                                        BorderThickness="0.5"
                                        CornerRadius="3"
                                        Opacity="0"
                                        IsHitTestVisible="False">
                                    <Border Background="{ThemeResource EtherSteeringBarThumbDisabledFillBrush}"
                                            CornerRadius="3" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:EtherSteeringBar" BasedOn="{StaticResource DefaultEtherSteeringBarStyle}" />
</ResourceDictionary>
