<!--
    Ether Design System Radio Button

    Figma source: ursRC201v8IiVeafliI45F
      Light component set 62102:8755 · Dark specimens 62102:8800–8805
    Circle 18 x 18, 1.5 px stroke drawn inside. Label is Roboto SemiBold 12 with an
    8 px gap. When checked, an 8 x 8 Gray25 (#F5F7F8) dot sits in the centre
    (Figma radio SVG r=4). No indeterminate state (IsThreeState = False via
    DefaultEtherRadioButtonStyle).

    STATES
      Unchecked: Default / Hover / Pressed / Disabled
      Checked:   Default / Hover / Pressed / Disabled
      Disabled is Default colours at 40 % (Figma Opacity row). Checked
      Disabled paints the 8 px Gray25 dot and Blue500 fill as one
      RadialGradientBrush so group opacity cannot let blue show through
      the centre. *DisabledBrush keys stay in the dictionaries; checked
      Disabled consumes DisabledCheckedFillBrush.

    Sibling of the Checkbox (same form-control palette): the only visual
    differences are the round shape and the inner dot in place of the tick.

    Light/Dark component brushes bind Color to primitive StaticResources.
    Semantic form-control/* keys are not referenced here. High Contrast uses
    Windows SystemColor*. Fill depends on BOTH check-ness and pointer state,
    which live in two separate visual-state groups (CommonStates, CheckStates).
    To avoid those groups fighting over one property, each owns a different one:
      - CommonStates writes Background on TWO different borders (UncheckedFill
        and CheckedFill) — the four pointer fills for each — plus checked stroke
        on Pressed (Blue700) vs Default/Hover (Blue500).
      - CheckStates writes only Visibility (which of the two faces shows).
    No property is written by both groups, so there is no ordering race.

    LOCATION
      This dictionary lives beside its class (Controls/EtherRadioButton.cs) and is merged
      explicitly from App.xaml. See the "Mechanism refinement" note in
      docs/superpowers/plans/2026-08-06-self-contained-component-authoring-plan.md.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ether.DesignSystem.Controls"
    xmlns:primitives="using:Ether.DesignSystem.Controls.Primitives">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="EtherRadioButtonCircleFillDefaultBrush" Color="{StaticResource AlphaGray40}"/>
            <SolidColorBrush x:Key="EtherRadioButtonCircleFillHoverBrush" Color="{StaticResource AlphaGray90}"/>
            <SolidColorBrush x:Key="EtherRadioButtonCircleFillPressedBrush" Color="{StaticResource AlphaGray20}"/>
            <SolidColorBrush x:Key="EtherRadioButtonCircleStrokeBrush" Color="{StaticResource Gray400}"/>
            <SolidColorBrush x:Key="EtherRadioButtonFocusBrush" Color="{StaticResource AlphaBlack70}"/>
            <SolidColorBrush x:Key="EtherRadioButtonCheckedFillDefaultBrush" Color="{StaticResource Blue500}"/>
            <SolidColorBrush x:Key="EtherRadioButtonCheckedFillHoverBrush" Color="{StaticResource Blue600}"/>
            <SolidColorBrush x:Key="EtherRadioButtonCheckedFillPressedBrush" Color="{StaticResource Blue700}"/>
            <SolidColorBrush x:Key="EtherRadioButtonCheckedStrokeBrush" Color="{StaticResource Blue500}"/>
            <SolidColorBrush x:Key="EtherRadioButtonInnerDotBrush" Color="{StaticResource Gray25}"/>
            <SolidColorBrush x:Key="EtherRadioButtonLabelBrush" Color="{StaticResource AlphaBlack70}"/>
            <SolidColorBrush x:Key="EtherRadioButtonDisabledUncheckedFillBrush" Color="{StaticResource AlphaGray40}"/>
            <SolidColorBrush x:Key="EtherRadioButtonDisabledUncheckedStrokeBrush" Color="{StaticResource Gray400}"/>
            <!-- 8 px inner disc (r=4 / 18) then Blue500; one layer so 40 % opacity matches Figma. -->
            <RadialGradientBrush x:Key="EtherRadioButtonDisabledCheckedFillBrush"
                                 MappingMode="RelativeToBoundingBox"
                                 Center="0.5,0.5"
                                 GradientOrigin="0.5,0.5"
                                 RadiusX="0.5"
                                 RadiusY="0.5"
                                 SpreadMethod="Pad">
                <GradientStop Color="{StaticResource Gray25}" Offset="0"/>
                <GradientStop Color="{StaticResource Gray25}" Offset="0.444"/>
                <GradientStop Color="{StaticResource Blue500}" Offset="0.45"/>
                <GradientStop Color="{StaticResource Blue500}" Offset="1"/>
            </RadialGradientBrush>
            <SolidColorBrush x:Key="EtherRadioButtonDisabledCheckedDotBrush" Color="{StaticResource Gray25}"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="EtherRadioButtonCircleFillDefaultBrush" Color="{StaticResource AlphaGray5}"/>
            <SolidColorBrush x:Key="EtherRadioButtonCircleFillHoverBrush" Color="{StaticResource AlphaGray15}"/>
            <SolidColorBrush x:Key="EtherRadioButtonCircleFillPressedBrush" Color="{StaticResource AlphaGray25}"/>
            <SolidColorBrush x:Key="EtherRadioButtonCircleStrokeBrush" Color="{StaticResource Gray500}"/>
            <SolidColorBrush x:Key="EtherRadioButtonFocusBrush" Color="{StaticResource AlphaWhite70}"/>
            <SolidColorBrush x:Key="EtherRadioButtonCheckedFillDefaultBrush" Color="{StaticResource Blue500}"/>
            <SolidColorBrush x:Key="EtherRadioButtonCheckedFillHoverBrush" Color="{StaticResource Blue600}"/>
            <SolidColorBrush x:Key="EtherRadioButtonCheckedFillPressedBrush" Color="{StaticResource Blue700}"/>
            <SolidColorBrush x:Key="EtherRadioButtonCheckedStrokeBrush" Color="{StaticResource Blue500}"/>
            <SolidColorBrush x:Key="EtherRadioButtonInnerDotBrush" Color="{StaticResource Gray25}"/>
            <SolidColorBrush x:Key="EtherRadioButtonLabelBrush" Color="{StaticResource AlphaWhite70}"/>
            <SolidColorBrush x:Key="EtherRadioButtonDisabledUncheckedFillBrush" Color="{StaticResource AlphaGray5}"/>
            <SolidColorBrush x:Key="EtherRadioButtonDisabledUncheckedStrokeBrush" Color="{StaticResource Gray500}"/>
            <RadialGradientBrush x:Key="EtherRadioButtonDisabledCheckedFillBrush"
                                 MappingMode="RelativeToBoundingBox"
                                 Center="0.5,0.5"
                                 GradientOrigin="0.5,0.5"
                                 RadiusX="0.5"
                                 RadiusY="0.5"
                                 SpreadMethod="Pad">
                <GradientStop Color="{StaticResource Gray25}" Offset="0"/>
                <GradientStop Color="{StaticResource Gray25}" Offset="0.444"/>
                <GradientStop Color="{StaticResource Blue500}" Offset="0.45"/>
                <GradientStop Color="{StaticResource Blue500}" Offset="1"/>
            </RadialGradientBrush>
            <SolidColorBrush x:Key="EtherRadioButtonDisabledCheckedDotBrush" Color="{StaticResource Gray25}"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="EtherRadioButtonCircleFillDefaultBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="EtherRadioButtonCircleFillHoverBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="EtherRadioButtonCircleFillPressedBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="EtherRadioButtonCircleStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="EtherRadioButtonFocusBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherRadioButtonCheckedFillDefaultBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherRadioButtonCheckedFillHoverBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherRadioButtonCheckedFillPressedBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherRadioButtonCheckedStrokeBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherRadioButtonInnerDotBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
            <SolidColorBrush x:Key="EtherRadioButtonLabelBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="EtherRadioButtonDisabledUncheckedFillBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="EtherRadioButtonDisabledUncheckedStrokeBrush" Color="{ThemeResource SystemColorGrayTextColor}"/>
            <RadialGradientBrush x:Key="EtherRadioButtonDisabledCheckedFillBrush"
                                 MappingMode="RelativeToBoundingBox"
                                 Center="0.5,0.5"
                                 GradientOrigin="0.5,0.5"
                                 RadiusX="0.5"
                                 RadiusY="0.5"
                                 SpreadMethod="Pad">
                <GradientStop Color="{ThemeResource SystemColorHighlightTextColor}" Offset="0"/>
                <GradientStop Color="{ThemeResource SystemColorHighlightTextColor}" Offset="0.444"/>
                <GradientStop Color="{ThemeResource SystemColorHighlightColor}" Offset="0.45"/>
                <GradientStop Color="{ThemeResource SystemColorHighlightColor}" Offset="1"/>
            </RadialGradientBrush>
            <SolidColorBrush x:Key="EtherRadioButtonDisabledCheckedDotBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Structural overlay fill: not themed, so High Contrast can keep SystemColor-only
         theme keys while the stroke ring still reveals the face beneath it. -->
    <SolidColorBrush x:Key="EtherRadioButtonTransparentBrush" Color="Transparent"/>

    <ControlTemplate x:Key="EtherRadioButtonTemplate" TargetType="controls:EtherRadioButton">
        <Grid x:Name="LayoutRoot" Background="{StaticResource EtherRadioButtonTransparentBrush}">
            <VisualStateManager.VisualStateGroups>

                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition From="Normal" To="PointerOver" GeneratedDuration="0:0:0.12">
                            <VisualTransition.GeneratedEasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                        <VisualTransition From="PointerOver" To="Normal" GeneratedDuration="0:0:0.12">
                            <VisualTransition.GeneratedEasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                        <VisualTransition To="Pressed" GeneratedDuration="0:0:0.08">
                            <VisualTransition.GeneratedEasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Target="UncheckedFill.Background" Value="{ThemeResource EtherRadioButtonCircleFillDefaultBrush}"/>
                            <Setter Target="CheckedFill.Background" Value="{ThemeResource EtherRadioButtonCheckedFillDefaultBrush}"/>
                            <Setter Target="CheckedStroke.BorderBrush" Value="{ThemeResource EtherRadioButtonCheckedStrokeBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="UncheckedFill.Background" Value="{ThemeResource EtherRadioButtonCircleFillHoverBrush}"/>
                            <Setter Target="CheckedFill.Background" Value="{ThemeResource EtherRadioButtonCheckedFillHoverBrush}"/>
                            <Setter Target="CheckedStroke.BorderBrush" Value="{ThemeResource EtherRadioButtonCheckedStrokeBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="UncheckedFill.Background" Value="{ThemeResource EtherRadioButtonCircleFillPressedBrush}"/>
                            <Setter Target="CheckedFill.Background" Value="{ThemeResource EtherRadioButtonCheckedFillPressedBrush}"/>
                            <Setter Target="CheckedStroke.BorderBrush" Value="{ThemeResource EtherRadioButtonCheckedFillPressedBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <!-- Figma: Default colours, then 40 % on the whole control. A
                                 separate translucent Ellipse lets blue show through the
                                 centre. Paint the 8 px disc into CheckedFill as one
                                 gradient, hide Dot, then fade LayoutRoot. -->
                            <Setter Target="LayoutRoot.Opacity" Value="0.4"/>
                            <Setter Target="Dot.Opacity" Value="0"/>
                            <Setter Target="UncheckedFill.Background" Value="{ThemeResource EtherRadioButtonCircleFillDefaultBrush}"/>
                            <Setter Target="CheckedFill.Background" Value="{ThemeResource EtherRadioButtonDisabledCheckedFillBrush}"/>
                            <Setter Target="CheckedStroke.BorderBrush" Value="{ThemeResource EtherRadioButtonCheckedStrokeBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>

                <VisualStateGroup x:Name="CheckStates">
                    <VisualState x:Name="Unchecked">
                        <VisualState.Setters>
                            <Setter Target="UncheckedFace.Visibility" Value="Visible"/>
                            <Setter Target="CheckedFace.Visibility" Value="Collapsed"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Checked">
                        <VisualState.Setters>
                            <Setter Target="UncheckedFace.Visibility" Value="Collapsed"/>
                            <Setter Target="CheckedFace.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                    <!-- Indeterminate intentionally unstyled: a radio is never three-state. -->
                </VisualStateGroup>

                <!-- Keyboard focus (a11y): the FocusRing below is shown/hidden from code-behind
                     (OnGotFocus/OnLostFocus, keyboard focus only). Modern WinUI controls do not
                     drive a FocusStates VSM group, so a visual-state group here would be dead. -->

            </VisualStateManager.VisualStateGroups>

            <!-- HandContentControl sets a hand cursor over the whole clickable area. It only
                 affects hit-testable instances: the showcase specimens (IsHitTestVisible=False)
                 never receive pointer input, so they keep the arrow. -->
            <primitives:HandContentControl HorizontalContentAlignment="Left"
                                         VerticalContentAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing8}" VerticalAlignment="Center">
                <!-- Figma nodes 62102:8755/8800 specify a fixed 18x18 indicator;
                     keep it fixed as an explicit design decision (option b), while
                     the label itself follows the shared text-overflow policy. -->
                <Grid Width="18" Height="18">
                    <!--
                        Each face is a solid fill circle with the stroke as a SEPARATE
                        transparent-background ring on top — never one Border carrying both a
                        Background and a BorderBrush. That single-Border form clips the fill to
                        the inner radius (outer radius minus 1.5 px border) and, at fractional
                        DPI, leaves a hairline seam at the rounded edge that shows the white
                        page through. Here the ring's only backdrop is the fill beneath it, so
                        any seam reveals the fill colour, not white. CornerRadius 9 on an
                        18 x 18 Border renders a full circle with the border drawn inside.
                    -->
                    <!-- Unchecked face: translucent fill under a grey stroke ring. -->
                    <Grid x:Name="UncheckedFace">
                        <Border x:Name="UncheckedFill"
                                Background="{ThemeResource EtherRadioButtonCircleFillDefaultBrush}"
                                CornerRadius="9"/>
                        <Border x:Name="UncheckedStroke"
                                Background="{StaticResource EtherRadioButtonTransparentBrush}"
                                BorderBrush="{ThemeResource EtherRadioButtonCircleStrokeBrush}"
                                BorderThickness="1.5"
                                CornerRadius="9"
                                IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Checked face: brand-blue fill under a blue stroke ring, carrying the dot. -->
                    <Grid x:Name="CheckedFace" Visibility="Collapsed">
                        <Border x:Name="CheckedFill"
                                Background="{ThemeResource EtherRadioButtonCheckedFillDefaultBrush}"
                                CornerRadius="9"/>
                        <Border x:Name="CheckedStroke"
                                Background="{StaticResource EtherRadioButtonTransparentBrush}"
                                BorderBrush="{ThemeResource EtherRadioButtonCheckedStrokeBrush}"
                                BorderThickness="1.5"
                                CornerRadius="9"
                                IsHitTestVisible="False"/>
                        <!-- Figma's 8 px inner dot is part of the fixed indicator spec. -->
                        <Ellipse x:Name="Dot"
                                 Width="8" Height="8"
                                 Fill="{ThemeResource EtherRadioButtonInnerDotBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Keyboard focus ring: hugs the 18x18 circle (inner edge meets the circle
                         edge, so no page shows through => no white halo). Shown only when Focused. -->
                    <Border x:Name="FocusRing"
                            Margin="-2"
                            BorderBrush="{ThemeResource EtherRadioButtonFocusBrush}"
                            BorderThickness="2"
                            CornerRadius="11"
                            IsHitTestVisible="False"
                            Visibility="Collapsed"/>
                </Grid>

                <ContentPresenter x:Name="Label"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                  Visibility="{Binding UsesTextContentPath, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EtherStringContentVisibilityConverter}, ConverterParameter=False}"
                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                  FontSize="{StaticResource Size12}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   VerticalAlignment="Center"
                                   AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock x:Name="TextContent"
                           Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                           Visibility="{Binding UsesTextContentPath, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EtherStringContentVisibilityConverter}}"
                           Foreground="{TemplateBinding Foreground}"
                           FontFamily="{TemplateBinding FontFamily}"
                           FontSize="{StaticResource Size12}"
                           FontWeight="{TemplateBinding FontWeight}"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.AccessibilityView="Raw"/>
            </StackPanel>
            </primitives:HandContentControl>
        </Grid>
    </ControlTemplate>

    <Style x:Key="DefaultEtherRadioButtonStyle" TargetType="controls:EtherRadioButton">
        <Setter Property="Foreground" Value="{ThemeResource EtherRadioButtonLabelBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource RobotoFont}"/>
        <Setter Property="FontWeight" Value="{StaticResource WeightSemibold}"/>
        <Setter Property="IsThreeState" Value="False"/>
        <Setter Property="UseSystemFocusVisuals" Value="False"/>
        <Setter Property="HighContrastAdjustment" Value="None"/>
        <Setter Property="MinWidth" Value="{StaticResource Spacing0}"/>
        <Setter Property="MinHeight" Value="{StaticResource Spacing0}"/>
        <Setter Property="Padding" Value="{StaticResource Padding0}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource EtherRadioButtonTemplate}"/>
    </Style>

    <Style TargetType="controls:EtherRadioButton" BasedOn="{StaticResource DefaultEtherRadioButtonStyle}"/>

</ResourceDictionary>
