<!--
    Ether Design System Radio Button

    Figma source: ursRC201v8IiVeafliI45F, node 60607:915 (spec-sheet-radio-buttons)
    Circle 18 x 18, 1.5 px stroke drawn inside. Label is Inter SemiBold 12 with an
    8 px gap. When checked, a 10 x 10 near-white (#F5F7F8) dot sits in the centre.
    No indeterminate state (IsThreeState = False via DefaultEtherRadioButtonStyle).

    STATES
      Unchecked: Default / Hover / Pressed / Disabled
      Checked:   Default / Hover / Disabled        (no distinct pressed in the spec)
      Disabled reads as the control at 40 % (see the disabled-brush note below).

    Sibling of the Checkbox (same spec sheet, same palette): the only visual
    differences are the round shape and the inner dot in place of the tick.

    Colours live in EtherRadioButton* component theme dictionaries (Light/Dark keep
    the previous literal hex; High Contrast uses Windows SystemColor*). Fill depends
    on BOTH check-ness and pointer state, which live in two separate visual-state
    groups (CommonStates, CheckStates). To avoid those groups fighting over one
    property, each owns a different one:
      - CommonStates writes Background on TWO different borders (UncheckedFill and
        CheckedFill) — the four pointer fills for each.
      - CheckStates writes only Visibility (which of the two faces shows).
    No property is written by both groups, so there is no ordering race.

    LOCATION
      This dictionary lives beside its class (Controls/EtherRadioButton.cs) and is merged
      explicitly from App.xaml. See the "Mechanism refinement" note in
      docs/superpowers/plans/2026-08-06-self-contained-component-authoring-plan.md.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="EtherRadioButtonCircleFillDefaultBrush" Color="#66F5F7F8"/>
            <SolidColorBrush x:Key="EtherRadioButtonCircleFillHoverBrush"   Color="#E6F5F7F8"/>
            <SolidColorBrush x:Key="EtherRadioButtonCircleFillPressedBrush" Color="#338B96A1"/>
            <SolidColorBrush x:Key="EtherRadioButtonCircleStrokeBrush"      Color="#FF8B96A1"/>
            <SolidColorBrush x:Key="EtherRadioButtonCheckedFillDefaultBrush" Color="#FF196FFF"/>
            <SolidColorBrush x:Key="EtherRadioButtonCheckedFillHoverBrush"   Color="#FF0D62FF"/>
            <SolidColorBrush x:Key="EtherRadioButtonCheckedStrokeBrush"      Color="#FF196FFF"/>
            <SolidColorBrush x:Key="EtherRadioButtonInnerDotBrush"           Color="#FFF5F7F8"/>
            <SolidColorBrush x:Key="EtherRadioButtonLabelBrush"              Color="#B3000000"/>
            <SolidColorBrush x:Key="EtherRadioButtonDisabledUncheckedFillBrush"   Color="#FDFEFE"/>
            <SolidColorBrush x:Key="EtherRadioButtonDisabledUncheckedStrokeBrush" Color="#D0D5D9"/>
            <SolidColorBrush x:Key="EtherRadioButtonDisabledCheckedFillBrush"     Color="#A3C5FF"/>
            <SolidColorBrush x:Key="EtherRadioButtonDisabledCheckedDotBrush"      Color="#FBFCFC"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="EtherRadioButtonCircleFillDefaultBrush" Color="#1AFFFFFF"/>
            <SolidColorBrush x:Key="EtherRadioButtonCircleFillHoverBrush"   Color="#33FFFFFF"/>
            <SolidColorBrush x:Key="EtherRadioButtonCircleFillPressedBrush" Color="#29FFFFFF"/>
            <SolidColorBrush x:Key="EtherRadioButtonCircleStrokeBrush"      Color="#FF8B96A1"/>
            <SolidColorBrush x:Key="EtherRadioButtonCheckedFillDefaultBrush" Color="#FF196FFF"/>
            <SolidColorBrush x:Key="EtherRadioButtonCheckedFillHoverBrush"   Color="#FF0D62FF"/>
            <SolidColorBrush x:Key="EtherRadioButtonCheckedStrokeBrush"      Color="#FF196FFF"/>
            <SolidColorBrush x:Key="EtherRadioButtonInnerDotBrush"           Color="#FFF5F7F8"/>
            <SolidColorBrush x:Key="EtherRadioButtonLabelBrush"              Color="#B3FFFFFF"/>
            <SolidColorBrush x:Key="EtherRadioButtonDisabledUncheckedFillBrush"   Color="#FF1E2025"/>
            <SolidColorBrush x:Key="EtherRadioButtonDisabledUncheckedStrokeBrush" Color="#FF525B66"/>
            <SolidColorBrush x:Key="EtherRadioButtonDisabledCheckedFillBrush"     Color="#FF355CA8"/>
            <SolidColorBrush x:Key="EtherRadioButtonDisabledCheckedDotBrush"      Color="#FFF5F7F8"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="EtherRadioButtonCircleFillDefaultBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="EtherRadioButtonCircleFillHoverBrush"   Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="EtherRadioButtonCircleFillPressedBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="EtherRadioButtonCircleStrokeBrush"      Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="EtherRadioButtonCheckedFillDefaultBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherRadioButtonCheckedFillHoverBrush"   Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherRadioButtonCheckedStrokeBrush"      Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherRadioButtonInnerDotBrush"           Color="{ThemeResource SystemColorHighlightTextColor}"/>
            <SolidColorBrush x:Key="EtherRadioButtonLabelBrush"              Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="EtherRadioButtonDisabledUncheckedFillBrush"   Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="EtherRadioButtonDisabledUncheckedStrokeBrush" Color="{ThemeResource SystemColorGrayTextColor}"/>
            <SolidColorBrush x:Key="EtherRadioButtonDisabledCheckedFillBrush"     Color="{ThemeResource SystemColorGrayTextColor}"/>
            <SolidColorBrush x:Key="EtherRadioButtonDisabledCheckedDotBrush"      Color="{ThemeResource SystemColorButtonFaceColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Structural overlay fill: not themed, so High Contrast can keep SystemColor-only
         theme keys while the stroke ring still reveals the face beneath it. -->
    <SolidColorBrush x:Key="EtherRadioButtonTransparentBrush" Color="Transparent"/>

    <ControlTemplate x:Key="EtherRadioButtonTemplate" TargetType="controls:EtherRadioButton">
        <Grid x:Name="LayoutRoot" Background="{StaticResource EtherRadioButtonTransparentBrush}">
            <VisualStateManager.VisualStateGroups>

                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition From="Normal" To="PointerOver" GeneratedDuration="0:0:0.12">
                            <VisualTransition.GeneratedEasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                        <VisualTransition From="PointerOver" To="Normal" GeneratedDuration="0:0:0.12">
                            <VisualTransition.GeneratedEasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                        <VisualTransition To="Pressed" GeneratedDuration="0:0:0.08">
                            <VisualTransition.GeneratedEasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Target="UncheckedFill.Background" Value="{ThemeResource EtherRadioButtonCircleFillDefaultBrush}"/>
                            <Setter Target="CheckedFill.Background" Value="{ThemeResource EtherRadioButtonCheckedFillDefaultBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="UncheckedFill.Background" Value="{ThemeResource EtherRadioButtonCircleFillHoverBrush}"/>
                            <Setter Target="CheckedFill.Background" Value="{ThemeResource EtherRadioButtonCheckedFillHoverBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="UncheckedFill.Background" Value="{ThemeResource EtherRadioButtonCircleFillPressedBrush}"/>
                            <!-- The spec has no distinct checked-pressed; keep the default blue. -->
                            <Setter Target="CheckedFill.Background" Value="{ThemeResource EtherRadioButtonCheckedFillDefaultBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <!-- Solid pre-composited colours instead of a group opacity (see the
                                 disabled-brush note above). CheckStates still picks which face
                                 shows; both faces' disabled colours are set here so either is ready.
                                 Checked stroke is set to the disabled fill so the rim stays uniform.
                                 Only the label fades by opacity — it has nothing overlapping it. -->
                            <Setter Target="UncheckedFill.Background" Value="{ThemeResource EtherRadioButtonDisabledUncheckedFillBrush}"/>
                            <Setter Target="UncheckedStroke.BorderBrush" Value="{ThemeResource EtherRadioButtonDisabledUncheckedStrokeBrush}"/>
                            <Setter Target="CheckedFill.Background" Value="{ThemeResource EtherRadioButtonDisabledCheckedFillBrush}"/>
                            <Setter Target="CheckedStroke.BorderBrush" Value="{ThemeResource EtherRadioButtonDisabledCheckedFillBrush}"/>
                            <Setter Target="Dot.Fill" Value="{ThemeResource EtherRadioButtonDisabledCheckedDotBrush}"/>
                            <Setter Target="Label.Opacity" Value="0.4"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>

                <VisualStateGroup x:Name="CheckStates">
                    <VisualState x:Name="Unchecked">
                        <VisualState.Setters>
                            <Setter Target="UncheckedFace.Visibility" Value="Visible"/>
                            <Setter Target="CheckedFace.Visibility" Value="Collapsed"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Checked">
                        <VisualState.Setters>
                            <Setter Target="UncheckedFace.Visibility" Value="Collapsed"/>
                            <Setter Target="CheckedFace.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                    <!-- Indeterminate intentionally unstyled: a radio is never three-state. -->
                </VisualStateGroup>

                <!-- No FocusStates group: the spec defines no focus treatment, and a ring set
                     outside the circle left a white page-gap that read as an unwanted halo.
                     UseSystemFocusVisuals stays False. -->

            </VisualStateManager.VisualStateGroups>

            <!-- HandContentControl sets a hand cursor over the whole clickable area. It only
                 affects hit-testable instances: the showcase specimens (IsHitTestVisible=False)
                 never receive pointer input, so they keep the arrow. -->
            <controls:HandContentControl HorizontalContentAlignment="Left"
                                         VerticalContentAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing8}" VerticalAlignment="Center">
                <Grid Width="18" Height="18">
                    <!--
                        Each face is a solid fill circle with the stroke as a SEPARATE
                        transparent-background ring on top — never one Border carrying both a
                        Background and a BorderBrush. That single-Border form clips the fill to
                        the inner radius (outer radius minus 1.5 px border) and, at fractional
                        DPI, leaves a hairline seam at the rounded edge that shows the white
                        page through. Here the ring's only backdrop is the fill beneath it, so
                        any seam reveals the fill colour, not white. CornerRadius 9 on an
                        18 x 18 Border renders a full circle with the border drawn inside.
                    -->
                    <!-- Unchecked face: translucent fill under a grey stroke ring. -->
                    <Grid x:Name="UncheckedFace">
                        <Border x:Name="UncheckedFill"
                                Background="{ThemeResource EtherRadioButtonCircleFillDefaultBrush}"
                                CornerRadius="9"/>
                        <Border x:Name="UncheckedStroke"
                                Background="{StaticResource EtherRadioButtonTransparentBrush}"
                                BorderBrush="{ThemeResource EtherRadioButtonCircleStrokeBrush}"
                                BorderThickness="1.5"
                                CornerRadius="9"
                                IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Checked face: brand-blue fill under a blue stroke ring, carrying the dot. -->
                    <Grid x:Name="CheckedFace" Visibility="Collapsed">
                        <Border x:Name="CheckedFill"
                                Background="{ThemeResource EtherRadioButtonCheckedFillDefaultBrush}"
                                CornerRadius="9"/>
                        <Border x:Name="CheckedStroke"
                                Background="{StaticResource EtherRadioButtonTransparentBrush}"
                                BorderBrush="{ThemeResource EtherRadioButtonCheckedStrokeBrush}"
                                BorderThickness="1.5"
                                CornerRadius="9"
                                IsHitTestVisible="False"/>
                        <Ellipse x:Name="Dot"
                                 Width="{StaticResource Spacing10}" Height="{StaticResource Spacing10}"
                                 Fill="{ThemeResource EtherRadioButtonInnerDotBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

                <ContentPresenter x:Name="Label"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Foreground="{ThemeResource EtherRadioButtonLabelBrush}"
                                  FontFamily="{StaticResource InterFont}"
                                  FontSize="{StaticResource Size12}"
                                  FontWeight="{StaticResource WeightSemibold}"
                                  VerticalAlignment="Center"/>
            </StackPanel>
            </controls:HandContentControl>
        </Grid>
    </ControlTemplate>

    <Style x:Key="DefaultEtherRadioButtonStyle" TargetType="controls:EtherRadioButton">
        <Setter Property="IsThreeState" Value="False"/>
        <Setter Property="UseSystemFocusVisuals" Value="False"/>
        <Setter Property="HighContrastAdjustment" Value="None"/>
        <Setter Property="MinWidth" Value="{StaticResource Spacing0}"/>
        <Setter Property="MinHeight" Value="{StaticResource Spacing0}"/>
        <Setter Property="Padding" Value="{StaticResource Padding0}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource EtherRadioButtonTemplate}"/>
    </Style>

    <Style TargetType="controls:EtherRadioButton" BasedOn="{StaticResource DefaultEtherRadioButtonStyle}"/>

</ResourceDictionary>
