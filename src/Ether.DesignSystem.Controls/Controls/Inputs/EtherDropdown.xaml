<!--
    EtherDropdown.xaml = Ether Design System · Compact Dropdown
    ============================================================

    USAGE
      <controls:EtherDropdown SelectedIndex="0">
          <ComboBoxItem Content="10 Minutes"/>
          <ComboBoxItem Content="30 Minutes"/>
          <ComboBoxItem Content="1 Hour"/>
      </controls:EtherDropdown>

    DefaultEtherDropdownStyle owns the default setters and template. The implicit
    style is BasedOn that key. EtherDropdown remains a keyed alias for older
    StaticResource call sites. EtherDropdownItem stays the ComboBoxItem style.

    VISUAL STATES
      Default:     EtherDropdownFillDefaultBrush · EtherDropdownForegroundBrush
      PointerOver: EtherDropdownFillHoverBrush
      Pressed:     EtherDropdownFillPressedBrush
      Opened:      EtherDropdownActiveStrokeBrush 1 px outline · default fill
      Focused:     EtherDropdownFocusBrush 2 px
      Disabled:    entire control at 40% opacity

    KEY MEASUREMENTS (Figma source: ursRC201v8IiVeafliI45F
      Light trigger 60752:11307 · Dark trigger 62102:10010
      Light menu 62005:1225 · Dark menu 62102:10038)
      Width       max(130 px, longest option + icon + padding)
      Height      32 px (MinHeight)
      Padding     8 all sides
      CornerRadius 4 (RadiusSm)
      Font        Inter SemiBold 11 px · letter-spacing 0.22 px
      Arrow icon  16×16 slot · filled triangle Path

    MENU MEASUREMENTS
      Item height 26 px (literal; Figma item frames)
      Item gap    4 px (StackPanel Spacing)
      Menu padding 4 px all sides
      Visible     6 items, then scrolls (MaxVisibleItems)

    Light/Dark component brushes bind Color to primitive StaticResources.
    Trigger fills: Gray75/100/150 Light, Gray950/900/850 Dark.
    Label: AlphaBlack70 / AlphaWhite70. Arrow uses the same brush as the label.
    Menu panel matches Default fill. Light item hover/pressed are the unbound
    Figma overlays AlphaWhite40 / AlphaWhite60; Dark items are Gray850 / Gray800.
    Selected uses the hover fill (Figma has no Selected variant). High Contrast
    uses Windows SystemColor*. Corner radius uses RadiusSm.

    LOCATION
      This dictionary lives beside its class (Controls/EtherDropdown.cs) and is merged
      explicitly from App.xaml. See the "Mechanism refinement" note in
      docs/superpowers/plans/2026-08-06-self-contained-component-authoring-plan.md.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ether.DesignSystem.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="EtherDropdownActiveStrokeBrush" ResourceKey="BorderDropdownActive"/>
            <SolidColorBrush x:Key="EtherDropdownFillDefaultBrush" Color="{StaticResource Gray75}"/>
            <SolidColorBrush x:Key="EtherDropdownFillHoverBrush" Color="{StaticResource Gray100}"/>
            <SolidColorBrush x:Key="EtherDropdownFillPressedBrush" Color="{StaticResource Gray150}"/>
            <SolidColorBrush x:Key="EtherDropdownFocusBrush" Color="{StaticResource Blue600}"/>
            <SolidColorBrush x:Key="EtherDropdownForegroundBrush" Color="{StaticResource AlphaBlack70}"/>
            <!-- Same color as the default label/item text in Light/Dark: the Hover/Pressed/
                 Selected fills here are translucent overlays, so the default text color stays
                 legible on top of them. High Contrast repaints those fills as an opaque
                 SystemColorHighlightColor, so these need to repaint as
                 SystemColorHighlightTextColor there instead (see the HighContrast dictionary). -->
            <SolidColorBrush x:Key="EtherDropdownForegroundHoverBrush" Color="{StaticResource AlphaBlack70}"/>
            <SolidColorBrush x:Key="EtherDropdownForegroundPressedBrush" Color="{StaticResource AlphaBlack70}"/>
            <SolidColorBrush x:Key="EtherDropdownItemForegroundActiveBrush" Color="{StaticResource AlphaBlack70}"/>
            <SolidColorBrush x:Key="EtherDropdownItemSelectedBrush" Color="{StaticResource AlphaWhite40}"/>
            <SolidColorBrush x:Key="EtherDropdownItemSelectedHoverBrush" Color="{StaticResource AlphaWhite40}"/>
            <SolidColorBrush x:Key="EtherDropdownItemSelectedPressedBrush" Color="{StaticResource AlphaWhite60}"/>
            <SolidColorBrush x:Key="EtherDropdownMenuBackgroundBrush" Color="{StaticResource Gray75}"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <StaticResource x:Key="EtherDropdownActiveStrokeBrush" ResourceKey="BorderDropdownActive"/>
            <SolidColorBrush x:Key="EtherDropdownFillDefaultBrush" Color="{StaticResource Gray950}"/>
            <SolidColorBrush x:Key="EtherDropdownFillHoverBrush" Color="{StaticResource Gray900}"/>
            <SolidColorBrush x:Key="EtherDropdownFillPressedBrush" Color="{StaticResource Gray850}"/>
            <SolidColorBrush x:Key="EtherDropdownFocusBrush" Color="{StaticResource Blue500}"/>
            <SolidColorBrush x:Key="EtherDropdownForegroundBrush" Color="{StaticResource AlphaWhite70}"/>
            <SolidColorBrush x:Key="EtherDropdownForegroundHoverBrush" Color="{StaticResource AlphaWhite70}"/>
            <SolidColorBrush x:Key="EtherDropdownForegroundPressedBrush" Color="{StaticResource AlphaWhite70}"/>
            <SolidColorBrush x:Key="EtherDropdownItemForegroundActiveBrush" Color="{StaticResource AlphaWhite70}"/>
            <SolidColorBrush x:Key="EtherDropdownItemSelectedBrush" Color="{StaticResource Gray850}"/>
            <SolidColorBrush x:Key="EtherDropdownItemSelectedHoverBrush" Color="{StaticResource Gray850}"/>
            <SolidColorBrush x:Key="EtherDropdownItemSelectedPressedBrush" Color="{StaticResource Gray800}"/>
            <SolidColorBrush x:Key="EtherDropdownMenuBackgroundBrush" Color="{StaticResource Gray950}"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <LinearGradientBrush x:Key="EtherDropdownActiveStrokeBrush"
                                 StartPoint="1,0.51923561"
                                 EndPoint="0,0.51923561">
                <GradientStop Offset="0" Color="{ThemeResource SystemColorHighlightColor}"/>
                <GradientStop Offset="0.09789021" Color="{ThemeResource SystemColorHighlightColor}"/>
                <GradientStop Offset="0.8" Color="{ThemeResource SystemColorHighlightColor}"/>
                <GradientStop Offset="1" Color="{ThemeResource SystemColorHighlightColor}"/>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="EtherDropdownFillDefaultBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="EtherDropdownFillHoverBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherDropdownFillPressedBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherDropdownFocusBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherDropdownForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <!-- Paired with FillHoverBrush/FillPressedBrush and the Item*Brush fills below,
                 which repaint as an opaque SystemColorHighlightColor in High Contrast: text sitting
                 on that fill must be SystemColorHighlightTextColor, not the WindowText color used
                 against the ButtonFace/transparent default fill. -->
            <SolidColorBrush x:Key="EtherDropdownForegroundHoverBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
            <SolidColorBrush x:Key="EtherDropdownForegroundPressedBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
            <SolidColorBrush x:Key="EtherDropdownItemForegroundActiveBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
            <SolidColorBrush x:Key="EtherDropdownItemSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherDropdownItemSelectedHoverBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherDropdownItemSelectedPressedBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherDropdownMenuBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Structural overlay fill: not themed, so High Contrast can keep SystemColor-only
         theme keys while the trigger/item hit-test layers stay empty. -->
    <SolidColorBrush x:Key="EtherDropdownTransparentBrush" Color="Transparent"/>

    <!-- Single source of truth for the width floor: the trigger's MinWidth and the menu's
         MinWidth both read this, so the spec lives in one place. -->
    <x:Double x:Key="DropdownMinWidth">130</x:Double>

    <ControlTemplate x:Key="EtherDropdownTemplate" TargetType="controls:EtherDropdown">
        <Grid x:Name="LayoutRoot">
            <VisualStateManager.VisualStateGroups>
                <!--
                    StateFill and OpenFill exist so these two groups never write the same
                    property. CommonStates owns StateFill.Background; DropDownStates owns
                    which of the two fills is visible. Driving one shared fill from both
                    groups does not work: while the menu is open, pointer events over the
                    menu bubble to the ComboBox (the Popup is inside this template) and put
                    CommonStates into PointerOver, lighting the trigger up for a pointer
                    that is over the MENU. A VisualState setter outranks both an animation
                    and a same-frame correction, so the only reliable fix is to give the
                    open state a fill of its own that hover cannot address.
                -->
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="StateFill.Background" Value="{ThemeResource EtherDropdownFillHoverBrush}"/>
                            <Setter Target="TriggerText.Foreground" Value="{ThemeResource EtherDropdownForegroundHoverBrush}"/>
                            <Setter Target="Arrow.Fill" Value="{ThemeResource EtherDropdownForegroundHoverBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="StateFill.Background" Value="{ThemeResource EtherDropdownFillPressedBrush}"/>
                            <Setter Target="TriggerText.Foreground" Value="{ThemeResource EtherDropdownForegroundPressedBrush}"/>
                            <Setter Target="Arrow.Fill" Value="{ThemeResource EtherDropdownForegroundPressedBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <!-- Figma: retain base colors, then fade the entire dropdown to 40%. -->
                            <Setter Target="LayoutRoot.Opacity" Value="0.4"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Target="FocusRing.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Unfocused"/>
                </VisualStateGroup>
                <VisualStateGroup x:Name="DropDownStates">
                    <VisualState x:Name="Opened">
                        <VisualState.Setters>
                            <Setter Target="ActiveStroke.Visibility" Value="Visible"/>
                            <!-- Swap to a fill CommonStates has no handle on, so hover and
                                 pressed cannot repaint the trigger while the menu is up. -->
                            <Setter Target="StateFill.Visibility" Value="Collapsed"/>
                            <Setter Target="OpenFill.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                        <Storyboard>
                            <!-- Angle animations run independently (off the UI thread), so no
                                 EnableDependentAnimation is needed. -->
                            <DoubleAnimation Storyboard.TargetName="ArrowRotation"
                                             Storyboard.TargetProperty="Angle"
                                             To="180" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Closed">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ArrowRotation"
                                             Storyboard.TargetProperty="Angle"
                                             To="0" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- Fill while the menu is closed; CommonStates repaints this one. -->
            <Border x:Name="StateFill"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    IsHitTestVisible="False"/>

            <!-- Fill while the menu is open. Always the default colour, and out of reach of
                 CommonStates, so pointer state cannot tint the trigger. Exactly one of the
                 two fills is ever visible, so the translucent tokens never stack. -->
            <Border x:Name="OpenFill"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>

            <Border x:Name="Bg"
                    Background="{StaticResource EtherDropdownTransparentBrush}"
                    CornerRadius="{StaticResource RadiusSm}"
                    Padding="{TemplateBinding Padding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                    </Grid.ColumnDefinitions>
                    <!-- ComboBox requires a template part named exactly "ContentPresenter"
                         and drives it itself: it clears the part's Content while the menu
                         is open, and renaming the part away breaks the control's own
                         DropDownStates transitions (the Opened gradient stroke stops
                         appearing). So keep the part for the framework but hide it, and
                         show the selection through TriggerText instead. -->
                    <ContentPresenter x:Name="ContentPresenter"
                                      Grid.Column="0"
                                      Visibility="Collapsed"/>
                    <!-- Raw: the ComboBox's own automation peer already reports the selection,
                         so exposing this TextBlock too would announce it twice. -->
                    <TextBlock x:Name="TriggerText"
                               Grid.Column="0"
                               AutomationProperties.AccessibilityView="Raw"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Foreground="{TemplateBinding Foreground}"
                               FontFamily="{TemplateBinding FontFamily}"
                               FontSize="{TemplateBinding FontSize}"
                               FontWeight="{TemplateBinding FontWeight}"
                                CharacterSpacing="20"
                                Style="{StaticResource EtherSingleLineTextBlockStyle}"/>
                    <Path x:Name="Arrow"
                          Grid.Column="1"
                          Width="8"
                          Height="4"
                          Data="M 0 0 L 8 0 L 4 4 Z"
                          Stretch="Fill"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Fill="{TemplateBinding Foreground}"
                          RenderTransformOrigin="0.5,0.5"
                          AutomationProperties.AccessibilityView="Raw">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="ArrowRotation"/>
                        </Path.RenderTransform>
                    </Path>
                </Grid>
            </Border>

            <!-- Figma Gradient-100, shown while the dropdown menu is open. -->
            <Border x:Name="ActiveStroke"
                    BorderBrush="{ThemeResource EtherDropdownActiveStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSm}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>

            <Border x:Name="FocusRing"
                    Margin="-3"
                    BorderBrush="{ThemeResource EtherDropdownFocusBrush}"
                    BorderThickness="2"
                    CornerRadius="5"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>

            <!-- Figma dropdown menu: 4 px container padding and 6 px item padding. -->
            <Popup x:Name="Popup">
                <!-- Framework-driven show/hide motion. It has to live on the Popup rather than
                     on a Storyboard we run ourselves, because ComboBox tears the popup down the
                     instant the menu closes — only the Popup's own transition gets to play a
                     close animation before that happens. -->
                <Popup.ChildTransitions>
                    <TransitionCollection>
                        <PopupThemeTransition FromVerticalOffset="-8"/>
                    </TransitionCollection>
                </Popup.ChildTransitions>
                <Border x:Name="PopupBorder"
                        Background="{ThemeResource EtherDropdownMenuBackgroundBrush}"
                        CornerRadius="{StaticResource RadiusSm}"
                        Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MinWidth="{StaticResource DropdownMinWidth}"
                        Padding="{StaticResource Padding4}">
                    <ScrollViewer x:Name="ScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <!-- Scroll bar styling now lives in the app-wide Controls/EtherScrollBar.xaml. -->
                        <!-- No right gutter: the menu's padding is a symmetric 4 px, so the
                             4 px scroll bar overlays the item edge instead of insetting it. -->
                        <ItemsPresenter/>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
    </ControlTemplate>

    <Style x:Key="EtherDropdownItem" TargetType="ComboBoxItem">
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
        <Setter Property="FontSize" Value="{StaticResource Size11}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid x:Name="ItemBackground"
                          Background="{StaticResource EtherDropdownTransparentBrush}"
                          CornerRadius="{StaticResource RadiusSm}"
                          Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBackground.Background" Value="{ThemeResource EtherDropdownItemSelectedHoverBrush}"/>
                                        <Setter Target="ItemContent.Foreground" Value="{ThemeResource EtherDropdownItemForegroundActiveBrush}"/>
                                        <Setter Target="ItemTextContent.Foreground" Value="{ThemeResource EtherDropdownItemForegroundActiveBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBackground.Background" Value="{ThemeResource EtherDropdownItemSelectedPressedBrush}"/>
                                        <Setter Target="ItemContent.Foreground" Value="{ThemeResource EtherDropdownItemForegroundActiveBrush}"/>
                                        <Setter Target="ItemTextContent.Foreground" Value="{ThemeResource EtherDropdownItemForegroundActiveBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBackground.Opacity" Value="0.4"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBackground.Background" Value="{ThemeResource EtherDropdownItemSelectedBrush}"/>
                                        <Setter Target="ItemContent.Foreground" Value="{ThemeResource EtherDropdownItemForegroundActiveBrush}"/>
                                        <Setter Target="ItemTextContent.Foreground" Value="{ThemeResource EtherDropdownItemForegroundActiveBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedUnfocused">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBackground.Background" Value="{ThemeResource EtherDropdownItemSelectedBrush}"/>
                                        <Setter Target="ItemContent.Foreground" Value="{ThemeResource EtherDropdownItemForegroundActiveBrush}"/>
                                        <Setter Target="ItemTextContent.Foreground" Value="{ThemeResource EtherDropdownItemForegroundActiveBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBackground.Background" Value="{ThemeResource EtherDropdownItemSelectedBrush}"/>
                                        <Setter Target="ItemBackground.Opacity" Value="0.4"/>
                                        <Setter Target="ItemContent.Foreground" Value="{ThemeResource EtherDropdownItemForegroundActiveBrush}"/>
                                        <Setter Target="ItemTextContent.Foreground" Value="{ThemeResource EtherDropdownItemForegroundActiveBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBackground.Background" Value="{ThemeResource EtherDropdownItemSelectedHoverBrush}"/>
                                        <Setter Target="ItemContent.Foreground" Value="{ThemeResource EtherDropdownItemForegroundActiveBrush}"/>
                                        <Setter Target="ItemTextContent.Foreground" Value="{ThemeResource EtherDropdownItemForegroundActiveBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBackground.Background" Value="{ThemeResource EtherDropdownItemSelectedPressedBrush}"/>
                                        <Setter Target="ItemContent.Foreground" Value="{ThemeResource EtherDropdownItemForegroundActiveBrush}"/>
                                        <Setter Target="ItemTextContent.Foreground" Value="{ThemeResource EtherDropdownItemForegroundActiveBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="ItemContent"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                          Visibility="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EtherStringContentVisibilityConverter}}"
                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Foreground="{ThemeResource EtherDropdownForegroundBrush}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{StaticResource WeightSemibold}"
                                           CharacterSpacing="20"/>
                        <TextBlock x:Name="ItemTextContent"
                                   Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EtherStringContentVisibilityConverter}, ConverterParameter=String}"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                   Foreground="{ThemeResource EtherDropdownForegroundBrush}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{StaticResource WeightSemibold}"
                                   CharacterSpacing="20"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultEtherDropdownStyle" TargetType="controls:EtherDropdown">
        <Setter Property="Background"                 Value="{ThemeResource EtherDropdownFillDefaultBrush}"/>
        <Setter Property="Foreground"                 Value="{ThemeResource EtherDropdownForegroundBrush}"/>
        <Setter Property="CornerRadius"               Value="{StaticResource RadiusSm}"/>
        <Setter Property="FontWeight"                 Value="{StaticResource WeightSemibold}"/>
        <Setter Property="Padding"                    Value="{StaticResource Padding8}"/>
        <Setter Property="HorizontalAlignment"       Value="Left"/>
        <Setter Property="MinWidth"                   Value="{StaticResource DropdownMinWidth}"/>
        <Setter Property="MinHeight"                  Value="32"/>
        <Setter Property="FontFamily"                 Value="{StaticResource InterFont}"/>
        <Setter Property="FontSize"                   Value="{StaticResource Size11}"/>
        <Setter Property="MaxVisibleItems"            Value="6"/>
        <Setter Property="MenuGap"                    Value="{StaticResource Spacing4}"/>
        <Setter Property="ItemContainerStyle"          Value="{StaticResource EtherDropdownItem}"/>
        <!-- ComboBox's default items panel is CarouselPanel, which centres the menu on the
             selected item and takes scrolling over itself — leaving the host ScrollViewer
             reporting a zero extent, so its Auto scrollbar never appears. A plain StackPanel
             restores ordinary top-down layout and pixel scrolling. -->
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" Spacing="{StaticResource Spacing4}"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="UseSystemFocusVisuals"      Value="False"/>
        <Setter Property="HighContrastAdjustment"     Value="None"/>
        <Setter Property="Template" Value="{StaticResource EtherDropdownTemplate}"/>
    </Style>

    <Style TargetType="controls:EtherDropdown" BasedOn="{StaticResource DefaultEtherDropdownStyle}"/>
    <Style x:Key="EtherDropdown" TargetType="controls:EtherDropdown" BasedOn="{StaticResource DefaultEtherDropdownStyle}"/>

</ResourceDictionary>
