<!--
    EtherButton.xaml = Ether Design System · Button Styles
    =======================================================

    Applied to controls:EtherButton (a Button subclass with a hand cursor + optional icons).
    DefaultEtherButtonStyle is Primary medium (large). The implicit style is BasedOn that key.
    Existing named Style keys remain the supported explicit contract.

    USAGE
      Default            <controls:EtherButton Content="Save changes"/>
      Primary (large)    <controls:EtherButton Style="{StaticResource EtherButtonPrimary}"      Content="Save changes"/>
      Primary (small)    <controls:EtherButton Style="{StaticResource EtherButtonPrimarySmall}" Content="Save"/>
      Left / Right icon  EtherButton.LeftIcon and EtherButton.RightIcon — independently optional,
                         strongly-typed IconElement slots. An unset slot is collapsed by its
                         matching visual state; callers may supply either, both, or neither:
                           <controls:EtherButton Style="{StaticResource EtherButtonPrimary}" Content="Next">
                               <controls:EtherButton.RightIcon>
                                    <PathIcon Style="{StaticResource IconChevronRight}" Width="20" Height="20"/>
                               </controls:EtherButton.RightIcon>
                           </controls:EtherButton>
      Secondary (large)  <controls:EtherButton Style="{StaticResource EtherButtonSecondary}"      Content="Cancel"/>
      Secondary (small)  <controls:EtherButton Style="{StaticResource EtherButtonSecondarySmall}" Content="Cancel"/>
      Tertiary (large)   <controls:EtherButton Style="{StaticResource EtherButtonTertiary}"       Content="Learn more"/>
      Tertiary (small)   <controls:EtherButton Style="{StaticResource EtherButtonTertiarySmall}"  Content="More"/>
      Convenience form   <controls:EtherButton Variant="Primary" Size="Small" Content="Save"/>
                         (equivalent to Style="{StaticResource EtherButtonPrimarySmall}" — set
                         BOTH Variant and Size, or neither; existing Style= call sites are
                         unaffected either way)

    VISUAL STATES
      CommonStates: Normal · PointerOver · Pressed · Disabled
      FocusStates:  Focused · Unfocused · PointerFocused
      LeftIconStates:  LeftIconVisible · LeftIconCollapsed
      RightIconStates: RightIconVisible · RightIconCollapsed

    KEY MEASUREMENTS (Figma source: ursRC201v8IiVeafliI45F · node 62075:5624)
      Default           min-width=108EPX · 46EPX height · 20EPX horizontal / 12EPX vertical padding · 14EPX font · Figma icon 20EPX · radius 4EPX
      Small             min-width=94EPX  · 32EPX height · 16EPX horizontal / 8EPX vertical padding · 12EPX font · Figma icon 16EPX · radius 4EPX
      Icon size remains caller-controlled: the slots accept any IconElement.
      Horizontal padding is a deliberate 2026-08-27 product deviation from Figma (12/8EPX):
      Figma's Default button is fixed at 108EPX wide, so its effective visual inset exceeds
      p-12 on short labels; content-sized WinUI buttons need the extra 4EPX to match that look.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ether.DesignSystem.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="EtherButtonPrimaryBackgroundBrush" Color="{StaticResource Blue600}" />
            <SolidColorBrush x:Key="EtherButtonPrimaryBackgroundHoverBrush" Color="{StaticResource Blue700}" />
            <SolidColorBrush x:Key="EtherButtonPrimaryBackgroundPressedBrush" Color="{StaticResource Blue800}" />
            <SolidColorBrush x:Key="EtherButtonPrimaryBackgroundDisabledBrush" Color="{StaticResource Blue600}" />
            <SolidColorBrush x:Key="EtherButtonPrimaryBorderBrush" Color="{StaticResource AlphaWhite25}" />
            <SolidColorBrush x:Key="EtherButtonPrimaryBorderDisabledBrush" Color="{StaticResource AlphaWhite0}" />
            <SolidColorBrush x:Key="EtherButtonPrimaryForegroundBrush" Color="{StaticResource Gray0}" />
            <SolidColorBrush x:Key="EtherButtonPrimaryForegroundDisabledBrush" Color="{StaticResource Gray0}" />
            <SolidColorBrush x:Key="EtherButtonSecondaryBackgroundBrush" Color="{StaticResource AlphaWhite0}" />
            <SolidColorBrush x:Key="EtherButtonSecondaryBackgroundHoverBrush" Color="{StaticResource Gray25}" />
            <SolidColorBrush x:Key="EtherButtonSecondaryBackgroundPressedBrush" Color="{StaticResource Gray50}" />
            <SolidColorBrush x:Key="EtherButtonSecondaryBorderBrush" Color="{StaticResource AlphaNavy20}" />
            <SolidColorBrush x:Key="EtherButtonSecondaryForegroundBrush" Color="{StaticResource Gray1000}" />
            <!-- Same color as the default label in Light/Dark: Hover/Pressed only tint the fill a
                 shade darker, so the default label color stays legible on top of it. High Contrast
                 repaints Hover/Pressed as an opaque SystemColorHighlightColor fill, so these need
                 to repaint as SystemColorHighlightTextColor there instead. -->
            <SolidColorBrush x:Key="EtherButtonSecondaryForegroundHoverBrush" Color="{StaticResource Gray1000}" />
            <SolidColorBrush x:Key="EtherButtonSecondaryForegroundPressedBrush" Color="{StaticResource Gray1000}" />
            <SolidColorBrush x:Key="EtherButtonTertiaryBackgroundBrush" Color="{StaticResource AlphaWhite0}" />
            <SolidColorBrush x:Key="EtherButtonTertiaryForegroundBrush" Color="{StaticResource Blue600}" />
            <SolidColorBrush x:Key="EtherButtonTertiaryForegroundHoverBrush" Color="{StaticResource Blue700}" />
            <SolidColorBrush x:Key="EtherButtonTertiaryForegroundPressedBrush" Color="{StaticResource Blue800}" />
            <SolidColorBrush x:Key="EtherButtonFocusStrokeBrush" Color="{StaticResource Blue600}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="EtherButtonPrimaryBackgroundBrush" Color="{StaticResource Blue600}" />
            <SolidColorBrush x:Key="EtherButtonPrimaryBackgroundHoverBrush" Color="{StaticResource Blue700}" />
            <SolidColorBrush x:Key="EtherButtonPrimaryBackgroundPressedBrush" Color="{StaticResource Blue800}" />
            <SolidColorBrush x:Key="EtherButtonPrimaryBackgroundDisabledBrush" Color="{StaticResource Blue600}" />
            <SolidColorBrush x:Key="EtherButtonPrimaryBorderBrush" Color="{StaticResource AlphaWhite16}" />
            <SolidColorBrush x:Key="EtherButtonPrimaryBorderDisabledBrush" Color="{StaticResource AlphaWhite0}" />
            <SolidColorBrush x:Key="EtherButtonPrimaryForegroundBrush" Color="{StaticResource Gray0}" />
            <SolidColorBrush x:Key="EtherButtonPrimaryForegroundDisabledBrush" Color="{StaticResource Gray0}" />
            <SolidColorBrush x:Key="EtherButtonSecondaryBackgroundBrush" Color="{StaticResource AlphaWhite0}" />
            <SolidColorBrush x:Key="EtherButtonSecondaryBackgroundHoverBrush" Color="{StaticResource Gray800}" />
            <SolidColorBrush x:Key="EtherButtonSecondaryBackgroundPressedBrush" Color="{StaticResource Gray850}" />
            <SolidColorBrush x:Key="EtherButtonSecondaryBorderBrush" Color="{StaticResource AlphaWhite12}" />
            <SolidColorBrush x:Key="EtherButtonSecondaryForegroundBrush" Color="{StaticResource Gray0}" />
            <SolidColorBrush x:Key="EtherButtonSecondaryForegroundHoverBrush" Color="{StaticResource Gray0}" />
            <SolidColorBrush x:Key="EtherButtonSecondaryForegroundPressedBrush" Color="{StaticResource Gray0}" />
            <SolidColorBrush x:Key="EtherButtonTertiaryBackgroundBrush" Color="{StaticResource AlphaWhite0}" />
            <SolidColorBrush x:Key="EtherButtonTertiaryForegroundBrush" Color="{StaticResource Blue300}" />
            <SolidColorBrush x:Key="EtherButtonTertiaryForegroundHoverBrush" Color="{StaticResource Blue200}" />
            <SolidColorBrush x:Key="EtherButtonTertiaryForegroundPressedBrush" Color="{StaticResource Blue100}" />
            <SolidColorBrush x:Key="EtherButtonFocusStrokeBrush" Color="{StaticResource Blue500}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="EtherButtonPrimaryBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherButtonPrimaryBackgroundHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherButtonPrimaryBackgroundPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherButtonPrimaryBackgroundDisabledBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="EtherButtonPrimaryBorderBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="EtherButtonPrimaryBorderDisabledBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="EtherButtonPrimaryForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="EtherButtonPrimaryForegroundDisabledBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="EtherButtonSecondaryBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="EtherButtonSecondaryBackgroundHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherButtonSecondaryBackgroundPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherButtonSecondaryBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="EtherButtonSecondaryForegroundBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <!-- Paired with SecondaryBackgroundHoverBrush/SecondaryBackgroundPressedBrush above,
                 which repaint as an opaque SystemColorHighlightColor fill in High Contrast: the
                 label/icons sitting on that fill must be SystemColorHighlightTextColor, not the
                 ButtonText color used against the ButtonFace default fill. -->
            <SolidColorBrush x:Key="EtherButtonSecondaryForegroundHoverBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="EtherButtonSecondaryForegroundPressedBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="EtherButtonTertiaryBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EtherButtonTertiaryForegroundBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="EtherButtonTertiaryForegroundHoverBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="EtherButtonTertiaryForegroundPressedBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="EtherButtonFocusStrokeBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--
        Shared text policy for component labels. ContentPresenter has TextWrapping but no
        TextTrimming, so each label has an explicit TextBlock for string content and a separate
        ContentPresenter for non-string content. EtherButton.xaml is the first component
        dictionary in Generic.xaml, so later input dictionaries can reuse this converter.
    -->
    <Style x:Key="EtherSingleLineTextBlockStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- Used only by component-owned textual label slots. Do not apply this template to
         EtherButton/Checkbox/RadioButton Content, which can be arbitrary UIElement content. -->
    <DataTemplate x:Key="EtherSingleLineTextContentTemplate">
        <TextBlock Text="{Binding}" Style="{StaticResource EtherSingleLineTextBlockStyle}"/>
    </DataTemplate>
    <controls:EtherStringContentVisibilityConverter x:Key="EtherStringContentVisibilityConverter"/>

    <!-- ===========================================================
         CONTROL TEMPLATES  (shared by large + small style pairs)
    =============================================================== -->

    <!-- PRIMARY -->
    <ControlTemplate x:Key="EtherButtonPrimaryTemplate" TargetType="controls:EtherButton">
        <Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Bg.Background" Value="{ThemeResource EtherButtonPrimaryBackgroundHoverBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Bg.Background" Value="{ThemeResource EtherButtonPrimaryBackgroundPressedBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <!-- Figma disabled is a 40% fade. *DisabledBrush keys stay in the
                                 theme dictionaries for key symmetry (High Contrast) and are not
                                 consumed here — swapping to those brushes would change the visual. -->
                            <Setter Target="Bg.Opacity" Value="0.4"/>
                            <Setter Target="Stroke.Opacity" Value="0.4"/>
                            <Setter Target="FocusRing.Visibility" Value="Collapsed"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Target="FocusRing.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Unfocused"/>
                    <VisualState x:Name="PointerFocused"/>
                </VisualStateGroup>
                <VisualStateGroup x:Name="LeftIconStates">
                    <VisualState x:Name="LeftIconVisible">
                        <VisualState.Setters>
                            <Setter Target="LeftIcon.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="LeftIconCollapsed">
                        <VisualState.Setters>
                            <Setter Target="LeftIcon.Visibility" Value="Collapsed"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="RightIconStates">
                    <VisualState x:Name="RightIconVisible">
                        <VisualState.Setters>
                            <Setter Target="RightIcon.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="RightIconCollapsed">
                        <VisualState.Setters>
                            <Setter Target="RightIcon.Visibility" Value="Collapsed"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Border x:Name="Bg"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
                <StackPanel Orientation="Horizontal"
                            Spacing="{StaticResource Spacing6}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                    <ContentPresenter x:Name="LeftIcon"
                                      Content="{TemplateBinding LeftIcon}"
                                      Visibility="Collapsed"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center"
                                      HorizontalContentAlignment="Center"
                                      VerticalAlignment="Center"/>
                    <ContentPresenter x:Name="Cp"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                      Visibility="{Binding UsesTextContentPath, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EtherStringContentVisibilityConverter}, ConverterParameter=False}"
                                      Foreground="{TemplateBinding Foreground}"
                                      FontFamily="{TemplateBinding FontFamily}"
                                      FontSize="{TemplateBinding FontSize}"
                                      FontWeight="{TemplateBinding FontWeight}"
                                      MaxWidth="{TemplateBinding MaxWidth}"
                                      HorizontalAlignment="Center"
                                      HorizontalContentAlignment="Center"
                                      VerticalAlignment="Center"/>
                    <TextBlock x:Name="TextContent"
                               Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                               Visibility="{Binding UsesTextContentPath, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EtherStringContentVisibilityConverter}}"
                               Foreground="{Binding Foreground, ElementName=Cp}"
                               FontFamily="{TemplateBinding FontFamily}"
                               FontSize="{TemplateBinding FontSize}"
                               FontWeight="{TemplateBinding FontWeight}"
                               MaxWidth="{TemplateBinding MaxWidth}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"/>
                    <!-- Optional trailing icon slot (collapses when RightIcon is unset). -->
                    <ContentPresenter x:Name="RightIcon"
                                      Content="{TemplateBinding RightIcon}"
                                      Visibility="Collapsed"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center"
                                      HorizontalContentAlignment="Center"
                                      VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Stroke is a sibling overlay, NOT a property of Bg: the spec's border token is
                 semi-transparent (rgba(255,255,255,0.25)), and a Border's own BorderBrush
                 composites against the page behind the control — over a white page a 25%-white
                 ring is invisible. As an overlay it composites over Bg, matching Figma's
                 inside stroke (visible light ring on the filled background). -->
            <Border x:Name="Stroke"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    IsHitTestVisible="False"/>

            <Border x:Name="FocusRing"
                    Margin="-3"
                    BorderBrush="{ThemeResource EtherButtonFocusStrokeBrush}"
                    BorderThickness="2"
                    CornerRadius="5"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>
        </Grid>
    </ControlTemplate>

    <!-- SECONDARY -->
    <ControlTemplate x:Key="EtherButtonSecondaryTemplate" TargetType="controls:EtherButton">
        <Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Bg.Background" Value="{ThemeResource EtherButtonSecondaryBackgroundHoverBrush}"/>
                            <Setter Target="LeftIcon.Foreground" Value="{ThemeResource EtherButtonSecondaryForegroundHoverBrush}"/>
                            <Setter Target="Cp.Foreground" Value="{ThemeResource EtherButtonSecondaryForegroundHoverBrush}"/>
                            <Setter Target="RightIcon.Foreground" Value="{ThemeResource EtherButtonSecondaryForegroundHoverBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Bg.Background" Value="{ThemeResource EtherButtonSecondaryBackgroundPressedBrush}"/>
                            <Setter Target="LeftIcon.Foreground" Value="{ThemeResource EtherButtonSecondaryForegroundPressedBrush}"/>
                            <Setter Target="Cp.Foreground" Value="{ThemeResource EtherButtonSecondaryForegroundPressedBrush}"/>
                            <Setter Target="RightIcon.Foreground" Value="{ThemeResource EtherButtonSecondaryForegroundPressedBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Bg.Opacity" Value="0.4"/>
                            <Setter Target="Stroke.Opacity" Value="0.4"/>
                            <Setter Target="FocusRing.Visibility" Value="Collapsed"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Target="FocusRing.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Unfocused"/>
                    <VisualState x:Name="PointerFocused"/>
                </VisualStateGroup>
                <VisualStateGroup x:Name="LeftIconStates">
                    <VisualState x:Name="LeftIconVisible">
                        <VisualState.Setters>
                            <Setter Target="LeftIcon.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="LeftIconCollapsed">
                        <VisualState.Setters>
                            <Setter Target="LeftIcon.Visibility" Value="Collapsed"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="RightIconStates">
                    <VisualState x:Name="RightIconVisible">
                        <VisualState.Setters>
                            <Setter Target="RightIcon.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="RightIconCollapsed">
                        <VisualState.Setters>
                            <Setter Target="RightIcon.Visibility" Value="Collapsed"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Border x:Name="Bg"
                    Background="{ThemeResource EtherButtonSecondaryBackgroundBrush}"
                    CornerRadius="{StaticResource RadiusSm}"
                    Padding="{TemplateBinding Padding}">
                <StackPanel Orientation="Horizontal"
                            Spacing="{StaticResource Spacing6}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                    <ContentPresenter x:Name="LeftIcon"
                                      Content="{TemplateBinding LeftIcon}"
                                      Visibility="Collapsed"
                                      Foreground="{ThemeResource EtherButtonSecondaryForegroundBrush}"
                                      HorizontalAlignment="Center"
                                      HorizontalContentAlignment="Center"
                                      VerticalAlignment="Center"/>
                    <ContentPresenter x:Name="Cp"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                      Visibility="{Binding UsesTextContentPath, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EtherStringContentVisibilityConverter}, ConverterParameter=False}"
                                      MaxWidth="{TemplateBinding MaxWidth}"
                                      Foreground="{ThemeResource EtherButtonSecondaryForegroundBrush}"
                                      FontFamily="{StaticResource InstrumentSans}"
                                      FontSize="{TemplateBinding FontSize}"
                                      FontWeight="{StaticResource WeightSemibold}"
                                      HorizontalAlignment="Center"
                                      HorizontalContentAlignment="Center"
                                      VerticalAlignment="Center"/>
                    <TextBlock x:Name="TextContent"
                               Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                               Visibility="{Binding UsesTextContentPath, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EtherStringContentVisibilityConverter}}"
                               Foreground="{Binding Foreground, ElementName=Cp}"
                               FontFamily="{StaticResource InstrumentSans}"
                               FontSize="{TemplateBinding FontSize}"
                               FontWeight="{StaticResource WeightSemibold}"
                               MaxWidth="{TemplateBinding MaxWidth}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"/>
                    <ContentPresenter x:Name="RightIcon"
                                      Content="{TemplateBinding RightIcon}"
                                      Visibility="Collapsed"
                                      Foreground="{ThemeResource EtherButtonSecondaryForegroundBrush}"
                                      HorizontalAlignment="Center"
                                      HorizontalContentAlignment="Center"
                                      VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- See Primary: overlay stroke so the semi-transparent border token composites
                 over the button background, not the page. -->
            <Border x:Name="Stroke"
                    BorderBrush="{ThemeResource EtherButtonSecondaryBorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource RadiusSm}"
                    IsHitTestVisible="False"/>

            <Border x:Name="FocusRing"
                    Margin="-3"
                    BorderBrush="{ThemeResource EtherButtonFocusStrokeBrush}"
                    BorderThickness="2"
                    CornerRadius="5"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>
        </Grid>
    </ControlTemplate>

    <!-- TERTIARY -->
    <ControlTemplate x:Key="EtherButtonTertiaryTemplate" TargetType="controls:EtherButton">
        <Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Cp.Foreground" Value="{ThemeResource EtherButtonTertiaryForegroundHoverBrush}"/>
                            <Setter Target="LeftIcon.Foreground" Value="{ThemeResource EtherButtonTertiaryForegroundHoverBrush}"/>
                            <Setter Target="RightIcon.Foreground" Value="{ThemeResource EtherButtonTertiaryForegroundHoverBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Cp.Foreground" Value="{ThemeResource EtherButtonTertiaryForegroundPressedBrush}"/>
                            <Setter Target="LeftIcon.Foreground" Value="{ThemeResource EtherButtonTertiaryForegroundPressedBrush}"/>
                            <Setter Target="RightIcon.Foreground" Value="{ThemeResource EtherButtonTertiaryForegroundPressedBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Bg.Opacity" Value="0.4"/>
                            <Setter Target="FocusRing.Visibility" Value="Collapsed"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Target="FocusRing.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Unfocused"/>
                    <VisualState x:Name="PointerFocused"/>
                </VisualStateGroup>
                <VisualStateGroup x:Name="LeftIconStates">
                    <VisualState x:Name="LeftIconVisible">
                        <VisualState.Setters>
                            <Setter Target="LeftIcon.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="LeftIconCollapsed">
                        <VisualState.Setters>
                            <Setter Target="LeftIcon.Visibility" Value="Collapsed"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="RightIconStates">
                    <VisualState x:Name="RightIconVisible">
                        <VisualState.Setters>
                            <Setter Target="RightIcon.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="RightIconCollapsed">
                        <VisualState.Setters>
                            <Setter Target="RightIcon.Visibility" Value="Collapsed"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Border x:Name="Bg"
                    Background="{ThemeResource EtherButtonTertiaryBackgroundBrush}"
                    CornerRadius="{StaticResource RadiusSm}"
                    Padding="{TemplateBinding Padding}">
                <StackPanel Orientation="Horizontal"
                            Spacing="{StaticResource Spacing6}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                    <ContentPresenter x:Name="LeftIcon"
                                      Content="{TemplateBinding LeftIcon}"
                                      Visibility="Collapsed"
                                      Foreground="{ThemeResource EtherButtonTertiaryForegroundBrush}"
                                      HorizontalAlignment="Center"
                                      HorizontalContentAlignment="Center"
                                      VerticalAlignment="Center"/>
                    <ContentPresenter x:Name="Cp"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      MaxWidth="{TemplateBinding MaxWidth}"
                                      Foreground="{ThemeResource EtherButtonTertiaryForegroundBrush}"
                                      ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                      Visibility="{Binding UsesTextContentPath, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EtherStringContentVisibilityConverter}, ConverterParameter=False}"
                                      FontFamily="{StaticResource InstrumentSans}"
                                      FontSize="{TemplateBinding FontSize}"
                                      FontWeight="{StaticResource WeightSemibold}"
                                      HorizontalAlignment="Center"
                                      HorizontalContentAlignment="Center"
                                      VerticalAlignment="Center"/>
                    <TextBlock x:Name="TextContent"
                               Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                               Visibility="{Binding UsesTextContentPath, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EtherStringContentVisibilityConverter}}"
                               Foreground="{Binding Foreground, ElementName=Cp}"
                               FontFamily="{StaticResource InstrumentSans}"
                               FontSize="{TemplateBinding FontSize}"
                               FontWeight="{StaticResource WeightSemibold}"
                               MaxWidth="{TemplateBinding MaxWidth}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"/>
                    <ContentPresenter x:Name="RightIcon"
                                      Content="{TemplateBinding RightIcon}"
                                      Visibility="Collapsed"
                                      Foreground="{ThemeResource EtherButtonTertiaryForegroundBrush}"
                                      HorizontalAlignment="Center"
                                      HorizontalContentAlignment="Center"
                                      VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border x:Name="FocusRing"
                    Margin="-3"
                    BorderBrush="{ThemeResource EtherButtonFocusStrokeBrush}"
                    BorderThickness="2"
                    CornerRadius="5"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>
        </Grid>
    </ControlTemplate>

    <!-- ===========================================================
         STYLES
    =============================================================== -->

    <Style x:Key="DefaultEtherButtonStyle" TargetType="controls:EtherButton">
        <Setter Property="Background"                 Value="{ThemeResource EtherButtonPrimaryBackgroundBrush}"/>
        <Setter Property="BorderBrush"                 Value="{ThemeResource EtherButtonPrimaryBorderBrush}"/>
