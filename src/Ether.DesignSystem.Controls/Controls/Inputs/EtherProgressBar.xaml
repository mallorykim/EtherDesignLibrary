<!--
    Ether Design System Progress Bar

    Figma source: ursRC201v8IiVeafliI45F
      Light 62110:22813 · Dark 62120:1374
    Determinate RangeBase. Track is 4 epx tall. Labels are Instrument Sans
    SemiBold 14: title left, value right, 8 epx above the track. Outer padding
    is 4 epx top and 12 epx bottom. Fill is a solid primitive (Light Blue700,
    Dark Blue400), not the Steering Bar navy-to-cyan gradient. Track is Light
    Gray75 / Dark Gray700. Corner radius 2 reads as a pill on a 4 epx bar
    (`RadiusXs`). Padding lives on the style and template-binds onto LayoutRoot.

    DefaultEtherProgressBarStyle owns the default range and label setters; the
    implicit style is BasedOn that key. Light/Dark component brushes bind Color
    to primitive StaticResources. High Contrast uses Windows SystemColor*.
    IsTabStop and UseSystemFocusVisuals stay False: the bar is read-only chrome.

    LOCATION
      This dictionary lives beside its class (Controls/Inputs/EtherProgressBar.cs)
      and is merged from Controls Generic.xaml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="EtherProgressBarFillBrush" Color="{StaticResource Blue700}" />
            <SolidColorBrush x:Key="EtherProgressBarTitleForegroundBrush" Color="{StaticResource Gray1000}" />
            <SolidColorBrush x:Key="EtherProgressBarTrackBrush" Color="{StaticResource Gray75}" />
            <SolidColorBrush x:Key="EtherProgressBarValueForegroundBrush" Color="{StaticResource AlphaBlack70}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="EtherProgressBarFillBrush" Color="{StaticResource Blue400}" />
            <SolidColorBrush x:Key="EtherProgressBarTitleForegroundBrush" Color="{StaticResource Gray0}" />
            <SolidColorBrush x:Key="EtherProgressBarTrackBrush" Color="{StaticResource Gray700}" />
            <SolidColorBrush x:Key="EtherProgressBarValueForegroundBrush" Color="{StaticResource Gray0}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="EtherProgressBarFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherProgressBarTitleForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EtherProgressBarTrackBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="EtherProgressBarValueForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="DefaultEtherProgressBarStyle" TargetType="controls:EtherProgressBar">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Value" Value="0" />
        <Setter Property="ShowTitle" Value="True" />
        <Setter Property="ShowValue" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="HighContrastAdjustment" Value="None" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0,4,0,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:EtherProgressBar">
                    <Grid x:Name="LayoutRoot" Padding="{TemplateBinding Padding}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="LabelStates">
                                <VisualState x:Name="BothLabelsVisible">
                                    <VisualState.Setters>
                                        <Setter Target="LabelRow.Visibility" Value="Visible" />
                                        <Setter Target="TitleText.Visibility" Value="Visible" />
                                        <Setter Target="ValueLabel.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="TitleOnly">
                                    <VisualState.Setters>
                                        <Setter Target="LabelRow.Visibility" Value="Visible" />
                                        <Setter Target="TitleText.Visibility" Value="Visible" />
                                        <Setter Target="ValueLabel.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="ValueOnly">
                                    <VisualState.Setters>
                                        <Setter Target="LabelRow.Visibility" Value="Visible" />
                                        <Setter Target="TitleText.Visibility" Value="Collapsed" />
                                        <Setter Target="ValueLabel.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="LabelsHidden">
                                    <VisualState.Setters>
                                        <Setter Target="LabelRow.Visibility" Value="Collapsed" />
                                        <Setter Target="TitleText.Visibility" Value="Collapsed" />
                                        <Setter Target="ValueLabel.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid x:Name="LabelRow" Grid.Row="0" Margin="0,0,0,8">
                            <ContentPresenter x:Name="TitleText" Content="{TemplateBinding Title}"
                                              ContentTemplate="{StaticResource EtherSingleLineTextContentTemplate}"
                                              HorizontalAlignment="Left" FontFamily="{StaticResource InstrumentSans}"
                                              FontSize="{StaticResource Size14}" FontWeight="{StaticResource WeightSemibold}"
                                              Foreground="{ThemeResource EtherProgressBarTitleForegroundBrush}"/>
                            <ContentPresenter x:Name="ValueLabel" Content="{TemplateBinding ValueContent}"
                                              ContentTemplate="{StaticResource EtherSingleLineTextContentTemplate}"
                                              HorizontalAlignment="Right" FontFamily="{StaticResource InstrumentSans}"
                                              FontSize="{StaticResource Size14}" FontWeight="{StaticResource WeightSemibold}"
                                              Foreground="{ThemeResource EtherProgressBarValueForegroundBrush}"/>
                        </Grid>

                        <Grid x:Name="ProgressTrack" Grid.Row="1" Height="{StaticResource Spacing4}"
                              AutomationProperties.AccessibilityView="Raw">
                            <Border x:Name="ProgressTrackBackground"
                                    Background="{ThemeResource EtherProgressBarTrackBrush}"
                                    CornerRadius="{StaticResource RadiusXs}"
                                    AutomationProperties.AccessibilityView="Raw" />
                            <Grid AutomationProperties.AccessibilityView="Raw">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="FillColumn" Width="0*" />
                                    <ColumnDefinition x:Name="RestColumn" Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ProgressFill"
                                        Grid.Column="0"
                                        Background="{ThemeResource EtherProgressBarFillBrush}"
                                        CornerRadius="{StaticResource RadiusXs}"
                                        AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:EtherProgressBar" BasedOn="{StaticResource DefaultEtherProgressBarStyle}" />
</ResourceDictionary>
