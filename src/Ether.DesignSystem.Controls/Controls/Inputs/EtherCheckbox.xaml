<!--
    Ether Design System Checkbox

    Figma source: ursRC201v8IiVeafliI45F
      Light component set 62085:7907 · Dark spec tables 62093:60 / 62093:163
    Box 18 x 18, corner radius 4, 1.5 px stroke. Label is Inter SemiBold 12 with
    an 8 px gap. Checkmark is Gray25 (#F5F7F8), the same primitive as the
    RadioButton inner dot. Figma still exports Unity Checkbox/default/icon-checked
    (#F5F6F7); no Ether primitive has that hex. No indeterminate state
    (IsThreeState = False via DefaultEtherCheckboxStyle).

    STATES
      Unchecked: Default / Hover / Pressed / Disabled
      Checked:   Default / Hover / Pressed / Disabled
      Disabled is the Default colours at 40 % opacity (Figma Opacity row).
      *DisabledBrush keys stay in the dictionaries for High Contrast symmetry
      and are not consumed — swapping to those brushes would change the visual.

    Light/Dark component brushes bind Color to primitive StaticResources.
    Semantic form-control/* keys are not referenced here. High Contrast uses
    Windows SystemColor*. Fill depends on BOTH check-ness and pointer state,
    which live in two separate visual-state groups (CommonStates, CheckStates).
    To avoid those groups fighting over one property, each owns a different one:
      - CommonStates writes Background on TWO different borders (UncheckedFill
        and CheckedFill) — the four pointer fills for each — plus checked stroke
        on Pressed (Blue700) vs Default/Hover (Blue500).
      - CheckStates writes only Visibility (which of the two faces shows).
    No property is written by both groups, so there is no ordering race.

    LOCATION
      This dictionary lives beside its class (Controls/EtherCheckbox.cs) and is
      merged explicitly from App.xaml. See the "Mechanism refinement" note in
      docs/superpowers/plans/2026-08-06-self-contained-component-authoring-plan.md.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ether.DesignSystem.Controls"
    xmlns:primitives="using:Ether.DesignSystem.Controls.Primitives">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="EtherCheckboxFillDefaultBrush" Color="{StaticResource AlphaGray40}"/>
            <SolidColorBrush x:Key="EtherCheckboxFillHoverBrush" Color="{StaticResource AlphaGray90}"/>
            <SolidColorBrush x:Key="EtherCheckboxFillPressedBrush" Color="{StaticResource AlphaGray20}"/>
            <SolidColorBrush x:Key="EtherCheckboxStrokeBrush" Color="{StaticResource Gray400}"/>
            <SolidColorBrush x:Key="EtherCheckboxFocusBrush" Color="{StaticResource AlphaBlack70}"/>
            <SolidColorBrush x:Key="EtherCheckboxCheckedFillDefaultBrush" Color="{StaticResource Blue500}"/>
            <SolidColorBrush x:Key="EtherCheckboxCheckedFillHoverBrush" Color="{StaticResource Blue600}"/>
            <SolidColorBrush x:Key="EtherCheckboxCheckedFillPressedBrush" Color="{StaticResource Blue700}"/>
            <SolidColorBrush x:Key="EtherCheckboxCheckedStrokeBrush" Color="{StaticResource Blue500}"/>
            <SolidColorBrush x:Key="EtherCheckboxGlyphBrush" Color="{StaticResource Gray25}"/>
            <SolidColorBrush x:Key="EtherCheckboxLabelBrush" Color="{StaticResource AlphaBlack70}"/>
            <SolidColorBrush x:Key="EtherCheckboxDisabledUncheckedFillBrush" Color="{StaticResource AlphaGray40}"/>
            <SolidColorBrush x:Key="EtherCheckboxDisabledUncheckedStrokeBrush" Color="{StaticResource Gray400}"/>
            <SolidColorBrush x:Key="EtherCheckboxDisabledCheckedFillBrush" Color="{StaticResource Blue500}"/>
            <SolidColorBrush x:Key="EtherCheckboxDisabledGlyphBrush" Color="{StaticResource Gray25}"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="EtherCheckboxFillDefaultBrush" Color="{StaticResource AlphaGray5}"/>
            <SolidColorBrush x:Key="EtherCheckboxFillHoverBrush" Color="{StaticResource AlphaGray15}"/>
            <SolidColorBrush x:Key="EtherCheckboxFillPressedBrush" Color="{StaticResource AlphaGray25}"/>
            <SolidColorBrush x:Key="EtherCheckboxStrokeBrush" Color="{StaticResource Gray500}"/>
            <SolidColorBrush x:Key="EtherCheckboxFocusBrush" Color="{StaticResource AlphaWhite70}"/>
            <SolidColorBrush x:Key="EtherCheckboxCheckedFillDefaultBrush" Color="{StaticResource Blue500}"/>
            <SolidColorBrush x:Key="EtherCheckboxCheckedFillHoverBrush" Color="{StaticResource Blue600}"/>
            <SolidColorBrush x:Key="EtherCheckboxCheckedFillPressedBrush" Color="{StaticResource Blue700}"/>
            <SolidColorBrush x:Key="EtherCheckboxCheckedStrokeBrush" Color="{StaticResource Blue500}"/>
            <SolidColorBrush x:Key="EtherCheckboxGlyphBrush" Color="{StaticResource Gray25}"/>
            <SolidColorBrush x:Key="EtherCheckboxLabelBrush" Color="{StaticResource AlphaWhite70}"/>
            <SolidColorBrush x:Key="EtherCheckboxDisabledUncheckedFillBrush" Color="{StaticResource AlphaGray5}"/>
            <SolidColorBrush x:Key="EtherCheckboxDisabledUncheckedStrokeBrush" Color="{StaticResource Gray500}"/>
            <SolidColorBrush x:Key="EtherCheckboxDisabledCheckedFillBrush" Color="{StaticResource Blue500}"/>
            <SolidColorBrush x:Key="EtherCheckboxDisabledGlyphBrush" Color="{StaticResource Gray25}"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="EtherCheckboxFillDefaultBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="EtherCheckboxFillHoverBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="EtherCheckboxFillPressedBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="EtherCheckboxStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="EtherCheckboxFocusBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherCheckboxCheckedFillDefaultBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherCheckboxCheckedFillHoverBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherCheckboxCheckedFillPressedBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherCheckboxCheckedStrokeBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherCheckboxGlyphBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
            <SolidColorBrush x:Key="EtherCheckboxLabelBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="EtherCheckboxDisabledUncheckedFillBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="EtherCheckboxDisabledUncheckedStrokeBrush" Color="{ThemeResource SystemColorGrayTextColor}"/>
            <SolidColorBrush x:Key="EtherCheckboxDisabledCheckedFillBrush" Color="{ThemeResource SystemColorGrayTextColor}"/>
            <SolidColorBrush x:Key="EtherCheckboxDisabledGlyphBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Structural overlay fill: not themed, so High Contrast can keep SystemColor-only
         theme keys while the stroke ring still reveals the face beneath it. -->
    <SolidColorBrush x:Key="EtherCheckboxTransparentBrush" Color="Transparent"/>

    <ControlTemplate x:Key="EtherCheckboxTemplate" TargetType="controls:EtherCheckbox">
        <Grid x:Name="LayoutRoot" Background="{StaticResource EtherCheckboxTransparentBrush}">
            <VisualStateManager.VisualStateGroups>

                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition From="Normal" To="PointerOver" GeneratedDuration="0:0:0.12">
                            <VisualTransition.GeneratedEasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                        <VisualTransition From="PointerOver" To="Normal" GeneratedDuration="0:0:0.12">
                            <VisualTransition.GeneratedEasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                        <VisualTransition To="Pressed" GeneratedDuration="0:0:0.08">
                            <VisualTransition.GeneratedEasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Target="UncheckedFill.Background" Value="{ThemeResource EtherCheckboxFillDefaultBrush}"/>
                            <Setter Target="CheckedFill.Background" Value="{ThemeResource EtherCheckboxCheckedFillDefaultBrush}"/>
                            <Setter Target="CheckedStroke.BorderBrush" Value="{ThemeResource EtherCheckboxCheckedStrokeBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="UncheckedFill.Background" Value="{ThemeResource EtherCheckboxFillHoverBrush}"/>
                            <Setter Target="CheckedFill.Background" Value="{ThemeResource EtherCheckboxCheckedFillHoverBrush}"/>
                            <Setter Target="CheckedStroke.BorderBrush" Value="{ThemeResource EtherCheckboxCheckedStrokeBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="UncheckedFill.Background" Value="{ThemeResource EtherCheckboxFillPressedBrush}"/>
                            <Setter Target="CheckedFill.Background" Value="{ThemeResource EtherCheckboxCheckedFillPressedBrush}"/>
                            <Setter Target="CheckedStroke.BorderBrush" Value="{ThemeResource EtherCheckboxCheckedFillPressedBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <!-- Figma disabled is Default colours at 40 % opacity. *DisabledBrush
                                 keys stay in the theme dictionaries for key symmetry (High Contrast)
                                 and are not consumed here. -->
                            <Setter Target="LayoutRoot.Opacity" Value="0.4"/>
                            <Setter Target="UncheckedFill.Background" Value="{ThemeResource EtherCheckboxFillDefaultBrush}"/>
                            <Setter Target="CheckedFill.Background" Value="{ThemeResource EtherCheckboxCheckedFillDefaultBrush}"/>
                            <Setter Target="CheckedStroke.BorderBrush" Value="{ThemeResource EtherCheckboxCheckedStrokeBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>

                <VisualStateGroup x:Name="CheckStates">
                    <VisualState x:Name="Unchecked">
                        <VisualState.Setters>
                            <Setter Target="UncheckedFace.Visibility" Value="Visible"/>
                            <Setter Target="CheckedFace.Visibility" Value="Collapsed"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Checked">
                        <VisualState.Setters>
                            <Setter Target="UncheckedFace.Visibility" Value="Collapsed"/>
                            <Setter Target="CheckedFace.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                    <!-- Indeterminate intentionally unstyled: IsThreeState is False. -->
                </VisualStateGroup>

                <!-- Keyboard focus (a11y): the FocusRing below is shown/hidden from code-behind
                     (OnGotFocus/OnLostFocus, keyboard focus only). Modern WinUI controls do not
                     drive a FocusStates VSM group, so a visual-state group here would be dead. -->

            </VisualStateManager.VisualStateGroups>

            <!-- HandContentControl sets a hand cursor over the whole clickable area. It only
                 affects hit-testable instances: the showcase specimens (IsHitTestVisible=False)
                 never receive pointer input, so they keep the arrow. -->
            <primitives:HandContentControl HorizontalContentAlignment="Left"
                                         VerticalContentAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing8}" VerticalAlignment="Center">
                <!-- Figma nodes 62102:8755/8800 specify a fixed 18x18 indicator;
                     keep it fixed as an explicit design decision (option b), while
                     the label itself follows the shared text-overflow policy. -->
                <Grid Width="18" Height="18">
                    <!--
                        Each face is a solid fill rect with the stroke as a SEPARATE
                        transparent-background ring on top — never one Border carrying both a
                        Background and a BorderBrush. That single-Border form clips the fill to
                        the inner radius (outer radius minus 1.5 px border) and, at fractional
                        DPI, leaves a hairline seam at the rounded corners that shows the white
                        page through — the white ring. Here the ring's only backdrop is the
                        fill beneath it, so any corner seam reveals the fill colour, not white.
                    -->
                    <!-- Unchecked face: translucent fill under a grey stroke ring. -->
                    <Grid x:Name="UncheckedFace">
                        <Border x:Name="UncheckedFill"
                                Background="{ThemeResource EtherCheckboxFillDefaultBrush}"
                                CornerRadius="{StaticResource RadiusSm}"/>
                        <Border x:Name="UncheckedStroke"
                                Background="{StaticResource EtherCheckboxTransparentBrush}"
                                BorderBrush="{ThemeResource EtherCheckboxStrokeBrush}"
                                BorderThickness="1.5"
                                CornerRadius="{StaticResource RadiusSm}"
                                IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Checked face: brand-blue fill under a blue stroke ring, carrying the tick. -->
                    <Grid x:Name="CheckedFace" Visibility="Collapsed">
                        <Border x:Name="CheckedFill"
                                Background="{ThemeResource EtherCheckboxCheckedFillDefaultBrush}"
                                CornerRadius="{StaticResource RadiusSm}"/>
                        <Border x:Name="CheckedStroke"
                                Background="{StaticResource EtherCheckboxTransparentBrush}"
                                BorderBrush="{ThemeResource EtherCheckboxCheckedStrokeBrush}"
                                BorderThickness="1.5"
                                CornerRadius="{StaticResource RadiusSm}"
                                IsHitTestVisible="False"/>
                        <!-- Figma's 11 px check glyph is part of the fixed indicator spec. -->
                        <Viewbox Width="11" Height="11"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="Glyph"
                                  Stroke="{ThemeResource EtherCheckboxGlyphBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M1.5,5.5 L4.5,8.5 L9.5,2.5"/>
                        </Viewbox>
                    </Grid>

                    <!-- Keyboard focus ring: hugs the 18x18 box (inner edge meets the box edge, so
                         no page shows through => no white halo). Shown only in the Focused state. -->
                    <Border x:Name="FocusRing"
                            Margin="-2"
                            BorderBrush="{ThemeResource EtherCheckboxFocusBrush}"
                            BorderThickness="2"
                            CornerRadius="6"
                            IsHitTestVisible="False"
                            Visibility="Collapsed"/>
                </Grid>

                <ContentPresenter x:Name="Label"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                  Visibility="{Binding UsesTextContentPath, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EtherStringContentVisibilityConverter}, ConverterParameter=False}"
                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                  FontSize="{StaticResource Size12}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   VerticalAlignment="Center"/>
                <TextBlock x:Name="TextContent"
                           Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                           Visibility="{Binding UsesTextContentPath, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EtherStringContentVisibilityConverter}}"
                           Foreground="{TemplateBinding Foreground}"
                           FontFamily="{TemplateBinding FontFamily}"
                           FontSize="{StaticResource Size12}"
                           FontWeight="{TemplateBinding FontWeight}"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            </primitives:HandContentControl>
        </Grid>
    </ControlTemplate>

    <Style x:Key="DefaultEtherCheckboxStyle" TargetType="controls:EtherCheckbox">
        <Setter Property="Foreground" Value="{ThemeResource EtherCheckboxLabelBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
        <Setter Property="FontWeight" Value="{StaticResource WeightSemibold}"/>
        <Setter Property="IsThreeState" Value="False"/>
        <Setter Property="UseSystemFocusVisuals" Value="False"/>
        <Setter Property="HighContrastAdjustment" Value="None"/>
        <Setter Property="MinWidth" Value="{StaticResource Spacing0}"/>
        <Setter Property="MinHeight" Value="{StaticResource Spacing0}"/>
        <Setter Property="Padding" Value="{StaticResource Padding0}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource EtherCheckboxTemplate}"/>
    </Style>

    <Style TargetType="controls:EtherCheckbox" BasedOn="{StaticResource DefaultEtherCheckboxStyle}"/>

</ResourceDictionary>
