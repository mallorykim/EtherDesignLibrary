<!--
    EtherSegmentedControl.xaml - Ether Design System · Segmented Control
    ═══════════════════════════════════════════════════════════════════════

    USAGE
      Default (DefaultEtherSegmentedControlStyle via DefaultStyleKey):

        <controls:EtherSegmentedControl>
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource EtherSegment}" GroupName="MyCtrl"
                             Content="Overview"  IsChecked="True"/>
                <RadioButton Style="{StaticResource EtherSegment}" GroupName="MyCtrl"
                             Content="Details"/>
                <RadioButton Style="{StaticResource EtherSegment}" GroupName="MyCtrl"
                             Content="History"/>
            </StackPanel>
        </controls:EtherSegmentedControl>

      Named track alias (same visual; older call sites):

        <controls:EtherSegmentedControl Style="{StaticResource EtherSegmentedTrack}">
            ...
        </controls:EtherSegmentedControl>

    EVENTS
      Bind each RadioButton.Checked to a handler or use x:Bind to a ViewModel bool.

    KEY MEASUREMENTS (Figma source: ursRC201v8IiVeafliI45F · node 60340:7245)
      Track     padding 4 · CornerRadius 8 · BackgroundSegmentTrack
                soft blue shadow (Figma node 1210:1463)
      Segment   px=16 py=10 · CornerRadius 4 · min-height 40
                selected: background/brand · text/on-brand
                hover: BackgroundSegmentHover (brand @ 6%)
                pressed: BackgroundSegmentPressed (brand @ 10%)
      Font      Instrument Sans SemiBold 12 px, centred

    TOKENS (Light/Dark keep these aliases; High Contrast uses SystemColor*)
      Track bg:   BackgroundSegmentTrack
      Segment bg: background/brand (selected) / transparent (default)
      Text:       text/on-brand (selected) / TextSecondary (unselected)
      Radius:     radius/control (8) for track · radius/control-sm (4) for segment pill

    LOCATION
      This dictionary lives beside its class (Controls/Inputs/EtherSegmentedControl.cs)
      and is merged from the Controls Generic.xaml entry point.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="EtherSegmentedControlCasterBrush" ResourceKey="BackgroundSurface"/>
            <StaticResource x:Key="EtherSegmentedControlFocusStrokeBrush" ResourceKey="border/focus"/>
            <StaticResource x:Key="EtherSegmentedControlSegmentCheckedBrush" ResourceKey="background/brand"/>
            <StaticResource x:Key="EtherSegmentedControlSegmentForegroundBrush" ResourceKey="TextSecondary"/>
            <StaticResource x:Key="EtherSegmentedControlSegmentForegroundCheckedBrush" ResourceKey="text/on-brand"/>
            <StaticResource x:Key="EtherSegmentedControlSegmentHoverBrush" ResourceKey="BackgroundSegmentHover"/>
            <StaticResource x:Key="EtherSegmentedControlSegmentPressedBrush" ResourceKey="BackgroundSegmentPressed"/>
            <SolidColorBrush x:Key="EtherSegmentedControlShadowBrush" Color="#FF0054E5"/>
            <StaticResource x:Key="EtherSegmentedControlTrackBackgroundBrush" ResourceKey="BackgroundSegmentTrack"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <StaticResource x:Key="EtherSegmentedControlCasterBrush" ResourceKey="BackgroundSurface"/>
            <StaticResource x:Key="EtherSegmentedControlFocusStrokeBrush" ResourceKey="border/focus"/>
            <StaticResource x:Key="EtherSegmentedControlSegmentCheckedBrush" ResourceKey="background/brand"/>
            <StaticResource x:Key="EtherSegmentedControlSegmentForegroundBrush" ResourceKey="TextSecondary"/>
            <StaticResource x:Key="EtherSegmentedControlSegmentForegroundCheckedBrush" ResourceKey="text/on-brand"/>
            <StaticResource x:Key="EtherSegmentedControlSegmentHoverBrush" ResourceKey="BackgroundSegmentHover"/>
            <StaticResource x:Key="EtherSegmentedControlSegmentPressedBrush" ResourceKey="BackgroundSegmentPressed"/>
            <SolidColorBrush x:Key="EtherSegmentedControlShadowBrush" Color="#FF0054E5"/>
            <StaticResource x:Key="EtherSegmentedControlTrackBackgroundBrush" ResourceKey="BackgroundSegmentTrack"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="EtherSegmentedControlCasterBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlFocusStrokeBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlSegmentCheckedBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlSegmentForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlSegmentForegroundCheckedBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlSegmentHoverBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlSegmentPressedBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlShadowBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlTrackBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Structural overlay fill: not themed, so High Contrast can keep SystemColor-only
         theme keys while the segment text container stays empty. -->
    <SolidColorBrush x:Key="EtherSegmentedControlTransparentBrush" Color="Transparent"/>

    <!-- Track container template. Composition shadows are rendered behind TrackSurface
         by EtherSegmentedControl. Reserve vertical layout space for the 18px blur / 12px offset. -->
    <ControlTemplate x:Key="EtherSegmentedTrackTemplate" TargetType="controls:EtherSegmentedControl">
        <Grid>
            <Border x:Name="CasterBrushSource"
                    Width="1"
                    Height="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Opacity="0"
                    IsHitTestVisible="False"
                    Background="{ThemeResource EtherSegmentedControlCasterBrush}"/>
            <Border x:Name="ShadowBrushSource"
                    Width="1"
                    Height="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Opacity="0"
                    IsHitTestVisible="False"
                    Background="{ThemeResource EtherSegmentedControlShadowBrush}"/>
            <Canvas x:Name="ShadowHost" IsHitTestVisible="False"/>
            <Border x:Name="TrackSurface"
                    Margin="0,8,0,30"
                    Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="{StaticResource radius/control}">
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- Individual segment (RadioButton)

         State backgrounds are separate LAYERS (hover / pressed / checked), each carrying its
         own {ThemeResource} fill, and the visual states toggle only their Opacity. This is
         deliberate: a VisualState.Setter whose *value* is a {ThemeResource} brush does NOT
         revert reliably on state exit (the hover/pressed background sticks — verified via a
         pointer-event log showing PointerExited firing yet the fill remaining). Opacity is a
         plain double and reverts cleanly, so the fill clears the moment the pointer leaves. -->
    <ControlTemplate x:Key="EtherSegmentTemplate" TargetType="RadioButton">
        <Grid HorizontalAlignment="Stretch">
            <VisualStateManager.VisualStateGroups>
                <!-- Background layers (HoverLayer/PressedLayer/CheckedLayer) are driven directly
                     from code in HandRadioButton.UpdateSegmentVisual — NOT from these states —
                     because the VSM leaves layer opacity stuck after the pointer leaves. Only the
                     checked TEXT colour and the disabled dim stay here (those revert fine). -->
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver"/>
                    <VisualState x:Name="Pressed"/>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Bg.Opacity" Value="0.4"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Checked">
                        <VisualState.Setters>
                            <Setter Target="Cp.Foreground" Value="{ThemeResource EtherSegmentedControlSegmentForegroundCheckedBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedPointerOver">
                        <VisualState.Setters>
                            <Setter Target="Cp.Foreground" Value="{ThemeResource EtherSegmentedControlSegmentForegroundCheckedBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedPressed">
                        <VisualState.Setters>
                            <Setter Target="Cp.Foreground" Value="{ThemeResource EtherSegmentedControlSegmentForegroundCheckedBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Indeterminate"/>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Target="FocusRing.Opacity" Value="1"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Unfocused"/>
                    <VisualState x:Name="PointerFocused"/>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- Background state layers (behind the text). Opacity toggled by HandRadioButton. -->
            <Border x:Name="HoverLayer"
                    Background="{ThemeResource EtherSegmentedControlSegmentHoverBrush}"
                    CornerRadius="{StaticResource radius/control-sm}"
                    Opacity="0"/>
            <Border x:Name="PressedLayer"
                    Background="{ThemeResource EtherSegmentedControlSegmentPressedBrush}"
                    CornerRadius="{StaticResource radius/control-sm}"
                    Opacity="0"/>
            <Border x:Name="CheckedLayer"
                    Background="{ThemeResource EtherSegmentedControlSegmentCheckedBrush}"
                    CornerRadius="{StaticResource radius/control-sm}"
                    Opacity="0"/>

            <Border x:Name="Bg"
                    Background="{StaticResource EtherSegmentedControlTransparentBrush}"
                    CornerRadius="{StaticResource radius/control-sm}"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter x:Name="Cp"
                                  Content="{TemplateBinding Content}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource EtherSegmentedControlSegmentForegroundBrush}"
                                  FontFamily="{StaticResource InstrumentSans}"
                                  FontSize="{StaticResource Size12}"
                                  FontWeight="{StaticResource WeightSemibold}"/>
            </Border>

            <Border x:Name="FocusRing"
                    Margin="-3"
                    BorderBrush="{ThemeResource EtherSegmentedControlFocusStrokeBrush}"
                    BorderThickness="2"
                    CornerRadius="{StaticResource RadiusSm}"
                    IsHitTestVisible="False"
                    Opacity="0"/>
        </Grid>
    </ControlTemplate>

    <Style x:Key="EtherSegment" TargetType="RadioButton">
        <Setter Property="Padding"                    Value="16,10"/>
        <Setter Property="MinHeight"                  Value="{StaticResource Spacing40}"/>
        <Setter Property="HorizontalAlignment"        Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="UseSystemFocusVisuals"      Value="False"/>
        <Setter Property="HighContrastAdjustment"     Value="None"/>
        <Setter Property="Template" Value="{StaticResource EtherSegmentTemplate}"/>
    </Style>

    <Style x:Key="DefaultEtherSegmentedControlStyle" TargetType="controls:EtherSegmentedControl">
        <Setter Property="Padding"       Value="{StaticResource Padding4}"/>
        <Setter Property="Background"    Value="{ThemeResource EtherSegmentedControlTrackBackgroundBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="HighContrastAdjustment"     Value="None"/>
        <Setter Property="Template" Value="{StaticResource EtherSegmentedTrackTemplate}"/>
    </Style>

    <Style TargetType="controls:EtherSegmentedControl" BasedOn="{StaticResource DefaultEtherSegmentedControlStyle}"/>
    <Style x:Key="EtherSegmentedTrack" TargetType="controls:EtherSegmentedControl" BasedOn="{StaticResource DefaultEtherSegmentedControlStyle}"/>

</ResourceDictionary>
