<!--
    EtherSegmentedControl.xaml - Ether Design System · Segmented Control
    ═══════════════════════════════════════════════════════════════════════

    USAGE
      Default (DefaultEtherSegmentedControlStyle via DefaultStyleKey):

        <controls:EtherSegmentedControl>
            <controls:EtherSegmentPanel>
                <RadioButton Style="{StaticResource EtherSegment}" GroupName="MyCtrl"
                             Content="Overview"  IsChecked="True"/>
                <RadioButton Style="{StaticResource EtherSegment}" GroupName="MyCtrl"
                             Content="Details"/>
                <RadioButton Style="{StaticResource EtherSegment}" GroupName="MyCtrl"
                             Content="History"/>
            </controls:EtherSegmentPanel>
        </controls:EtherSegmentedControl>

      Named track alias (same visual; older call sites):

        <controls:EtherSegmentedControl Style="{StaticResource EtherSegmentedTrack}">
            ...
        </controls:EtherSegmentedControl>

    EVENTS
      Bind each RadioButton.Checked to a handler or use x:Bind to a ViewModel bool.

    KEY MEASUREMENTS (Figma: ursRC201v8IiVeafliI45F
      selected 62110:23700 · Light track 62110:24735 · Dark 62110:24850)
      Track     padding 4 · RadiusMd 8 · Light AlphaWhite40 · Dark AlphaBlack70
                soft blue shadows (Blue800 @ 8% / 10%)
      Segment   px=16 py=12 · RadiusSm 4 · min-height 33
                selected: Blue600 fill · Gray0 label
                default: transparent · Light AlphaBlack70 / Dark AlphaWhite70
                hover: AlphaBrand6 / Dark AlphaBrand10
                pressed: AlphaBrand10 / Dark AlphaBrand16
      Font      Instrument Sans SemiBold 12 px, centred

    Light/Dark component brushes bind Color to primitive StaticResources.
    High Contrast uses Windows SystemColor*.

    LOCATION
      This dictionary lives beside its class (Controls/Inputs/EtherSegmentedControl.cs)
      and is merged from the Controls Generic.xaml entry point.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="EtherSegmentedControlCasterBrush" Color="{StaticResource Gray0}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlFocusStrokeBrush" Color="{StaticResource Blue600}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlSegmentCheckedBrush" Color="{StaticResource Blue600}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlSegmentForegroundBrush" Color="{StaticResource AlphaBlack70}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlSegmentForegroundCheckedBrush" Color="{StaticResource Gray0}"/>
            <!-- Same color as the default label in Light/Dark: the Hover/Pressed fills here are a
                 faint tint (AlphaBrand6/10), so the default label color stays legible on top of
                 them. High Contrast repaints Hover/Pressed as an opaque SystemColorHighlightColor
                 fill, so these need to repaint as SystemColorHighlightTextColor there instead. -->
            <SolidColorBrush x:Key="EtherSegmentedControlSegmentForegroundHoverBrush" Color="{StaticResource AlphaBlack70}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlSegmentForegroundPressedBrush" Color="{StaticResource AlphaBlack70}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlSegmentHoverBrush" Color="{StaticResource AlphaBrand6}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlSegmentPressedBrush" Color="{StaticResource AlphaBrand10}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlShadowBrush" Color="{StaticResource Blue800}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlTrackBackgroundBrush" Color="{StaticResource AlphaWhite40}"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="EtherSegmentedControlCasterBrush" Color="{StaticResource Gray900}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlFocusStrokeBrush" Color="{StaticResource Blue500}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlSegmentCheckedBrush" Color="{StaticResource Blue600}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlSegmentForegroundBrush" Color="{StaticResource AlphaWhite70}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlSegmentForegroundCheckedBrush" Color="{StaticResource Gray0}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlSegmentForegroundHoverBrush" Color="{StaticResource AlphaWhite70}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlSegmentForegroundPressedBrush" Color="{StaticResource AlphaWhite70}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlSegmentHoverBrush" Color="{StaticResource AlphaBrand10}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlSegmentPressedBrush" Color="{StaticResource AlphaBrand16}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlShadowBrush" Color="{StaticResource Blue800}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlTrackBackgroundBrush" Color="{StaticResource AlphaBlack70}"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="EtherSegmentedControlCasterBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlFocusStrokeBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlSegmentCheckedBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlSegmentForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlSegmentForegroundCheckedBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
            <!-- Paired with SegmentHoverBrush/SegmentPressedBrush below, which repaint as an
                 opaque SystemColorHighlightColor fill in High Contrast: the label sitting on top
                 of that fill must be SystemColorHighlightTextColor, not the WindowText color used
                 against the transparent/ButtonFace default background. -->
            <SolidColorBrush x:Key="EtherSegmentedControlSegmentForegroundHoverBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlSegmentForegroundPressedBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlSegmentHoverBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlSegmentPressedBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlShadowBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="EtherSegmentedControlTrackBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Structural overlay fill: not themed, so High Contrast can keep SystemColor-only
         theme keys while the segment text container stays empty. -->
    <SolidColorBrush x:Key="EtherSegmentedControlTransparentBrush" Color="Transparent"/>

    <!-- Track container template. Composition shadows are rendered behind TrackSurface
         by EtherSegmentedControl. TrackSurface reserves 8/30 epx vertical space for the
         18px blur / 12px offset; ShadowHost is wider on the sides for horizontal blur bleed. -->
    <ControlTemplate x:Key="EtherSegmentedTrackTemplate" TargetType="controls:EtherSegmentedControl">
        <Grid>
            <Border x:Name="CasterBrushSource"
                    Width="1"
                    Height="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Opacity="0"
                    IsHitTestVisible="False"
                    Background="{ThemeResource EtherSegmentedControlCasterBrush}"/>
            <Border x:Name="ShadowBrushSource"
                    Width="1"
                    Height="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Opacity="0"
                    IsHitTestVisible="False"
                    Background="{ThemeResource EtherSegmentedControlShadowBrush}"/>
            <!-- Wider than TrackSurface so the blurred far shadow (18px) can bleed
                 left/right instead of being cut at the track edge. -->
            <Border x:Name="ShadowHost"
                    Margin="-24,0"
                    Background="{StaticResource EtherSegmentedControlTransparentBrush}"
                    IsHitTestVisible="False"/>
            <Border x:Name="TrackSurface"
                    Margin="0,8,0,30"
                    Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="{StaticResource RadiusMd}">
                <Grid>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                      Visibility="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EtherStringContentVisibilityConverter}}"
                                      ContentTransitions="{TemplateBinding ContentTransitions}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      AutomationProperties.AccessibilityView="Raw"/>
                    <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                               Visibility="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EtherStringContentVisibilityConverter}, ConverterParameter=String}"
                               HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.AccessibilityView="Raw"/>
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- Individual segment (RadioButton)

         State backgrounds are separate LAYERS (hover / pressed / checked), each carrying its
         own {ThemeResource} fill, and the visual states toggle only their Opacity. This is
         deliberate: a VisualState.Setter whose *value* is a {ThemeResource} brush does NOT
         revert reliably on state exit (the hover/pressed background sticks — verified via a
         pointer-event log showing PointerExited firing yet the fill remaining). Opacity is a
         plain double and reverts cleanly, so the fill clears the moment the pointer leaves. -->
    <ControlTemplate x:Key="EtherSegmentTemplate" TargetType="RadioButton">
        <Grid HorizontalAlignment="Stretch">
            <VisualStateManager.VisualStateGroups>
                <!-- Background layers (HoverLayer/PressedLayer/CheckedLayer) are driven directly
                     from code in HandRadioButton.UpdateSegmentVisual — NOT from these states —
                     because the VSM leaves layer opacity stuck after the pointer leaves. Only the
                     checked TEXT colour and the disabled dim stay here (those revert fine). -->
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <!-- Only the label color lives here (see EtherSegmentedControlSegmentForegroundHoverBrush
                         above): it is a plain ThemeResource Setter on Foreground, which reverts
                         cleanly on state exit, unlike the Background stickiness described below. -->
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Cp.Foreground" Value="{ThemeResource EtherSegmentedControlSegmentForegroundHoverBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Cp.Foreground" Value="{ThemeResource EtherSegmentedControlSegmentForegroundPressedBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Bg.Opacity" Value="0.4"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Checked">
                        <VisualState.Setters>
                            <Setter Target="Cp.Foreground" Value="{ThemeResource EtherSegmentedControlSegmentForegroundCheckedBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedPointerOver">
                        <VisualState.Setters>
                            <Setter Target="Cp.Foreground" Value="{ThemeResource EtherSegmentedControlSegmentForegroundCheckedBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedPressed">
                        <VisualState.Setters>
                            <Setter Target="Cp.Foreground" Value="{ThemeResource EtherSegmentedControlSegmentForegroundCheckedBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Indeterminate"/>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Target="FocusRing.Opacity" Value="1"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Unfocused"/>
                    <VisualState x:Name="PointerFocused"/>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- Background state layers (behind the text). Opacity toggled by HandRadioButton. -->
            <Border x:Name="HoverLayer"
                    Background="{ThemeResource EtherSegmentedControlSegmentHoverBrush}"
                    CornerRadius="{StaticResource RadiusSm}"
                    Opacity="0"/>
            <Border x:Name="PressedLayer"
                    Background="{ThemeResource EtherSegmentedControlSegmentPressedBrush}"
                    CornerRadius="{StaticResource RadiusSm}"
                    Opacity="0"/>
            <Border x:Name="CheckedLayer"
                    Background="{ThemeResource EtherSegmentedControlSegmentCheckedBrush}"
                    CornerRadius="{StaticResource RadiusSm}"
                    Opacity="0"/>

            <Border x:Name="Bg"
                    Background="{StaticResource EtherSegmentedControlTransparentBrush}"
                    CornerRadius="{StaticResource RadiusSm}"
                    Padding="{TemplateBinding Padding}">
                <Grid>
                    <ContentPresenter x:Name="Cp"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                      ContentTransitions="{TemplateBinding ContentTransitions}"
                                      Visibility="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EtherStringContentVisibilityConverter}}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Foreground="{ThemeResource EtherSegmentedControlSegmentForegroundBrush}"
                                      FontFamily="{TemplateBinding FontFamily}"
                                      FontSize="{TemplateBinding FontSize}"
                                      FontWeight="{TemplateBinding FontWeight}"
                                      AutomationProperties.AccessibilityView="Raw"/>
                    <TextBlock x:Name="TextContent"
                               Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                               Visibility="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EtherStringContentVisibilityConverter}, ConverterParameter=String}"
                               HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                               Foreground="{Binding Foreground, ElementName=Cp}"
                               FontFamily="{TemplateBinding FontFamily}"
                               FontSize="{TemplateBinding FontSize}"
                               FontWeight="{TemplateBinding FontWeight}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.AccessibilityView="Raw"/>
                </Grid>
            </Border>

            <Border x:Name="FocusRing"
                    Margin="-3"
                    BorderBrush="{ThemeResource EtherSegmentedControlFocusStrokeBrush}"
                    BorderThickness="2"
                    CornerRadius="{StaticResource RadiusSm}"
                    IsHitTestVisible="False"
                    Opacity="0"/>
        </Grid>
    </ControlTemplate>

    <Style x:Key="EtherSegment" TargetType="RadioButton">
        <Setter Property="FontFamily"                 Value="{StaticResource InstrumentSans}"/>
        <Setter Property="FontSize"                   Value="{StaticResource Size12}"/>
        <Setter Property="FontWeight"                 Value="{StaticResource WeightSemibold}"/>
        <Setter Property="Padding"                    Value="16,12"/>
        <Setter Property="MinHeight"                  Value="33"/>
        <Setter Property="MinWidth"                   Value="0"/>
        <Setter Property="HorizontalAlignment"        Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="UseSystemFocusVisuals"      Value="False"/>
        <Setter Property="HighContrastAdjustment"     Value="None"/>
        <Setter Property="Template" Value="{StaticResource EtherSegmentTemplate}"/>
    </Style>

    <Style x:Key="DefaultEtherSegmentedControlStyle" TargetType="controls:EtherSegmentedControl">
        <Setter Property="Padding"                    Value="4"/>
        <Setter Property="Background"                 Value="{ThemeResource EtherSegmentedControlTrackBackgroundBrush}"/>
        <Setter Property="HorizontalAlignment"        Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="IsTabStop"                  Value="False"/>
        <Setter Property="UseSystemFocusVisuals"      Value="False"/>
        <Setter Property="HighContrastAdjustment"     Value="None"/>
        <Setter Property="Template" Value="{StaticResource EtherSegmentedTrackTemplate}"/>
    </Style>

    <Style TargetType="controls:EtherSegmentedControl" BasedOn="{StaticResource DefaultEtherSegmentedControlStyle}"/>
    <Style x:Key="EtherSegmentedTrack" TargetType="controls:EtherSegmentedControl" BasedOn="{StaticResource DefaultEtherSegmentedControlStyle}"/>

</ResourceDictionary>
