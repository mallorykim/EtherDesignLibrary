<!--
    Ether Design System Slider

    Figma source: ursRC201v8IiVeafliI45F
      Light Tick slider 62181:5284 · Dark 62181:5341
    2×40 epx ticks with a 3 epx gap, 4×45 epx knob (radius 2). Tick count is
    even and follows the parent width at Figma density (2 epx bar + 3 epx
    gap). Title is
    Instrument Sans SemiBold 14; tick labels are Inter Medium 11. Title and
    labels are optional (`ShowTitle` / `ShowLabels`); at most 11 labels.
    Labels are UI only; the payload is RangeBase.Value.

    DefaultEtherSliderStyle owns the default setters; the implicit style is
    BasedOn that key. Light/Dark component brushes bind Color to primitive
    StaticResources. High Contrast uses Windows SystemColor*.

    The Knob is template-declared. Tick bars are created to an even count that
    fills the stretched track. Code updates Canvas.Left, Fill, and knob
    hover/press sizing; pointer capture stays on BarCanvas rather than
    VisualStateManager. UseSystemFocusVisuals stays False so custom High
    Contrast brushes are not overdrawn by a system halo. Keyboard focus uses
    the hover knob size (6×45, radius 4) as the visible focus cue.

    LOCATION
      This dictionary lives beside its class (Controls/Inputs/EtherSlider.xaml.cs)
      and is merged from Controls Generic.xaml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="EtherSliderHighlightBrush" Color="{StaticResource AlphaBrandGlow65}"/>
            <SolidColorBrush x:Key="EtherSliderInactiveBrush" Color="{StaticResource Gray300}"/>
            <SolidColorBrush x:Key="EtherSliderKnobBrush" Color="{StaticResource Blue600}"/>
            <SolidColorBrush x:Key="EtherSliderKnobPressedBrush" Color="{StaticResource Blue700}"/>
            <SolidColorBrush x:Key="EtherSliderLabelForegroundBrush" Color="{StaticResource AlphaBlack70}"/>
            <SolidColorBrush x:Key="EtherSliderValueForegroundBrush" Color="{StaticResource Gray1000}"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="EtherSliderHighlightBrush" Color="{StaticResource AlphaBrandGlow65}"/>
            <SolidColorBrush x:Key="EtherSliderInactiveBrush" Color="{StaticResource Gray600}"/>
            <SolidColorBrush x:Key="EtherSliderKnobBrush" Color="{StaticResource Blue500}"/>
            <SolidColorBrush x:Key="EtherSliderKnobPressedBrush" Color="{StaticResource Blue600}"/>
            <SolidColorBrush x:Key="EtherSliderLabelForegroundBrush" Color="{StaticResource AlphaWhite70}"/>
            <SolidColorBrush x:Key="EtherSliderValueForegroundBrush" Color="{StaticResource Gray0}"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="EtherSliderHighlightBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherSliderInactiveBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="EtherSliderKnobBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherSliderKnobPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherSliderLabelForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EtherSliderValueForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Hit-test fill for BarCanvas: not themed, so High Contrast can keep
         SystemColor-only theme keys while the canvas stays empty. -->
    <SolidColorBrush x:Key="EtherSliderTransparentBrush" Color="Transparent"/>

    <Style x:Key="EtherSliderTickLabelStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource EtherSingleLineTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource EtherSliderLabelForegroundBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
        <Setter Property="FontSize" Value="{StaticResource Size11}"/>
        <Setter Property="FontWeight" Value="{StaticResource WeightMedium}"/>
        <Setter Property="CharacterSpacing" Value="20"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw"/>
    </Style>

    <Style x:Key="DefaultEtherSliderStyle" TargetType="controls:EtherSlider">
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="HighContrastAdjustment" Value="None" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Value" Value="50" />
        <Setter Property="SmallChange" Value="1" />
        <Setter Property="LargeChange" Value="10" />
        <Setter Property="ShowTitle" Value="True" />
        <Setter Property="ShowLabels" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:EtherSlider">
                    <Grid x:Name="LayoutRoot">
                        <Border x:Name="HighlightBrushSource"
                                Width="1"
                                Height="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Opacity="0"
                                IsHitTestVisible="False"
                                Background="{ThemeResource EtherSliderHighlightBrush}" />
                        <Border x:Name="InactiveBrushSource"
                                Width="1"
                                Height="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Opacity="0"
                                IsHitTestVisible="False"
                                Background="{ThemeResource EtherSliderInactiveBrush}" />
                        <Border x:Name="KnobBrushSource"
                                Width="1"
                                Height="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Opacity="0"
                                IsHitTestVisible="False"
                                Background="{ThemeResource EtherSliderKnobBrush}" />
                        <Border x:Name="KnobPressedBrushSource"
                                Width="1"
                                Height="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Opacity="0"
                                IsHitTestVisible="False"
                                Background="{ThemeResource EtherSliderKnobPressedBrush}" />
                        <StackPanel>
                            <TextBlock x:Name="ValueText"
                                       HorizontalAlignment="Left"
                                       MinHeight="18"
                                       Margin="0,0,0,4"
                                       Foreground="{ThemeResource EtherSliderValueForegroundBrush}"
                                       FontFamily="{StaticResource InstrumentSans}"
                                       FontSize="{StaticResource Size14}"
                                       FontWeight="{StaticResource WeightSemibold}"
                                       Style="{StaticResource EtherSingleLineTextBlockStyle}"
                                       AutomationProperties.AccessibilityView="Raw"/>
                            <Canvas x:Name="BarCanvas"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    Background="{StaticResource EtherSliderTransparentBrush}">
                                <Rectangle x:Name="Knob"
                                           Width="4"
                                           MinHeight="45"
                                           RadiusX="2"
                                           RadiusY="2"
                                           Canvas.Top="0"
                                           IsHitTestVisible="False" />
                            </Canvas>
                            <Grid x:Name="LabelRow"
                                  Margin="0,4,0,0"
                                  HorizontalAlignment="Stretch">
                                <TextBlock Style="{StaticResource EtherSliderTickLabelStyle}"
                                           HorizontalAlignment="Left"
                                           TextAlignment="Left"/>
                                <TextBlock Style="{StaticResource EtherSliderTickLabelStyle}"/>
                                <TextBlock Style="{StaticResource EtherSliderTickLabelStyle}"/>
                                <TextBlock Style="{StaticResource EtherSliderTickLabelStyle}"/>
                                <TextBlock Style="{StaticResource EtherSliderTickLabelStyle}"/>
                                <TextBlock Style="{StaticResource EtherSliderTickLabelStyle}"/>
                                <TextBlock Style="{StaticResource EtherSliderTickLabelStyle}"/>
                                <TextBlock Style="{StaticResource EtherSliderTickLabelStyle}"/>
                                <TextBlock Style="{StaticResource EtherSliderTickLabelStyle}"/>
                                <TextBlock Style="{StaticResource EtherSliderTickLabelStyle}"/>
                                <TextBlock Style="{StaticResource EtherSliderTickLabelStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:EtherSlider" BasedOn="{StaticResource DefaultEtherSliderStyle}" />
</ResourceDictionary>
