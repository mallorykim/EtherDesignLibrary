<!--
    Ether Design System Toggle Switch

    This keyed style keeps the Microsoft.UI.Xaml ToggleSwitch template contract:
    its named parts, ToggleStates transitions, and native knob repositioning are
    intact. Ether only supplies the visual skin.

    NOT SUPPORTED (intentionally simplified): the Ether switch has no header — the
    HeaderContentPresenter stays collapsed, so ToggleSwitch.Header/HeaderTemplate is not
    an Ether feature. Keep OffContent/OnContent equal width; differing widths make the
    control jump width as it toggles.
-->
<ResourceDictionary
    x:Class="Ether.DesignSystem.Controls.Resources.EtherSwitchResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ether.DesignSystem.Controls"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="EtherSwitchFocusBrush" Color="{StaticResource Blue600}" />
            <SolidColorBrush x:Key="EtherSwitchKnobDisabledBrush" Color="{StaticResource Gray50}" />
            <SolidColorBrush x:Key="EtherSwitchKnobDisabledStrokeBrush" Color="{StaticResource Gray0}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillBrush" Color="{StaticResource Gray25}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillHoverBrush" Color="{StaticResource Gray50}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillPressedBrush" Color="{StaticResource Gray75}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillOnBrush" Color="{StaticResource Blue50}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillOnHoverBrush" Color="{StaticResource Blue100}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillOnPressedBrush" Color="{StaticResource Blue200}" />
            <SolidColorBrush x:Key="EtherSwitchKnobSheenBrush" Color="{StaticResource AlphaWhite0}" />
            <SolidColorBrush x:Key="EtherSwitchKnobShadow1Brush" Color="#35183361" />
            <SolidColorBrush x:Key="EtherSwitchKnobShadow2Brush" Color="#1A183361" />
            <SolidColorBrush x:Key="EtherSwitchKnobShadow3Brush" Color="#0D183361" />
            <SolidColorBrush x:Key="EtherSwitchKnobStrokeBrush" Color="{StaticResource Gray0}" />
            <SolidColorBrush x:Key="EtherSwitchKnobStrokeHoverBrush" Color="{StaticResource Gray0}" />
            <SolidColorBrush x:Key="EtherSwitchKnobStrokePressedBrush" Color="{StaticResource Gray0}" />
            <SolidColorBrush x:Key="EtherSwitchLabelForegroundBrush" Color="{StaticResource AlphaBlack70}" />
            <SolidColorBrush x:Key="EtherSwitchOffTrackBrush" Color="{StaticResource AlphaBlack10}" />
            <LinearGradientBrush x:Key="EtherSwitchOnTrackBrush" StartPoint="1,0.5" EndPoint="0,0.5">
                <GradientStop Color="#40E1FD" Offset="0.00" />
                <GradientStop Color="#0EB2FF" Offset="0.098" />
                <GradientStop Color="#0015FF" Offset="0.80" />
                <GradientStop Color="#0021F3" Offset="1.00" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="EtherSwitchOnTrackGlowFillBrush" Color="{StaticResource AlphaWhite6}" />
            <SolidColorBrush x:Key="EtherSwitchOnTrackGlowStrokeBrush" Color="{StaticResource AlphaWhite20}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="EtherSwitchFocusBrush" Color="{StaticResource Blue500}" />
            <SolidColorBrush x:Key="EtherSwitchKnobDisabledBrush" Color="{StaticResource Gray500}" />
            <SolidColorBrush x:Key="EtherSwitchKnobDisabledStrokeBrush" Color="{StaticResource Gray500}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillBrush" Color="{StaticResource Gray25}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillHoverBrush" Color="{StaticResource Gray50}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillPressedBrush" Color="{StaticResource Gray75}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillOnBrush" Color="{StaticResource Blue50}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillOnHoverBrush" Color="{StaticResource Blue100}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillOnPressedBrush" Color="{StaticResource Blue200}" />
            <SolidColorBrush x:Key="EtherSwitchKnobSheenBrush" Color="{StaticResource AlphaWhite0}" />
            <SolidColorBrush x:Key="EtherSwitchKnobShadow1Brush" Color="#35183361" />
            <SolidColorBrush x:Key="EtherSwitchKnobShadow2Brush" Color="#1A183361" />
            <SolidColorBrush x:Key="EtherSwitchKnobShadow3Brush" Color="#0D183361" />
            <SolidColorBrush x:Key="EtherSwitchKnobStrokeBrush" Color="{StaticResource Gray0}" />
            <SolidColorBrush x:Key="EtherSwitchKnobStrokeHoverBrush" Color="{StaticResource Gray0}" />
            <SolidColorBrush x:Key="EtherSwitchKnobStrokePressedBrush" Color="{StaticResource Gray0}" />
            <SolidColorBrush x:Key="EtherSwitchLabelForegroundBrush" Color="{StaticResource AlphaWhite70}" />
            <SolidColorBrush x:Key="EtherSwitchOffTrackBrush" Color="{StaticResource AlphaWhite10}" />
            <LinearGradientBrush x:Key="EtherSwitchOnTrackBrush" StartPoint="1,0.5" EndPoint="0,0.5">
                <GradientStop Color="#40E1FD" Offset="0.00" />
                <GradientStop Color="#0EB2FF" Offset="0.098" />
                <GradientStop Color="#0015FF" Offset="0.80" />
                <GradientStop Color="#0021F3" Offset="1.00" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="EtherSwitchOnTrackGlowFillBrush" Color="{StaticResource AlphaWhite6}" />
            <SolidColorBrush x:Key="EtherSwitchOnTrackGlowStrokeBrush" Color="{StaticResource AlphaWhite20}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="EtherSwitchFocusBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherSwitchKnobDisabledBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="EtherSwitchKnobDisabledStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillOnBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillOnHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillOnPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherSwitchKnobSheenBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EtherSwitchKnobShadow1Brush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EtherSwitchKnobShadow2Brush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EtherSwitchKnobShadow3Brush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EtherSwitchKnobStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EtherSwitchKnobStrokeHoverBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="EtherSwitchKnobStrokePressedBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="EtherSwitchLabelForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EtherSwitchOffTrackBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="EtherSwitchOnTrackBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherSwitchOnTrackGlowFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EtherSwitchOnTrackGlowStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="EtherSwitchTransparentBrush" Color="Transparent" />

    <ControlTemplate x:Key="EtherSwitchTemplate" TargetType="ToggleSwitch">
        <Grid Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"><VisualState.Setters>
                        <Setter Target="TrackVisuals.Opacity" Value="1" /><Setter Target="LabelsHost.Opacity" Value="1" />
                        <Setter Target="KnobFrame.BorderBrush" Value="{ThemeResource EtherSwitchKnobStrokeBrush}" />
                        <Setter Target="SwitchKnobOff.Fill" Value="{ThemeResource EtherSwitchKnobFillBrush}" />
                        <Setter Target="SwitchKnobOn.Background" Value="{ThemeResource EtherSwitchKnobFillOnBrush}" />
                        <Setter Target="Shadow1.Visibility" Value="Visible" /><Setter Target="Shadow2.Visibility" Value="Visible" /><Setter Target="Shadow3.Visibility" Value="Visible" /><Setter Target="TrackGlow.Visibility" Value="Visible" />
                    </VisualState.Setters></VisualState>
                    <VisualState x:Name="PointerOver"><VisualState.Setters>
                        <Setter Target="KnobFrame.BorderBrush" Value="{ThemeResource EtherSwitchKnobStrokeHoverBrush}" />
                        <Setter Target="SwitchKnobOff.Fill" Value="{ThemeResource EtherSwitchKnobFillHoverBrush}" />
                        <Setter Target="SwitchKnobOn.Background" Value="{ThemeResource EtherSwitchKnobFillOnHoverBrush}" />
                    </VisualState.Setters></VisualState>
                    <VisualState x:Name="Pressed"><VisualState.Setters>
                        <Setter Target="KnobFrame.BorderBrush" Value="{ThemeResource EtherSwitchKnobStrokePressedBrush}" />
                        <Setter Target="SwitchKnobOff.Fill" Value="{ThemeResource EtherSwitchKnobFillPressedBrush}" />
                        <Setter Target="SwitchKnobOn.Background" Value="{ThemeResource EtherSwitchKnobFillOnPressedBrush}" />
                    </VisualState.Setters></VisualState>
                    <VisualState x:Name="Disabled"><VisualState.Setters>
                        <Setter Target="TrackVisuals.Opacity" Value="0.4" /><Setter Target="LabelsHost.Opacity" Value="0.4" />
                        <Setter Target="KnobFrame.BorderBrush" Value="{ThemeResource EtherSwitchKnobDisabledStrokeBrush}" />
                        <Setter Target="SwitchKnobOff.Fill" Value="{ThemeResource EtherSwitchKnobDisabledBrush}" /><Setter Target="SwitchKnobOn.Background" Value="{ThemeResource EtherSwitchKnobDisabledBrush}" />
                        <Setter Target="Shadow1.Visibility" Value="Collapsed" /><Setter Target="Shadow2.Visibility" Value="Collapsed" /><Setter Target="Shadow3.Visibility" Value="Collapsed" /><Setter Target="TrackGlow.Visibility" Value="Collapsed" />
                    </VisualState.Setters></VisualState>
                </VisualStateGroup>

                <VisualStateGroup x:Name="ToggleStates">
                    <VisualStateGroup.Transitions>
                        <!-- Hold the full On look (incl. knob X and OuterBorder) while the stock
                             control passes through the empty Dragging state on pointer-press, so a
                             tap does not revert to the base (Off) look. This is the fix for the
                             off->on->off flicker: the earlier RepositionThemeAnimation + TemplateSettings
                             bindings threw at transition time (XAML apply crash) and are removed. -->
                        <VisualTransition x:Name="OnToDraggingTransition" From="On" To="Dragging" GeneratedDuration="0">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X" To="12" Duration="0" />
                                <DoubleAnimation Storyboard.TargetName="OuterBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                <DoubleAnimation Storyboard.TargetName="OnTrackBacking" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                <DoubleAnimation Storyboard.TargetName="TrackGlow" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                <DoubleAnimation Storyboard.TargetName="SwitchKnobOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                <DoubleAnimation Storyboard.TargetName="SwitchKnobOff" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                            </Storyboard>
                        </VisualTransition>
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Dragging" />
                    <VisualState x:Name="Off">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.0833" />
                            <DoubleAnimation Storyboard.TargetName="OuterBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.0833" />
                            <DoubleAnimation Storyboard.TargetName="OnTrackBacking" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.0833" />
                            <DoubleAnimation Storyboard.TargetName="TrackGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.0833" />
                            <DoubleAnimation Storyboard.TargetName="SwitchKnobOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.0833" />
                            <DoubleAnimation Storyboard.TargetName="SwitchKnobOff" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.0833" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="On">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X" To="12" Duration="0:0:0.0833" />
                            <DoubleAnimation Storyboard.TargetName="OuterBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.0833" />
                            <DoubleAnimation Storyboard.TargetName="OnTrackBacking" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.0833" />
                            <DoubleAnimation Storyboard.TargetName="TrackGlow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.0833" />
                            <DoubleAnimation Storyboard.TargetName="SwitchKnobOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.0833" />
                            <DoubleAnimation Storyboard.TargetName="SwitchKnobOff" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.0833" />
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>

                <VisualStateGroup x:Name="ContentStates">
                    <VisualState x:Name="OffContent"><Storyboard><DoubleAnimation Storyboard.TargetName="OffContentPresenter" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /><ObjectAnimationUsingKeyFrames Storyboard.TargetName="OffContentPresenter" Storyboard.TargetProperty="IsHitTestVisible"><DiscreteObjectKeyFrame KeyTime="0"><DiscreteObjectKeyFrame.Value><x:Boolean>True</x:Boolean></DiscreteObjectKeyFrame.Value></DiscreteObjectKeyFrame></ObjectAnimationUsingKeyFrames></Storyboard></VisualState>
                    <VisualState x:Name="OnContent"><Storyboard><DoubleAnimation Storyboard.TargetName="OnContentPresenter" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /><ObjectAnimationUsingKeyFrames Storyboard.TargetName="OnContentPresenter" Storyboard.TargetProperty="IsHitTestVisible"><DiscreteObjectKeyFrame KeyTime="0"><DiscreteObjectKeyFrame.Value><x:Boolean>True</x:Boolean></DiscreteObjectKeyFrame.Value></DiscreteObjectKeyFrame></ObjectAnimationUsingKeyFrames></Storyboard></VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused"><VisualState.Setters><Setter Target="FocusRing.Visibility" Value="Visible" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Unfocused" /><VisualState x:Name="PointerFocused" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <ContentPresenter x:Name="HeaderContentPresenter" x:DeferLoadStrategy="Lazy" Grid.Row="0" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" IsHitTestVisible="False" TextWrapping="Wrap" VerticalAlignment="Top" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
            <Grid Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                <Grid x:Name="LabelsHost" Grid.Column="0" VerticalAlignment="Center">
                    <ContentPresenter x:Name="OffContentPresenter" Opacity="0" Foreground="{ThemeResource EtherSwitchLabelForegroundBrush}" FontFamily="{StaticResource InterFont}" FontSize="{StaticResource Size12}" FontWeight="{StaticResource WeightSemibold}" IsHitTestVisible="False" Content="{TemplateBinding OffContent}" ContentTemplate="{TemplateBinding OffContentTemplate}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" AutomationProperties.AccessibilityView="Raw" />
                    <ContentPresenter x:Name="OnContentPresenter" Opacity="0" Foreground="{ThemeResource EtherSwitchLabelForegroundBrush}" FontFamily="{StaticResource InterFont}" FontSize="{StaticResource Size12}" FontWeight="{StaticResource WeightSemibold}" IsHitTestVisible="False" Content="{TemplateBinding OnContent}" ContentTemplate="{TemplateBinding OnContentTemplate}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" AutomationProperties.AccessibilityView="Raw" />
                </Grid>
                <Grid x:Name="SwitchAreaGrid" Grid.Column="2" Width="40" Height="20" CornerRadius="6" Control.IsTemplateFocusTarget="True" Background="{StaticResource EtherSwitchTransparentBrush}">
                    <Grid x:Name="TrackVisuals" IsHitTestVisible="False">
                        <Rectangle x:Name="OuterBorder" Width="40" Height="20" RadiusX="6" RadiusY="6" Fill="{ThemeResource EtherSwitchOffTrackBrush}" />
                        <Rectangle x:Name="OnTrackBacking" Width="40" Height="20" RadiusX="6" RadiusY="6" Fill="{ThemeResource EtherSwitchOnTrackBrush}" Opacity="0" />
                        <!-- 34 - 22 = 12: this is the stock control's native travel measure. -->
                        <Rectangle x:Name="SwitchKnobBounds" Width="34" Height="14" Margin="3,0" HorizontalAlignment="Left" VerticalAlignment="Center" RadiusX="4.2" RadiusY="4.2" Fill="{ThemeResource EtherSwitchOnTrackBrush}" Opacity="0" />
                        <Border x:Name="TrackGlow" Background="{ThemeResource EtherSwitchOnTrackGlowFillBrush}" BorderBrush="{ThemeResource EtherSwitchOnTrackGlowStrokeBrush}" BorderThickness="1" CornerRadius="6" IsHitTestVisible="False" Opacity="0" />
                    </Grid>
                    <Grid x:Name="SwitchKnob" Width="22" Height="14" Margin="3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Grid.RenderTransform><TranslateTransform x:Name="KnobTranslateTransform" /></Grid.RenderTransform>
                        <Border x:Name="Shadow1" Margin="2,10,2,-1" CornerRadius="4" Background="{ThemeResource EtherSwitchKnobShadow1Brush}" /><Border x:Name="Shadow2" Margin="1,11,1,0" CornerRadius="4" Background="{ThemeResource EtherSwitchKnobShadow2Brush}" /><Border x:Name="Shadow3" Margin="3,11,3,0" CornerRadius="3.722" Background="{ThemeResource EtherSwitchKnobShadow3Brush}" />
                        <Border x:Name="KnobFrame" BorderBrush="{ThemeResource EtherSwitchKnobStrokeBrush}" BorderThickness="2" CornerRadius="3.722"><Grid Width="18" Height="10"><Rectangle x:Name="SwitchKnobOff" Fill="{ThemeResource EtherSwitchKnobFillBrush}" RadiusX="1.722" RadiusY="1.722" /><Border x:Name="SwitchKnobOn" Background="{ThemeResource EtherSwitchKnobFillOnBrush}" CornerRadius="1.722" Opacity="0" /></Grid></Border>
                    </Grid>
                </Grid>
                <primitives:Thumb x:Name="SwitchThumb" Grid.ColumnSpan="3" AutomationProperties.AccessibilityView="Raw"><primitives:Thumb.Template><ControlTemplate TargetType="primitives:Thumb"><Rectangle Fill="Transparent" /></ControlTemplate></primitives:Thumb.Template></primitives:Thumb>
            </Grid>
            <Border x:Name="FocusRing" Grid.Row="1" Margin="-3" BorderBrush="{ThemeResource EtherSwitchFocusBrush}" BorderThickness="2" CornerRadius="6" IsHitTestVisible="False" Visibility="Collapsed" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="EtherSwitch" TargetType="ToggleSwitch">
        <Setter Property="OffContentTemplate" Value="{StaticResource EtherSingleLineTextContentTemplate}" />
        <Setter Property="OnContentTemplate" Value="{StaticResource EtherSingleLineTextContentTemplate}" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="HighContrastAdjustment" Value="None" />
        <Setter Property="MinWidth" Value="{StaticResource Spacing0}" />
        <Setter Property="MinHeight" Value="{StaticResource Spacing0}" />
        <Setter Property="Padding" Value="{StaticResource Padding0}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource EtherSwitchTemplate}" />
    </Style>
</ResourceDictionary>
