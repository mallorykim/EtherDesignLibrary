<!--
    Ether Design System Toggle Switch

    Figma source: ursRC201v8IiVeafliI45F
      Light Off/Default 62138:28454 · Light On/Default 62138:28495
      Dark Off/Hover instance 62138:28796 · component set 62138:28453
    Track: 40 x 20, radius 6. Knob fill: 18 x 10, radius 1.722. Off fill is
    opaque Gray25 (hover Gray50, pressed Gray75). On fill is opaque Blue50
    (hover Blue100, pressed Blue200). White stroke is 2 px OUTSIDE, painted
    22 x 14.
    Off fill inset 5 (host margin 3); On travel 12 (fill x = 17). Label is Inter
    SemiBold 12 with an 8 px gap. Figma draws the caption to the right of the
    track; product layout keeps OffContent/OnContent on the left.

    Keyed style (x:Key="EtherSwitch"), not implicit: ToggleSwitch is a stock
    framework type, so an implicit style here would silently restyle every bare
    <ToggleSwitch/> anywhere else in the app. Call sites keep
    Style="{StaticResource EtherSwitch}".

    Colour-bearing values live in EtherSwitch* Light/Dark/HighContrast
    dictionaries. The template does not use literal hex. Light/Dark bind Color
    to primitives for off-track, label, knob stroke, knob fill, and focus.
    Light knob stroke is Gray0 with Gray25 / Blue50 fills in both themes.
    Dark Disabled knob fill and stroke are Gray500; Light Disabled stays
    Gray50. On-track cyan to navy has no matching primitive and stays as
    component-dictionary hex. High Contrast uses Windows SystemColor*.

    Disabled fades the track and labels to 40 % (Figma Opacity row). Knobs
    stay opaque (Light Gray50, Dark Gray500) so Off is not a near-white
    block and On does not pick up the cyan track. WinUI parent opacity
    punches the track through a translucent knob, so SwitchContent is not
    faded. Shadows and On-track glow collapse.

    The Dark instance 62138:28796 ships a Figma prototype loop; toggle motion
    stays the 0.16s CubicEase On/Off transition.

    LOCATION
      This compiled dictionary lives beside its code-behind and styles the
      stock ToggleSwitch type through a keyed style (not implicit). It is
      instantiated from Generic.xaml.
-->
<ResourceDictionary
    x:Class="Ether.DesignSystem.Controls.EtherSwitch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ether.DesignSystem.Controls"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="EtherSwitchFocusBrush" Color="{StaticResource Blue600}" />
            <SolidColorBrush x:Key="EtherSwitchKnobDisabledBrush" Color="{StaticResource Gray50}" />
            <SolidColorBrush x:Key="EtherSwitchKnobDisabledStrokeBrush" Color="{StaticResource Gray0}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillBrush" Color="{StaticResource Gray25}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillHoverBrush" Color="{StaticResource Gray50}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillPressedBrush" Color="{StaticResource Gray75}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillOnBrush" Color="{StaticResource Blue50}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillOnHoverBrush" Color="{StaticResource Blue100}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillOnPressedBrush" Color="{StaticResource Blue200}" />
            <SolidColorBrush x:Key="EtherSwitchKnobSheenBrush" Color="{StaticResource AlphaWhite0}" />
            <SolidColorBrush x:Key="EtherSwitchKnobShadow1Brush" Color="#35183361" />
            <SolidColorBrush x:Key="EtherSwitchKnobShadow2Brush" Color="#1A183361" />
            <SolidColorBrush x:Key="EtherSwitchKnobShadow3Brush" Color="#0D183361" />
            <SolidColorBrush x:Key="EtherSwitchKnobStrokeBrush" Color="{StaticResource Gray0}" />
            <!-- Same color as the resting stroke in Light/Dark: Hover/Pressed only tint the knob
                 fill a shade darker, so the resting stroke color stays visible against it. High
                 Contrast repaints Hover/Pressed fills as an opaque SystemColorHighlightColor, so
                 the stroke needs to repaint as SystemColorHighlightTextColor there instead. -->
            <SolidColorBrush x:Key="EtherSwitchKnobStrokeHoverBrush" Color="{StaticResource Gray0}" />
            <SolidColorBrush x:Key="EtherSwitchKnobStrokePressedBrush" Color="{StaticResource Gray0}" />
            <SolidColorBrush x:Key="EtherSwitchLabelForegroundBrush" Color="{StaticResource AlphaBlack70}" />
            <SolidColorBrush x:Key="EtherSwitchOffTrackBrush" Color="{StaticResource AlphaBlack10}" />
            <LinearGradientBrush x:Key="EtherSwitchOnTrackBrush" StartPoint="1,0.5" EndPoint="0,0.5">
                <GradientStop Color="#40E1FD" Offset="0.00" />
                <GradientStop Color="#0EB2FF" Offset="0.098" />
                <GradientStop Color="#0015FF" Offset="0.80" />
                <GradientStop Color="#0021F3" Offset="1.00" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="EtherSwitchOnTrackGlowFillBrush" Color="{StaticResource AlphaWhite6}" />
            <SolidColorBrush x:Key="EtherSwitchOnTrackGlowStrokeBrush" Color="{StaticResource AlphaWhite20}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="EtherSwitchFocusBrush" Color="{StaticResource Blue500}" />
            <SolidColorBrush x:Key="EtherSwitchKnobDisabledBrush" Color="{StaticResource Gray500}" />
            <SolidColorBrush x:Key="EtherSwitchKnobDisabledStrokeBrush" Color="{StaticResource Gray500}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillBrush" Color="{StaticResource Gray25}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillHoverBrush" Color="{StaticResource Gray50}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillPressedBrush" Color="{StaticResource Gray75}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillOnBrush" Color="{StaticResource Blue50}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillOnHoverBrush" Color="{StaticResource Blue100}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillOnPressedBrush" Color="{StaticResource Blue200}" />
            <SolidColorBrush x:Key="EtherSwitchKnobSheenBrush" Color="{StaticResource AlphaWhite0}" />
            <SolidColorBrush x:Key="EtherSwitchKnobShadow1Brush" Color="#35183361" />
            <SolidColorBrush x:Key="EtherSwitchKnobShadow2Brush" Color="#1A183361" />
            <SolidColorBrush x:Key="EtherSwitchKnobShadow3Brush" Color="#0D183361" />
            <SolidColorBrush x:Key="EtherSwitchKnobStrokeBrush" Color="{StaticResource Gray0}" />
            <SolidColorBrush x:Key="EtherSwitchKnobStrokeHoverBrush" Color="{StaticResource Gray0}" />
            <SolidColorBrush x:Key="EtherSwitchKnobStrokePressedBrush" Color="{StaticResource Gray0}" />
            <SolidColorBrush x:Key="EtherSwitchLabelForegroundBrush" Color="{StaticResource AlphaWhite70}" />
            <SolidColorBrush x:Key="EtherSwitchOffTrackBrush" Color="{StaticResource AlphaWhite10}" />
            <LinearGradientBrush x:Key="EtherSwitchOnTrackBrush" StartPoint="1,0.5" EndPoint="0,0.5">
                <GradientStop Color="#40E1FD" Offset="0.00" />
                <GradientStop Color="#0EB2FF" Offset="0.098" />
                <GradientStop Color="#0015FF" Offset="0.80" />
                <GradientStop Color="#0021F3" Offset="1.00" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="EtherSwitchOnTrackGlowFillBrush" Color="{StaticResource AlphaWhite6}" />
            <SolidColorBrush x:Key="EtherSwitchOnTrackGlowStrokeBrush" Color="{StaticResource AlphaWhite20}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="EtherSwitchFocusBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherSwitchKnobDisabledBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="EtherSwitchKnobDisabledStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillOnBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillOnHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherSwitchKnobFillOnPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherSwitchKnobSheenBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EtherSwitchKnobShadow1Brush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EtherSwitchKnobShadow2Brush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EtherSwitchKnobShadow3Brush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EtherSwitchKnobStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <!-- Paired with KnobFillHoverBrush/PressedBrush/OnHoverBrush/OnPressedBrush above,
                 which repaint as an opaque SystemColorHighlightColor in High Contrast: the stroke
                 delineating the knob against that fill must be SystemColorHighlightTextColor, not
                 the WindowText color used against the resting WindowColor fill. -->
            <SolidColorBrush x:Key="EtherSwitchKnobStrokeHoverBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="EtherSwitchKnobStrokePressedBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="EtherSwitchLabelForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EtherSwitchOffTrackBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="EtherSwitchOnTrackBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherSwitchOnTrackGlowFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EtherSwitchOnTrackGlowStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Structural overlay fill: not themed, so High Contrast dictionaries stay
         SystemColor-only while the clipped track host and SwitchThumb stay empty. -->
    <SolidColorBrush x:Key="EtherSwitchTransparentBrush" Color="Transparent"/>

    <ControlTemplate x:Key="EtherSwitchTemplate" TargetType="ToggleSwitch">
        <Grid x:Name="LayoutRoot">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition From="Normal" To="PointerOver" GeneratedDuration="0:0:0.12">
                            <VisualTransition.GeneratedEasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                        <VisualTransition From="PointerOver" To="Normal" GeneratedDuration="0:0:0.12">
                            <VisualTransition.GeneratedEasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                        <VisualTransition To="Pressed" GeneratedDuration="0:0:0.08">
                            <VisualTransition.GeneratedEasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Target="KnobFill.Background" Value="{ThemeResource EtherSwitchKnobFillBrush}"/>
                            <Setter Target="KnobFillOn.Background" Value="{ThemeResource EtherSwitchKnobFillOnBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="KnobFill.Background" Value="{ThemeResource EtherSwitchKnobFillHoverBrush}"/>
                            <Setter Target="KnobFillOn.Background" Value="{ThemeResource EtherSwitchKnobFillOnHoverBrush}"/>
                            <Setter Target="Knob.BorderBrush" Value="{ThemeResource EtherSwitchKnobStrokeHoverBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="KnobFill.Background" Value="{ThemeResource EtherSwitchKnobFillPressedBrush}"/>
                            <Setter Target="KnobFillOn.Background" Value="{ThemeResource EtherSwitchKnobFillOnPressedBrush}"/>
                            <Setter Target="Knob.BorderBrush" Value="{ThemeResource EtherSwitchKnobStrokePressedBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <!-- Track and labels fade to 40 %. Knob fill and
                                 stroke use EtherSwitchKnobDisabled* so Dark
                                 Disabled is Gray500, not a near-white disc. -->
                            <Setter Target="TrackOff.Opacity" Value="0.4"/>
                            <Setter Target="TrackOn.Opacity" Value="0.4"/>
                            <Setter Target="OffLabel.Opacity" Value="0.4"/>
                            <Setter Target="OnLabel.Opacity" Value="0.4"/>
                            <Setter Target="Knob.BorderBrush" Value="{ThemeResource EtherSwitchKnobDisabledStrokeBrush}"/>
                            <Setter Target="KnobFill.Background" Value="{ThemeResource EtherSwitchKnobDisabledBrush}"/>
                            <Setter Target="KnobFillOn.Background" Value="{ThemeResource EtherSwitchKnobDisabledBrush}"/>
                            <Setter Target="Shadow1.Visibility" Value="Collapsed"/>
                            <Setter Target="Shadow2.Visibility" Value="Collapsed"/>
                            <Setter Target="Shadow3.Visibility" Value="Collapsed"/>
                            <Setter Target="TrackGlow.Visibility" Value="Collapsed"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>

                <VisualStateGroup x:Name="ToggleStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition From="Off" To="On" GeneratedDuration="0:0:0.16">
                            <VisualTransition.GeneratedEasingFunction>
                                <CubicEase EasingMode="EaseInOut"/>
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                        <VisualTransition From="On" To="Off" GeneratedDuration="0:0:0.16">
                            <VisualTransition.GeneratedEasingFunction>
                                <CubicEase EasingMode="EaseInOut"/>
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Off">
                        <VisualState.Setters>
                            <Setter Target="TrackOff.Visibility" Value="Visible"/>
                            <Setter Target="TrackOn.Visibility" Value="Collapsed"/>
                            <Setter Target="TrackGlow.Visibility" Value="Collapsed"/>
                            <Setter Target="OffLabel.Visibility" Value="Visible"/>
                            <Setter Target="OnLabel.Visibility" Value="Collapsed"/>
                            <Setter Target="KnobFill.Visibility" Value="Visible"/>
                            <Setter Target="KnobFillOn.Visibility" Value="Collapsed"/>
                            <Setter Target="KnobSheen.Visibility" Value="Collapsed"/>
                            <Setter Target="KnobTransform.X" Value="0"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="On">
                        <VisualState.Setters>
                            <Setter Target="TrackOff.Visibility" Value="Collapsed"/>
                            <Setter Target="TrackOn.Visibility" Value="Visible"/>
                            <Setter Target="TrackGlow.Visibility" Value="Visible"/>
                            <Setter Target="OffLabel.Visibility" Value="Collapsed"/>
                            <Setter Target="OnLabel.Visibility" Value="Visible"/>
                            <Setter Target="KnobFill.Visibility" Value="Collapsed"/>
                            <Setter Target="KnobFillOn.Visibility" Value="Visible"/>
                            <Setter Target="KnobSheen.Visibility" Value="Collapsed"/>
                            <!-- Fill inset 5 + 12 px travel = fill x 17. Host is
                                 2 px larger on each side for the outside stroke. -->
                            <Setter Target="KnobTransform.X" Value="12"/>
                        </VisualState.Setters>
                    </VisualState>
                    <!-- Stock ToggleSwitch goes to Dragging while the thumb is
                         captured. Chrome stays on the current Off/On setters. -->
                    <VisualState x:Name="Dragging"/>
                </VisualStateGroup>

                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Target="FocusRing.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Unfocused"/>
                    <VisualState x:Name="PointerFocused"/>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <StackPanel x:Name="SwitchContent"
                        Orientation="Horizontal"
                        Spacing="{StaticResource Spacing8}"
                        VerticalAlignment="Center">
                <ContentPresenter x:Name="OffLabel"
                                  Content="{TemplateBinding OffContent}"
                                  ContentTemplate="{TemplateBinding OffContentTemplate}"
                                  Foreground="{ThemeResource EtherSwitchLabelForegroundBrush}"
                                  FontFamily="{StaticResource InterFont}"
                                  FontSize="{StaticResource Size12}"
                                  FontWeight="{StaticResource WeightSemibold}"
                                  VerticalAlignment="Center"
                                  Visibility="Visible"/>
                <ContentPresenter x:Name="OnLabel"
                                  Content="{TemplateBinding OnContent}"
                                  ContentTemplate="{TemplateBinding OnContentTemplate}"
                                  Foreground="{ThemeResource EtherSwitchLabelForegroundBrush}"
                                  FontFamily="{StaticResource InterFont}"
                                  FontSize="{StaticResource Size12}"
                                  FontWeight="{StaticResource WeightSemibold}"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed"/>
                <!-- Figma nodes 62138:28454/28495 specify a fixed 40x20 track and
                     fixed 22x14 knob host; keep these dimensions fixed as an explicit
                     design decision (option b), rather than scaling them with FontSize. -->
                <controls:HandContentControl x:Name="SwitchArea"
                                             Width="40"
                                             Height="20"
                                             HorizontalContentAlignment="Stretch"
                                             VerticalContentAlignment="Stretch">
                    <Grid Background="{StaticResource EtherSwitchTransparentBrush}">
                        <Grid.Clip>
                            <RectangleGeometry Rect="0,0,40,20"/>
                        </Grid.Clip>
                        <Border x:Name="TrackOff"
                                Background="{ThemeResource EtherSwitchOffTrackBrush}"
                                CornerRadius="6"
                                Visibility="Visible"/>

                        <Border x:Name="TrackOn"
                                Background="{ThemeResource EtherSwitchOnTrackBrush}"
                                CornerRadius="6"
                                Visibility="Collapsed"/>

                        <!-- Soft white inset in the On state (Figma inner glow ~24 px). -->
                        <Border x:Name="TrackGlow"
                                Background="{ThemeResource EtherSwitchOnTrackGlowFillBrush}"
                                BorderBrush="{ThemeResource EtherSwitchOnTrackGlowStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                IsHitTestVisible="False"
                                Visibility="Collapsed"/>

                        <!--
                            Soft navy drop under the knob, kept inside the 20 px track.
                            The 14 px host is centered with a 3 px gap; shadow must
                            stay in that gap.
                        -->
                        <Grid x:Name="KnobHost"
                              Width="22"
                              Height="14"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Margin="3,0,0,0">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="KnobTransform"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Shadow1"
                                    Margin="2,10,2,-1"
                                    CornerRadius="4"
                                    Background="{ThemeResource EtherSwitchKnobShadow1Brush}"
                                    IsHitTestVisible="False"/>
                            <Border x:Name="Shadow2"
                                    Margin="1,11,1,0"
                                    CornerRadius="4"
                                    Background="{ThemeResource EtherSwitchKnobShadow2Brush}"
                                    IsHitTestVisible="False"/>
                            <Border x:Name="Shadow3"
                                    Margin="3,11,3,0"
                                    CornerRadius="3.722"
                                    Background="{ThemeResource EtherSwitchKnobShadow3Brush}"
                                    IsHitTestVisible="False"/>

                            <!-- 22x14 host with 2 px BorderThickness leaves an 18x10
                                 content box, so the stroke grows outside the fill. -->
                            <Border x:Name="Knob"
                                    CornerRadius="3.722"
                                    BorderBrush="{ThemeResource EtherSwitchKnobStrokeBrush}"
                                    BorderThickness="2">
                                <Grid Width="18" Height="10">
                                    <Border x:Name="KnobBase"
                                            Background="{StaticResource EtherSwitchTransparentBrush}"
                                            CornerRadius="1.722"
                                            IsHitTestVisible="False"/>
                                    <Border x:Name="KnobFill"
                                            Background="{ThemeResource EtherSwitchKnobFillBrush}"
                                            CornerRadius="1.722"/>
                                    <Border x:Name="KnobFillOn"
                                            Background="{ThemeResource EtherSwitchKnobFillOnBrush}"
                                            CornerRadius="1.722"
                                            Visibility="Collapsed"/>
                                    <Border x:Name="KnobSheen"
                                            Background="{ThemeResource EtherSwitchKnobSheenBrush}"
                                            CornerRadius="1.722"
                                            Visibility="Collapsed"
                                            IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <primitives:Thumb x:Name="SwitchThumb"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          MinWidth="{StaticResource Spacing0}"
                                          MinHeight="{StaticResource Spacing0}"
                                          Background="{StaticResource EtherSwitchTransparentBrush}"
                                          BorderThickness="0"
                                          Opacity="0"
                                          IsHitTestVisible="True"
                                          AutomationProperties.AccessibilityView="Raw"/>
                    </Grid>
                </controls:HandContentControl>
            </StackPanel>

            <Border x:Name="FocusRing"
                    Margin="-3"
                    BorderBrush="{ThemeResource EtherSwitchFocusBrush}"
                    BorderThickness="2"
                    CornerRadius="6"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>
        </Grid>
    </ControlTemplate>

    <Style x:Key="EtherSwitch" TargetType="ToggleSwitch">
        <Setter Property="OffContentTemplate" Value="{StaticResource EtherSingleLineTextContentTemplate}"/>
        <Setter Property="OnContentTemplate" Value="{StaticResource EtherSingleLineTextContentTemplate}"/>
        <Setter Property="UseSystemFocusVisuals" Value="False"/>
        <Setter Property="HighContrastAdjustment" Value="None"/>
        <Setter Property="MinWidth" Value="{StaticResource Spacing0}"/>
        <Setter Property="MinHeight" Value="{StaticResource Spacing0}"/>
        <Setter Property="Padding" Value="{StaticResource Padding0}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource EtherSwitchTemplate}"/>
    </Style>
</ResourceDictionary>
