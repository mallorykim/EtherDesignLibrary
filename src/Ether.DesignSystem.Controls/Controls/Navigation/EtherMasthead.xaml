<!--
    Ether Design System Masthead

    Right-aligned caption bar with optional icon slots and AppWindow minimize,
    maximize/restore, and close chrome. DefaultEtherMastheadStyle owns the
    default setters; the implicit style is BasedOn that key. Colour-bearing
    values live in EtherMasthead* Light/Dark/HighContrast dictionaries. The
    template does not use literal hex.

    Optional icon visibility and the maximize/restore glyph swap are driven
    through VisualStateManager. Caption click handling stays code-driven so
    window chrome is not rewritten onto VSM.

    USAGE
      ExtendsContentIntoTitleBar = true;
      SetTitleBar(MastheadControl);

    LOCATION
      This dictionary lives beside its class (Controls/Navigation/EtherMasthead.xaml.cs)
      and is merged from Controls Generic.xaml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ether.DesignSystem.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="EtherMastheadCaptionHoverBrush" ResourceKey="ActionSecondaryBgHover" />
            <StaticResource x:Key="EtherMastheadCaptionPressedBrush" ResourceKey="ActionSecondaryBgPressed" />
            <StaticResource x:Key="EtherMastheadFocusBrush" ResourceKey="border/focus" />
            <StaticResource x:Key="EtherMastheadIconForegroundBrush" ResourceKey="text/primary" />
            <!-- Same color as the default icon in Light/Dark: the caption button's Hover/Pressed
                 fill (EtherMastheadCaptionHoverBrush/PressedBrush above) is a faint tint, so the
                 default icon color stays legible on top of it. High Contrast repaints that fill as
                 an opaque SystemColorHighlightColor, so these need to repaint as
                 SystemColorHighlightTextColor there instead (see the HighContrast dictionary). -->
            <StaticResource x:Key="EtherMastheadIconForegroundHoverBrush" ResourceKey="text/primary" />
            <StaticResource x:Key="EtherMastheadIconForegroundPressedBrush" ResourceKey="text/primary" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <StaticResource x:Key="EtherMastheadCaptionHoverBrush" ResourceKey="ActionSecondaryBgHover" />
            <StaticResource x:Key="EtherMastheadCaptionPressedBrush" ResourceKey="ActionSecondaryBgPressed" />
            <StaticResource x:Key="EtherMastheadFocusBrush" ResourceKey="border/focus" />
            <StaticResource x:Key="EtherMastheadIconForegroundBrush" ResourceKey="text/primary" />
            <StaticResource x:Key="EtherMastheadIconForegroundHoverBrush" ResourceKey="text/primary" />
            <StaticResource x:Key="EtherMastheadIconForegroundPressedBrush" ResourceKey="text/primary" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="EtherMastheadCaptionHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherMastheadCaptionPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherMastheadFocusBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherMastheadIconForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <!-- Paired with CaptionHoverBrush/CaptionPressedBrush above, which repaint as an opaque
                 SystemColorHighlightColor fill in High Contrast: the caption icon sitting on that
                 fill must be SystemColorHighlightTextColor, not the WindowText color used against
                 the transparent default fill. -->
            <SolidColorBrush x:Key="EtherMastheadIconForegroundHoverBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="EtherMastheadIconForegroundPressedBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="EtherMastheadCaptionButtonStyle" TargetType="controls:EtherButton">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="{StaticResource Padding0}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="UseSystemFocusVisuals" Value="False"/>
        <Setter Property="HighContrastAdjustment" Value="None"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Bg.Background" Value="{ThemeResource EtherMastheadCaptionHoverBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Bg.Background" Value="{ThemeResource EtherMastheadCaptionPressedBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Bg.Opacity" Value="0.4"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusRing.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unfocused"/>
                                <VisualState x:Name="PointerFocused"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusNone}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <Border x:Name="FocusRing"
                                Margin="-3"
                                BorderBrush="{ThemeResource EtherMastheadFocusBrush}"
                                BorderThickness="2"
                                CornerRadius="{StaticResource RadiusSm}"
                                IsHitTestVisible="False"
                                Visibility="Collapsed"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultEtherMastheadStyle" TargetType="controls:EtherMasthead">
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="HighContrastAdjustment" Value="None" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:EtherMasthead">
                    <Grid x:Name="LayoutRoot"
                          Padding="{StaticResource Padding12}"
                          Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="SettingsIconStates">
                                <VisualState x:Name="SettingsVisible">
                                    <VisualState.Setters>
                                        <Setter Target="SettingsButton.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SettingsCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="SettingsButton.Visibility" Value="Collapsed"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SearchIconStates">
                                <VisualState x:Name="SearchVisible">
                                    <VisualState.Setters>
                                        <Setter Target="SearchIconSlot.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SearchCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="SearchIconSlot.Visibility" Value="Collapsed"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="MenuIconStates">
                                <VisualState x:Name="MenuVisible">
                                    <VisualState.Setters>
                                        <Setter Target="MenuIconSlot.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="MenuCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="MenuIconSlot.Visibility" Value="Collapsed"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ChevronStates">
                                <VisualState x:Name="ChevronVisible">
                                    <VisualState.Setters>
                                        <Setter Target="ChevronSlot.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="ChevronCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="ChevronSlot.Visibility" Value="Collapsed"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="WindowStates">
                                <VisualState x:Name="WindowRestored">
                                    <VisualState.Setters>
                                        <Setter Target="MaximizeIcon.Visibility" Value="Visible"/>
                                        <Setter Target="RestoreIcon.Visibility" Value="Collapsed"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="WindowMaximized">
                                    <VisualState.Setters>
                                        <Setter Target="MaximizeIcon.Visibility" Value="Collapsed"/>
                                        <Setter Target="RestoreIcon.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="{StaticResource Spacing0}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">

                            <Grid x:Name="MenuIconSlot"
                                  Width="44"
                                  Height="44"
                                  Visibility="Collapsed">
                                <FontIcon Glyph="&#xE700;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="{StaticResource Size16}"
                                          Foreground="{ThemeResource EtherMastheadIconForegroundBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw"/>
                            </Grid>

                            <Grid x:Name="SearchIconSlot"
                                  Width="44"
                                  Height="44"
                                  Visibility="Collapsed">
                                <FontIcon Glyph="&#xE721;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="{StaticResource Size16}"
                                          Foreground="{ThemeResource EtherMastheadIconForegroundBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw"/>
                            </Grid>

                            <Grid x:Name="SettingsButton"
                                  Width="44"
                                  Height="44"
                                  Visibility="Visible">
                                <FontIcon Glyph="&#xE713;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="{StaticResource Size16}"
                                          Foreground="{ThemeResource EtherMastheadIconForegroundBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw"/>
                            </Grid>

                            <Grid x:Name="ChevronSlot"
                                  Width="44"
                                  Height="44"
                                  Visibility="Collapsed">
                                <FontIcon Glyph="&#xE70D;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="{StaticResource Size14}"
                                          Foreground="{ThemeResource EtherMastheadIconForegroundBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw"/>
                            </Grid>

                            <controls:EtherButton x:Name="MinimizeButton"
                                                  Style="{StaticResource EtherMastheadCaptionButtonStyle}"
                                                  AutomationProperties.Name="Minimize window">
                                <Grid>
                                    <Rectangle x:Name="MinimizeIcon"
                                               Width="{StaticResource Spacing12}"
                                               Height="1"
                                               Fill="{ThemeResource EtherMastheadIconForegroundBrush}"
                                               RadiusX="0.5"
                                               RadiusY="0.5"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </controls:EtherButton>

                            <controls:EtherButton x:Name="MaximizeRestoreButton"
                                                  Style="{StaticResource EtherMastheadCaptionButtonStyle}"
                                                  AutomationProperties.Name="Maximize window">
                                <Grid Width="{StaticResource Spacing10}"
                                      Height="{StaticResource Spacing10}">
                                    <Rectangle x:Name="MaximizeIcon"
                                               Width="{StaticResource Spacing10}"
                                               Height="{StaticResource Spacing10}"
                                               Stroke="{ThemeResource EtherMastheadIconForegroundBrush}"
                                               StrokeThickness="1"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <Grid x:Name="RestoreIcon"
                                          Width="{StaticResource Spacing10}"
                                          Height="{StaticResource Spacing10}"
                                          Visibility="Collapsed">
                                        <Rectangle x:Name="RestoreIconBack"
                                                   Width="7"
                                                   Height="7"
                                                   Stroke="{ThemeResource EtherMastheadIconForegroundBrush}"
                                                   StrokeThickness="1"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Top"/>
                                        <Rectangle x:Name="RestoreIconFront"
                                                   Width="7"
                                                   Height="7"
                                                   Stroke="{ThemeResource EtherMastheadIconForegroundBrush}"
                                                   StrokeThickness="1"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Bottom"/>
                                    </Grid>
                                </Grid>
                            </controls:EtherButton>

                            <controls:EtherButton x:Name="CloseButton"
                                                  Style="{StaticResource EtherMastheadCaptionButtonStyle}"
                                                  AutomationProperties.Name="Close window">
                                <Grid Width="{StaticResource Spacing10}"
                                      Height="{StaticResource Spacing10}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                    <Path x:Name="CloseIconStroke1"
                                          Data="M 0 0 L 10 10"
                                          Stroke="{ThemeResource EtherMastheadIconForegroundBrush}"
                                          StrokeThickness="1"
                                          StrokeStartLineCap="Square"
                                          StrokeEndLineCap="Square"/>
                                    <Path x:Name="CloseIconStroke2"
                                          Data="M 10 0 L 0 10"
                                          Stroke="{ThemeResource EtherMastheadIconForegroundBrush}"
                                          StrokeThickness="1"
                                          StrokeStartLineCap="Square"
                                          StrokeEndLineCap="Square"/>
                                </Grid>
                            </controls:EtherButton>

                        </StackPanel>

                        <!-- Theme-resolved color swatches, read from code-behind to recolor the
                             caption icons above on pointer state. They exist because the icons are
                             plain Shape content hosted through EtherMastheadCaptionButtonStyle's
                             ContentPresenter: Shape.Fill/Stroke does not participate in WinUI's
                             Foreground property-value-inheritance the way TextElement/Control
                             Foreground does, and a VisualState.Setter can only reach named parts
                             within the SAME ControlTemplate that declares the state — not into a
                             sibling control's own template (EtherMastheadCaptionButtonStyle) or
                             into that control's Content. Reading an already-resolved {ThemeResource}
                             brush off a live element is the standard, theme-correct way to fetch a
                             themed brush from code (see EtherMasthead.xaml.cs pointer handlers).
                             NOTE: an earlier attempt replaced this with a pure-XAML
                             Setter Target="Foreground" (no ElementName, intended to target the
                             templated Button's own Foreground property) + an ElementName Binding
                             on the icon Shapes. That compiled but threw a runtime
                             COMException (0x800F1000) out of VisualStateManager.GoToState the
                             moment the PointerOver state actually needed to apply, so it does not
                             work in this WinUI 3 version — back to swatches + code-behind. -->
                        <Rectangle x:Name="IconForegroundDefaultSwatch"
                                   Width="0" Height="0" Opacity="0" IsHitTestVisible="False"
                                   Fill="{ThemeResource EtherMastheadIconForegroundBrush}"/>
                        <Rectangle x:Name="IconForegroundHoverSwatch"
                                   Width="0" Height="0" Opacity="0" IsHitTestVisible="False"
                                   Fill="{ThemeResource EtherMastheadIconForegroundHoverBrush}"/>
                        <Rectangle x:Name="IconForegroundPressedSwatch"
                                   Width="0" Height="0" Opacity="0" IsHitTestVisible="False"
                                   Fill="{ThemeResource EtherMastheadIconForegroundPressedBrush}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:EtherMasthead" BasedOn="{StaticResource DefaultEtherMastheadStyle}" />
</ResourceDictionary>
