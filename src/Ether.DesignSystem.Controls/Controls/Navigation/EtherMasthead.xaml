<!--
    Ether Design System Masthead

    Right-aligned caption bar with optional icon slots and AppWindow minimize,
    maximize/restore, and close chrome. DefaultEtherMastheadStyle owns the
    default setters; the implicit style is BasedOn that key. Colour-bearing
    values live in EtherMasthead* Light/Dark/HighContrast dictionaries. The
    template does not use literal hex.

    The three caption buttons carry Segoe Fluent Icons font glyphs as Content
    (E921 minimize, E922 maximize, E923 restore, E8BB close). Their hover/pressed
    washes are translucent (AlphaBlack10/AlphaBlack20 in Light, AlphaWhite10/
    AlphaWhite20 in Dark) with RadiusMd rounded corners, and EtherMastheadCaptionButtonStyle's
    own VisualStateManager recolors both the wash and the glyph directly.
    The close button overrides only its wash to the design system's translucent-red
    AlphaDanger12 (hover) / AlphaDanger16 (pressed) token, so it reads as destructive;
    High Contrast keeps it on SystemColorHighlightColor like the other two.

    Optional icon visibility and the maximize/restore glyph swap are driven
    through VisualStateManager. Caption click handling stays code-driven so
    window chrome is not rewritten onto VSM.

    USAGE
      ExtendsContentIntoTitleBar = true;
      SetTitleBar(MastheadControl);

    LOCATION
      This dictionary lives beside its class (Controls/Navigation/EtherMasthead.xaml.cs)
      and is merged from Controls Generic.xaml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ether.DesignSystem.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="EtherMastheadCaptionHoverBrush" Color="{StaticResource AlphaBlack10}" />
            <SolidColorBrush x:Key="EtherMastheadCaptionPressedBrush" Color="{StaticResource AlphaBlack20}" />
            <SolidColorBrush x:Key="EtherMastheadCloseHoverBrush" Color="{StaticResource AlphaDanger12}" />
            <SolidColorBrush x:Key="EtherMastheadClosePressedBrush" Color="{StaticResource AlphaDanger16}" />
            <StaticResource x:Key="EtherMastheadFocusBrush" ResourceKey="border/focus" />
            <StaticResource x:Key="EtherMastheadIconForegroundBrush" ResourceKey="text/primary" />
            <!-- Same color as the default icon in Light/Dark: the caption button's Hover/Pressed
                 fill (EtherMastheadCaptionHoverBrush/PressedBrush above) is a faint tint, so the
                 default icon color stays legible on top of it. High Contrast repaints that fill as
                 an opaque SystemColorHighlightColor, so these need to repaint as
                 SystemColorHighlightTextColor there instead (see the HighContrast dictionary). -->
            <StaticResource x:Key="EtherMastheadIconForegroundHoverBrush" ResourceKey="text/primary" />
            <StaticResource x:Key="EtherMastheadIconForegroundPressedBrush" ResourceKey="text/primary" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="EtherMastheadCaptionHoverBrush" Color="{StaticResource AlphaWhite10}" />
            <SolidColorBrush x:Key="EtherMastheadCaptionPressedBrush" Color="{StaticResource AlphaWhite20}" />
            <SolidColorBrush x:Key="EtherMastheadCloseHoverBrush" Color="{StaticResource AlphaDanger12}" />
            <SolidColorBrush x:Key="EtherMastheadClosePressedBrush" Color="{StaticResource AlphaDanger16}" />
            <StaticResource x:Key="EtherMastheadFocusBrush" ResourceKey="border/focus" />
            <StaticResource x:Key="EtherMastheadIconForegroundBrush" ResourceKey="text/primary" />
            <StaticResource x:Key="EtherMastheadIconForegroundHoverBrush" ResourceKey="text/primary" />
            <StaticResource x:Key="EtherMastheadIconForegroundPressedBrush" ResourceKey="text/primary" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="EtherMastheadCaptionHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherMastheadCaptionPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherMastheadCloseHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherMastheadClosePressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherMastheadFocusBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EtherMastheadIconForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <!-- Paired with CaptionHoverBrush/CaptionPressedBrush above, which repaint as an opaque
                 SystemColorHighlightColor fill in High Contrast: the caption icon sitting on that
                 fill must be SystemColorHighlightTextColor, not the WindowText color used against
                 the transparent default fill. -->
            <SolidColorBrush x:Key="EtherMastheadIconForegroundHoverBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="EtherMastheadIconForegroundPressedBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="EtherMastheadCaptionButtonStyle" TargetType="controls:EtherButton">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="MinWidth" Value="46"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="{StaticResource Padding0}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="UseSystemFocusVisuals" Value="False"/>
        <Setter Property="HighContrastAdjustment" Value="None"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Bg.Background" Value="{ThemeResource EtherMastheadCaptionHoverBrush}"/>
                                        <Setter Target="Glyph.Foreground" Value="{ThemeResource EtherMastheadIconForegroundHoverBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Bg.Background" Value="{ThemeResource EtherMastheadCaptionPressedBrush}"/>
                                        <Setter Target="Glyph.Foreground" Value="{ThemeResource EtherMastheadIconForegroundPressedBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Bg.Opacity" Value="0.4"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusRing.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unfocused"/>
                                <VisualState x:Name="PointerFocused"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusMd}">
                            <FontIcon x:Name="Glyph"
                                      Glyph="{TemplateBinding Content}"
                                      FontFamily="Segoe Fluent Icons"
                                      FontSize="10"
                                      Foreground="{ThemeResource EtherMastheadIconForegroundBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      AutomationProperties.AccessibilityView="Raw"/>
                        </Border>

                        <Border x:Name="FocusRing"
                                Margin="-3"
                                BorderBrush="{ThemeResource EtherMastheadFocusBrush}"
                                BorderThickness="2"
                                CornerRadius="{StaticResource RadiusSm}"
                                IsHitTestVisible="False"
                                Visibility="Collapsed"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Destructive caption button: identical to EtherMastheadCaptionButtonStyle except the
         hover/pressed wash uses the translucent-red EtherMastheadClose* brushes. Kept as a sibling
         style (not a per-instance Resources override) so every wash brush stays a top-level
         component theme key, per the masthead contract. -->
    <Style x:Key="EtherMastheadCloseButtonStyle"
           TargetType="controls:EtherButton"
           BasedOn="{StaticResource EtherMastheadCaptionButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Bg.Background" Value="{ThemeResource EtherMastheadCloseHoverBrush}"/>
                                        <Setter Target="Glyph.Foreground" Value="{ThemeResource EtherMastheadIconForegroundHoverBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Bg.Background" Value="{ThemeResource EtherMastheadClosePressedBrush}"/>
                                        <Setter Target="Glyph.Foreground" Value="{ThemeResource EtherMastheadIconForegroundPressedBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Bg.Opacity" Value="0.4"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusRing.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unfocused"/>
                                <VisualState x:Name="PointerFocused"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusMd}">
                            <FontIcon x:Name="Glyph"
                                      Glyph="{TemplateBinding Content}"
                                      FontFamily="Segoe Fluent Icons"
                                      FontSize="10"
                                      Foreground="{ThemeResource EtherMastheadIconForegroundBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      AutomationProperties.AccessibilityView="Raw"/>
                        </Border>

                        <Border x:Name="FocusRing"
                                Margin="-3"
                                BorderBrush="{ThemeResource EtherMastheadFocusBrush}"
                                BorderThickness="2"
                                CornerRadius="{StaticResource RadiusSm}"
                                IsHitTestVisible="False"
                                Visibility="Collapsed"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultEtherMastheadStyle" TargetType="controls:EtherMasthead">
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="HighContrastAdjustment" Value="None" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:EtherMasthead">
                    <Grid x:Name="LayoutRoot"
                          Padding="{StaticResource Padding12}"
                          Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="SettingsIconStates">
                                <VisualState x:Name="SettingsVisible">
                                    <VisualState.Setters>
                                        <Setter Target="SettingsButton.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SettingsCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="SettingsButton.Visibility" Value="Collapsed"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SearchIconStates">
                                <VisualState x:Name="SearchVisible">
                                    <VisualState.Setters>
                                        <Setter Target="SearchIconSlot.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SearchCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="SearchIconSlot.Visibility" Value="Collapsed"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="MenuIconStates">
                                <VisualState x:Name="MenuVisible">
                                    <VisualState.Setters>
                                        <Setter Target="MenuIconSlot.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="MenuCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="MenuIconSlot.Visibility" Value="Collapsed"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ChevronStates">
                                <VisualState x:Name="ChevronVisible">
                                    <VisualState.Setters>
                                        <Setter Target="ChevronSlot.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="ChevronCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="ChevronSlot.Visibility" Value="Collapsed"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="WindowStates">
                                <VisualState x:Name="WindowRestored"/>
                                <VisualState x:Name="WindowMaximized">
                                    <VisualState.Setters>
                                        <Setter Target="MaximizeRestoreButton.Content" Value="&#xE923;"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="{StaticResource Spacing0}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">

                            <Grid x:Name="MenuIconSlot"
                                  Width="44"
                                  Height="44"
                                  Visibility="Collapsed">
                                <FontIcon Glyph="&#xE700;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="{StaticResource Size16}"
                                          Foreground="{ThemeResource EtherMastheadIconForegroundBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw"/>
                            </Grid>

                            <Grid x:Name="SearchIconSlot"
                                  Width="44"
                                  Height="44"
                                  Visibility="Collapsed">
                                <FontIcon Glyph="&#xE721;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="{StaticResource Size16}"
                                          Foreground="{ThemeResource EtherMastheadIconForegroundBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw"/>
                            </Grid>

                            <Grid x:Name="SettingsButton"
                                  Width="44"
                                  Height="44"
                                  Visibility="Visible">
                                <FontIcon Glyph="&#xE713;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="{StaticResource Size16}"
                                          Foreground="{ThemeResource EtherMastheadIconForegroundBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw"/>
                            </Grid>

                            <Grid x:Name="ChevronSlot"
                                  Width="44"
                                  Height="44"
                                  Visibility="Collapsed">
                                <FontIcon Glyph="&#xE70D;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="{StaticResource Size14}"
                                          Foreground="{ThemeResource EtherMastheadIconForegroundBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw"/>
                            </Grid>

                            <controls:EtherButton x:Name="MinimizeButton"
                                                  Style="{StaticResource EtherMastheadCaptionButtonStyle}"
                                                  Content="&#xE921;"
                                                  AutomationProperties.Name="Minimize window"/>

                            <controls:EtherButton x:Name="MaximizeRestoreButton"
                                                  Style="{StaticResource EtherMastheadCaptionButtonStyle}"
                                                  Content="&#xE922;"
                                                  AutomationProperties.Name="Maximize window"/>

                            <controls:EtherButton x:Name="CloseButton"
                                                  Style="{StaticResource EtherMastheadCloseButtonStyle}"
                                                  Content="&#xE8BB;"
                                                  AutomationProperties.Name="Close window"/>

                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:EtherMasthead" BasedOn="{StaticResource DefaultEtherMastheadStyle}" />
</ResourceDictionary>
