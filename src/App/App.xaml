<Application
    x:Class="EtherSandbox.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:EtherSandbox.Converters"
    xmlns:controls="using:EtherSandbox.Controls">

    <Application.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Framework default control resources (brushes/styles like
                    TabViewButtonBackground) that NavigationView's own template depends
                    on. Unpackaged WinUI 3 apps do not get these for free — they must be
                    merged explicitly.
                -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
                <!--
                    Master design-system dictionary. It merges the token files and all
                    component dictionaries in the correct order, so App.xaml stays a thin
                    shell and the design system owns its own resource graph.
                -->
                <ResourceDictionary Source="ms-appx:///Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
