<!--
    EtherAIAssistant.xaml = Ether Design System = Dell AI Assistant Panel
    =

    USAGE
      Place in EtherAiPanelPage.xaml as the right column (342 px).

        <local:EtherAIAssistant Type="Empty"/>
        <local:EtherAIAssistant Type="Devices"/>
        <local:EtherAIAssistant Type="Display"/>

    TYPE VARIANTS (Figma source: ursRC201v8IiVeafliI45F = node 58074:2564)
      Empty     No conversation. Centred sparkle icon + "Dell AI Assistant" title.
                Prompt input bar docked to bottom.
      Devices   Active conversation about device management.  Header + response card
                listing devices + prompt bar.
      Display   Active conversation about display settings.  Header + response card
                with display settings + prompt bar.

    STRUCTURE (all types)
      =  = 342 px wide, radius 16
      =  Header strip (Devices/Display only)   =  sparkle + "Dell AI Assistant" + X button
      =  =  =
      =  Conversation area (Devices/Display)   =  AI response cards (intelligence glow)
      =                                        =
      =  OR                                    =
      =  Empty centre: sparkle + title         =  (Empty only)
      =  =  =
      =  Prompt input                          =  bg/ai-input = "What do you need?"
      =  [ = = = ~~ ]  [ = ]                =  toolbar + send button
      =

    AI RESPONSE CARD (inside Devices/Display)
      Background   BackgroundCanvas
      Border       1 px BackgroundSurfaceInverse (black)
      Shadow       =3px =3px rgba(187,0,255,0.1) = 0 2px 4px rgba(25,111,255,0.5)
      CornerRadius 12 (RadiusControlLg)
      Padding      16 = gap 8

    SEND BUTTON
      Background   BackgroundSurfaceInverse (always black)
      Border       1 px AiAccentPurple
      CornerRadius 4 (RadiusControlSm)
      Size         42 = 42

    PROMPT INPUT
      Background   BackgroundAiInput (rgba 192,200,205 @40% L / rgba 255,255,255 @25% D)
      CornerRadius 8 (RadiusControl)
      Height       51 = Padding px=12, py=4
      Placeholder  Inter Regular 14 px = opacity 50% = TextPrimary

    KEY FONTS
      Panel title:     InstrumentSans SemiBold 16 px
      Card heading:    InstrumentSans SemiBold 15 px
      Card content:    InterFont Regular/Medium 14 px
      Response label:  InterFont Medium 14 px = TextTertiary

    TOKENS
      Panel bg:        transparent (host provides BackgroundSurface)
      Header bg:       none (inherits)
      Input bg:        BackgroundAiInput (ThemeResource)
      Response card:   BackgroundCanvas (ThemeResource) + intelligence glow
      Send bg:         BackgroundSurfaceInverse (ThemeResource)
      Send border:     AiAccentPurple (ThemeResource)
      Sparkle icon:    AiAccentBlue (ThemeResource)
-->
<UserControl
    x:Class="EtherSandbox.Controls.EtherAIAssistant"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    Width="342">

    <!--
        STATIC PREVIEW = shows the Empty state.
        In a real project, swap content by binding a Type property
        and showing/collapsing the three visual sub-trees below.
    -->
    <Border CornerRadius="16">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- =
                 EMPTY STATE (visible when Type = "Empty")
                 Hide this StackPanel for Devices / Display.
            = -->
            <StackPanel x:Name="EmptyState"
                        Grid.Row="0"
                        Orientation="Vertical"
                        Spacing="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <!-- Sparkle icon = replace with Image Source="ms-appx:///Assets/Icons/Sparkles.png" -->
                <TextBlock Text="=" FontSize="45"
                           Foreground="{ThemeResource AiAccentBlue}"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Dell AI Assistant"
                           FontFamily="{StaticResource InstrumentSans}"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimary}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- =
                 ACTIVE STATE header (visible when Type = "Devices" or "Display")
                 Collapse x:Name="ActiveHeader" for Empty state.

                 <Grid x:Name="ActiveHeader" Grid.Row="0" VerticalAlignment="Top" Padding="16">
                     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                         <TextBlock Text="=" FontSize="45" Foreground="{ThemeResource AiAccentBlue}"/>
                         <TextBlock Text="Dell AI Assistant"
                                    FontFamily="{StaticResource InstrumentSans}"
                                    FontSize="16" FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextPrimary}"
                                    VerticalAlignment="Center"/>
                     </StackPanel>
                     <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                             Width="16" Height="16"
                             Style="{StaticResource EtherButtonTertiary}"
                             Content="="/>
                 </Grid>
            = -->

            <!-- =
                 AI RESPONSE CARD  (visible when Type = "Devices" or "Display")
                 Collapse for Empty state.

                 Intelligence glow: layered AttachedCardShadow (purple offset + blue drop).
                 <Border Grid.Row="0"
                         Margin="16,77,16,0"
                         VerticalAlignment="Top"
                         CornerRadius="{StaticResource RadiusControlLg}"
                         Background="Transparent">
                     <ui:Effects.Shadow>
                         <media:AttachedCardShadow Color="#BB00FF" Offset="-3,-3" BlurRadius="0" Opacity="0.1" CornerRadius="12"/>
                     </ui:Effects.Shadow>
                 <Border CornerRadius="{StaticResource RadiusControlLg}" Background="Transparent">
                     <ui:Effects.Shadow>
                         <media:AttachedCardShadow Color="#196FFF" Offset="0,2" BlurRadius="4" Opacity="0.5" CornerRadius="12"/>
                     </ui:Effects.Shadow>
                 <Border x:Name="ResponseCard"
                         CornerRadius="{StaticResource RadiusControlLg}"
                         Background="{ThemeResource BackgroundCanvas}"
                         BorderBrush="{ThemeResource BackgroundSurfaceInverse}"
                         BorderThickness="1"
                         Padding="16,8,16,16">
                     <StackPanel Orientation="Vertical" Spacing="8">
                         <Border BorderBrush="{ThemeResource ActionPrimaryBgDisabled}"
                                 BorderThickness="0,0,0,1" Padding="0,16,0,8">
                             <TextBlock Text="Your Devices"  (or "Display")
                                        FontFamily="{StaticResource InstrumentSans}"
                                        FontSize="15" FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextPrimary}"/>
                         </Border>
                         [ Device list / display settings rows go here ]
                     </StackPanel>
                 </Border>
                 </Border>
                 </Border>
            = -->

            <!-- =
                 PROMPT INPUT + TOOLBAR (always visible, docked to bottom)
            = -->
            <StackPanel Grid.Row="1"
                        Orientation="Vertical"
                        Spacing="8"
                        Padding="16">

                <!-- Prompt input field -->
                <Border Background="{ThemeResource BackgroundAiInput}"
                        CornerRadius="{StaticResource RadiusControl}"
                        Height="51"
                        Padding="12,4,12,4">
                    <StackPanel Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Top"
                                Margin="0,10,0,0">
                        <!-- Separator glyph (vertical line) -->
                        <Border Width="1" Height="23" Margin="0,0,4,0"
                                Background="{ThemeResource BorderDefault}"/>
                        <TextBlock Text="What do you need?"
                                   FontFamily="{StaticResource InterFont}"
                                   FontSize="14" FontWeight="Normal"
                                   Opacity="0.50"
                                   Foreground="{ThemeResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Toolbar row: input mode icons + send button -->
                <Grid>
                    <!-- Input mode icons (keyboard / mic / scan / waveform) -->
                    <StackPanel Orientation="Horizontal" Spacing="16"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Padding="4,4,12,4">
                        <!-- Each icon: 18=18 = replace Border with Image -->
                        <Border Width="18" Height="18"
                                Background="{ThemeResource BackgroundSurfaceInverse}"
                                CornerRadius="{StaticResource RadiusControl}"
                                Padding="4"/>
                        <Border Width="18" Height="18"
                                Background="{ThemeResource TextSecondary}"
                                CornerRadius="2" Opacity="0.6"/>
                        <Border Width="18" Height="18"
                                Background="{ThemeResource TextSecondary}"
                                CornerRadius="2" Opacity="0.6"/>
                        <Border Width="18" Height="18"
                                Background="{ThemeResource TextSecondary}"
                                CornerRadius="2" Opacity="0.6"/>
                    </StackPanel>

                    <!-- Send button -->
                    <Border HorizontalAlignment="Right"
                            Width="42" Height="42"
                            Background="{ThemeResource BackgroundSurfaceInverse}"
                            BorderBrush="{ThemeResource AiAccentPurple}"
                            BorderThickness="2"
                            CornerRadius="{StaticResource RadiusControlSm}">
                        <TextBlock Text="=" FontSize="16"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>

            </StackPanel>
        </Grid>
    </Border>

</UserControl>

