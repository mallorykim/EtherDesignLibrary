<!--
    EtherDeviceMenu.xaml = Ether Design System = Device Menu (Horizontal Dock)
    =

    USAGE
      Place at the top of a content area, below the main page header.

        <local:EtherDeviceMenu/>

      Or embed the inline XAML structure below directly in your page =
      no UserControl class required for static mock=ups.

    STRUCTURE
      =
      =  =  [Laptop]  Pro Max 14 =  [Keyboard]  [Monitor]  [Mouse]  =  +  =
      =  AI  =        = device chips =              = divider = add    =
      =

      Left:  AI sparkle icon (intelligence marker)
      Middle: horizontal list of DeviceState chips (scrollable)
              Selected chip: white background card + name label
              Unselected chip: icon only, transparent
      Divider: 1 px vertical line (BackgroundDivider)
      Right:  "+" add button (40px wide)

    DEVICE STATE CHIP
      Selected:   Background BackgroundCanvas = CornerRadius 8 = px=12 py=6
                  Device image 32=32 + TextBlock (Inter SemiBold 14 px, TextPrimary)
      Unselected: Transparent = CornerRadius 8 = px=12 py=6 = icon only 32=32

    KEY MEASUREMENTS (Figma source: ursRC201v8IiVeafliI45F = node 1211:1242 + 1211:906)
      Container  805 px wide = py=8
      Chip       px=12 py=6 = CornerRadius 8 (RadiusControl)
      Icon       32=32
      Label font Inter SemiBold 14 px (selected only)
      Divider    1 px vertical = BackgroundDivider = mx=8

    TOKENS
      Selected chip bg:   BackgroundCanvas (ThemeResource)
      Unselected chip bg: Transparent
      Label fg:           TextPrimary (ThemeResource)
      Divider:            BackgroundDivider (ThemeResource)
-->
<UserControl
    x:Class="EtherSandbox.Controls.EtherDeviceMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Padding="0,8,0,8">
        <StackPanel Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">

            <!-- AI Sparkle icon -->
            <Border Width="32" Height="32"
                    CornerRadius="{StaticResource RadiusControl}"
                    Padding="12,6,12,6"
                    VerticalAlignment="Center">
                <!-- Replace with AI sparkle icon image -->
                <TextBlock Text="="
                           FontSize="14"
                           Foreground="{ThemeResource AiAccentBlue}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Device chips (scrollable row) -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="4">

                    <!-- SELECTED DEVICE CHIP (Pro Max 14) -->
                    <Border Background="{ThemeResource BackgroundCanvas}"
                            CornerRadius="{StaticResource RadiusControl}"
                            Padding="12,6,12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Image Width="32" Height="32" Stretch="Uniform"/>
                            <!--  Replace Source with device image path  -->
                            <TextBlock Text="Pro Max 14"
                                       FontFamily="{StaticResource InterFont}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- UNSELECTED DEVICE CHIP -->
                    <Border Background="Transparent"
                            CornerRadius="{StaticResource RadiusControl}"
                            Padding="12,6,12,6">
                        <Image Width="32" Height="32" Stretch="Uniform"/>
                        <!--  Replace Source with device image path  -->
                    </Border>

                    <!-- UNSELECTED DEVICE CHIP -->
                    <Border Background="Transparent"
                            CornerRadius="{StaticResource RadiusControl}"
                            Padding="12,6,12,6">
                        <Image Width="32" Height="32" Stretch="Uniform"/>
                    </Border>

                    <!-- UNSELECTED DEVICE CHIP -->
                    <Border Background="Transparent"
                            CornerRadius="{StaticResource RadiusControl}"
                            Padding="12,6,12,6">
                        <Image Width="32" Height="32" Stretch="Uniform"/>
                    </Border>

                    <!-- UNSELECTED DEVICE CHIP -->
                    <Border Background="Transparent"
                            CornerRadius="{StaticResource RadiusControl}"
                            Padding="12,6,12,6">
                        <Image Width="32" Height="32" Stretch="Uniform"/>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Divider -->
            <Border Width="1"
                    Margin="4,0,4,0"
                    Background="{ThemeResource BackgroundDivider}"
                    VerticalAlignment="Stretch"/>

            <!-- Add button ("+") -->
            <Border Width="40"
                    CornerRadius="{StaticResource RadiusControl}"
                    Padding="12,6,12,6"
                    VerticalAlignment="Center">
                <TextBlock Text="+"
                           FontSize="18" FontWeight="Normal"
                           Foreground="{ThemeResource TextSecondary}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

        </StackPanel>
    </Border>

</UserControl>

