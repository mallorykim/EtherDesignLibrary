<!--
    EtherButton.xaml = Ether Design System · Button Styles
    =======================================================

    Applied to controls:EtherButton (a Button subclass with a hand cursor + optional icon).

    USAGE
      Primary (large)   <controls:EtherButton Style="{StaticResource EtherButtonPrimary}"      Content="Save changes"/>
      Primary (small)   <controls:EtherButton Style="{StaticResource EtherButtonPrimarySmall}" Content="Save"/>
      Right icon        EtherButton.RightIcon — OPTIONAL, strongly-typed IconElement. Unset =
                        text only (the slot collapses). Set (or replace) with any FontIcon /
                        BitmapIcon / PathIcon / SymbolIcon to show a trailing icon:
                          <controls:EtherButton Style="{StaticResource EtherButtonPrimary}" Content="Next">
                              <controls:EtherButton.RightIcon>
                                  <FontIcon Glyph="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                              </controls:EtherButton.RightIcon>
                          </controls:EtherButton>
      Secondary (large) <controls:EtherButton Style="{StaticResource EtherButtonSecondary}"      Content="Cancel"/>
      Secondary (small) <controls:EtherButton Style="{StaticResource EtherButtonSecondarySmall}" Content="Cancel"/>
      Tertiary (large)  <controls:EtherButton Style="{StaticResource EtherButtonTertiary}"       Content="Learn more"/>
      Tertiary (small)  <controls:EtherButton Style="{StaticResource EtherButtonTertiarySmall}"  Content="More"/>
      Convenience form  <controls:EtherButton Variant="Primary" Size="Small" Content="Save"/>
                        (equivalent to Style="{StaticResource EtherButtonPrimarySmall}" — set
                        BOTH Variant and Size, or neither; existing Style= call sites are
                        unaffected either way)

    LOCATION
      This dictionary lives beside its class (Controls/EtherButton.cs) and is merged
      explicitly from App.xaml — see the "Mechanism refinement" note in
      docs/superpowers/plans/2026-08-06-self-contained-component-authoring-plan.md.

    VISUAL STATES
      CommonStates: Normal · PointerOver · Pressed · Disabled
      FocusStates:  Focused · Unfocused · PointerFocused

    KEY MEASUREMENTS (Figma source: ursRC201v8IiVeafliI45F · node 1210:1846)
      Primary large     min=height 44 · Padding 12,12,8,12 · font 14 · radius 4
      Primary small     min=height 32 · Padding 12,8,8,8   · font 12 · radius 4
      Secondary large   min=height 44 · Padding 12,12,8,12 · font 14 · border 2px
      Secondary small   min=height 32 · Padding 12,8,8,8   · font 12 · border 2px
      Tertiary large    auto height   · Padding 4           · font 14
      Tertiary small    auto height   · Padding 4           · font 12

    NOTE: Secondary border is 2 px ActionSecondaryBorder = components.md updated to match Figma.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls"
    xmlns:converters="using:EtherSandbox.Converters">

    <!-- Label optical-centering nudge = FontSize x this factor (see the RenderTransform
         on each label). Scales the nudge with size so large and small both centre. -->
    <converters:MultiplyConverter x:Key="LabelNudge"/>

    <!-- ===========================================================
         CONTROL TEMPLATES  (shared by large + small style pairs)
    =============================================================== -->

    <!-- PRIMARY -->
    <ControlTemplate x:Key="EtherButtonPrimaryTemplate" TargetType="controls:EtherButton">
        <Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Bg.Background" Value="{ThemeResource ActionPrimaryBgHover}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Bg.Background" Value="{ThemeResource ActionPrimaryBgPressed}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <!-- Pre-composited disabled colours (like the radio/checkbox), NOT a
                                 group opacity: fading the whole Border dims the fill AND the white
                                 label together, washing the text out. Instead the fill takes the
                                 disabled token and the label stays full-opacity white so it reads. -->
                            <Setter Target="Bg.Background" Value="{ThemeResource ActionPrimaryBgDisabled}"/>
                            <Setter Target="Bg.BorderBrush" Value="Transparent"/>
                            <Setter Target="Cp.Foreground" Value="{ThemeResource ActionPrimaryFgDisabled}"/>
                            <Setter Target="RightIcon.Foreground" Value="{ThemeResource ActionPrimaryFgDisabled}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Target="FocusRing.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Unfocused"/>
                    <VisualState x:Name="PointerFocused"/>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Border x:Name="Bg"
                    Background="{ThemeResource ActionPrimaryBg}"
                    BorderBrush="#40FFFFFF"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}"
                    Padding="{TemplateBinding Padding}">
                <StackPanel Orientation="Horizontal"
                            Spacing="{StaticResource Spacing6}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                    <TextBlock x:Name="Cp"
                                      Text="{TemplateBinding Content}"
                                      Foreground="{ThemeResource ActionPrimaryFg}"
                                      FontFamily="Inter"
                                      FontSize="{TemplateBinding FontSize}"
                                      FontWeight="{StaticResource WeightSemibold}"
                                      VerticalAlignment="Center">
                        <!-- Nudge the label down (FontSize x 0.096): XAML centers the full line
                             box (incl. descent leading), which leaves an empty descent
                             gap below no-descender text so it sits optically high.
                             RenderTransform shifts only the pixels, not layout. -->
                        <TextBlock.RenderTransform>
                            <TranslateTransform Y="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LabelNudge}, ConverterParameter=0.0962}"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <!-- Optional trailing icon slot (collapses when RightIcon is unset). -->
                    <ContentPresenter x:Name="RightIcon"
                                      Content="{TemplateBinding RightIcon}"
                                      Visibility="{TemplateBinding RightIconVisibility}"
                                      Foreground="{ThemeResource ActionPrimaryFg}"
                                      VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border x:Name="FocusRing"
                    Margin="-3"
                    BorderBrush="{ThemeResource BorderFocus}"
                    BorderThickness="2"
                    CornerRadius="5"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>
        </Grid>
    </ControlTemplate>

    <!-- SECONDARY -->
    <ControlTemplate x:Key="EtherButtonSecondaryTemplate" TargetType="controls:EtherButton">
        <Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Bg.Background" Value="{ThemeResource ActionSecondaryBgHover}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Bg.Background" Value="{ThemeResource ActionSecondaryBgPressed}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Bg.Opacity" Value="0.4"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Target="FocusRing.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Unfocused"/>
                    <VisualState x:Name="PointerFocused"/>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Border x:Name="Bg"
                    Background="{ThemeResource ActionSecondaryBg}"
                    BorderBrush="{ThemeResource ActionSecondaryBorder}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}"
                    Padding="{TemplateBinding Padding}">
                <StackPanel Orientation="Horizontal"
                            Spacing="{StaticResource Spacing6}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                    <TextBlock x:Name="Cp"
                                      Text="{TemplateBinding Content}"
                                      Foreground="{ThemeResource ActionSecondaryFg}"
                                      FontFamily="Inter"
                                      FontSize="{TemplateBinding FontSize}"
                                      FontWeight="{StaticResource WeightSemibold}"
                                      VerticalAlignment="Center">
                        <!-- Nudge the label down (FontSize x 0.096): XAML centers the full line
                             box (incl. descent leading), which leaves an empty descent
                             gap below no-descender text so it sits optically high.
                             RenderTransform shifts only the pixels, not layout. -->
                        <TextBlock.RenderTransform>
                            <TranslateTransform Y="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LabelNudge}, ConverterParameter=0.0962}"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <ContentPresenter x:Name="RightIcon"
                                      Content="{TemplateBinding RightIcon}"
                                      Visibility="{TemplateBinding RightIconVisibility}"
                                      Foreground="{ThemeResource ActionSecondaryFg}"
                                      VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border x:Name="FocusRing"
                    Margin="-3"
                    BorderBrush="{ThemeResource BorderFocus}"
                    BorderThickness="2"
                    CornerRadius="5"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>
        </Grid>
    </ControlTemplate>

    <!-- TERTIARY -->
    <ControlTemplate x:Key="EtherButtonTertiaryTemplate" TargetType="controls:EtherButton">
        <Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Cp.Foreground" Value="{ThemeResource ActionTertiaryFgHover}"/>
                            <Setter Target="RightIcon.Foreground" Value="{ThemeResource ActionTertiaryFgHover}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Cp.Foreground" Value="{ThemeResource ActionTertiaryFgPressed}"/>
                            <Setter Target="RightIcon.Foreground" Value="{ThemeResource ActionTertiaryFgPressed}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Bg.Opacity" Value="0.4"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Target="FocusRing.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Unfocused"/>
                    <VisualState x:Name="PointerFocused"/>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Border x:Name="Bg"
                    Background="Transparent"
                    CornerRadius="{StaticResource RadiusControlSm}"
                    Padding="{TemplateBinding Padding}">
                <StackPanel Orientation="Horizontal"
                            Spacing="{StaticResource Spacing6}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                    <TextBlock x:Name="Cp"
                                      Text="{TemplateBinding Content}"
                                      Foreground="{ThemeResource ActionTertiaryFg}"
                                      FontFamily="{StaticResource InstrumentSans}"
                                      FontSize="{TemplateBinding FontSize}"
                                      FontWeight="{StaticResource WeightSemibold}"
                                      VerticalAlignment="Center">
                        <!-- Nudge the label down (FontSize x 0.096): XAML centers the full line
                             box (incl. descent leading), which leaves an empty descent
                             gap below no-descender text so it sits optically high.
                             RenderTransform shifts only the pixels, not layout. -->
                        <TextBlock.RenderTransform>
                            <TranslateTransform Y="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LabelNudge}, ConverterParameter=0.0962}"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <ContentPresenter x:Name="RightIcon"
                                      Content="{TemplateBinding RightIcon}"
                                      Visibility="{TemplateBinding RightIconVisibility}"
                                      Foreground="{ThemeResource ActionTertiaryFg}"
                                      VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border x:Name="FocusRing"
                    Margin="-3"
                    BorderBrush="{ThemeResource BorderFocus}"
                    BorderThickness="2"
                    CornerRadius="5"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>
        </Grid>
    </ControlTemplate>

    <!-- ===========================================================
         STYLES
    =============================================================== -->

    <Style x:Key="EtherButtonPrimary" TargetType="controls:EtherButton">
        <Setter Property="MinHeight"                  Value="{StaticResource Spacing40}"/>
        <Setter Property="Padding"                    Value="16,10,16,10"/>
        <Setter Property="FontSize"                   Value="{StaticResource Size14}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="UseSystemFocusVisuals"      Value="False"/>
        <Setter Property="Template" Value="{StaticResource EtherButtonPrimaryTemplate}"/>
    </Style>

    <Style x:Key="EtherButtonPrimarySmall" TargetType="controls:EtherButton">
        <Setter Property="MinHeight"                  Value="{StaticResource Spacing32}"/>
        <Setter Property="Padding"                    Value="12,8,12,8"/>
        <Setter Property="FontSize"                   Value="{StaticResource Size12}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="UseSystemFocusVisuals"      Value="False"/>
        <Setter Property="Template" Value="{StaticResource EtherButtonPrimaryTemplate}"/>
    </Style>

    <Style x:Key="EtherButtonSecondary" TargetType="controls:EtherButton">
        <Setter Property="MinHeight"                  Value="{StaticResource Spacing40}"/>
        <Setter Property="Padding"                    Value="16,10,16,10"/>
        <Setter Property="FontSize"                   Value="{StaticResource Size14}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="UseSystemFocusVisuals"      Value="False"/>
        <Setter Property="Template" Value="{StaticResource EtherButtonSecondaryTemplate}"/>
    </Style>

    <Style x:Key="EtherButtonSecondarySmall" TargetType="controls:EtherButton">
        <Setter Property="MinHeight"                  Value="{StaticResource Spacing32}"/>
        <Setter Property="Padding"                    Value="12,8,12,8"/>
        <Setter Property="FontSize"                   Value="{StaticResource Size12}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="UseSystemFocusVisuals"      Value="False"/>
        <Setter Property="Template" Value="{StaticResource EtherButtonSecondaryTemplate}"/>
    </Style>

    <Style x:Key="EtherButtonTertiary" TargetType="controls:EtherButton">
        <Setter Property="Padding"                    Value="{StaticResource Padding4}"/>
        <Setter Property="FontSize"                   Value="{StaticResource Size14}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="UseSystemFocusVisuals"      Value="False"/>
        <Setter Property="Template" Value="{StaticResource EtherButtonTertiaryTemplate}"/>
    </Style>

    <Style x:Key="EtherButtonTertiarySmall" TargetType="controls:EtherButton">
        <Setter Property="Padding"                    Value="{StaticResource Padding4}"/>
        <Setter Property="FontSize"                   Value="{StaticResource Size12}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="UseSystemFocusVisuals"      Value="False"/>
        <Setter Property="Template" Value="{StaticResource EtherButtonTertiaryTemplate}"/>
    </Style>

</ResourceDictionary>
