<!--
    Ether Design System Steering Bar

    A draggable slider-like control with a rounded track, gradient progress fill,
    glass thumb, and optional title/value labels. Supports continuous dragging or
    custom stops with snapping.

    Colours are literal hex per the spec (this component is not wired to the
    EtherColors token set), consistent with the other spec-sheet components.

    Implicit style: this dictionary is merged from Generic.xaml, and any
    EtherSteeringBar automatically picks up this template with no Style= at the
    call site.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls">

    <SolidColorBrush x:Key="StopMarkerActiveBrush" Color="#D9FFFFFF"/>
    <SolidColorBrush x:Key="StopMarkerInactiveBrush" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="StopMarkerDisabledActiveBrush" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="StopMarkerDisabledInactiveBrush" Color="#33FFFFFF"/>

    <Style TargetType="controls:EtherSteeringBar">
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="UseSystemFocusVisuals" Value="False"/>
        <Setter Property="AutomationProperties.Name" Value="Steering Bar"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:EtherSteeringBar">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="LabelRow" Margin="0,0,0,8">
                            <ContentPresenter x:Name="TitleText"
                                              HorizontalAlignment="Left"
                                              FontFamily="{StaticResource InstrumentSans}"
                                              FontSize="14"
                                              FontWeight="SemiBold"
                                              Foreground="{ThemeResource TextPrimary}"/>
                            <ContentPresenter x:Name="ValueLabel"
                                              HorizontalAlignment="Right"
                                              FontFamily="{StaticResource InstrumentSans}"
                                              FontSize="14"
                                              FontWeight="SemiBold"
                                              Foreground="{ThemeResource TextSecondary}"/>
                        </Grid>

                        <Grid x:Name="InteractionSurface"
                              Grid.Row="1"
                              Height="15"
                              Background="Transparent">
                            <Border x:Name="TrackBackground"
                                    Height="4"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource BackgroundTrack}"
                                    CornerRadius="2"/>

                            <Border x:Name="FillBorder"
                                    Width="0"
                                    Height="4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    CornerRadius="2"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#0021F3" Offset="0.00"/>
                                        <GradientStop Color="#0015FF" Offset="0.33"/>
                                        <GradientStop Color="#0EB2FF" Offset="0.67"/>
                                        <GradientStop Color="#40E1FD" Offset="1.00"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Canvas x:Name="StopMarkersHost"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    IsHitTestVisible="False"/>

                            <Grid x:Name="ThumbHost"
                                  Width="21"
                                  Height="13"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Margin="0,1,0,0"
                                  IsHitTestVisible="False">
                                <Border x:Name="ShadowFar"
                                        Margin="-2,0,-2,-2"
                                        CornerRadius="5"
                                        Background="#06000000"
                                        Translation="0,2,0"/>
                                <Border x:Name="ShadowNear"
                                        Margin="0,0,0,-1"
                                        CornerRadius="3.5"
                                        Background="#0D000000"
                                        Translation="0,0.8,0"/>

                                <Border x:Name="ThumbBorder"
                                        BorderBrush="#BFC7D0D8"
                                        BorderThickness="0.5"
                                        CornerRadius="3">
                                    <Border x:Name="ThumbFill"
                                            CornerRadius="3">
                                        <Grid>
                                            <Border CornerRadius="3">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#FFFDFEFF" Offset="0.00"/>
                                                        <GradientStop Color="#FFF8FDFF" Offset="0.42"/>
                                                        <GradientStop Color="#FFF2F7F9" Offset="1.00"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="0.5"
                                                    CornerRadius="2.4">
                                                <Border.Background>
                                                    <RadialGradientBrush Center="0.32,0.14" RadiusX="1.0" RadiusY="0.85">
                                                        <GradientStop Color="#7AFFFFFF" Offset="0.00"/>
                                                        <GradientStop Color="#24E7F8FF" Offset="0.58"/>
                                                        <GradientStop Color="#00FFFFFF" Offset="1.00"/>
                                                    </RadialGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="1.8,1.6,1.8,4.6"
                                                    CornerRadius="5.5"
                                                    Opacity="0.9">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                        <GradientStop Color="#00BFEFFF" Offset="0.00"/>
                                                        <GradientStop Color="#AA82ECFF" Offset="0.52"/>
                                                        <GradientStop Color="#00BFEFFF" Offset="1.00"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="0.7,0.7,0.7,0"
                                                    VerticalAlignment="Top"
                                                    Height="1.8"
                                                    CornerRadius="1"
                                                    Background="#5AFFFFFF"
                                                    IsHitTestVisible="False"/>
                                        </Grid>
                                    </Border>
                                </Border>

                                <Border x:Name="ThumbDisabledShell"
                                        BorderBrush="#BFC7D0D8"
                                        BorderThickness="0.5"
                                        CornerRadius="3"
                                        Opacity="0"
                                        IsHitTestVisible="False">
                                    <Border Background="#FFFFFFFF"
                                            CornerRadius="3"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
