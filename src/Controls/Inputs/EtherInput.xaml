<!--
    Ether Design System InputContainer (single-line text field)

    Figma source: ursRC201v8IiVeafliI45F, node 60582:847 (spec-sheet-input-container)

    SPEC (literal per the spec sheet — this component is not wired to the
    EtherColors token set, mirroring EtherCheckbox):
                     Default        Hover          Active(focus)  Filled     Disabled
      Fill           C0C8CD 40%     C0C8CD 60%     C0C8CD 40%     40%        40%
      Border         #000000 30%    #000000 30%    #196FFF 100%   30%        30%
      Border weight  1px            1px            1px            1px        1px
      Text           #000000        #000000        #000000        #000000    #000000
      Font           Inter Regular 14 (all states)
      Corner radius  8px            Padding 16px   Opacity 100%              50%

    STATE MAPPING (WinUI TextBox drives these state names itself):
      Normal      -> Default / Filled (Filled has no distinct treatment; it is
                     just the field carrying text)
      PointerOver -> Hover  (fill darkens 40% -> 60%; border unchanged)
      Focused     -> Active (fill returns to 40%; border turns brand blue)
      Disabled    -> whole control at 50% opacity. Safe as a single element
                     opacity here: fill and border sit on ONE Border, so there
                     is no separate-visual compositing artifact (cf. the
                     EtherCheckbox disabled note, which had a glyph over a fill).

    Alpha hex (from EtherColors header): 30%=0x4D  40%=0x66  50%=0x80  60%=0x99

    LOCATION
      This dictionary lives beside its class (Controls/EtherInput.cs) and is merged
      explicitly from App.xaml. See the "Mechanism refinement" note in
      docs/superpowers/plans/2026-08-06-self-contained-component-authoring-plan.md.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="InputFillDefault" Color="#66C0C8CD"/>
            <SolidColorBrush x:Key="InputFillHover"   Color="#99C0C8CD"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="InputFillDefault" Color="#40FFFFFF"/>
            <SolidColorBrush x:Key="InputFillHover"   Color="#66FFFFFF"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="InputFillDefault" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="InputFillHover"   Color="{ThemeResource SystemColorButtonFaceColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <ControlTemplate x:Key="EtherInputTemplate" TargetType="controls:EtherInput">
        <Grid x:Name="LayoutRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition From="Normal" To="PointerOver" GeneratedDuration="0:0:0.12"/>
                        <VisualTransition From="PointerOver" To="Normal" GeneratedDuration="0:0:0.12"/>
                    </VisualStateGroup.Transitions>

                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Target="BorderElement.Background" Value="{ThemeResource InputFillDefault}"/>
                            <Setter Target="BorderElement.BorderBrush" Value="{ThemeResource BorderDefault}"/>
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <!-- Hover: fill 40% -> 60%; border stays black 30%. -->
                            <Setter Target="BorderElement.Background" Value="{ThemeResource InputFillHover}"/>
                            <Setter Target="BorderElement.BorderBrush" Value="{ThemeResource BorderDefault}"/>
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <!-- Active: fill returns to 40%; border turns brand blue. -->
                            <Setter Target="BorderElement.Background" Value="{ThemeResource InputFillDefault}"/>
                            <Setter Target="BorderElement.BorderBrush" Value="{ThemeResource border/focus}"/>
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <!-- Whole control at 50%; fill/border keep their default brushes. -->
                            <Setter Target="LayoutRoot.Opacity" Value="0.5"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- Single Border carries both the fill and the 1px stroke. -->
            <Border x:Name="BorderElement"
                    Grid.Row="1"
                    Background="{ThemeResource InputFillDefault}"
                    BorderBrush="{ThemeResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource radius/control}"
                    Control.IsTemplateFocusTarget="True"/>

            <!-- Placeholder sits behind the editable text; TextBox toggles its visibility. -->
            <ContentControl x:Name="PlaceholderTextContentPresenter"
                            Grid.Row="1"
                            Content="{TemplateBinding PlaceholderText}"
                            Foreground="{ThemeResource TextTertiary}"
                            FontFamily="{StaticResource InterFont}"
                            FontSize="{StaticResource Size14}"
                            IsHitTestVisible="False"
                            IsTabStop="False"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Center"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"/>

            <!-- Required part: hosts the editable text. -->
            <ScrollViewer x:Name="ContentElement"
                          Grid.Row="1"
                          Padding="{TemplateBinding Padding}"
                          HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                          VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                          IsHorizontalRailEnabled="{TemplateBinding ScrollViewer.IsHorizontalRailEnabled}"
                          IsVerticalRailEnabled="{TemplateBinding ScrollViewer.IsVerticalRailEnabled}"
                          IsDeferredScrollingEnabled="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                          AutomationProperties.AccessibilityView="Raw"
                          ZoomMode="Disabled"
                          IsTabStop="False"/>
        </Grid>
    </ControlTemplate>

    <Style TargetType="controls:EtherInput">
        <Setter Property="Foreground" Value="{ThemeResource text/primary}"/>
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource action/primary/bg}"/>
        <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
        <Setter Property="FontSize" Value="{StaticResource Size14}"/>
        <Setter Property="FontWeight" Value="{StaticResource WeightRegular}"/>
        <Setter Property="Padding" Value="{StaticResource PaddingMd}"/>
        <Setter Property="MinWidth" Value="{StaticResource Spacing0}"/>
        <Setter Property="MinHeight" Value="{StaticResource Spacing0}"/>
        <Setter Property="UseSystemFocusVisuals" Value="False"/>
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Auto"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="Template" Value="{StaticResource EtherInputTemplate}"/>
    </Style>

</ResourceDictionary>
