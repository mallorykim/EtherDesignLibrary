<!--
    EtherSegmentedControl.xaml - Ether Design System · Segmented Control
    ═══════════════════════════════════════════════════════════════════════

    USAGE
      Paste the ContentControl + RadioButton block below directly into your page XAML.
      The three segments use RadioButton with a shared GroupName so only one
      is selected at a time.  No code-behind required for selection logic.

        <ContentControl Style="{StaticResource EtherSegmentedTrack}">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource EtherSegment}" GroupName="MyCtrl"
                             Content="Overview"  IsChecked="True"/>
                <RadioButton Style="{StaticResource EtherSegment}" GroupName="MyCtrl"
                             Content="Details"/>
                <RadioButton Style="{StaticResource EtherSegment}" GroupName="MyCtrl"
                             Content="History"/>
            </StackPanel>
        </ContentControl>

    EVENTS
      Bind each RadioButton.Checked to a handler or use x:Bind to a ViewModel bool.

    KEY MEASUREMENTS (Figma source: ursRC201v8IiVeafliI45F · node 60340:7245)
      Track     padding 4 · CornerRadius 8 · BackgroundSegmentTrack
                soft blue shadow (Figma node 1210:1463)
      Segment   px=16 py=10 · CornerRadius 4 · min-height 40
                selected: BackgroundBrand · TextOnBrand
                hover: BackgroundSegmentHover (brand @ 6%)
                pressed: BackgroundSegmentPressed (brand @ 10%)
      Font      Instrument Sans SemiBold 12 px, centred

    TOKENS
      Track bg:   BackgroundSegmentTrack
      Segment bg: BackgroundBrand (selected) / transparent (default)
      Text:       TextOnBrand (selected) / TextSecondary (unselected)
      Radius:     radius/control (8) for track · radius/control-sm (4) for segment pill

    LOCATION
      This dictionary lives beside its class (Controls/EtherSegmentedTrack.cs) and is merged
      explicitly from App.xaml. See the "Mechanism refinement" note in
      docs/superpowers/plans/2026-08-06-self-contained-component-authoring-plan.md.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls">

    <!-- Track container style -->
    <ControlTemplate x:Key="EtherSegmentedTrackTemplate" TargetType="controls:EtherSegmentedControl">
        <Grid>
            <!-- Composition shadows are rendered behind this surface by EtherSegmentedTrack. -->
            <!-- Reserve vertical layout space for the 18px blur / 12px offset. -->
            <Canvas x:Name="ShadowHost" IsHitTestVisible="False"/>
            <Border x:Name="TrackSurface"
                    Margin="0,8,0,30"
                    Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="{StaticResource radius/control}">
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
        </Grid>
    </ControlTemplate>

    <Style x:Key="EtherSegmentedTrack" TargetType="controls:EtherSegmentedControl">
        <Setter Property="Padding"       Value="{StaticResource Padding4}"/>
        <Setter Property="Background"    Value="{ThemeResource BackgroundSegmentTrack}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="Template" Value="{StaticResource EtherSegmentedTrackTemplate}"/>
    </Style>

    <!-- Individual segment (RadioButton)

         State backgrounds are separate LAYERS (hover / pressed / checked), each carrying its
         own {ThemeResource} fill, and the visual states toggle only their Opacity. This is
         deliberate: a VisualState.Setter whose *value* is a {ThemeResource} brush does NOT
         revert reliably on state exit (the hover/pressed background sticks — verified via a
         pointer-event log showing PointerExited firing yet the fill remaining). Opacity is a
         plain double and reverts cleanly, so the fill clears the moment the pointer leaves. -->
    <ControlTemplate x:Key="EtherSegmentTemplate" TargetType="RadioButton">
        <Grid HorizontalAlignment="Stretch">
            <VisualStateManager.VisualStateGroups>
                <!-- Background layers (HoverLayer/PressedLayer/CheckedLayer) are driven directly
                     from code in HandRadioButton.UpdateSegmentVisual — NOT from these states —
                     because the VSM leaves layer opacity stuck after the pointer leaves. Only the
                     checked TEXT colour and the disabled dim stay here (those revert fine). -->
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver"/>
                    <VisualState x:Name="Pressed"/>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Bg.Opacity" Value="0.4"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Checked">
                        <VisualState.Setters>
                            <Setter Target="Cp.Foreground" Value="{ThemeResource text/on-brand}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedPointerOver">
                        <VisualState.Setters>
                            <Setter Target="Cp.Foreground" Value="{ThemeResource text/on-brand}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedPressed">
                        <VisualState.Setters>
                            <Setter Target="Cp.Foreground" Value="{ThemeResource text/on-brand}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Indeterminate"/>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Target="FocusRing.Opacity" Value="1"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Unfocused"/>
                    <VisualState x:Name="PointerFocused"/>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- Background state layers (behind the text). Opacity toggled by the states above. -->
            <Border x:Name="HoverLayer"
                    Background="{ThemeResource BackgroundSegmentHover}"
                    CornerRadius="{StaticResource radius/control-sm}"
                    Opacity="0"/>
            <Border x:Name="PressedLayer"
                    Background="{ThemeResource BackgroundSegmentPressed}"
                    CornerRadius="{StaticResource radius/control-sm}"
                    Opacity="0"/>
            <Border x:Name="CheckedLayer"
                    Background="{ThemeResource background/brand}"
                    CornerRadius="{StaticResource radius/control-sm}"
                    Opacity="0"/>

            <Border x:Name="Bg"
                    Background="Transparent"
                    CornerRadius="{StaticResource radius/control-sm}"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter x:Name="Cp"
                                  Content="{TemplateBinding Content}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextSecondary}"
                                  FontFamily="{StaticResource InstrumentSans}"
                                  FontSize="{StaticResource Size12}"
                                  FontWeight="{StaticResource WeightSemibold}"/>
            </Border>

            <Border x:Name="FocusRing"
                    Margin="-3"
                    BorderBrush="{ThemeResource border/focus}"
                    BorderThickness="2"
                    CornerRadius="{StaticResource RadiusSm}"
                    IsHitTestVisible="False"
                    Opacity="0"/>
        </Grid>
    </ControlTemplate>

    <Style x:Key="EtherSegment" TargetType="RadioButton">
        <Setter Property="Padding"                    Value="16,10"/>
        <Setter Property="MinHeight"                  Value="{StaticResource Spacing40}"/>
        <Setter Property="HorizontalAlignment"        Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="UseSystemFocusVisuals"      Value="False"/>
        <Setter Property="Template" Value="{StaticResource EtherSegmentTemplate}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         READY-TO-USE EXAMPLE STRUCTURE
         Copy this block into your page and replace Content values.
         Wrap in a Grid column or StackPanel as needed.

         <ContentControl Style="{StaticResource EtherSegmentedTrack}" Width="330">
             <StackPanel Orientation="Horizontal">
                 <RadioButton Style="{StaticResource EtherSegment}" GroupName="Seg1"
                              Content="Overview" IsChecked="True" HorizontalAlignment="Stretch"/>
                 <RadioButton Style="{StaticResource EtherSegment}" GroupName="Seg1"
                              Content="Details" HorizontalAlignment="Stretch"/>
                 <RadioButton Style="{StaticResource EtherSegment}" GroupName="Seg1"
                              Content="History" HorizontalAlignment="Stretch"/>
             </StackPanel>
         </ContentControl>
    ═══════════════════════════════════════════════════════════════ -->

</ResourceDictionary>
