<!--
    Ether Design System Checkbox

    Figma source: ursRC201v8IiVeafliI45F, node 60598:1105 (spec-sheet-checkbox)
    Box 18 x 18, corner radius 4, 1.5 px stroke. Label is Inter SemiBold 12 with
    an 8 px gap. Checkmark is a near-white (#F5F6F7) tick, shown only when checked.
    No indeterminate state (IsThreeState = False).

    STATES
      Unchecked: Default / Hover / Pressed / Disabled
      Checked:   Default / Hover / Disabled        (no distinct pressed in the spec)
      Disabled reads as the control at 40 % (see the disabled-brush note below).

    Colours are literal hex per the spec (this component is not wired to the
    EtherColors token set). Fill depends on BOTH check-ness and pointer state,
    which live in two separate visual-state groups (CommonStates, CheckStates).
    To avoid those groups fighting over one property, each owns a different one:
      - CommonStates writes Background on TWO different borders (UncheckedBox and
        CheckedFace) — the four pointer fills for each.
      - CheckStates writes only Visibility (which of the two borders shows).
    No property is written by both groups, so there is no ordering race.

    LOCATION
      This dictionary lives beside its class (Controls/EtherCheckbox.cs) and is
      merged explicitly from App.xaml. See the "Mechanism refinement" note in
      docs/superpowers/plans/2026-08-06-self-contained-component-authoring-plan.md.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="CheckboxFillDefault"  Color="#66F5F7F8"/>
            <SolidColorBrush x:Key="CheckboxFillHover"    Color="#E6F5F7F8"/>
            <SolidColorBrush x:Key="CheckboxFillPressed"  Color="#338B96A1"/>
            <SolidColorBrush x:Key="CheckboxStroke"       Color="#FF8B96A1"/>
            <SolidColorBrush x:Key="CheckboxCheckedFillDefault" Color="#FF196FFF"/>
            <SolidColorBrush x:Key="CheckboxCheckedFillHover"   Color="#FF0D62FF"/>
            <SolidColorBrush x:Key="CheckboxCheckedStroke"      Color="#FF196FFF"/>
            <SolidColorBrush x:Key="CheckboxGlyph"              Color="#FFF5F6F7"/>
            <SolidColorBrush x:Key="CheckboxLabel"              Color="#B3000000"/>
            <SolidColorBrush x:Key="CheckboxDisabledUncheckedFill"   Color="#FDFEFE"/>
            <SolidColorBrush x:Key="CheckboxDisabledUncheckedStroke" Color="#D0D5D9"/>
            <SolidColorBrush x:Key="CheckboxDisabledCheckedFill"     Color="#A3C5FF"/>
            <SolidColorBrush x:Key="CheckboxDisabledGlyph"           Color="#FBFBFC"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="CheckboxFillDefault"  Color="#1AFFFFFF"/>
            <SolidColorBrush x:Key="CheckboxFillHover"    Color="#33FFFFFF"/>
            <SolidColorBrush x:Key="CheckboxFillPressed"  Color="#29FFFFFF"/>
            <SolidColorBrush x:Key="CheckboxStroke"       Color="#FF8B96A1"/>
            <SolidColorBrush x:Key="CheckboxCheckedFillDefault" Color="#FF196FFF"/>
            <SolidColorBrush x:Key="CheckboxCheckedFillHover"   Color="#FF0D62FF"/>
            <SolidColorBrush x:Key="CheckboxCheckedStroke"      Color="#FF196FFF"/>
            <SolidColorBrush x:Key="CheckboxGlyph"              Color="#FFF5F6F7"/>
            <SolidColorBrush x:Key="CheckboxLabel"              Color="#B3FFFFFF"/>
            <SolidColorBrush x:Key="CheckboxDisabledUncheckedFill"   Color="#FF1E2025"/>
            <SolidColorBrush x:Key="CheckboxDisabledUncheckedStroke" Color="#FF525B66"/>
            <SolidColorBrush x:Key="CheckboxDisabledCheckedFill"     Color="#FF355CA8"/>
            <SolidColorBrush x:Key="CheckboxDisabledGlyph"           Color="#FFF5F6F7"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="CheckboxFillDefault"  Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="CheckboxFillHover"    Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="CheckboxFillPressed"  Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="CheckboxStroke"       Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="CheckboxCheckedFillDefault" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="CheckboxCheckedFillHover"   Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="CheckboxCheckedStroke"      Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="CheckboxGlyph"              Color="{ThemeResource SystemColorHighlightTextColor}"/>
            <SolidColorBrush x:Key="CheckboxLabel"              Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="CheckboxDisabledUncheckedFill"   Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="CheckboxDisabledUncheckedStroke" Color="{ThemeResource SystemColorGrayTextColor}"/>
            <SolidColorBrush x:Key="CheckboxDisabledCheckedFill"     Color="{ThemeResource SystemColorGrayTextColor}"/>
            <SolidColorBrush x:Key="CheckboxDisabledGlyph"           Color="{ThemeResource SystemColorButtonFaceColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <ControlTemplate x:Key="EtherCheckboxTemplate" TargetType="controls:EtherCheckbox">
        <Grid x:Name="LayoutRoot" Background="Transparent">
            <VisualStateManager.VisualStateGroups>

                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition From="Normal" To="PointerOver" GeneratedDuration="0:0:0.12"/>
                        <VisualTransition From="PointerOver" To="Normal" GeneratedDuration="0:0:0.12"/>
                        <VisualTransition To="Pressed" GeneratedDuration="0:0:0.08"/>
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Target="UncheckedFill.Background" Value="{ThemeResource CheckboxFillDefault}"/>
                            <Setter Target="CheckedFill.Background" Value="{ThemeResource CheckboxCheckedFillDefault}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="UncheckedFill.Background" Value="{ThemeResource CheckboxFillHover}"/>
                            <Setter Target="CheckedFill.Background" Value="{ThemeResource CheckboxCheckedFillHover}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="UncheckedFill.Background" Value="{ThemeResource CheckboxFillPressed}"/>
                            <!-- The spec has no distinct checked-pressed; keep the default blue. -->
                            <Setter Target="CheckedFill.Background" Value="{ThemeResource CheckboxCheckedFillDefault}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <!-- Solid pre-composited colours instead of a group opacity (see the
                                 disabled-brush note above). CheckStates still picks which face
                                 shows; both faces' disabled colours are set here so either is ready.
                                 Checked stroke is set to the disabled fill so the rim stays uniform.
                                 Only the label fades by opacity — it has nothing overlapping it. -->
                            <Setter Target="UncheckedFill.Background" Value="{ThemeResource CheckboxDisabledUncheckedFill}"/>
                            <Setter Target="UncheckedStroke.BorderBrush" Value="{ThemeResource CheckboxDisabledUncheckedStroke}"/>
                            <Setter Target="CheckedFill.Background" Value="{ThemeResource CheckboxDisabledCheckedFill}"/>
                            <Setter Target="CheckedStroke.BorderBrush" Value="{ThemeResource CheckboxDisabledCheckedFill}"/>
                            <Setter Target="Glyph.Stroke" Value="{ThemeResource CheckboxDisabledGlyph}"/>
                            <Setter Target="Label.Opacity" Value="0.4"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>

                <VisualStateGroup x:Name="CheckStates">
                    <VisualState x:Name="Unchecked">
                        <VisualState.Setters>
                            <Setter Target="UncheckedFace.Visibility" Value="Visible"/>
                            <Setter Target="CheckedFace.Visibility" Value="Collapsed"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Checked">
                        <VisualState.Setters>
                            <Setter Target="UncheckedFace.Visibility" Value="Collapsed"/>
                            <Setter Target="CheckedFace.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                    <!-- Indeterminate intentionally unstyled: IsThreeState is False. -->
                </VisualStateGroup>

                <!-- No FocusStates group: the spec defines no focus treatment, and a ring set
                     3 px outside the box left a white page-gap between the box and the ring
                     that read as an unwanted white halo. UseSystemFocusVisuals stays False. -->

            </VisualStateManager.VisualStateGroups>

            <!-- HandContentControl sets a hand cursor over the whole clickable area. It only
                 affects hit-testable instances: the showcase specimens (IsHitTestVisible=False)
                 never receive pointer input, so they keep the arrow. -->
            <controls:HandContentControl HorizontalContentAlignment="Left"
                                         VerticalContentAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing8}" VerticalAlignment="Center">
                <Grid Width="18" Height="18">
                    <!--
                        Each face is a solid fill rect with the stroke as a SEPARATE
                        transparent-background ring on top — never one Border carrying both a
                        Background and a BorderBrush. That single-Border form clips the fill to
                        the inner radius (outer radius minus 1.5 px border) and, at fractional
                        DPI, leaves a hairline seam at the rounded corners that shows the white
                        page through — the white ring. Here the ring's only backdrop is the
                        fill beneath it, so any corner seam reveals the fill colour, not white.
                    -->
                    <!-- Unchecked face: translucent fill under a grey stroke ring. -->
                    <Grid x:Name="UncheckedFace">
                        <Border x:Name="UncheckedFill"
                                Background="{ThemeResource CheckboxFillDefault}"
                                CornerRadius="{StaticResource RadiusControlSm}"/>
                        <Border x:Name="UncheckedStroke"
                                Background="Transparent"
                                BorderBrush="{ThemeResource CheckboxStroke}"
                                BorderThickness="1.5"
                                CornerRadius="{StaticResource RadiusControlSm}"
                                IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Checked face: brand-blue fill under a blue stroke ring, carrying the tick. -->
                    <Grid x:Name="CheckedFace" Visibility="Collapsed">
                        <Border x:Name="CheckedFill"
                                Background="{ThemeResource CheckboxCheckedFillDefault}"
                                CornerRadius="{StaticResource RadiusControlSm}"/>
                        <Border x:Name="CheckedStroke"
                                Background="Transparent"
                                BorderBrush="{ThemeResource CheckboxCheckedStroke}"
                                BorderThickness="1.5"
                                CornerRadius="{StaticResource RadiusControlSm}"
                                IsHitTestVisible="False"/>
                        <Viewbox Width="11" Height="11"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="Glyph"
                                  Stroke="{ThemeResource CheckboxGlyph}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M1.5,5.5 L4.5,8.5 L9.5,2.5"/>
                        </Viewbox>
                    </Grid>
                </Grid>

                <ContentPresenter x:Name="Label"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Foreground="{ThemeResource CheckboxLabel}"
                                  FontFamily="{StaticResource InterFont}"
                                  FontSize="{StaticResource Size12}"
                                  FontWeight="{StaticResource WeightSemibold}"
                                  VerticalAlignment="Center"/>
            </StackPanel>
            </controls:HandContentControl>
        </Grid>
    </ControlTemplate>

    <Style TargetType="controls:EtherCheckbox">
        <Setter Property="IsThreeState" Value="False"/>
        <Setter Property="UseSystemFocusVisuals" Value="False"/>
        <Setter Property="MinWidth" Value="{StaticResource Spacing0}"/>
        <Setter Property="MinHeight" Value="{StaticResource Spacing0}"/>
        <Setter Property="Padding" Value="{StaticResource Padding0}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource EtherCheckboxTemplate}"/>
    </Style>

</ResourceDictionary>
