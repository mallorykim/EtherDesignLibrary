<!--
    Ether Design System Checkbox

    Figma source: ursRC201v8IiVeafliI45F, node 60598:1105 (spec-sheet-checkbox)
    Box 18 x 18, corner radius 4, 1.5 px stroke. Label is Inter SemiBold 12 with
    an 8 px gap. Checkmark is a near-white (#F5F6F7) tick, shown only when checked.
    No indeterminate state (IsThreeState = False via DefaultEtherCheckboxStyle).

    STATES
      Unchecked: Default / Hover / Pressed / Disabled
      Checked:   Default / Hover / Disabled        (no distinct pressed in the spec)
      Disabled reads as the control at 40 % (see the disabled-brush note below).

    Colours live in EtherCheckbox* component theme dictionaries (Light/Dark keep the
    previous literal hex; High Contrast uses Windows SystemColor*). Fill depends on
    BOTH check-ness and pointer state, which live in two separate visual-state groups
    (CommonStates, CheckStates). To avoid those groups fighting over one property,
    each owns a different one:
      - CommonStates writes Background on TWO different borders (UncheckedBox and
        CheckedFace) — the four pointer fills for each.
      - CheckStates writes only Visibility (which of the two borders shows).
    No property is written by both groups, so there is no ordering race.

    LOCATION
      This dictionary lives beside its class (Controls/EtherCheckbox.cs) and is
      merged explicitly from App.xaml. See the "Mechanism refinement" note in
      docs/superpowers/plans/2026-08-06-self-contained-component-authoring-plan.md.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="EtherCheckboxFillDefaultBrush"  Color="#66F5F7F8"/>
            <SolidColorBrush x:Key="EtherCheckboxFillHoverBrush"    Color="#E6F5F7F8"/>
            <SolidColorBrush x:Key="EtherCheckboxFillPressedBrush"  Color="#338B96A1"/>
            <SolidColorBrush x:Key="EtherCheckboxStrokeBrush"       Color="#FF8B96A1"/>
            <SolidColorBrush x:Key="EtherCheckboxCheckedFillDefaultBrush" Color="#FF196FFF"/>
            <SolidColorBrush x:Key="EtherCheckboxCheckedFillHoverBrush"   Color="#FF0D62FF"/>
            <SolidColorBrush x:Key="EtherCheckboxCheckedStrokeBrush"      Color="#FF196FFF"/>
            <SolidColorBrush x:Key="EtherCheckboxGlyphBrush"              Color="#FFF5F6F7"/>
            <SolidColorBrush x:Key="EtherCheckboxLabelBrush"              Color="#B3000000"/>
            <SolidColorBrush x:Key="EtherCheckboxDisabledUncheckedFillBrush"   Color="#FDFEFE"/>
            <SolidColorBrush x:Key="EtherCheckboxDisabledUncheckedStrokeBrush" Color="#D0D5D9"/>
            <SolidColorBrush x:Key="EtherCheckboxDisabledCheckedFillBrush"     Color="#A3C5FF"/>
            <SolidColorBrush x:Key="EtherCheckboxDisabledGlyphBrush"           Color="#FBFBFC"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="EtherCheckboxFillDefaultBrush"  Color="#1AFFFFFF"/>
            <SolidColorBrush x:Key="EtherCheckboxFillHoverBrush"    Color="#33FFFFFF"/>
            <SolidColorBrush x:Key="EtherCheckboxFillPressedBrush"  Color="#29FFFFFF"/>
            <SolidColorBrush x:Key="EtherCheckboxStrokeBrush"       Color="#FF8B96A1"/>
            <SolidColorBrush x:Key="EtherCheckboxCheckedFillDefaultBrush" Color="#FF196FFF"/>
            <SolidColorBrush x:Key="EtherCheckboxCheckedFillHoverBrush"   Color="#FF0D62FF"/>
            <SolidColorBrush x:Key="EtherCheckboxCheckedStrokeBrush"      Color="#FF196FFF"/>
            <SolidColorBrush x:Key="EtherCheckboxGlyphBrush"              Color="#FFF5F6F7"/>
            <SolidColorBrush x:Key="EtherCheckboxLabelBrush"              Color="#B3FFFFFF"/>
            <SolidColorBrush x:Key="EtherCheckboxDisabledUncheckedFillBrush"   Color="#FF1E2025"/>
            <SolidColorBrush x:Key="EtherCheckboxDisabledUncheckedStrokeBrush" Color="#FF525B66"/>
            <SolidColorBrush x:Key="EtherCheckboxDisabledCheckedFillBrush"     Color="#FF355CA8"/>
            <SolidColorBrush x:Key="EtherCheckboxDisabledGlyphBrush"           Color="#FFF5F6F7"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="EtherCheckboxFillDefaultBrush"  Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="EtherCheckboxFillHoverBrush"    Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="EtherCheckboxFillPressedBrush"  Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="EtherCheckboxStrokeBrush"       Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="EtherCheckboxCheckedFillDefaultBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherCheckboxCheckedFillHoverBrush"   Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherCheckboxCheckedStrokeBrush"      Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="EtherCheckboxGlyphBrush"              Color="{ThemeResource SystemColorHighlightTextColor}"/>
            <SolidColorBrush x:Key="EtherCheckboxLabelBrush"              Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="EtherCheckboxDisabledUncheckedFillBrush"   Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="EtherCheckboxDisabledUncheckedStrokeBrush" Color="{ThemeResource SystemColorGrayTextColor}"/>
            <SolidColorBrush x:Key="EtherCheckboxDisabledCheckedFillBrush"     Color="{ThemeResource SystemColorGrayTextColor}"/>
            <SolidColorBrush x:Key="EtherCheckboxDisabledGlyphBrush"           Color="{ThemeResource SystemColorButtonFaceColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Structural overlay fill: not themed, so High Contrast can keep SystemColor-only
         theme keys while the stroke ring still reveals the face beneath it. -->
    <SolidColorBrush x:Key="EtherCheckboxTransparentBrush" Color="Transparent"/>

    <ControlTemplate x:Key="EtherCheckboxTemplate" TargetType="controls:EtherCheckbox">
        <Grid x:Name="LayoutRoot" Background="{StaticResource EtherCheckboxTransparentBrush}">
            <VisualStateManager.VisualStateGroups>

                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition From="Normal" To="PointerOver" GeneratedDuration="0:0:0.12"/>
                        <VisualTransition From="PointerOver" To="Normal" GeneratedDuration="0:0:0.12"/>
                        <VisualTransition To="Pressed" GeneratedDuration="0:0:0.08"/>
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Target="UncheckedFill.Background" Value="{ThemeResource EtherCheckboxFillDefaultBrush}"/>
                            <Setter Target="CheckedFill.Background" Value="{ThemeResource EtherCheckboxCheckedFillDefaultBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="UncheckedFill.Background" Value="{ThemeResource EtherCheckboxFillHoverBrush}"/>
                            <Setter Target="CheckedFill.Background" Value="{ThemeResource EtherCheckboxCheckedFillHoverBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="UncheckedFill.Background" Value="{ThemeResource EtherCheckboxFillPressedBrush}"/>
                            <!-- The spec has no distinct checked-pressed; keep the default blue. -->
                            <Setter Target="CheckedFill.Background" Value="{ThemeResource EtherCheckboxCheckedFillDefaultBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <!-- Solid pre-composited colours instead of a group opacity (see the
                                 disabled-brush note above). CheckStates still picks which face
                                 shows; both faces' disabled colours are set here so either is ready.
                                 Checked stroke is set to the disabled fill so the rim stays uniform.
                                 Only the label fades by opacity — it has nothing overlapping it. -->
                            <Setter Target="UncheckedFill.Background" Value="{ThemeResource EtherCheckboxDisabledUncheckedFillBrush}"/>
                            <Setter Target="UncheckedStroke.BorderBrush" Value="{ThemeResource EtherCheckboxDisabledUncheckedStrokeBrush}"/>
                            <Setter Target="CheckedFill.Background" Value="{ThemeResource EtherCheckboxDisabledCheckedFillBrush}"/>
                            <Setter Target="CheckedStroke.BorderBrush" Value="{ThemeResource EtherCheckboxDisabledCheckedFillBrush}"/>
                            <Setter Target="Glyph.Stroke" Value="{ThemeResource EtherCheckboxDisabledGlyphBrush}"/>
                            <Setter Target="Label.Opacity" Value="0.4"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>

                <VisualStateGroup x:Name="CheckStates">
                    <VisualState x:Name="Unchecked">
                        <VisualState.Setters>
                            <Setter Target="UncheckedFace.Visibility" Value="Visible"/>
                            <Setter Target="CheckedFace.Visibility" Value="Collapsed"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Checked">
                        <VisualState.Setters>
                            <Setter Target="UncheckedFace.Visibility" Value="Collapsed"/>
                            <Setter Target="CheckedFace.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                    <!-- Indeterminate intentionally unstyled: IsThreeState is False. -->
                </VisualStateGroup>

                <!-- No FocusStates group: the spec defines no focus treatment, and a ring set
                     3 px outside the box left a white page-gap between the box and the ring
                     that read as an unwanted white halo. UseSystemFocusVisuals stays False. -->

            </VisualStateManager.VisualStateGroups>

            <!-- HandContentControl sets a hand cursor over the whole clickable area. It only
                 affects hit-testable instances: the showcase specimens (IsHitTestVisible=False)
                 never receive pointer input, so they keep the arrow. -->
            <controls:HandContentControl HorizontalContentAlignment="Left"
                                         VerticalContentAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing8}" VerticalAlignment="Center">
                <Grid Width="18" Height="18">
                    <!--
                        Each face is a solid fill rect with the stroke as a SEPARATE
                        transparent-background ring on top — never one Border carrying both a
                        Background and a BorderBrush. That single-Border form clips the fill to
                        the inner radius (outer radius minus 1.5 px border) and, at fractional
                        DPI, leaves a hairline seam at the rounded corners that shows the white
                        page through — the white ring. Here the ring's only backdrop is the
                        fill beneath it, so any corner seam reveals the fill colour, not white.
                    -->
                    <!-- Unchecked face: translucent fill under a grey stroke ring. -->
                    <Grid x:Name="UncheckedFace">
                        <Border x:Name="UncheckedFill"
                                Background="{ThemeResource EtherCheckboxFillDefaultBrush}"
                                CornerRadius="{StaticResource radius/control-sm}"/>
                        <Border x:Name="UncheckedStroke"
                                Background="{StaticResource EtherCheckboxTransparentBrush}"
                                BorderBrush="{ThemeResource EtherCheckboxStrokeBrush}"
                                BorderThickness="1.5"
                                CornerRadius="{StaticResource radius/control-sm}"
                                IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Checked face: brand-blue fill under a blue stroke ring, carrying the tick. -->
                    <Grid x:Name="CheckedFace" Visibility="Collapsed">
                        <Border x:Name="CheckedFill"
                                Background="{ThemeResource EtherCheckboxCheckedFillDefaultBrush}"
                                CornerRadius="{StaticResource radius/control-sm}"/>
                        <Border x:Name="CheckedStroke"
                                Background="{StaticResource EtherCheckboxTransparentBrush}"
                                BorderBrush="{ThemeResource EtherCheckboxCheckedStrokeBrush}"
                                BorderThickness="1.5"
                                CornerRadius="{StaticResource radius/control-sm}"
                                IsHitTestVisible="False"/>
                        <Viewbox Width="11" Height="11"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="Glyph"
                                  Stroke="{ThemeResource EtherCheckboxGlyphBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M1.5,5.5 L4.5,8.5 L9.5,2.5"/>
                        </Viewbox>
                    </Grid>
                </Grid>

                <ContentPresenter x:Name="Label"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Foreground="{ThemeResource EtherCheckboxLabelBrush}"
                                  FontFamily="{StaticResource InterFont}"
                                  FontSize="{StaticResource Size12}"
                                  FontWeight="{StaticResource WeightSemibold}"
                                  VerticalAlignment="Center"/>
            </StackPanel>
            </controls:HandContentControl>
        </Grid>
    </ControlTemplate>

    <Style x:Key="DefaultEtherCheckboxStyle" TargetType="controls:EtherCheckbox">
        <Setter Property="IsThreeState" Value="False"/>
        <Setter Property="UseSystemFocusVisuals" Value="False"/>
        <Setter Property="MinWidth" Value="{StaticResource Spacing0}"/>
        <Setter Property="MinHeight" Value="{StaticResource Spacing0}"/>
        <Setter Property="Padding" Value="{StaticResource Padding0}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource EtherCheckboxTemplate}"/>
    </Style>

    <Style TargetType="controls:EtherCheckbox" BasedOn="{StaticResource DefaultEtherCheckboxStyle}"/>

</ResourceDictionary>
