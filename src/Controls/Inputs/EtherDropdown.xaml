<!--
    EtherDropdown.xaml = Ether Design System · Compact Dropdown
    ============================================================

    USAGE
      <ComboBox Style="{StaticResource EtherDropdown}"
                SelectedIndex="0">
          <ComboBoxItem Content="10 Minutes"/>
          <ComboBoxItem Content="30 Minutes"/>
          <ComboBoxItem Content="1 Hour"/>
      </ComboBox>

    VISUAL STATES
      Default:     BackgroundDropdown (rgba black@8%) · TextSecondary · arrow icon
      PointerOver: BackgroundDropdownHover (rgba black@14%)
      Pressed:     BackgroundDropdownPressed (rgba black@20%)
      Opened:      Gradient-100 1 px outline
      Focused:     BorderFocus 2 px
      Disabled:    TextDisabled

    KEY MEASUREMENTS (Figma source: ursRC201v8IiVeafliI45F · node 58074:2134)
      Width       max(130 px, longest option + icon + padding)
      Height      32 px (MinHeight)
      Padding     8 all sides
      CornerRadius 4 (RadiusControlSm)
      Font        Inter Medium 11 px · letter=spacing 0.22 px
      Arrow icon  16×16

    MENU MEASUREMENTS
      Item height 26 px (fixed)
      Item gap    4 px (StackPanel Spacing)
      Menu padding 4 px all sides
      Visible     6 items, then scrolls (DropdownSizing.MaxVisibleItems)

    TOKENS
      Background:  BackgroundDropdown / Hover / Pressed (ThemeResource)
      Text:        TextSecondary (ThemeResource)
      Arrow:       TextSecondary (ThemeResource)
      Active stroke: BorderDropdownActive (StaticResource)
      Focus ring:  BorderFocus

    LOCATION
      This dictionary lives beside its class (Controls/EtherDropdown.cs) and is merged
      explicitly from App.xaml. See the "Mechanism refinement" note in
      docs/superpowers/plans/2026-08-06-self-contained-component-authoring-plan.md.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls">

    <!-- Single source of truth for the width floor: the trigger's MinWidth and the menu's
         MinWidth both read this, so the spec lives in one place. -->
    <x:Double x:Key="DropdownMinWidth">130</x:Double>

    <ControlTemplate x:Key="EtherDropdownTemplate" TargetType="controls:EtherDropdown">
        <Grid x:Name="LayoutRoot">
            <VisualStateManager.VisualStateGroups>
                <!--
                    StateFill and OpenFill exist so these two groups never write the same
                    property. CommonStates owns StateFill.Background; DropDownStates owns
                    which of the two fills is visible. Driving one shared fill from both
                    groups does not work: while the menu is open, pointer events over the
                    menu bubble to the ComboBox (the Popup is inside this template) and put
                    CommonStates into PointerOver, lighting the trigger up for a pointer
                    that is over the MENU. A VisualState setter outranks both an animation
                    and a same-frame correction, so the only reliable fix is to give the
                    open state a fill of its own that hover cannot address.
                -->
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="StateFill.Background" Value="{ThemeResource BackgroundDropdownHover}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="StateFill.Background" Value="{ThemeResource BackgroundDropdownPressed}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <!-- Figma: retain base colors, then fade the entire dropdown to 40%. -->
                            <Setter Target="LayoutRoot.Opacity" Value="0.4"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Target="FocusRing.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Unfocused"/>
                </VisualStateGroup>
                <VisualStateGroup x:Name="DropDownStates">
                    <VisualState x:Name="Opened">
                        <VisualState.Setters>
                            <Setter Target="ActiveStroke.Visibility" Value="Visible"/>
                            <!-- Swap to a fill CommonStates has no handle on, so hover and
                                 pressed cannot repaint the trigger while the menu is up. -->
                            <Setter Target="StateFill.Visibility" Value="Collapsed"/>
                            <Setter Target="OpenFill.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                        <Storyboard>
                            <!-- Angle animations run independently (off the UI thread), so no
                                 EnableDependentAnimation is needed. -->
                            <DoubleAnimation Storyboard.TargetName="ArrowRotation"
                                             Storyboard.TargetProperty="Angle"
                                             To="180" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Closed">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ArrowRotation"
                                             Storyboard.TargetProperty="Angle"
                                             To="0" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- Fill while the menu is closed; CommonStates repaints this one. -->
            <Border x:Name="StateFill"
                    Background="{ThemeResource BackgroundDropdown}"
                    CornerRadius="{StaticResource RadiusControlSm}"
                    IsHitTestVisible="False"/>

            <!-- Fill while the menu is open. Always the default colour, and out of reach of
                 CommonStates, so pointer state cannot tint the trigger. Exactly one of the
                 two fills is ever visible, so the translucent tokens never stack. -->
            <Border x:Name="OpenFill"
                    Background="{ThemeResource BackgroundDropdown}"
                    CornerRadius="{StaticResource RadiusControlSm}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>

            <Border x:Name="Bg"
                    Background="Transparent"
                    CornerRadius="{StaticResource RadiusControlSm}"
                    Padding="{TemplateBinding Padding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                    </Grid.ColumnDefinitions>
                    <!-- ComboBox requires a template part named exactly "ContentPresenter"
                         and drives it itself: it clears the part's Content while the menu
                         is open, and renaming the part away breaks the control's own
                         DropDownStates transitions (the Opened gradient stroke stops
                         appearing). So keep the part for the framework but hide it, and
                         show the selection through TriggerText instead, which
                         DropdownSizing.SyncSelectionText keeps in sync. -->
                    <ContentPresenter x:Name="ContentPresenter"
                                      Grid.Column="0"
                                      Visibility="Collapsed"/>
                    <!-- Raw: the ComboBox's own automation peer already reports the selection,
                         so exposing this TextBlock too would announce it twice. -->
                    <TextBlock x:Name="TriggerText"
                               Grid.Column="0"
                               AutomationProperties.AccessibilityView="Raw"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextSecondary}"
                               FontFamily="{TemplateBinding FontFamily}"
                               FontSize="{TemplateBinding FontSize}"
                               FontWeight="Medium"
                               CharacterSpacing="20"
                               TextWrapping="NoWrap"/>
                    <Path x:Name="Arrow"
                          Grid.Column="1"
                          Width="8"
                          Height="4"
                          Data="M 0 0 L 8 0 L 4 4 Z"
                          Stretch="Fill"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Fill="{ThemeResource TextSecondary}"
                          RenderTransformOrigin="0.5,0.5"
                          AutomationProperties.AccessibilityView="Raw">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="ArrowRotation"/>
                        </Path.RenderTransform>
                    </Path>
                </Grid>
            </Border>

            <!-- Figma Gradient-100, shown while the dropdown menu is open. -->
            <Border x:Name="ActiveStroke"
                    BorderBrush="{StaticResource BorderDropdownActive}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusControlSm}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>

            <Border x:Name="FocusRing"
                    Margin="-3"
                    BorderBrush="{ThemeResource BorderFocus}"
                    BorderThickness="2"
                    CornerRadius="5"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>

            <!-- Figma dropdown menu: 4 px container padding and 6 px item padding. -->
            <Popup x:Name="Popup">
                <!-- Framework-driven show/hide motion. It has to live on the Popup rather than
                     on a Storyboard we run ourselves, because ComboBox tears the popup down the
                     instant the menu closes — only the Popup's own transition gets to play a
                     close animation before that happens. -->
                <Popup.ChildTransitions>
                    <TransitionCollection>
                        <PopupThemeTransition FromVerticalOffset="-8"/>
                    </TransitionCollection>
                </Popup.ChildTransitions>
                <Border x:Name="PopupBorder"
                        Background="{ThemeResource BackgroundDropdownMenu}"
                        CornerRadius="{StaticResource RadiusControlSm}"
                        MinWidth="{StaticResource DropdownMinWidth}"
                        Padding="4">
                    <ScrollViewer x:Name="ScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <!-- Scroll bar styling now lives in the app-wide Controls/EtherScrollBar.xaml. -->
                        <!-- No right gutter: the menu's padding is a symmetric 4 px, so the
                             4 px scroll bar overlays the item edge instead of insetting it. -->
                        <ItemsPresenter/>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
    </ControlTemplate>

    <Style x:Key="EtherDropdownItem" TargetType="ComboBoxItem">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid x:Name="ItemBackground"
                          Background="Transparent"
                          CornerRadius="{StaticResource RadiusControlSm}"
                          Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBackground.Background" Value="{ThemeResource BackgroundDropdownItemSelectedHover}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBackground.Background" Value="{ThemeResource BackgroundDropdownItemSelectedPressed}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBackground.Opacity" Value="0.4"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBackground.Background" Value="{ThemeResource BackgroundDropdownItemSelected}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedUnfocused">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBackground.Background" Value="{ThemeResource BackgroundDropdownItemSelected}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBackground.Background" Value="{ThemeResource BackgroundDropdownItemSelected}"/>
                                        <Setter Target="ItemBackground.Opacity" Value="0.4"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBackground.Background" Value="{ThemeResource BackgroundDropdownItemSelectedHover}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBackground.Background" Value="{ThemeResource BackgroundDropdownItemSelectedPressed}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Foreground="{ThemeResource TextSecondary}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          FontWeight="Medium"
                                          CharacterSpacing="20"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit default style for the control: every <controls:EtherDropdown/> picks it up
         without naming a key. Scoped to our own type, so it cannot restyle stock ComboBoxes. -->
    <Style TargetType="controls:EtherDropdown">
        <Setter Property="Padding"                    Value="8"/>
        <Setter Property="HorizontalAlignment"       Value="Left"/>
        <Setter Property="MinWidth"                   Value="{StaticResource DropdownMinWidth}"/>
        <Setter Property="MinHeight"                  Value="32"/>
        <Setter Property="FontFamily"                 Value="{StaticResource InterFont}"/>
        <Setter Property="FontSize"                   Value="11"/>
        <Setter Property="MaxVisibleItems"            Value="6"/>
        <Setter Property="MenuGap"                    Value="4"/>
        <Setter Property="ItemContainerStyle"          Value="{StaticResource EtherDropdownItem}"/>
        <!-- ComboBox's default items panel is CarouselPanel, which centres the menu on the
             selected item and takes scrolling over itself — leaving the host ScrollViewer
             reporting a zero extent, so its Auto scrollbar never appears. A plain StackPanel
             restores ordinary top-down layout and pixel scrolling. -->
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" Spacing="4"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="UseSystemFocusVisuals"      Value="False"/>
        <Setter Property="Template" Value="{StaticResource EtherDropdownTemplate}"/>
    </Style>

</ResourceDictionary>
