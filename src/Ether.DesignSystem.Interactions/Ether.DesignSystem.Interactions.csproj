<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Ether.DesignSystem.Interactions</AssemblyName>
    <RootNamespace>Ether.DesignSystem.Interactions</RootNamespace>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <PackageId>Ether.DesignSystem.Interactions</PackageId>
    <Version>$(EtherDesignSystemPreviewVersion)</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <Authors>Ether Design System</Authors>
    <Description>Application-layer interaction adapters for Ether WinUI 3 controls.</Description>
    <PackageTags>winui;winui3;design-system;interaction;events;preview</PackageTags>
    <PackageReleaseNotes>0.1.0-preview.1. See docs/releases/0.1.0-preview.1.md. EtherButton RightIconVisibility was removed (RightIconStates). High Contrast semantic keys map to Windows SystemColor*. x64 unpackaged and packaged (MSIX build/produce) consumers are verified; MSIX install/runtime, any architecture other than x64, Insights/Appium, and stable-release readiness remain incomplete.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/yiqizhong/ether-lib</PackageProjectUrl>
    <RepositoryUrl>https://github.com/yiqizhong/ether-lib</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ether.DesignSystem.Controls\Ether.DesignSystem.Controls.csproj" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <None Update="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
