<Page
    x:Class="EtherSandbox.Views.Controls.IntelligenceButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls"
    xmlns:views="using:EtherSandbox.Views">

    <views:ComponentPage
        Title="Intelligence Button"
        HasDisabledToggle="True"
        Description="Updated intelligence button with a dual-gradient stroke, hover glow, and refined pressed and disabled treatments. The AI accent styling stays visible across both themes.">

        <views:ComponentPage.InteractiveContent>
            <StackPanel Orientation="Horizontal" Spacing="24">
                <StackPanel Spacing="8">
                    <TextBlock Text="Functional"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                    <controls:EtherIntelligenceButton Content="What's this mean?"
                                                     AutomationProperties.Name="Interactive intelligence button"
                                                     HorizontalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="With longer label"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                    <controls:EtherIntelligenceButton Content="=  Optimise my battery"
                                                     AutomationProperties.Name="Interactive intelligence button long label"
                                                     HorizontalContentAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </views:ComponentPage.InteractiveContent>

        <views:ComponentPage.StatesContent>
            <StackPanel Orientation="Horizontal" Spacing="24">
                <StackPanel Spacing="8">
                    <TextBlock Text="Default"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                    <controls:EtherIntelligenceButton Content="What's this mean?"
                                                     AutomationProperties.Name="Default intelligence button"
                                                     IsHitTestVisible="False"
                                                     IsTabStop="False"/>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="Hover"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                    <controls:EtherIntelligenceButton x:Name="IntelligenceHoverState"
                                                     Content="What's this mean?"
                                                     AutomationProperties.Name="Hover intelligence button"
                                                     IsHitTestVisible="False"
                                                     IsTabStop="False"/>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="Pressed"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                    <controls:EtherIntelligenceButton x:Name="IntelligencePressedState"
                                                     Content="What's this mean?"
                                                     AutomationProperties.Name="Pressed intelligence button"
                                                     IsHitTestVisible="False"
                                                     IsTabStop="False"/>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="Disabled"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                    <controls:EtherIntelligenceButton x:Name="IntelligenceDisabledState"
                                                     Content="What's this mean?"
                                                     AutomationProperties.Name="Disabled intelligence button"
                                                     IsEnabled="False"
                                                     IsHitTestVisible="False"
                                                     IsTabStop="False"/>
                </StackPanel>
            </StackPanel>
        </views:ComponentPage.StatesContent>

    </views:ComponentPage>
</Page>
