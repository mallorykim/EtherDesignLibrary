<Page
    x:Class="EtherSandbox.Views.Controls.LabelFilterChipPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:EtherSandbox.Views">

    <views:ComponentPage
        Title="Label / Filter Chip"
        HasDisabledToggle="True"
        Description="ToggleButton used as a filter chip or badge. Click to toggle. Shows Checked — Unchecked transition.">

        <views:ComponentPage.InteractiveContent>
            <StackPanel Spacing="8">
                <TextBlock Text="FILTER CHIP GROUP (click any chip)"
                           Style="{StaticResource EtherMicroSemiBold}" Foreground="{ThemeResource TextTertiary}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ToggleButton Content="All" Style="{StaticResource EtherLabel}" IsChecked="True"/>
                    <ToggleButton Content="Updates" Style="{StaticResource EtherLabel}"/>
                    <ToggleButton Content="Drivers" Style="{StaticResource EtherLabel}"/>
                    <ToggleButton Content="Firmware" Style="{StaticResource EtherLabel}"/>
                    <ToggleButton Content="Security" Style="{StaticResource EtherLabel}"/>
                </StackPanel>
            </StackPanel>
        </views:ComponentPage.InteractiveContent>

        <views:ComponentPage.StatesContent>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <StackPanel Spacing="6">
                    <TextBlock Text="Unchecked"
                               Style="{StaticResource EtherMicroRegular}" Foreground="{ThemeResource TextTertiary}"/>
                    <ToggleButton Content="Label" Style="{StaticResource EtherLabel}"
                                  IsChecked="False"/>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="Checked"
                               Style="{StaticResource EtherMicroRegular}" Foreground="{ThemeResource TextTertiary}"/>
                    <ToggleButton Content="Label" Style="{StaticResource EtherLabel}"
                                  IsChecked="True"/>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="Disabled"
                               Style="{StaticResource EtherMicroRegular}" Foreground="{ThemeResource TextTertiary}"/>
                    <ToggleButton Content="Label" Style="{StaticResource EtherLabel}"
                                  IsEnabled="False"/>
                </StackPanel>
            </StackPanel>
        </views:ComponentPage.StatesContent>

    </views:ComponentPage>
</Page>
