<Page
    x:Class="EtherSandbox.Views.Controls.ToggleSwitchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:EtherSandbox.Views">

    <views:ComponentPage
        Title="Toggle Switch"
        HasDisabledToggle="True"
        Description="Updated toggle switch with refined ON and OFF styling across Light and Dark themes. Both values show default, hover, pressed, and disabled treatments.">

        <views:ComponentPage.InteractiveContent>
            <ToggleSwitch Style="{StaticResource EtherSwitch}"
                          OffContent="Off"
                          OnContent="On"/>
        </views:ComponentPage.InteractiveContent>

        <views:ComponentPage.StatesContent>
            <StackPanel Spacing="{StaticResource space/lg}">

                <!-- OFF states -->
                <StackPanel Spacing="8">
                    <TextBlock Text="OFF"
                               Style="{StaticResource micro/semibold}"
                               Foreground="{ThemeResource TextTertiary}"/>
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Default"
                                       Style="{StaticResource micro/regular}"
                                       Foreground="{ThemeResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
                            <ToggleSwitch Style="{StaticResource EtherSwitch}"
                                          IsOn="False"
                                          OffContent="Off"
                                          OnContent="On"
                                          IsHitTestVisible="False"
                                          IsTabStop="False"/>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Hover"
                                       Style="{StaticResource micro/regular}"
                                       Foreground="{ThemeResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
                            <ToggleSwitch x:Name="OffHoverState"
                                          Style="{StaticResource EtherSwitch}"
                                          IsOn="False"
                                          OffContent="Off"
                                          OnContent="On"
                                          IsHitTestVisible="False"
                                          IsTabStop="False"/>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Pressed"
                                       Style="{StaticResource micro/regular}"
                                       Foreground="{ThemeResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
                            <ToggleSwitch x:Name="OffPressedState"
                                          Style="{StaticResource EtherSwitch}"
                                          IsOn="False"
                                          OffContent="Off"
                                          OnContent="On"
                                          IsHitTestVisible="False"
                                          IsTabStop="False"/>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Disabled"
                                       Style="{StaticResource micro/regular}"
                                       Foreground="{ThemeResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
                            <ToggleSwitch Style="{StaticResource EtherSwitch}"
                                          IsOn="False"
                                          OffContent="Off"
                                          OnContent="On"
                                          IsEnabled="False"
                                          IsHitTestVisible="False"
                                          IsTabStop="False"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- ON states -->
                <StackPanel Spacing="8">
                    <TextBlock Text="ON"
                               Style="{StaticResource micro/semibold}"
                               Foreground="{ThemeResource TextTertiary}"/>
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Default"
                                       Style="{StaticResource micro/regular}"
                                       Foreground="{ThemeResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
                            <ToggleSwitch Style="{StaticResource EtherSwitch}"
                                          IsOn="True"
                                          OffContent="Off"
                                          OnContent="On"
                                          IsHitTestVisible="False"
                                          IsTabStop="False"/>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Hover"
                                       Style="{StaticResource micro/regular}"
                                       Foreground="{ThemeResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
                            <ToggleSwitch x:Name="OnHoverState"
                                          Style="{StaticResource EtherSwitch}"
                                          IsOn="True"
                                          OffContent="Off"
                                          OnContent="On"
                                          IsHitTestVisible="False"
                                          IsTabStop="False"/>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Pressed"
                                       Style="{StaticResource micro/regular}"
                                       Foreground="{ThemeResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
                            <ToggleSwitch x:Name="OnPressedState"
                                          Style="{StaticResource EtherSwitch}"
                                          IsOn="True"
                                          OffContent="Off"
                                          OnContent="On"
                                          IsHitTestVisible="False"
                                          IsTabStop="False"/>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Disabled"
                                       Style="{StaticResource micro/regular}"
                                       Foreground="{ThemeResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
                            <ToggleSwitch Style="{StaticResource EtherSwitch}"
                                          IsOn="True"
                                          OffContent="Off"
                                          OnContent="On"
                                          IsEnabled="False"
                                          IsHitTestVisible="False"
                                          IsTabStop="False"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </views:ComponentPage.StatesContent>

    </views:ComponentPage>
</Page>
