<Page
    x:Class="EtherSandbox.Views.Controls.SteeringBarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls"
    xmlns:views="using:EtherSandbox.Views">

    <views:ComponentPage
        Title="Steering Bar"
        Description="Draggable steering bar with a rounded track, gradient progress fill, glass thumb, and optional title/value labels. It supports continuous dragging or custom stops with snapping depending on the use case."
        HasDisabledToggle="True">

        <views:ComponentPage.InteractiveContent>
            <views:ControlExample x:Name="LiveExample"
                                  OutputText="Value: 31"
                                  SourceXaml="{x:Bind SpecimenXaml, Mode=OneTime}">
            <StackPanel Spacing="16" Width="480">
                <StackPanel Spacing="8">
                    <TextBlock Text="Continuous"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"/>
                    <controls:EtherSteeringBar x:Name="DebugSteeringBar"
                                               Width="480"
                                               Title="Playback"
                                               Value="31"
                                               AutomationProperties.Name="Interactive steering bar"
                                               ValueChanged="InteractiveSteeringBar_ValueChanged"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Custom stops with snapping"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"/>
                    <controls:EtherSteeringBar x:Name="StopsDemo"
                                               Width="480"
                                               Title="Intensity"
                                               Value="50"
                                               SnapToStops="True"
                                               AutomationProperties.Name="Interactive steering bar with stops"/>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <controls:EtherButton x:Name="DecreaseStopsButton"
                                              Content="−"
                                              Style="{StaticResource EtherButtonSecondarySmall}"
                                              Click="DecreaseStops_Click"/>
                        <TextBlock x:Name="StopCountText"
                                   Text="5 stops"
                                   Style="{StaticResource micro/regular}"
                                   Foreground="{ThemeResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                        <controls:EtherButton x:Name="IncreaseStopsButton"
                                              Content="+"
                                              Style="{StaticResource EtherButtonSecondarySmall}"
                                              Click="IncreaseStops_Click"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            </views:ControlExample>
        </views:ComponentPage.InteractiveContent>

        <views:ComponentPage.StatesContent>
            <StackPanel Spacing="24" Width="480">
                <StackPanel Spacing="8">
                    <TextBlock Text="TITLE + VALUE"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"/>
                    <controls:EtherSteeringBar Width="480"
                                               Title="Playback"
                                               Value="31"
                                               PreviewStatus="Default"
                                               IsHitTestVisible="False"
                                               AutomationProperties.Name="Default steering bar"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="TITLE ONLY"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"/>
                    <controls:EtherSteeringBar Width="480"
                                               Title="Playback"
                                               Value="31"
                                               ShowTitle="True"
                                               ShowValue="False"
                                               PreviewStatus="Hover"
                                               IsHitTestVisible="False"
                                               AutomationProperties.Name="Hover steering bar"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="VALUE ONLY"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"/>
                    <controls:EtherSteeringBar Width="480"
                                               Title="Playback"
                                               Value="31"
                                               ShowTitle="False"
                                               ShowValue="True"
                                               PreviewStatus="Pressed"
                                               IsHitTestVisible="False"
                                               AutomationProperties.Name="Pressed steering bar"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="BAR ONLY"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"/>
                    <controls:EtherSteeringBar Width="480"
                                               Title="Playback"
                                               Value="31"
                                               ShowTitle="False"
                                               ShowValue="False"
                                               PreviewStatus="Disabled"
                                               IsHitTestVisible="False"
                                               AutomationProperties.Name="Disabled steering bar"/>
                </StackPanel>
            </StackPanel>
        </views:ComponentPage.StatesContent>

    </views:ComponentPage>
</Page>
