<Page
    x:Class="EtherSandbox.Views.Controls.DropdownPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls"
    xmlns:views="using:EtherSandbox.Views">

    <Page.Resources>
        <Style x:Key="DropdownMenuPreviewContainer" TargetType="Border">
            <Setter Property="Width" Value="130"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="{ThemeResource BackgroundDropdownMenu}"/>
        </Style>
        <!-- Mirrors EtherDropdownItem: 26 px tall, 6 px side padding. -->
        <Style x:Key="DropdownMenuPreviewItem" TargetType="Border">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="DropdownMenuPreviewText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="CharacterSpacing" Value="20"/>
            <Setter Property="Foreground" Value="{ThemeResource TextSecondary}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Left"/>
        </Style>
    </Page.Resources>

    <views:ComponentPage
        Title="Dropdown"
        HasDisabledToggle="True"
        Description="Updated compact dropdown with content-hugging width, a theme-aware disclosure icon, and a gradient active stroke. Menu items are 26 px tall with a 4 px gap and 4 px container padding; past 6 items the menu scrolls.">

        <views:ComponentPage.InteractiveContent>
            <controls:EtherDropdown
                      SelectedIndex="0"
                      HorizontalAlignment="Left"
                      AutomationProperties.Name="Auto-lock delay">
                <ComboBoxItem Content="10 Minutes"/>
                <ComboBoxItem Content="30 Minutes"/>
                <ComboBoxItem Content="1 Hour"/>
                <ComboBoxItem Content="2 Hours"/>
                <ComboBoxItem Content="4 Hours"/>
                <ComboBoxItem Content="8 Hours"/>
                <ComboBoxItem Content="12 Hours"/>
                <ComboBoxItem Content="1 Day"/>
                <ComboBoxItem Content="Never"/>
            </controls:EtherDropdown>
        </views:ComponentPage.InteractiveContent>

        <views:ComponentPage.StatesContent>
            <StackPanel Orientation="Horizontal" Spacing="24">
                <StackPanel Spacing="8">
                    <TextBlock Text="Default"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                    <controls:EtherDropdown
                              SelectedIndex="0"
                              IsHitTestVisible="False" IsTabStop="False">
                        <ComboBoxItem Content="10 Minutes"/>
                    </controls:EtherDropdown>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="Hover"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                    <controls:EtherDropdown x:Name="DropdownHoverState"
                              SelectedIndex="0"
                              IsHitTestVisible="False" IsTabStop="False">
                        <ComboBoxItem Content="10 Minutes"/>
                    </controls:EtherDropdown>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="Pressed"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                    <controls:EtherDropdown x:Name="DropdownPressedState"
                              SelectedIndex="0"
                              IsHitTestVisible="False" IsTabStop="False">
                        <ComboBoxItem Content="10 Minutes"/>
                    </controls:EtherDropdown>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="Open (active)"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                    <!-- Driven into the real Opened visual state from code-behind, so
                         this shows the actual gradient stroke and flipped arrow rather
                         than a hand-drawn imitation. -->
                    <controls:EtherDropdown x:Name="DropdownOpenState"
                              SelectedIndex="0"
                              IsHitTestVisible="False" IsTabStop="False">
                        <ComboBoxItem Content="10 Minutes"/>
                    </controls:EtherDropdown>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="Open / item hover"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                    <Border Style="{StaticResource DropdownMenuPreviewContainer}">
                        <StackPanel Spacing="4">
                            <Border Style="{StaticResource DropdownMenuPreviewItem}"
                                    Background="{ThemeResource BackgroundDropdownItemSelectedHover}">
                                <TextBlock Text="Item menu" Style="{StaticResource DropdownMenuPreviewText}"/>
                            </Border>
                            <Border Style="{StaticResource DropdownMenuPreviewItem}"><TextBlock Text="Item menu" Style="{StaticResource DropdownMenuPreviewText}"/></Border>
                            <Border Style="{StaticResource DropdownMenuPreviewItem}"><TextBlock Text="Item menu" Style="{StaticResource DropdownMenuPreviewText}"/></Border>
                            <Border Style="{StaticResource DropdownMenuPreviewItem}"><TextBlock Text="Item menu" Style="{StaticResource DropdownMenuPreviewText}"/></Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="Open / item pressed"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                    <Border Style="{StaticResource DropdownMenuPreviewContainer}">
                        <StackPanel Spacing="4">
                            <Border Style="{StaticResource DropdownMenuPreviewItem}"
                                    Background="{ThemeResource BackgroundDropdownItemSelectedPressed}">
                                <TextBlock Text="Item menu" Style="{StaticResource DropdownMenuPreviewText}"/>
                            </Border>
                            <Border Style="{StaticResource DropdownMenuPreviewItem}"><TextBlock Text="Item menu" Style="{StaticResource DropdownMenuPreviewText}"/></Border>
                            <Border Style="{StaticResource DropdownMenuPreviewItem}"><TextBlock Text="Item menu" Style="{StaticResource DropdownMenuPreviewText}"/></Border>
                            <Border Style="{StaticResource DropdownMenuPreviewItem}"><TextBlock Text="Item menu" Style="{StaticResource DropdownMenuPreviewText}"/></Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="Open / scrollbar"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                    <!-- Six items: the menu's cap, which is the only point at which a
                         scroll bar can appear. Four would show no bar at all. -->
                    <Border Style="{StaticResource DropdownMenuPreviewContainer}">
                        <Grid>
                            <StackPanel Spacing="4">
                                <Border Style="{StaticResource DropdownMenuPreviewItem}"><TextBlock Text="Item menu" Style="{StaticResource DropdownMenuPreviewText}"/></Border>
                                <Border Style="{StaticResource DropdownMenuPreviewItem}"><TextBlock Text="Item menu" Style="{StaticResource DropdownMenuPreviewText}"/></Border>
                                <Border Style="{StaticResource DropdownMenuPreviewItem}"><TextBlock Text="Item menu" Style="{StaticResource DropdownMenuPreviewText}"/></Border>
                                <Border Style="{StaticResource DropdownMenuPreviewItem}"><TextBlock Text="Item menu" Style="{StaticResource DropdownMenuPreviewText}"/></Border>
                                <Border Style="{StaticResource DropdownMenuPreviewItem}"><TextBlock Text="Item menu" Style="{StaticResource DropdownMenuPreviewText}"/></Border>
                                <Border Style="{StaticResource DropdownMenuPreviewItem}"><TextBlock Text="Item menu" Style="{StaticResource DropdownMenuPreviewText}"/></Border>
                            </StackPanel>
                            <Border Width="4" Height="60"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource BackgroundDropdownScrollThumb}"
                                    CornerRadius="4"/>
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="Disabled"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                    <controls:EtherDropdown
                              SelectedIndex="0"
                              IsEnabled="False"
                              IsHitTestVisible="False" IsTabStop="False">
                        <ComboBoxItem Content="10 Minutes"/>
                    </controls:EtherDropdown>
                </StackPanel>
            </StackPanel>
        </views:ComponentPage.StatesContent>

    </views:ComponentPage>
</Page>
