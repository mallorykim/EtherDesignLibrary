<Page
    x:Class="EtherSandbox.Views.Controls.SegmentedControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls"
    xmlns:views="using:EtherSandbox.Views">

    <views:ComponentPage
        Title="Segmented Control"
        Description="Updated segmented control with a functional selection model plus specimen states for default, hover, pressed, and active treatments.">

        <views:ComponentPage.InteractiveContent>
            <StackPanel Orientation="Horizontal" Spacing="24">
                <StackPanel Spacing="6">
                    <TextBlock Text="2 SEGMENTS"
                               Style="{StaticResource micro/semibold}"
                               Foreground="{ThemeResource TextTertiary}"/>
                    <controls:EtherSegmentedControl Style="{StaticResource EtherSegmentedTrack}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <controls:HandRadioButton GroupName="SegmentedTwo" Content="List"
                                         Style="{StaticResource EtherSegment}"
                                         IsChecked="True"/>
                            <controls:HandRadioButton GroupName="SegmentedTwo" Content="Grid"
                                         Style="{StaticResource EtherSegment}"/>
                        </StackPanel>
                    </controls:EtherSegmentedControl>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="3 SEGMENTS"
                               Style="{StaticResource micro/semibold}"
                               Foreground="{ThemeResource TextTertiary}"/>
                    <controls:EtherSegmentedControl Style="{StaticResource EtherSegmentedTrack}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <controls:HandRadioButton GroupName="SegmentedThree" Content="Overview"
                                         Style="{StaticResource EtherSegment}"
                                         IsChecked="True"/>
                            <controls:HandRadioButton GroupName="SegmentedThree" Content="Details"
                                         Style="{StaticResource EtherSegment}"/>
                            <controls:HandRadioButton GroupName="SegmentedThree" Content="History"
                                         Style="{StaticResource EtherSegment}"/>
                        </StackPanel>
                    </controls:EtherSegmentedControl>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="4 SEGMENTS"
                               Style="{StaticResource micro/semibold}"
                               Foreground="{ThemeResource TextTertiary}"/>
                    <controls:EtherSegmentedControl Style="{StaticResource EtherSegmentedTrack}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <controls:HandRadioButton GroupName="SegmentedFour" Content="Day"
                                         Style="{StaticResource EtherSegment}"
                                         IsChecked="True"/>
                            <controls:HandRadioButton GroupName="SegmentedFour" Content="Week"
                                         Style="{StaticResource EtherSegment}"/>
                            <controls:HandRadioButton GroupName="SegmentedFour" Content="Month"
                                         Style="{StaticResource EtherSegment}"/>
                            <controls:HandRadioButton GroupName="SegmentedFour" Content="Year"
                                         Style="{StaticResource EtherSegment}"/>
                        </StackPanel>
                    </controls:EtherSegmentedControl>
                </StackPanel>
            </StackPanel>
        </views:ComponentPage.InteractiveContent>

        <views:ComponentPage.StatesContent>
            <StackPanel Orientation="Horizontal" Spacing="16">
                <StackPanel Width="130" Spacing="8">
                    <TextBlock Text="Default"
                               Style="{StaticResource micro/semibold}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                    <controls:HandRadioButton Content="Default"
                                 Style="{StaticResource EtherSegment}"
                                 IsHitTestVisible="False" IsTabStop="False"/>
                </StackPanel>
                <StackPanel Width="130" Spacing="8">
                    <TextBlock Text="Selected"
                               Style="{StaticResource micro/semibold}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                    <controls:HandRadioButton Content="Selected"
                                 Style="{StaticResource EtherSegment}"
                                 IsChecked="True"
                                 IsHitTestVisible="False" IsTabStop="False"/>
                </StackPanel>
                <StackPanel Width="130" Spacing="8">
                    <TextBlock Text="Hover"
                               Style="{StaticResource micro/semibold}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                    <controls:HandRadioButton Content="Hover"
                                 Style="{StaticResource EtherSegment}"
                                 PreviewState="Hover"
                                 IsHitTestVisible="False" IsTabStop="False"/>
                </StackPanel>
                <StackPanel Width="130" Spacing="8">
                    <TextBlock Text="Pressed"
                               Style="{StaticResource micro/semibold}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                    <controls:HandRadioButton Content="Pressed"
                                 Style="{StaticResource EtherSegment}"
                                 PreviewState="Pressed"
                                 IsHitTestVisible="False" IsTabStop="False"/>
                </StackPanel>
            </StackPanel>
        </views:ComponentPage.StatesContent>

    </views:ComponentPage>
</Page>
