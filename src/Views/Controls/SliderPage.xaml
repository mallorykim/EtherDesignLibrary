<Page
    x:Class="EtherSandbox.Views.Controls.SliderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls"
    xmlns:views="using:EtherSandbox.Views">

    <views:ComponentPage
        Title="Slider"
        Description="Bar-chart slider with interactive click-and-drag behavior and theme-aware selected bars. Sixty-three ticks fill with the component highlight brush up to the knob.">

        <views:ComponentPage.InteractiveContent>
            <views:ControlExample x:Name="LiveExample"
                                  OutputText="Value: 50%"
                                  SourceXaml="{x:Bind SpecimenXaml, Mode=OneTime}">
            <StackPanel Spacing="8">
                <TextBlock Text="50% (interactive — drag me)"
                           Style="{StaticResource micro/regular}"
                           Foreground="{ThemeResource TextTertiary}"/>
                <controls:EtherSlider x:Name="InteractiveSlider"
                                      Value="50"
                                      AutomationProperties.Name="Interactive slider"
                                      ValueChanged="InteractiveSlider_ValueChanged"/>
            </StackPanel>
            </views:ControlExample>
        </views:ComponentPage.InteractiveContent>

        <views:ComponentPage.StatesContent>
            <StackPanel Orientation="Horizontal" Spacing="48">
                <StackPanel Spacing="8">
                    <TextBlock Text="25%"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"/>
                    <controls:EtherSlider Value="25"
                                          AutomationProperties.Name="Slider at 25 percent"/>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="75%"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"/>
                    <controls:EtherSlider Value="75"
                                          AutomationProperties.Name="Slider at 75 percent"/>
                </StackPanel>
            </StackPanel>
        </views:ComponentPage.StatesContent>

    </views:ComponentPage>
</Page>
