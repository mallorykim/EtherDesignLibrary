<Page
    x:Class="EtherSandbox.Views.Controls.SliderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls"
    xmlns:views="using:EtherSandbox.Views">

    <views:ComponentPage
        Title="Slider"
        Description="Updated bar slider with interactive click-and-drag behavior and theme-aware selected bars. Twelve bars rise in height across the scale and fill with ActionPrimaryBg.">

        <views:ComponentPage.InteractiveContent>
            <StackPanel Spacing="8">
                <TextBlock Text="50% (interactive — drag me)"
                           Style="{StaticResource micro/regular}"
                           Foreground="{ThemeResource TextTertiary}"/>
                <controls:EtherSlider Value="50"/>
            </StackPanel>
        </views:ComponentPage.InteractiveContent>

        <views:ComponentPage.StatesContent>
            <StackPanel Orientation="Horizontal" Spacing="48">
                <StackPanel Spacing="8">
                    <TextBlock Text="25%"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"/>
                    <controls:EtherSlider Value="25"/>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="75%"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"/>
                    <controls:EtherSlider Value="75"/>
                </StackPanel>
            </StackPanel>
        </views:ComponentPage.StatesContent>

    </views:ComponentPage>
</Page>
