<Page
    x:Class="EtherSandbox.Views.Controls.CheckboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls"
    xmlns:views="using:EtherSandbox.Views">

    <views:ComponentPage
        Title="Checkbox"
        HasDisabledToggle="True"
        Description="Updated checkbox styling for Light and Dark themes, shown across unchecked and checked states with default, hover, pressed, and disabled treatments.">

        <views:ComponentPage.InteractiveContent>
            <controls:EtherCheckbox Content="Option"/>
        </views:ComponentPage.InteractiveContent>

        <views:ComponentPage.StatesContent>
            <StackPanel Spacing="{StaticResource space/lg}">

                <!-- UNCHECKED states -->
                <StackPanel Spacing="8">
                    <TextBlock Text="UNCHECKED"
                               Style="{StaticResource EtherMicroSemiBold}"
                               Foreground="{ThemeResource TextTertiary}"/>
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Default"
                                       Style="{StaticResource EtherMicroRegular}"
                                       Foreground="{ThemeResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
                            <controls:EtherCheckbox
                                                   Content="Option"
                                                   IsChecked="False"
                                                   IsHitTestVisible="False" IsTabStop="False"/>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Hover"
                                       Style="{StaticResource EtherMicroRegular}"
                                       Foreground="{ThemeResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
                            <controls:EtherCheckbox x:Name="UncheckedHover"
                                                   Content="Option"
                                                   IsChecked="False"
                                                   IsHitTestVisible="False" IsTabStop="False"/>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Pressed"
                                       Style="{StaticResource EtherMicroRegular}"
                                       Foreground="{ThemeResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
                            <controls:EtherCheckbox x:Name="UncheckedPressed"
                                                   Content="Option"
                                                   IsChecked="False"
                                                   IsHitTestVisible="False" IsTabStop="False"/>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Disabled"
                                       Style="{StaticResource EtherMicroRegular}"
                                       Foreground="{ThemeResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
                            <controls:EtherCheckbox
                                                   Content="Option"
                                                   IsChecked="False"
                                                   IsEnabled="False"
                                                   IsHitTestVisible="False" IsTabStop="False"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- CHECKED states -->
                <StackPanel Spacing="8">
                    <TextBlock Text="CHECKED"
                               Style="{StaticResource EtherMicroSemiBold}"
                               Foreground="{ThemeResource TextTertiary}"/>
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Default"
                                       Style="{StaticResource EtherMicroRegular}"
                                       Foreground="{ThemeResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
                            <controls:EtherCheckbox
                                                   Content="Option"
                                                   IsChecked="True"
                                                   IsHitTestVisible="False" IsTabStop="False"/>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Hover"
                                       Style="{StaticResource EtherMicroRegular}"
                                       Foreground="{ThemeResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
                            <controls:EtherCheckbox x:Name="CheckedHover"
                                                   Content="Option"
                                                   IsChecked="True"
                                                   IsHitTestVisible="False" IsTabStop="False"/>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Disabled"
                                       Style="{StaticResource EtherMicroRegular}"
                                       Foreground="{ThemeResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
                            <controls:EtherCheckbox
                                                   Content="Option"
                                                   IsChecked="True"
                                                   IsEnabled="False"
                                                   IsHitTestVisible="False" IsTabStop="False"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </views:ComponentPage.StatesContent>

    </views:ComponentPage>
</Page>
