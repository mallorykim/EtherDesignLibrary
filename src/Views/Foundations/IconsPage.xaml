<Page
    x:Class="EtherSandbox.Views.Foundations.IconsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:EtherSandbox.Views"
    xmlns:local="using:EtherSandbox.Views.Foundations"
    Loaded="OnLoaded">

    <views:ComponentPage
        Title="Icon Tokens"
        Description="DDS2 icon library — monoline SVGs from Assets/Icons/dds2, listed by name.">

        <views:ComponentPage.InteractiveContent>
            <StackPanel Spacing="12">
                <TextBlock x:Name="CountText"
                           Style="{StaticResource EtherMicroSemiBold}"
                           Foreground="{ThemeResource TextTertiary}"/>
                <ItemsControl x:Name="IconRows">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:IconGalleryRow">
                            <ItemsControl ItemsSource="{x:Bind Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:IconGalleryItem">
                                        <StackPanel Width="88" Spacing="6" Padding="8"
                                                    HorizontalAlignment="Center">
                                            <PathIcon Style="{x:Bind IconStyle}"
                                                      Width="20" Height="20"
                                                      HorizontalAlignment="Center"
                                                      Foreground="{ThemeResource IconPrimary}"/>
                                            <TextBlock Text="{x:Bind Name}"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       Foreground="{ThemeResource TextSecondary}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </views:ComponentPage.InteractiveContent>

    </views:ComponentPage>
</Page>
