<Page
    x:Class="EtherSandbox.Views.Foundations.IconsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:EtherSandbox.Views"
    xmlns:local="using:EtherSandbox.Views.Foundations"
    Loaded="OnLoaded">

    <views:ComponentPage
        Title="Icon Tokens"
        Description="DDS2 icon library — monoline SVGs from Assets/Icons/dds2, listed by name.">

        <views:ComponentPage.InteractiveContent>
            <StackPanel Spacing="12">
                <TextBlock Text="Size" Style="{StaticResource headers/h4}" Foreground="{ThemeResource text/primary}"/>
                <Border BorderBrush="{ThemeResource BorderSubtle}" BorderThickness="1"
                        CornerRadius="{StaticResource radius/control-sm}">
                    <ItemsControl x:Name="SizeItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:IconSizeItem">
                                <Grid Padding="12,10" ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Name}"
                                               HorizontalAlignment="Left"
                                               Foreground="{ThemeResource TextSecondary}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Size}"
                                               HorizontalAlignment="Left"
                                               Foreground="{ThemeResource text/brand}"/>
                                    <PathIcon Grid.Column="2" Data="{x:Bind IconData}"
                                              Width="{x:Bind Size}" Height="{x:Bind Size}"
                                              HorizontalAlignment="Left"
                                              Foreground="{ThemeResource icon/primary}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TextBlock Text="Icons" Style="{StaticResource headers/h4}" Foreground="{ThemeResource text/primary}"
                           Margin="0,8,0,0"/>
                <TextBlock x:Name="CountText"
                           Style="{StaticResource micro/semibold}"
                           Foreground="{ThemeResource TextTertiary}"/>
                <ItemsControl x:Name="IconRows">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:IconGalleryRow">
                            <ItemsControl ItemsSource="{x:Bind Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:IconGalleryItem">
                                        <StackPanel Width="88" Spacing="6" Padding="8"
                                                    HorizontalAlignment="Center">
                                            <PathIcon Style="{x:Bind IconStyle}"
                                                      Width="20" Height="20"
                                                      HorizontalAlignment="Center"
                                                      Foreground="{ThemeResource icon/primary}"/>
                                            <TextBlock Text="{x:Bind Name}"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       Foreground="{ThemeResource TextSecondary}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </views:ComponentPage.InteractiveContent>

    </views:ComponentPage>
</Page>
