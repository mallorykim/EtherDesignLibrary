<Page
    x:Class="EtherSandbox.Views.Surfaces.CardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls"
    xmlns:views="using:EtherSandbox.Views">

    <views:ComponentPage
        Title="Cards - Types"
        Description="Card component with gradient border effect, available in Normal, Intelligence (dark), and Callout (with header) types.">

        <views:ComponentPage.InteractiveContent>
            <StackPanel Width="1216" Spacing="24">
                <TextBlock Text="TYPE PREVIEWS"
                           Style="{StaticResource EtherMicroSemiBold}"
                           Foreground="{ThemeResource TextTertiary}"/>

                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="392"/>
                        <ColumnDefinition Width="392"/>
                        <ColumnDefinition Width="394"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="12">
                        <TextBlock Text="NORMAL"
                                   Style="{StaticResource EtherMicroSemiBold}"
                                   Foreground="{ThemeResource TextSecondary}"/>
                        <Border Style="{StaticResource EtherCardNormal}">
                            <Border Style="{StaticResource EtherCardNormalBody}">
                                <TextBlock Text="Card"
                                           FontFamily="{StaticResource InstrumentSans}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="Black"/>
                            </Border>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="12">
                        <TextBlock Text="INTELLIGENCE"
                                   Style="{StaticResource EtherMicroSemiBold}"
                                   Foreground="{ThemeResource TextSecondary}"/>
                        <Border Style="{StaticResource EtherCardIntelligence}">
                            <Border Style="{StaticResource EtherCardIntelligenceBody}">
                                <TextBlock Text="Card"
                                           FontFamily="{StaticResource InstrumentSans}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="White"/>
                            </Border>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="12">
                        <TextBlock Text="CALLOUT"
                                   Style="{StaticResource EtherMicroSemiBold}"
                                   Foreground="{ThemeResource TextSecondary}"/>
                        <Border Style="{StaticResource EtherCardCalloutShell}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Padding="12,8,12,8">
                                    <TextBlock Text="Intelligence Insight"
                                               FontFamily="{StaticResource InstrumentSans}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                    <Image Width="16"
                                           Height="16"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Stretch="Uniform"
                                           AutomationProperties.AccessibilityView="Raw">
                                        <Image.Source>
                                            <SvgImageSource UriSource="ms-appx:///Assets/Icons/ArrowRightAlt.svg"/>
                                        </Image.Source>
                                    </Image>
                                </Grid>

                                <Border Grid.Row="1"
                                        Style="{StaticResource EtherCardCalloutBody}">
                                    <TextBlock Text="Card"
                                               FontFamily="{StaticResource InstrumentSans}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="Black"/>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </views:ComponentPage.InteractiveContent>

    </views:ComponentPage>
</Page>
