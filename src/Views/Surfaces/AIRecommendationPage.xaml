<Page
    x:Class="EtherSandbox.Views.Surfaces.AIRecommendationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls"
    xmlns:views="using:EtherSandbox.Views">

    <views:ComponentPage
        Title="AI Recommendation"
        Description="Uses the gradient intelligence glow border (EtherCardIntelligence). Mode-invariant — looks the same in Light and Dark.">

        <views:ComponentPage.InteractiveContent>
            <Border Style="{StaticResource EtherCardIntelligence}" MaxWidth="480">
                <Border Style="{StaticResource EtherCardIntelligenceBody}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="="
                                       FontSize="16"
                                       Foreground="{ThemeResource AiAccentBlue}"/>
                            <TextBlock Text="AI Recommendation"
                                       Style="{StaticResource EtherH4}"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Based on your usage patterns, enabling Intelligent Battery Extender could extend your battery life by up to 2 hours today."
                                   FontFamily="{StaticResource InterFont}"
                                   FontSize="14"
                                   Foreground="#B3FFFFFF"
                                   TextWrapping="Wrap"/>
                        <controls:EtherButton Content="Enable now" Style="{StaticResource EtherButtonPrimarySmall}"/>
                    </StackPanel>
                </Border>
            </Border>
        </views:ComponentPage.InteractiveContent>

    </views:ComponentPage>
</Page>
