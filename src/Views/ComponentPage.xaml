<UserControl
    x:Class="EtherSandbox.Views.ComponentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls"
    x:Name="Root">

    <!--
        Shared chrome for every component page: title + description, an
        INTERACTIVE section (the live component) and a STATES section (visual
        states side by side). Leaf pages under Views/* supply only their own
        InteractiveContent / StatesContent — see ButtonPage.xaml for an example.

        StatesContent is optional: some source pages never authored discrete
        state swatches for a component (e.g. the nav-rail and chart specimens
        are shown once, at natural size), and inventing new ones would be
        redesigning rather than moving. When StatesContent is left unset the
        STATES card collapses instead of rendering empty.
    -->
    <Grid Background="{ThemeResource BackgroundCanvas}">
        <!--
            IsTabStop=True makes the ScrollViewer a valid focus target so a click on
            the page's empty space / non-interactive content (labels, descriptions)
            lands focus on the ScrollViewer itself — invisibly — instead of WinUI
            redirecting it to the first focusable descendant (which lit up the live
            specimen, e.g. the Input field's blue focus border, without the user
            clicking it). Unlike AllowFocusOnInteraction, IsTabStop does NOT cascade,
            so a direct click on a real control still focuses that control.
        -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      IsTabStop="True"
                      UseSystemFocusVisuals="False">
            <StackPanel Padding="24" Spacing="24">

                <!-- Page header -->
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{x:Bind Title, Mode=OneTime}"
                                   FontFamily="{StaticResource InstrumentSans}"
                                   FontSize="32" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimary}"/>
                        <controls:UpdatedBadge x:Name="UpdatedBadgeElement"
                                               Visibility="Collapsed"
                                               VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind Description, Mode=OneTime}"
                               FontFamily="{StaticResource InterFont}"
                               FontSize="14"
                               Foreground="{ThemeResource TextSecondary}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- =
                     INTERACTIVE
                = -->
                <Border Background="{ThemeResource BackgroundSurface}"
                        CornerRadius="{StaticResource RadiusSurface}"
                        Padding="24">
                    <StackPanel Spacing="16">
                        <!-- Header row: section label on the left; page-specific control
                             checkboxes and the opt-in "Disabled" checkbox on the right. These
                             live outside InteractiveHost so they stay enabled when the specimen
                             is disabled. -->
                        <Grid>
                            <TextBlock Text="INTERACTIVE"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource InterFont}"
                                       FontSize="10" FontWeight="SemiBold"
                                       CharacterSpacing="80"
                                       Foreground="{ThemeResource TextTertiary}"/>
                            <StackPanel Orientation="Horizontal" Spacing="20"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ContentPresenter Content="{x:Bind InteractiveControls, Mode=OneTime}"
                                                  VerticalAlignment="Center"/>
                                <controls:EtherCheckbox x:Name="DisabledCheck"
                                          Content="Disabled"
                                          Visibility="{x:Bind BoolToVisibility(HasDisabledToggle), Mode=OneTime}"
                                          Checked="OnDisabledToggled"
                                          Unchecked="OnDisabledToggled"/>
                            </StackPanel>
                        </Grid>
                        <!-- Disable-able host: ContentControl (unlike ContentPresenter) has
                             IsEnabled, which cascades to the specimen subtree. -->
                        <ContentControl x:Name="InteractiveHost"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Top"
                                        IsTabStop="False"
                                        Content="{x:Bind InteractiveContent, Mode=OneTime}"/>
                    </StackPanel>
                </Border>

                <!-- =
                     STATES
                = -->
                <Border Visibility="{x:Bind ConvertHasStates(StatesContent), Mode=OneTime}"
                        Background="{ThemeResource BackgroundSurface}"
                        CornerRadius="{StaticResource RadiusSurface}"
                        Padding="24">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{x:Bind StatesTitle, Mode=OneTime}"
                                   FontFamily="{StaticResource InterFont}"
                                   FontSize="10" FontWeight="SemiBold"
                                   CharacterSpacing="80"
                                   Foreground="{ThemeResource TextTertiary}"/>
                        <ContentPresenter Content="{x:Bind StatesContent, Mode=OneTime}"/>
                    </StackPanel>
                </Border>

                <Border Height="24"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
