<Page
    x:Class="EtherSandbox.Views.AIDesignLanguagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls"
    xmlns:views="using:EtherSandbox.Views">

    <!--
        Overview page for the AI design language, not a single component: the Dell AI
        Assistant panel and the Device Title Gradient are both part of how "AI" reads
        across the system rather than controls with their own dedicated pages.
    -->
    <views:ComponentPage
        Title="AI Design Language"
        Description="How AI reads across the system: the Dell AI Assistant panel and the device title gradient. Both are mode-invariant — look the same in Light and Dark.">

        <views:ComponentPage.InteractiveContent>
            <StackPanel Spacing="8">
                <TextBlock Text="DELL AI ASSISTANT PANEL — EtherAIAssistant (Empty state)"
                           Style="{StaticResource EtherMicroSemiBold}"
                           Foreground="{ThemeResource TextTertiary}"/>
                <TextBlock Text="342 px wide panel with sparkle icon, prompt input, and toolbar. BackgroundSurfaceRaised host."
                           Style="{StaticResource EtherMicroRegular}"
                           Foreground="{ThemeResource TextTertiary}"/>
                <Border Background="{ThemeResource BackgroundSurfaceRaised}"
                        CornerRadius="{StaticResource RadiusSurface}"
                        BorderBrush="{ThemeResource BorderSubtle}"
                        BorderThickness="1"
                        Width="342" Height="560"
                        HorizontalAlignment="Left">
                    <controls:EtherAIAssistant/>
                </Border>
            </StackPanel>
        </views:ComponentPage.InteractiveContent>

        <views:ComponentPage.StatesContent>
            <StackPanel Spacing="16">
                <TextBlock Text="Device Title Gradient — EtherDeviceTitle"
                           Style="{StaticResource EtherMicroSemiBold}"
                           Foreground="{ThemeResource TextTertiary}"/>
                <TextBlock Text="96 px Instrument Sans Bold with a navy-to-mid-blue linear gradient. Letter spacing −3.84 px (−40 units). Mode-invariant."
                           FontFamily="{StaticResource InterFont}"
                           FontSize="12" Foreground="{ThemeResource TextTertiary}"
                           TextWrapping="Wrap"/>
                <TextBlock Text="Dell Pro&#x0a;Max 14"
                           Style="{StaticResource EtherDeviceTitle}"/>
            </StackPanel>
        </views:ComponentPage.StatesContent>

    </views:ComponentPage>
</Page>
