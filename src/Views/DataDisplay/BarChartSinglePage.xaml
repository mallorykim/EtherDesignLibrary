<Page
    x:Class="EtherSandbox.Views.DataDisplay.BarChartSinglePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:EtherSandbox.Views">

    <views:ComponentPage
        Title="Bar Chart — Single"
        Description="Single-segment bar chart, thick (intelligence gradient) and thin (usage / storage) variants.">

        <views:ComponentPage.InteractiveContent>
            <StackPanel Spacing="12">
                <TextBlock Text="Thick — Gradient progress fill: #8FFFC3 — #0EB2FF — #0015FF — #141414."
                           FontFamily="{StaticResource InterFont}"
                           FontSize="12" Foreground="{ThemeResource TextTertiary}"/>
                <Border Background="{ThemeResource ActionTertiaryBgHover}"
                        Height="44" CornerRadius="{StaticResource RadiusControlSm}"
                        Padding="4" Width="547">
                    <Border CornerRadius="{StaticResource RadiusControlSm}"
                            Background="{StaticResource EtherBarThickGradient}"/>
                </Border>
            </StackPanel>
        </views:ComponentPage.InteractiveContent>

        <views:ComponentPage.StatesContent>
            <StackPanel Spacing="12">
                <TextBlock Text="Thin — Slim 4 px track with label row. Fill uses BackgroundBrand."
                           FontFamily="{StaticResource InterFont}"
                           FontSize="12" Foreground="{ThemeResource TextTertiary}"/>
                <StackPanel Orientation="Vertical" Spacing="8" Width="298" Padding="0,4,0,12">
                    <Grid>
                        <TextBlock Text="Cloud Repository"
                                   FontFamily="{StaticResource InstrumentSans}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource BackgroundSurfaceInverse}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="4/10GB Used"
                                   FontFamily="{StaticResource InterFont}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextSecondary}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Height="4">
                        <Border Background="{ThemeResource BackgroundSurfaceMuted}"
                                CornerRadius="6" Height="4"/>
                        <Border Background="{StaticResource BackgroundBrand}"
                                CornerRadius="4" Height="4"
                                Width="120" HorizontalAlignment="Left"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </views:ComponentPage.StatesContent>

    </views:ComponentPage>
</Page>
