<Page
    x:Class="EtherSandbox.Views.DataDisplay.BarChartTieredPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:EtherSandbox.Views">

    <views:ComponentPage
        Title="Bar Chart — Tiered"
        Description="Horizontal multi-segment bar with colour-coded legend.">

        <views:ComponentPage.InteractiveContent>
            <StackPanel Orientation="Vertical" Spacing="12" Width="393">
                <Border Background="{ThemeResource ActionTertiaryBgHover}"
                        Height="44" CornerRadius="{StaticResource RadiusControlSm}"
                        Padding="4,4,190,4">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{StaticResource ChartLevel0Navy}"
                                Width="97" CornerRadius="2,0,0,2"/>
                        <Border Background="{StaticResource ChartLevel1Blue}"
                                Width="43"/>
                        <Border Background="{StaticResource ChartLevel2Sky}"
                                Width="28"/>
                        <Border Background="{StaticResource ChartLevel3Cyan}"
                                Width="17" CornerRadius="0,2,2,0"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="4" VerticalAlignment="Center">
                        <Border Width="16" Height="8" CornerRadius="3"
                                Background="{ThemeResource BackgroundSurfaceInverse}"/>
                        <TextBlock Text="System"
                                   FontFamily="{StaticResource InterFont}"
                                   FontSize="11" FontWeight="Medium"
                                   Foreground="{ThemeResource TextTertiary}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="4" VerticalAlignment="Center">
                        <Border Width="16" Height="8" CornerRadius="3"
                                Background="{StaticResource ChartLevel1Blue}"
                                BorderBrush="#24000000" BorderThickness="1"/>
                        <TextBlock Text="Applications"
                                   FontFamily="{StaticResource InterFont}"
                                   FontSize="11" FontWeight="Medium"
                                   Foreground="{ThemeResource TextTertiary}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="4" VerticalAlignment="Center">
                        <Border Width="16" Height="8" CornerRadius="3"
                                Background="{StaticResource ChartLevel2Sky}"
                                BorderBrush="#24000000" BorderThickness="1"/>
                        <TextBlock Text="Trash"
                                   FontFamily="{StaticResource InterFont}"
                                   FontSize="11" FontWeight="Medium"
                                   Foreground="{ThemeResource TextTertiary}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="4" VerticalAlignment="Center">
                        <Border Width="16" Height="8" CornerRadius="3"
                                Background="{StaticResource ChartLevel3Cyan}"
                                BorderBrush="#24000000" BorderThickness="1"/>
                        <TextBlock Text="Etc"
                                   FontFamily="{StaticResource InterFont}"
                                   FontSize="11" FontWeight="Medium"
                                   Foreground="{ThemeResource TextTertiary}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </views:ComponentPage.InteractiveContent>

    </views:ComponentPage>
</Page>
