<Page
    x:Class="EtherSandbox.Views.DataDisplay.LineChartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:EtherSandbox.Views">

    <views:ComponentPage
        Title="Line Chart"
        Description="Y-axis labels, X-axis labels (Jan–Jun), BorderSubtle grid lines, and colour-coded legend. Chart lines are a PNG overlay — replace Image.Source with actual chart render.">

        <views:ComponentPage.InteractiveContent>
            <Grid Width="527" Padding="23,23,46,23">
                <StackPanel Orientation="Vertical" Spacing="23">
                    <Grid>
                        <TextBlock Text="100" FontFamily="{StaticResource InterFont}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ThemeResource BackgroundSurfaceInverse}"
                                   Width="39" VerticalAlignment="Center"/>
                        <Border HorizontalAlignment="Stretch" Margin="39,0,0,0"
                                BorderBrush="{ThemeResource BorderSubtle}"
                                BorderThickness="0,1,0,0" Height="1" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="75" FontFamily="{StaticResource InterFont}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ThemeResource BackgroundSurfaceInverse}"
                                   Width="39" VerticalAlignment="Center"/>
                        <Border HorizontalAlignment="Stretch" Margin="39,0,0,0"
                                BorderBrush="{ThemeResource BorderSubtle}"
                                BorderThickness="0,1,0,0" Height="1" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="50" FontFamily="{StaticResource InterFont}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ThemeResource BackgroundSurfaceInverse}"
                                   Width="39" VerticalAlignment="Center"/>
                        <Border HorizontalAlignment="Stretch" Margin="39,0,0,0"
                                BorderBrush="{ThemeResource BorderSubtle}"
                                BorderThickness="0,1,0,0" Height="1" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="25" FontFamily="{StaticResource InterFont}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ThemeResource BackgroundSurfaceInverse}"
                                   Width="39" VerticalAlignment="Center"/>
                        <Border HorizontalAlignment="Stretch" Margin="39,0,0,0"
                                BorderBrush="{ThemeResource BorderSubtle}"
                                BorderThickness="0,1,0,0" Height="1" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Orientation="Vertical" Spacing="12">
                        <Grid>
                            <TextBlock Text="0" FontFamily="{StaticResource InterFont}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource BackgroundSurfaceInverse}"
                                       Width="39" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Stretch" Margin="39,0,0,0"
                                    BorderBrush="{ThemeResource BorderDefault}"
                                    BorderThickness="0,1,0,0" Height="1" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="101" Margin="60,0,0,0">
                            <TextBlock Text="Jan" FontFamily="{StaticResource InterFont}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                            <TextBlock Text="Feb" FontFamily="{StaticResource InterFont}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                            <TextBlock Text="Mar" FontFamily="{StaticResource InterFont}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                            <TextBlock Text="Apr" FontFamily="{StaticResource InterFont}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="4" VerticalAlignment="Center">
                            <Border Width="12" Height="4" CornerRadius="1"
                                    Background="{StaticResource ChartPurple}"/>
                            <TextBlock Text="CPU Temp" FontFamily="{StaticResource InterFont}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="4" VerticalAlignment="Center">
                            <Border Width="12" Height="4" CornerRadius="1"
                                    Background="{StaticResource ChartLevel2Sky}"/>
                            <TextBlock Text="Battery Drain" FontFamily="{StaticResource InterFont}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="4" VerticalAlignment="Center">
                            <Border Width="12" Height="4" CornerRadius="1"
                                    Background="{StaticResource ChartCyanBright}"/>
                            <TextBlock Text="Charge Rate" FontFamily="{StaticResource InterFont}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </views:ComponentPage.InteractiveContent>

    </views:ComponentPage>
</Page>
