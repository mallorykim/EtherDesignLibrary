<Page
    x:Class="EtherSandbox.Views.DataDisplay.DataBlocksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:EtherSandbox.Views">

    <views:ComponentPage
        Title="Data Blocks"
        Description="2×2 stat grid. BackgroundSurfaceRaised blocks with optional StatusWarningBg highlight.">

        <views:ComponentPage.InteractiveContent>
            <StackPanel Orientation="Vertical" Spacing="8" Width="306">
                <TextBlock Text="eMMC Health for ThinOS"
                           FontFamily="{StaticResource InstrumentSans}"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimary}"/>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <Border Background="{ThemeResource BackgroundSurfaceRaised}"
                                Width="151" CornerRadius="{StaticResource RadiusControl}"
                                Padding="16,13,16,13" Margin="0,0,4,4">
                            <StackPanel Orientation="Vertical" Spacing="12">
                                <TextBlock Text="0"
                                           FontFamily="{StaticResource InstrumentSans}"
                                           FontSize="24" FontWeight="SemiBold"
                                           Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                                <TextBlock Text="Urgent"
                                           FontFamily="{StaticResource InstrumentSans}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Opacity="0.70"
                                           Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{ThemeResource StatusWarningBg}"
                                Width="151" CornerRadius="{StaticResource RadiusControl}"
                                Padding="16,13,16,13" Margin="0,0,0,4">
                            <StackPanel Orientation="Vertical" Spacing="12">
                                <TextBlock Text="1"
                                           FontFamily="{StaticResource InstrumentSans}"
                                           FontSize="24" FontWeight="SemiBold"
                                           Foreground="{ThemeResource StatusWarningBorder}"/>
                                <TextBlock Text="Warning"
                                           FontFamily="{StaticResource InstrumentSans}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Opacity="0.70"
                                           Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <Border Background="{ThemeResource BackgroundSurfaceRaised}"
                                Width="151" CornerRadius="{StaticResource RadiusControl}"
                                Padding="16,13,16,13" Margin="0,0,4,0">
                            <StackPanel Orientation="Vertical" Spacing="12">
                                <TextBlock Text="3"
                                           FontFamily="{StaticResource InstrumentSans}"
                                           FontSize="24" FontWeight="SemiBold"
                                           Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                                <TextBlock Text="Normal"
                                           FontFamily="{StaticResource InstrumentSans}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Opacity="0.70"
                                           Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{ThemeResource BackgroundSurfaceRaised}"
                                Width="151" CornerRadius="{StaticResource RadiusControl}"
                                Padding="16,13,16,13">
                            <StackPanel Orientation="Vertical" Spacing="12">
                                <TextBlock Text="6"
                                           FontFamily="{StaticResource InstrumentSans}"
                                           FontSize="24" FontWeight="SemiBold"
                                           Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                                <TextBlock Text="Reserved"
                                           FontFamily="{StaticResource InstrumentSans}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Opacity="0.70"
                                           Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </views:ComponentPage.InteractiveContent>

    </views:ComponentPage>
</Page>
