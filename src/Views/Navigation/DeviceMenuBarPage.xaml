<Page
    x:Class="EtherSandbox.Views.Navigation.DeviceMenuBarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls"
    xmlns:views="using:EtherSandbox.Views">

    <views:ComponentPage
        Title="Device Menu Bar"
        Description="Horizontal dock of device chips. Selected chip: BackgroundCanvas + label. Unselected: icon only.">

        <views:ComponentPage.InteractiveContent>
            <Border Background="{ThemeResource BackgroundInteractionModel}"
                    CornerRadius="{StaticResource RadiusSurface}"
                    Padding="0,4,0,4">
                <controls:EtherDeviceMenu HorizontalAlignment="Left"/>
            </Border>
        </views:ComponentPage.InteractiveContent>

    </views:ComponentPage>
</Page>
