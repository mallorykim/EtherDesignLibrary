<Page
    x:Class="EtherSandbox.Views.Navigation.WideNavPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls"
    xmlns:views="using:EtherSandbox.Views">

    <views:ComponentPage
        Title="Wide Nav (230px)"
        Description="Active item: #090D15 background, full-width, 48 px high. Inactive: TextNavInactive.">

        <views:ComponentPage.InteractiveContent>
            <Border Width="230" Height="560"
                    CornerRadius="{StaticResource RadiusSurface}">
                <controls:EtherWideNav/>
            </Border>
        </views:ComponentPage.InteractiveContent>

    </views:ComponentPage>
</Page>
