<Page
    x:Class="EtherSandbox.Views.Navigation.MastheadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls"
    xmlns:views="using:EtherSandbox.Views">

    <views:ComponentPage
        Title="Masthead"
        Description="Right-aligned masthead caption controls with 44 px hit targets for minimize, maximize/restore, and close."
        StatesTitle="VISUAL STATES">

        <views:ComponentPage.InteractiveContent>
            <views:ControlExample SourceXaml="{x:Bind SpecimenXaml, Mode=OneTime}">
            <StackPanel Width="720" Spacing="16">
                <Border Background="{ThemeResource BackgroundSurfaceRaised}"
                        BorderBrush="{ThemeResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource radius/surface}"
                        Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Default"
                                   FontFamily="{StaticResource InstrumentSans}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource text/primary}"/>
                        <Border CornerRadius="{StaticResource radius/surface}">
                            <controls:EtherMasthead ShowSettings="False"
                                                    PreviewIsMaximized="False"
                                                    EnableWindowCommands="False"
                                                    AutomationProperties.Name="Default masthead"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource BackgroundSurfaceRaised}"
                        BorderBrush="{ThemeResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource radius/surface}"
                        Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Maximized"
                                   FontFamily="{StaticResource InstrumentSans}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource text/primary}"/>
                        <Border CornerRadius="{StaticResource radius/surface}">
                            <controls:EtherMasthead ShowSettings="False"
                                                    PreviewIsMaximized="True"
                                                    EnableWindowCommands="False"
                                                    AutomationProperties.Name="Maximized masthead"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
            </views:ControlExample>
        </views:ComponentPage.InteractiveContent>

    </views:ComponentPage>
</Page>
