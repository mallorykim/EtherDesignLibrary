<Page
    x:Class="EtherSandbox.Views.Navigation.RightPanelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls"
    xmlns:views="using:EtherSandbox.Views">

    <views:ComponentPage
        Title="Right Panel (362px)"
        Description="Side panel with optional segmented control at top and primary button at bottom.">

        <views:ComponentPage.InteractiveContent>
            <Border Height="480"
                    Width="362"
                    CornerRadius="{StaticResource RadiusSurface}">
                <controls:EtherRightPanel/>
            </Border>
        </views:ComponentPage.InteractiveContent>

    </views:ComponentPage>
</Page>
