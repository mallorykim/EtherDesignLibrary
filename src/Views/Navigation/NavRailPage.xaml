<Page
    x:Class="EtherSandbox.Views.Navigation.NavRailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls"
    xmlns:views="using:EtherSandbox.Views">

    <views:ComponentPage
        Title="Nav Rail (101px)"
        Description="Active pill: #1A1A1A — radius 13 — 85×70. Inactive items: TextNavNarrowInactive.">

        <views:ComponentPage.InteractiveContent>
            <!-- Clipped container to show the rail at natural size -->
            <Border Width="101" Height="560"
                    CornerRadius="{StaticResource RadiusSurface}">
                <controls:EtherNavRail/>
            </Border>
        </views:ComponentPage.InteractiveContent>

    </views:ComponentPage>
</Page>
