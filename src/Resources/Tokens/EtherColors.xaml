            <!-- Action / Secondary -->
            <SolidColorBrush x:Key="ActionSecondaryBg"        Color="{StaticResource White00}"/>
            <SolidColorBrush x:Key="ActionSecondaryBgHover"   Color="{StaticResource Gray650}"/>
            <SolidColorBrush x:Key="ActionSecondaryBgPressed" Color="{StaticResource Gray725}"/>
            <SolidColorBrush x:Key="ActionSecondaryBorder"    Color="{StaticResource White20}"/>
            <SolidColorBrush x:Key="ActionSecondaryFg"        Color="{StaticResource White100}"/>

            <!-- Action / Tertiary -->
            <SolidColorBrush x:Key="ActionTertiaryBgHover"   Color="{StaticResource White04}"/>
            <SolidColorBrush x:Key="ActionTertiaryFg"       Color="{StaticResource Blue700}"/>
            <SolidColorBrush x:Key="ActionTertiaryFgHover"   Color="{StaticResource Blue650}"/>
            <SolidColorBrush x:Key="ActionTertiaryFgPressed" Color="{StaticResource Blue700}"/>
            <SolidColorBrush x:Key="ActionTertiaryFgDisabled" Color="{StaticResource Blue550}"/>

            <!-- Action / Danger -->
            <SolidColorBrush x:Key="ActionDangerBg"      Color="{StaticResource Red600}"/>
            <SolidColorBrush x:Key="ActionDangerBgHover" Color="{StaticResource Red450}"/>
            <SolidColorBrush x:Key="ActionDangerFg"      Color="{StaticResource White100}"/>

            <!-- Status / Success -->
            <SolidColorBrush x:Key="StatusSuccessFg"     Color="{StaticResource Green400}"/>
            <SolidColorBrush x:Key="StatusSuccessBg"     Color="{StaticResource Green500Alpha16}"/>
            <SolidColorBrush x:Key="StatusSuccessBorder" Color="{StaticResource Green400}"/>

            <!-- Status / Warning -->
            <SolidColorBrush x:Key="StatusWarningFg"     Color="{StaticResource Yellow500}"/>
            <SolidColorBrush x:Key="StatusWarningBg"     Color="{StaticResource Yellow500Alpha16}"/>
            <SolidColorBrush x:Key="StatusWarningBorder" Color="{StaticResource Yellow500}"/>

            <!-- Status / Danger -->
            <SolidColorBrush x:Key="StatusDangerFg"     Color="{StaticResource Red500}"/>
            <SolidColorBrush x:Key="StatusDangerBg"     Color="{StaticResource Red450Alpha16}"/>
            <SolidColorBrush x:Key="StatusDangerBorder" Color="{StaticResource Red450}"/>

            <!-- Status / Info -->
            <SolidColorBrush x:Key="StatusInfoFg"     Color="{StaticResource Blue500}"/>
            <SolidColorBrush x:Key="StatusInfoBg"     Color="{StaticResource Blue600Alpha16}"/>
            <SolidColorBrush x:Key="StatusInfoBorder" Color="{StaticResource Blue500}"/>

            <!-- AI Accents -->
            <SolidColorBrush x:Key="AiAccentPurple" Color="{StaticResource Purple400}"/>
