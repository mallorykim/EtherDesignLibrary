            <SolidColorBrush x:Key="BorderDefault"  Color="{StaticResource Navy900Alpha20}"/>
            <SolidColorBrush x:Key="BorderStrong"   Color="{StaticResource Navy900Alpha40}"/>
            <SolidColorBrush x:Key="BorderFocus"    Color="{StaticResource Blue600}"/>
            <SolidColorBrush x:Key="BorderBrand"    Color="{StaticResource Blue600}"/>
            <SolidColorBrush x:Key="BorderInverse"  Color="{StaticResource Black100}"/>
            <SolidColorBrush x:Key="BorderDanger"   Color="{StaticResource Red600}"/>
            <SolidColorBrush x:Key="BorderSuccess"  Color="{StaticResource Green500}"/>

            <!-- Action / Primary -->
