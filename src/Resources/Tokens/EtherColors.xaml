<!--
    EtherColors.xaml = Ether Design System � Color Resource Dictionary

    USAGE:
      ThemeResource  ? mode=adaptive tokens (Light/Dark auto=swap)
        <TextBlock Foreground="{ThemeResource TextPrimary}"/>
      StaticResource ? mode=invariant tokens (same in both modes)
        <Border Background="{StaticResource BackgroundBrand}"/>

    NAMING:  background/surface=raised ? BackgroundSurfaceRaised
             action/primary/bg=hover   ? ActionPrimaryBgHover

    ALPHA:   8=digit hex #AARRGGBB  (4%=0x0A � 8%=0x14 � 10%=0x1A �
             12%=0x1F � 16%=0x29 � 20%=0x33 � 25%=0x40 � 30%=0x4D �
             40%=0x66 � 50%=0x80 � 60%=0x99 � 65%=0xA6 � 70%=0xB3)
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ======================= LIGHT =========================== -->
        <ResourceDictionary x:Key="Light">

            <!-- Background -->
            <SolidColorBrush x:Key="BackgroundCanvas"           Color="{StaticResource White100}"/>
            <SolidColorBrush x:Key="BackgroundSurface"          Color="{StaticResource White100}"/>
            <SolidColorBrush x:Key="BackgroundSurfaceRaised"    Color="{StaticResource Gray20}"/>
            <SolidColorBrush x:Key="BackgroundSurfaceSunken"    Color="{StaticResource Gray40}"/>
            <SolidColorBrush x:Key="BackgroundSurfaceMuted"     Color="{StaticResource Gray60}"/>

            <SolidColorBrush x:Key="BackgroundSurfaceInverse"   Color="{StaticResource Black100}"/>
            <SolidColorBrush x:Key="BackgroundInteractionModel" Color="{StaticResource Gray70}"/>
            <SolidColorBrush x:Key="BackgroundOverlayScrim"     Color="{StaticResource Black60}"/>
            <SolidColorBrush x:Key="BackgroundGlassLight"       Color="{StaticResource White70}"/>
            <SolidColorBrush x:Key="BackgroundGlassDark"        Color="{StaticResource Black40}"/>
            <SolidColorBrush x:Key="BackgroundBrandSubtle"      Color="{StaticResource Blue600Alpha10}"/>
            <SolidColorBrush x:Key="BackgroundDivider"          Color="{StaticResource Gray100}"/>
            <SolidColorBrush x:Key="BackgroundPlaceholder"      Color="{StaticResource Gray80}"/>
            <SolidColorBrush x:Key="BackgroundTrack"            Color="{StaticResource Gray100}"/>
            <SolidColorBrush x:Key="BackgroundDropdownScrollThumb" Color="{StaticResource Gray300}"/>
            <SolidColorBrush x:Key="BackgroundDropdownScrollThumbHover" Color="{StaticResource Gray500}"/>
            <!-- Toggle switch OFF track: Figma uses black at 10%, independent of slider tracks. -->
            <SolidColorBrush x:Key="BackgroundSwitchOff"        Color="{StaticResource Black10}"/>
            <SolidColorBrush x:Key="BackgroundSwitchKnobDisabled" Color="{StaticResource Gray05}"/>
            <SolidColorBrush x:Key="BackgroundSegmentTrack"     Color="{StaticResource Gray20}"/>
            <SolidColorBrush x:Key="BackgroundSegmentHover"     Color="{StaticResource Blue600Alpha06}"/>
            <SolidColorBrush x:Key="BackgroundSegmentPressed"   Color="{StaticResource Blue600Alpha10}"/>
            <SolidColorBrush x:Key="BackgroundAiInput"           Color="{StaticResource Gray90Alpha40}"/>
            <SolidColorBrush x:Key="BackgroundDropdown"          Color="{StaticResource Black08}"/>
            <SolidColorBrush x:Key="BackgroundDropdownHover"     Color="{StaticResource Black14}"/>
            <SolidColorBrush x:Key="BackgroundDropdownPressed"   Color="{StaticResource Black20}"/>
            <SolidColorBrush x:Key="BackgroundDropdownMenu"      Color="{StaticResource Gray50}"/>
            <SolidColorBrush x:Key="BackgroundDropdownItemSelected"        Color="{StaticResource Gray25}"/>
            <SolidColorBrush x:Key="BackgroundDropdownItemSelectedHover"   Color="{StaticResource Gray30}"/>
            <SolidColorBrush x:Key="BackgroundDropdownItemSelectedPressed" Color="{StaticResource Gray10}"/>

            <!-- Text -->
            <SolidColorBrush x:Key="TextPrimary"   Color="{StaticResource Black100}"/>
            <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource Black70}"/>
            <SolidColorBrush x:Key="TextTertiary"  Color="{StaticResource Black50}"/>
            <SolidColorBrush x:Key="TextDisabled"  Color="{StaticResource Black30}"/>
            <SolidColorBrush x:Key="TextInverse"   Color="{StaticResource White100}"/>
            <SolidColorBrush x:Key="TextBrand"     Color="{StaticResource Blue600}"/>
            <SolidColorBrush x:Key="TextSuccess"   Color="{StaticResource Green700}"/>
            <SolidColorBrush x:Key="TextWarning"   Color="{StaticResource Yellow700}"/>
            <SolidColorBrush x:Key="TextDanger"    Color="{StaticResource Red600}"/>
            <SolidColorBrush x:Key="TextAi"        Color="{StaticResource Purple500}"/>
            <SolidColorBrush x:Key="TextNavNarrowInactive" Color="{StaticResource Black60}"/>
