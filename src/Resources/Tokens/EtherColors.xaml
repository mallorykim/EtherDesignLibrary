            <!-- Icon (mirrors Text roles) -->
            <SolidColorBrush x:Key="IconPrimary"   Color="{StaticResource Black100}"/>
            <SolidColorBrush x:Key="IconSecondary" Color="{StaticResource Black70}"/>
            <SolidColorBrush x:Key="IconTertiary"  Color="{StaticResource Black50}"/>
            <SolidColorBrush x:Key="IconDisabled"  Color="{StaticResource Black30}"/>
            <SolidColorBrush x:Key="IconInverse"   Color="{StaticResource White100}"/>
            <SolidColorBrush x:Key="IconBrand"     Color="{StaticResource Blue600}"/>
