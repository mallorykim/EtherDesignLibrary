            <SolidColorBrush x:Key="BackgroundSwitchKnobDisabled" Color="{StaticResource Gray82}"/>
            <SolidColorBrush x:Key="BackgroundSegmentTrack"     Color="{StaticResource White10}"/>
            <SolidColorBrush x:Key="BackgroundSegmentHover"     Color="{StaticResource White06}"/>
