        </ResourceDictionary>

        <!--
            HIGH CONTRAST
            =========================================================================
            Every key defined in Light/Dark must also exist here: ThemeDictionaries
            resolve per theme and do NOT fall back to another theme's dictionary, so a
            partial high-contrast set would fail lookups once the mode is active.

            High contrast deliberately discards brand colour. The user has chosen a
            system palette for legibility, so each token maps to the matching system
            colour rather than a tinted approximation — semantic hues (success, danger,
            AI) all flatten to the system text colour, and every "selected/hover/
            pressed" surface becomes the system highlight. Referencing SystemColor*
            resources with {ThemeResource} inside a theme dictionary is the documented
            exception to the "use StaticResource internally" rule.
        -->
        <ResourceDictionary x:Key="HighContrast">

            <!-- Surfaces -->
            <SolidColorBrush x:Key="BackgroundCanvas"            Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="BackgroundSurface"           Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="BackgroundSurfaceRaised"     Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="BackgroundSurfaceSunken"     Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="BackgroundSurfaceMuted"      Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="BackgroundSurfaceInverse"    Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="BackgroundInteractionModel"  Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="BackgroundOverlayScrim"      Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="BackgroundGlassLight"        Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="BackgroundGlassDark"         Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="BackgroundBrandSubtle"       Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="BackgroundDivider"           Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="BackgroundPlaceholder"       Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="BackgroundTrack"             Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="BackgroundDropdownScrollThumb" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="BackgroundDropdownScrollThumbHover" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="BackgroundSwitchOff"         Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="BackgroundSwitchKnobDisabled" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="BackgroundSegmentTrack"      Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="BackgroundSegmentHover"      Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="BackgroundSegmentPressed"    Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="BackgroundAiInput"           Color="{ThemeResource SystemColorButtonFaceColor}"/>

            <!-- Dropdown -->
            <SolidColorBrush x:Key="BackgroundDropdown"                    Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="BackgroundDropdownHover"               Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="BackgroundDropdownPressed"             Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="BackgroundDropdownMenu"                Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="BackgroundDropdownItemSelected"        Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="BackgroundDropdownItemSelectedHover"   Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="BackgroundDropdownItemSelectedPressed" Color="{ThemeResource SystemColorHighlightColor}"/>

            <!-- Text -->
            <SolidColorBrush x:Key="TextPrimary"            Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="TextSecondary"          Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="TextTertiary"           Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="TextDisabled"           Color="{ThemeResource SystemColorGrayTextColor}"/>
            <SolidColorBrush x:Key="TextInverse"            Color="{ThemeResource SystemColorHighlightTextColor}"/>
            <SolidColorBrush x:Key="TextBrand"              Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="TextSuccess"            Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="TextWarning"            Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="TextDanger"             Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="TextAi"                 Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="TextNavNarrowInactive"  Color="{ThemeResource SystemColorGrayTextColor}"/>
            <SolidColorBrush x:Key="TextNavInactive"        Color="{ThemeResource SystemColorGrayTextColor}"/>

            <!-- Icons -->
            <SolidColorBrush x:Key="IconPrimary"   Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="IconSecondary" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="IconTertiary"  Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="IconDisabled"  Color="{ThemeResource SystemColorGrayTextColor}"/>
            <SolidColorBrush x:Key="IconInverse"   Color="{ThemeResource SystemColorHighlightTextColor}"/>
            <SolidColorBrush x:Key="IconBrand"     Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="IconAi"        Color="{ThemeResource SystemColorWindowTextColor}"/>

            <!-- Borders -->
            <SolidColorBrush x:Key="BorderSubtle"  Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="BorderDefault" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="BorderStrong"  Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="BorderFocus"   Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="BorderBrand"   Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="BorderInverse" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="BorderDanger"  Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="BorderSuccess" Color="{ThemeResource SystemColorWindowTextColor}"/>

            <!-- Actions -->
            <SolidColorBrush x:Key="ActionPrimaryBg"          Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="ActionPrimaryBgHover"     Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="ActionPrimaryBgPressed"   Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="ActionPrimaryBgDisabled"  Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="ActionPrimaryFg"          Color="{ThemeResource SystemColorHighlightTextColor}"/>
            <SolidColorBrush x:Key="ActionPrimaryFgDisabled"  Color="{ThemeResource SystemColorGrayTextColor}"/>
            <SolidColorBrush x:Key="ActionSecondaryBg"        Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="ActionSecondaryBgHover"   Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="ActionSecondaryBgPressed" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="ActionSecondaryBorder"    Color="{ThemeResource SystemColorButtonTextColor}"/>
            <SolidColorBrush x:Key="ActionSecondaryFg"        Color="{ThemeResource SystemColorButtonTextColor}"/>
            <SolidColorBrush x:Key="ActionTertiaryBgHover"    Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="ActionTertiaryFg"         Color="{ThemeResource SystemColorButtonTextColor}"/>
            <SolidColorBrush x:Key="ActionTertiaryFgHover"    Color="{ThemeResource SystemColorHighlightTextColor}"/>
            <SolidColorBrush x:Key="ActionTertiaryFgPressed"  Color="{ThemeResource SystemColorHighlightTextColor}"/>
            <SolidColorBrush x:Key="ActionTertiaryFgDisabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
            <SolidColorBrush x:Key="ActionDangerBg"           Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="ActionDangerBgHover"      Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="ActionDangerFg"           Color="{ThemeResource SystemColorHighlightTextColor}"/>

            <!-- Status -->
            <SolidColorBrush x:Key="StatusSuccessFg"     Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="StatusSuccessBg"     Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="StatusSuccessBorder" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="StatusWarningFg"     Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="StatusWarningBg"     Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="StatusWarningBorder" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="StatusDangerFg"      Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="StatusDangerBg"      Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="StatusDangerBorder"  Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="StatusInfoFg"        Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="StatusInfoBg"        Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="StatusInfoBorder"    Color="{ThemeResource SystemColorWindowTextColor}"/>

            <!-- AI Accents -->
            <SolidColorBrush x:Key="AiAccentPurple" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="AiAccentBlue"   Color="{ThemeResource SystemColorHighlightColor}"/>

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- =============== MODE=INVARIANT  (StaticResource) =========== -->

    <!-- Background / brand -->
    <!-- Card Intelligence: always black regardless of theme -->
    <SolidColorBrush x:Key="BackgroundCardIntelligence" Color="{StaticResource Black100}"/>
    <SolidColorBrush x:Key="BackgroundBrand"     Color="{StaticResource Blue600}"/>
    <SolidColorBrush x:Key="BackgroundBrandSoft" Color="{StaticResource Blue600Alpha60}"/>
    <SolidColorBrush x:Key="BackgroundBrandGlow" Color="{StaticResource Blue400Alpha65}"/>

    <!-- Text / Icon on=brand (always white) -->
    <SolidColorBrush x:Key="TextOnBrand" Color="{StaticResource White100}"/>
    <SolidColorBrush x:Key="IconOnBrand" Color="{StaticResource White100}"/>

    <!-- AI Accent / Cyan -->
    <SolidColorBrush x:Key="AiAccentCyan" Color="{StaticResource Cyan300}"/>
    <!-- Intelligence button stacked stroke gradients (Figma node 60438:579).
         Figma applies these two linear strokes in order, both 1 px inside. -->
    <RadialGradientBrush x:Key="BorderIntelligenceBlue"
                         Center="0.5,0.5"
                         GradientOrigin="0.5,0.5"
                         RadiusX="0.5"
                         RadiusY="1">
        <GradientStop Offset="0" Color="{StaticResource Purple200}"/>
        <GradientStop Offset="0.13" Color="{StaticResource Blue550}"/>
        <GradientStop Offset="0.4" Color="{StaticResource Blue550}"/>
        <GradientStop Offset="0.66" Color="{StaticResource Blue550}"/>
