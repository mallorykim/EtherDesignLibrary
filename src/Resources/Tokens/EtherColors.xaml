            <SolidColorBrush x:Key="BackgroundOverlayScrim"     Color="{StaticResource Black70}"/>
            <SolidColorBrush x:Key="BackgroundGlassLight"       Color="{StaticResource White08}"/>
            <SolidColorBrush x:Key="BackgroundGlassDark"        Color="{StaticResource Black60}"/>
            <SolidColorBrush x:Key="BackgroundBrandSubtle"      Color="{StaticResource Blue600Alpha16}"/>
            <SolidColorBrush x:Key="BackgroundDivider"          Color="{StaticResource White16}"/>
            <SolidColorBrush x:Key="BackgroundPlaceholder"      Color="{StaticResource Gray600}"/>
