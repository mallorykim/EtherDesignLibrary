            <SolidColorBrush x:Key="TextInverse"   Color="{StaticResource Black100}"/>
            <SolidColorBrush x:Key="TextBrand"     Color="{StaticResource Blue500}"/>
            <SolidColorBrush x:Key="TextSuccess"   Color="{StaticResource Green400}"/>
            <SolidColorBrush x:Key="TextWarning"   Color="{StaticResource Yellow500}"/>
            <SolidColorBrush x:Key="TextDanger"    Color="{StaticResource Red500}"/>
            <SolidColorBrush x:Key="TextAi"        Color="{StaticResource Purple400}"/>
            <SolidColorBrush x:Key="TextNavNarrowInactive" Color="{StaticResource White60}"/>
            <SolidColorBrush x:Key="TextNavInactive"       Color="{StaticResource White50}"/>            

            <!-- Icon (mirrors Text roles) -->
            <SolidColorBrush x:Key="IconPrimary"   Color="{StaticResource White100}"/>
            <SolidColorBrush x:Key="IconSecondary" Color="{StaticResource White70}"/>
            <SolidColorBrush x:Key="IconTertiary"  Color="{StaticResource White50}"/>
            <SolidColorBrush x:Key="IconDisabled"  Color="{StaticResource White30}"/>
            <SolidColorBrush x:Key="IconInverse"   Color="{StaticResource Black100}"/>
            <SolidColorBrush x:Key="IconBrand"     Color="{StaticResource Blue500}"/>
            <SolidColorBrush x:Key="IconAi"        Color="{StaticResource Purple400}"/>

            <!-- Border -->
            <SolidColorBrush x:Key="BorderSubtle"   Color="{StaticResource White08}"/>
            <SolidColorBrush x:Key="BorderDefault"  Color="{StaticResource White12}"/>
            <SolidColorBrush x:Key="BorderStrong"   Color="{StaticResource White25}"/>
            <SolidColorBrush x:Key="BorderFocus"    Color="{StaticResource Blue500}"/>
            <SolidColorBrush x:Key="BorderBrand"    Color="{StaticResource Blue500}"/>
            <SolidColorBrush x:Key="BorderInverse"  Color="{StaticResource White100}"/>
            <SolidColorBrush x:Key="BorderDanger"   Color="{StaticResource Red450}"/>
            <SolidColorBrush x:Key="BorderSuccess"  Color="{StaticResource Green400}"/>

            <!-- Action / Primary -->
            <SolidColorBrush x:Key="ActionPrimaryBg"         Color="{StaticResource Blue550}"/>
            <SolidColorBrush x:Key="ActionPrimaryBgHover"    Color="{StaticResource Blue650}"/>
            <SolidColorBrush x:Key="ActionPrimaryBgPressed"  Color="{StaticResource Blue700}"/>
            <SolidColorBrush x:Key="ActionPrimaryBgDisabled" Color="{StaticResource Blue550Alpha40}"/>
            <SolidColorBrush x:Key="ActionPrimaryFg"         Color="{StaticResource White100}"/>
