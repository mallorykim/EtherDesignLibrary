            <SolidColorBrush x:Key="ActionSecondaryBgPressed" Color="{StaticResource Gray40}"/>
            <SolidColorBrush x:Key="ActionSecondaryBorder"    Color="{StaticResource Navy900Alpha20}"/>
            <SolidColorBrush x:Key="ActionSecondaryFg"        Color="{StaticResource Black100}"/>

            <!-- Action / Tertiary -->
            <SolidColorBrush x:Key="ActionTertiaryBgHover"   Color="{StaticResource Black04}"/>
            <SolidColorBrush x:Key="ActionTertiaryFg"       Color="{StaticResource Blue700}"/>
            <SolidColorBrush x:Key="ActionTertiaryFgHover"   Color="{StaticResource Blue650}"/>
            <SolidColorBrush x:Key="ActionTertiaryFgPressed" Color="{StaticResource Blue700}"/>
            <SolidColorBrush x:Key="ActionTertiaryFgDisabled" Color="{StaticResource Blue550}"/>

            <!-- Action / Danger -->
            <SolidColorBrush x:Key="ActionDangerBg"      Color="{StaticResource Red600}"/>
            <SolidColorBrush x:Key="ActionDangerBgHover" Color="{StaticResource Red400}"/>
            <SolidColorBrush x:Key="ActionDangerFg"      Color="{StaticResource White100}"/>

            <!-- Status / Success -->
            <SolidColorBrush x:Key="StatusSuccessFg"     Color="{StaticResource Green700}"/>
            <SolidColorBrush x:Key="StatusSuccessBg"     Color="{StaticResource Green500Alpha12}"/>
            <SolidColorBrush x:Key="StatusSuccessBorder" Color="{StaticResource Green500}"/>

            <!-- Status / Warning -->
            <SolidColorBrush x:Key="StatusWarningFg"     Color="{StaticResource Yellow700}"/>
            <SolidColorBrush x:Key="StatusWarningBg"     Color="{StaticResource Yellow500Alpha20}"/>
