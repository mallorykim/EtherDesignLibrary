            <SolidColorBrush x:Key="BackgroundDropdownHover"     Color="{StaticResource White14}"/>
            <SolidColorBrush x:Key="BackgroundDropdownPressed"   Color="{StaticResource White20}"/>
            <SolidColorBrush x:Key="BackgroundDropdownMenu"      Color="{StaticResource Gray875}"/>
            <SolidColorBrush x:Key="BackgroundDropdownItemSelected"        Color="{StaticResource Gray320}"/>
            <SolidColorBrush x:Key="BackgroundDropdownItemSelectedHover"   Color="{StaticResource Gray400}"/>
