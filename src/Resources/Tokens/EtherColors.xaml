            <SolidColorBrush x:Key="StatusDangerBg"     Color="{StaticResource Red450Alpha12}"/>
            <SolidColorBrush x:Key="StatusDangerBorder" Color="{StaticResource Red600}"/>

            <!-- Status / Info -->
            <SolidColorBrush x:Key="StatusInfoFg"     Color="{StaticResource Blue600}"/>
            <SolidColorBrush x:Key="StatusInfoBg"     Color="{StaticResource Blue600Alpha10}"/>
