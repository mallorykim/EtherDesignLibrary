<!--
    EtherSpacing.xaml = Ether Design System · Spacing & Radius

    All values are mode=invariant = use {StaticResource key}.
    BASE GRID: 4pt. All space/* values are multiples of 4.

    NAMING:  space/xs         ? SpaceXs    (x:Double and Thickness)
             radius/control   ? RadiusControl  (CornerRadius and Double)

    TOKEN TYPES:
      x:Double    ? for Width, Height, Gap, ColumnSpacing, RowSpacing
      Thickness   ? for Padding, Margin properties
      CornerRadius ? for Border.CornerRadius, Button.CornerRadius, etc.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== SPACING = x:Double =====================
         Use for Width, Height, ColumnSpacing, RowSpacing, Gap.
    =============================================================== -->
    <x:Double x:Key="Space3xs">2</x:Double>    <!-- space/3xs  ·  2px -->
    <x:Double x:Key="Space2xs">4</x:Double>    <!-- space/2xs  ·  4px -->
    <x:Double x:Key="SpaceXs">8</x:Double>     <!-- space/xs   ·  8px = tight component padding -->
    <x:Double x:Key="SpaceSm">12</x:Double>    <!-- space/sm   · 12px = standard component padding -->
    <x:Double x:Key="SpaceMd">16</x:Double>    <!-- space/md   · 16px = card padding, row gap -->
    <x:Double x:Key="SpaceLg">24</x:Double>    <!-- space/lg   · 24px = section gap, card gutter -->
    <x:Double x:Key="SpaceXl">32</x:Double>    <!-- space/xl   · 32px = section separation -->
    <x:Double x:Key="Space2xl">48</x:Double>   <!-- space/2xl  · 48px = content area inset -->
    <x:Double x:Key="Space3xl">64</x:Double>   <!-- space/3xl  · 64px -->
    <x:Double x:Key="Space4xl">96</x:Double>   <!-- space/4xl  · 96px -->

    <!-- ==================== SPACING = Thickness =====================
         Use for Padding and Margin properties (uniform, all sides).
    =============================================================== -->
    <Thickness x:Key="Padding3xs">2</Thickness>
    <Thickness x:Key="Padding2xs">4</Thickness>
    <Thickness x:Key="PaddingXs">8</Thickness>
    <Thickness x:Key="PaddingSm">12</Thickness>
    <Thickness x:Key="PaddingMd">16</Thickness>
    <Thickness x:Key="PaddingLg">24</Thickness>
    <Thickness x:Key="PaddingXl">32</Thickness>
    <Thickness x:Key="Padding2xl">48</Thickness>

    <!-- Horizontal=only padding (left,top,right,bottom) -->
    <Thickness x:Key="PaddingXsH">8,0,8,0</Thickness>
    <Thickness x:Key="PaddingSmH">12,0,12,0</Thickness>
    <Thickness x:Key="PaddingMdH">16,0,16,0</Thickness>
    <Thickness x:Key="PaddingLgH">24,0,24,0</Thickness>

    <!-- Vertical=only padding -->
    <Thickness x:Key="PaddingXsV">0,8,0,8</Thickness>
    <Thickness x:Key="PaddingSmV">0,12,0,12</Thickness>
    <Thickness x:Key="PaddingMdV">0,16,0,16</Thickness>

    <!-- ================ BORDER RADIUS = CornerRadius ================
         Use for Border.CornerRadius, Button.CornerRadius, etc.
    =============================================================== -->
    <CornerRadius x:Key="RadiusControlSm">4</CornerRadius>     <!-- radius/control=sm · inputs, text fields -->
    <CornerRadius x:Key="RadiusControl">8</CornerRadius>        <!-- radius/control    · buttons, tooltips, tags -->
    <CornerRadius x:Key="RadiusControlLg">12</CornerRadius>     <!-- radius/control=lg · larger buttons -->
    <CornerRadius x:Key="RadiusSurface">12</CornerRadius>       <!-- radius/surface    · cards, content tiles -->
    <CornerRadius x:Key="RadiusSurfaceLg">16</CornerRadius>     <!-- radius/surface=lg · large panels, drawers -->
    <CornerRadius x:Key="RadiusPill">9999</CornerRadius>        <!-- radius/pill       · chips, badges, toggles -->

    <!-- ================ BORDER RADIUS = x:Double ====================
         Use for Shape.RadiusX/Y, clip geometry, or numeric context.
    =============================================================== -->
    <x:Double x:Key="RadiusControlSmValue">4</x:Double>
    <x:Double x:Key="RadiusControlValue">8</x:Double>
    <x:Double x:Key="RadiusControlLgValue">12</x:Double>
    <x:Double x:Key="RadiusSurfaceValue">12</x:Double>
    <x:Double x:Key="RadiusSurfaceLgValue">16</x:Double>

    <!-- ================ ELEVATION = reference values ================
         WinUI3 uses ThemeShadow. Use Elevation property or these
         offsets when constructing custom shadow effects.

         Level 0 ? no shadow   (flat surfaces, textured backgrounds)
         Level 1 ? 0 2px  8px  #000 @8%   (cards)
         Level 2 ? 0 4px 16px  #000 @12%  (popovers, dropdowns)
         Level 3 ? 0 8px 32px  #000 @18%  (modals, dialogs)
         Level 4 ? 0 12px 48px #000 @24%  (overlays)
    =============================================================== -->
    <x:Double x:Key="ElevationLevel0">0</x:Double>
    <x:Double x:Key="ElevationLevel1">2</x:Double>
    <x:Double x:Key="ElevationLevel2">8</x:Double>
    <x:Double x:Key="ElevationLevel3">16</x:Double>
    <x:Double x:Key="ElevationLevel4">24</x:Double>

</ResourceDictionary>
