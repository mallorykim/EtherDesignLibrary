<!--
    EtherSpacing.xaml = Ether Design System - Spacing & Radius

    All values are mode-invariant - use {StaticResource key}.
    BASE GRID: 4 epx. All space/* values are multiples of 4.
    Units are epx (effective pixels).

    LAYERING (spacing):
      Primitive (EtherPrimitives.xaml): Spacing2..Spacing96 - the raw scale.
      Semantic  (here): space/* tokens that LINK to a primitive via
                <StaticResource ResourceKey="Spacing.."/>. Changing a
                primitive value flows through to every semantic alias.
      This resolves because Generic.xaml merges EtherPrimitives before this
      file, so the aliases below can see the Spacing* keys.

    NAMING:  space/xs         -> SpaceXs        (x:Double)
             radius/control   -> RadiusControl  (CornerRadius)

    TOKEN TYPES:
      x:Double     -> Width, Height, Gap, ColumnSpacing, RowSpacing
      Thickness    -> Padding, Margin
      CornerRadius -> Border.CornerRadius, Button.CornerRadius, etc.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ SPACING = x:Double (semantic) ==================
         space/* semantic tokens, each linked to a primitive Spacing* value.
         Use for Width, Height, ColumnSpacing, RowSpacing, Gap.
    =============================================================== -->
    <StaticResource x:Key="Space3xs" ResourceKey="Spacing2"/>    <!-- space/3xs -> spacing/2  =  2 epx -->
    <StaticResource x:Key="Space2xs" ResourceKey="Spacing4"/>    <!-- space/2xs -> spacing/4  =  4 epx -->
    <StaticResource x:Key="SpaceXs"  ResourceKey="Spacing8"/>    <!-- space/xs  -> spacing/8  =  8 epx (tight component padding) -->
    <StaticResource x:Key="SpaceSm"  ResourceKey="Spacing12"/>   <!-- space/sm  -> spacing/12 = 12 epx (standard component padding) -->
    <StaticResource x:Key="SpaceMd"  ResourceKey="Spacing16"/>   <!-- space/md  -> spacing/16 = 16 epx (card padding, row gap) -->
    <StaticResource x:Key="SpaceLg"  ResourceKey="Spacing24"/>   <!-- space/lg  -> spacing/24 = 24 epx (section gap, card gutter) -->
    <StaticResource x:Key="SpaceXl"  ResourceKey="Spacing32"/>   <!-- space/xl  -> spacing/32 = 32 epx (section separation) -->
    <StaticResource x:Key="Space2xl" ResourceKey="Spacing48"/>   <!-- space/2xl -> spacing/48 = 48 epx (content area inset) -->
    <StaticResource x:Key="Space3xl" ResourceKey="Spacing64"/>   <!-- space/3xl -> spacing/64 = 64 epx -->
    <StaticResource x:Key="Space4xl" ResourceKey="Spacing96"/>   <!-- space/4xl -> spacing/96 = 96 epx -->

    <!-- ==================== SPACING = Thickness =====================
         Use for Padding and Margin properties (uniform, all sides).
         Kept as literal Thickness values (no uniform primitive alias).
    =============================================================== -->
    <Thickness x:Key="Padding3xs">2</Thickness>
    <Thickness x:Key="Padding2xs">4</Thickness>
    <Thickness x:Key="PaddingXs">8</Thickness>
    <Thickness x:Key="PaddingSm">12</Thickness>
    <Thickness x:Key="PaddingMd">16</Thickness>
    <Thickness x:Key="PaddingLg">24</Thickness>
    <Thickness x:Key="PaddingXl">32</Thickness>
    <Thickness x:Key="Padding2xl">48</Thickness>

    <!-- Horizontal-only padding (left,top,right,bottom) -->
    <Thickness x:Key="PaddingXsH">8,0,8,0</Thickness>
    <Thickness x:Key="PaddingSmH">12,0,12,0</Thickness>
    <Thickness x:Key="PaddingMdH">16,0,16,0</Thickness>
    <Thickness x:Key="PaddingLgH">24,0,24,0</Thickness>

    <!-- Vertical-only padding -->
    <Thickness x:Key="PaddingXsV">0,8,0,8</Thickness>
    <Thickness x:Key="PaddingSmV">0,12,0,12</Thickness>
    <Thickness x:Key="PaddingMdV">0,16,0,16</Thickness>

    <!-- ================ BORDER RADIUS = CornerRadius (semantic) =====
         radius/* semantic tokens (by usage), each linked to a primitive
         Radius* value. Use for Border.CornerRadius, Button.CornerRadius, etc.
    =============================================================== -->
    <StaticResource x:Key="RadiusControlSm" ResourceKey="RadiusSm"/>    <!-- radius/control-sm -> radius/sm   =    4 epx (inputs, text fields) -->
    <StaticResource x:Key="RadiusControl"   ResourceKey="RadiusMd"/>    <!-- radius/control    -> radius/md   =    8 epx (buttons, tooltips, tags) -->
    <StaticResource x:Key="RadiusControlLg" ResourceKey="RadiusLg"/>    <!-- radius/control-lg -> radius/lg   =   12 epx (larger buttons) -->
    <StaticResource x:Key="RadiusSurface"   ResourceKey="RadiusLg"/>    <!-- radius/surface    -> radius/lg   =   12 epx (cards, content tiles) -->
    <StaticResource x:Key="RadiusSurfaceLg" ResourceKey="RadiusXl"/>    <!-- radius/surface-lg -> radius/xl   =   16 epx (large panels, drawers) -->
    <StaticResource x:Key="RadiusPill"      ResourceKey="RadiusFull"/>  <!-- radius/pill       -> radius/full = 9999 epx (chips, badges, toggles) -->

    <!-- ================ BORDER RADIUS = x:Double ====================
         Use for Shape.RadiusX/Y, clip geometry, or numeric context.
    =============================================================== -->
    <x:Double x:Key="RadiusControlSmValue">4</x:Double>
    <x:Double x:Key="RadiusControlValue">8</x:Double>
    <x:Double x:Key="RadiusControlLgValue">12</x:Double>
    <x:Double x:Key="RadiusSurfaceValue">12</x:Double>
    <x:Double x:Key="RadiusSurfaceLgValue">16</x:Double>

    <!-- ================ ELEVATION = reference values ================
         WinUI3 uses ThemeShadow. Use Elevation property or these
         offsets when constructing custom shadow effects.

         Level 0 - no shadow   (flat surfaces, textured backgrounds)
         Level 1 - 0 2px  8px  #000 @8%   (cards)
         Level 2 - 0 4px 16px  #000 @12%  (popovers, dropdowns)
         Level 3 - 0 8px 32px  #000 @18%  (modals, dialogs)
         Level 4 - 0 12px 48px #000 @24%  (overlays)
    =============================================================== -->
    <x:Double x:Key="ElevationLevel0">0</x:Double>
    <x:Double x:Key="ElevationLevel1">2</x:Double>
    <x:Double x:Key="ElevationLevel2">8</x:Double>
    <x:Double x:Key="ElevationLevel3">16</x:Double>
    <x:Double x:Key="ElevationLevel4">24</x:Double>

</ResourceDictionary>
