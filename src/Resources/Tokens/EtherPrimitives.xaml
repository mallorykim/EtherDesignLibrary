    <Color x:Key="AlphaWhite16">#29FFFFFF</Color>
    <Color x:Key="AlphaWhite20">#33FFFFFF</Color>
    <Color x:Key="AlphaWhite25">#40FFFFFF</Color>
    <Color x:Key="AlphaWhite30">#4DFFFFFF</Color>
