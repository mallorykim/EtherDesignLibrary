    <Color x:Key="AlphaWhite70">#B3FFFFFF</Color>
    <Color x:Key="AlphaWhite90">#E6FFFFFF</Color>

    <!-- color / alpha / brand (base #0D62FF = Blue600; glow uses its own #0090FF base) -->
    <Color x:Key="AlphaBrand6">#0F0D62FF</Color>
    <Color x:Key="AlphaBrand10">#1A0D62FF</Color>
    <Color x:Key="AlphaBrand16">#290D62FF</Color>
    <Color x:Key="AlphaBrand60">#990D62FF</Color>
    <Color x:Key="AlphaBrandGlow65">#A60090FF</Color>

    <!-- color / alpha / status -->
    <Color x:Key="AlphaSuccess12">#1F21CD52</Color>
    <Color x:Key="AlphaSuccess16">#2921CD52</Color>
    <Color x:Key="AlphaWarning16">#29FFB24D</Color>
    <Color x:Key="AlphaWarning20">#33FFB24D</Color>
    <Color x:Key="AlphaDanger12">#1FFF4D4D</Color>
    <Color x:Key="AlphaDanger16">#29FF4D4D</Color>

    <!-- color / alpha / navy (base #011C4B = Navy500) -->
    <Color x:Key="AlphaNavy12">#1F011C4B</Color>
    <Color x:Key="AlphaNavy20">#33011C4B</Color>
    <Color x:Key="AlphaNavy40">#66011C4B</Color>

    <!-- color / alpha / gray (mixed bases per source: 5/15/25 use #414553 = Gray600,
         20 uses #8B96A1 = Gray400, 40/90 use #F5F7F8 = Gray25) -->
    <Color x:Key="AlphaGray5">#0D414553</Color>
    <Color x:Key="AlphaGray15">#26414553</Color>
    <Color x:Key="AlphaGray20">#338B96A1</Color>
    <Color x:Key="AlphaGray25">#40414553</Color>
    <Color x:Key="AlphaGray40">#66F5F7F8</Color>
    <Color x:Key="AlphaGray90">#E6F5F7F8</Color>

    <!-- type / size -->
    <x:Double x:Key="Size11">11</x:Double>
    <x:Double x:Key="Size12">12</x:Double>
    <x:Double x:Key="Size14">14</x:Double>
    <x:Double x:Key="Size16">16</x:Double>
    <x:Double x:Key="Size18">18</x:Double>
    <x:Double x:Key="Size20">20</x:Double>
    <x:Double x:Key="Size24">24</x:Double>
    <x:Double x:Key="Size32">32</x:Double>
    <x:Double x:Key="Size48">48</x:Double>
    <x:Double x:Key="Size96">96</x:Double>

    <!-- type / weight -->
    <FontWeight x:Key="WeightRegular">Normal</FontWeight>
    <FontWeight x:Key="WeightMedium">Medium</FontWeight>
    <FontWeight x:Key="WeightSemibold">SemiBold</FontWeight>
    <FontWeight x:Key="WeightBold">Bold</FontWeight>

    <!-- spacing -->
    <x:Double x:Key="Spacing0">0</x:Double>
    <x:Double x:Key="Spacing2">2</x:Double>
    <x:Double x:Key="Spacing4">4</x:Double>
    <x:Double x:Key="Spacing6">6</x:Double>
    <x:Double x:Key="Spacing8">8</x:Double>
    <x:Double x:Key="Spacing10">10</x:Double>
    <x:Double x:Key="Spacing12">12</x:Double>
    <x:Double x:Key="Spacing16">16</x:Double>
    <x:Double x:Key="Spacing20">20</x:Double>
    <x:Double x:Key="Spacing24">24</x:Double>
    <x:Double x:Key="Spacing32">32</x:Double>
    <x:Double x:Key="Spacing40">40</x:Double>
    <x:Double x:Key="Spacing48">48</x:Double>
    <x:Double x:Key="Spacing56">56</x:Double>
    <x:Double x:Key="Spacing64">64</x:Double>
    <x:Double x:Key="Spacing80">80</x:Double>
    <x:Double x:Key="Spacing96">96</x:Double>

    <!-- radius (CornerRadius-typed: this is the property type Border.CornerRadius etc. need) -->
    <CornerRadius x:Key="RadiusNone">0</CornerRadius>
    <CornerRadius x:Key="RadiusXs">2</CornerRadius>
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>
    <CornerRadius x:Key="RadiusXl">16</CornerRadius>
    <CornerRadius x:Key="Radius2xl">24</CornerRadius>
    <CornerRadius x:Key="Radius3xl">32</CornerRadius>
    <CornerRadius x:Key="RadiusFull">9999</CornerRadius>

    <!-- Thickness-typed companions to the spacing scale above, for uniform Padding/Margin
         (Thickness and x:Double are different XAML types — a Setter can't use one for the
         other). Only the values actually consumed by a uniform Padding today; add more only
         when a real usage needs them. -->
    <Thickness x:Key="Padding0">0</Thickness>
    <Thickness x:Key="Padding4">4</Thickness>
    <Thickness x:Key="Padding8">8</Thickness>
    <Thickness x:Key="Padding12">12</Thickness>
    <Thickness x:Key="Padding20">20</Thickness>
</ResourceDictionary>
