    <!-- color / alpha / black (base #000000) -->
    <Color x:Key="AlphaBlack0">#00000000</Color>
    <Color x:Key="AlphaBlack4">#0A000000</Color>
    <Color x:Key="AlphaBlack5">#0D000000</Color>
    <Color x:Key="AlphaBlack6">#0F000000</Color>
    <Color x:Key="AlphaBlack8">#14000000</Color>
