    <!-- color / alpha / white (base #FFFFFF) -->
    <Color x:Key="AlphaWhite0">#00FFFFFF</Color>
    <Color x:Key="AlphaWhite4">#0AFFFFFF</Color>
    <Color x:Key="AlphaWhite6">#0FFFFFFF</Color>
    <Color x:Key="AlphaWhite8">#14FFFFFF</Color>
