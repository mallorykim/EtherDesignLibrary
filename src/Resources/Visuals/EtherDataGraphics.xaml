<!--
    EtherDataGraphics.xaml = Ether Design System · Data Visualization Components
    =============================================================================

    CONTAINS
      EtherTieredBarChart          Horizontal multi=segment bar with legend
      EtherSingleBarChartThick     Wide intelligence=gradient progress bar
      EtherSingleBarChartThin      Slim labelled progress bar (storage / usage)
      EtherDataBlocks              2×2 stat block grid with title
      EtherLineChart               Line chart with Y=axis, X=axis, legend + image slot

    USAGE
      All components are defined as Style keys + inline XAML structures.
      Paste the XAML blocks (marked COPY FROM HERE) into your page directly.

    SOURCES
      Tiered Bar Chart:          ursRC201v8IiVeafliI45F · node 58074:1865
      Single Bar Chart Thick:    ursRC201v8IiVeafliI45F · node 58074:1889
      Single Bar Chart Thin:     ursRC201v8IiVeafliI45F · node 58074:2115
      Data Blocks:               ursRC201v8IiVeafliI45F · node 58074:2107
      Line Chart:                ursRC201v8IiVeafliI45F · node 58074:1969

    CHART SEGMENT COLOURS  (mode=invariant = from Ether data palette)
      Level 0  #FF011C4B  (Navy)
      Level 1  #FF0054E5  (Blue)
      Level 2  #FF0090FF  (Sky)
      Level 3  #FF00FBFF  (Cyan)
      Warn     #FFFF6600  (StatusWarningBorder)
      Purple   #FF4100D0
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===========================================================
         CHART PALETTE = StaticResource brushes
    ============================================================== -->
    <SolidColorBrush x:Key="ChartLevel0Navy"   Color="#FF011C4B"/>
    <SolidColorBrush x:Key="ChartLevel1Blue"   Color="#FF0054E5"/>
    <SolidColorBrush x:Key="ChartLevel2Sky"    Color="#FF0090FF"/>
    <SolidColorBrush x:Key="ChartLevel3Cyan"   Color="#FF00FBFF"/>
    <SolidColorBrush x:Key="ChartPurple"       Color="#FF4100D0"/>
    <SolidColorBrush x:Key="ChartCyanBright"   Color="#FF00D0FF"/>

    <!-- ===========================================================
         INTELLIGENCE GRADIENT = Single Bar Chart Thick fill
         Matches Ether intelligence gradient direction
    ============================================================== -->
    <LinearGradientBrush x:Key="EtherBarThickGradient"
                         StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#8FFFC3" Offset="0.00"/>
        <GradientStop Color="#0EB2FF" Offset="0.09"/>
        <GradientStop Color="#0015FF" Offset="0.92"/>
        <GradientStop Color="#141414" Offset="1.05"/>
    </LinearGradientBrush>

    <!-- ===========================================================
         ? TIERED BAR CHART
         =========================================================
         COPY FROM HERE ?

         <StackPanel Orientation="Vertical" Spacing="12" Width="393">
             [ Bar track ]
             <Border Background="{ThemeResource ActionTertiaryBgHover}"
                     Height="44" CornerRadius="{StaticResource RadiusControlSm}"
                     Padding="4,4,190,4">
                 <StackPanel Orientation="Horizontal">
                     <Border Background="{StaticResource ChartLevel0Navy}"
                             Width="97" CornerRadius="2,0,0,2"/>
                     <Border Background="{StaticResource ChartLevel1Blue}"
                             Width="43"/>
                     <Border Background="{StaticResource ChartLevel2Sky}"
                             Width="28"/>
                     <Border Background="{StaticResource ChartLevel3Cyan}"
                             Width="17" CornerRadius="0,2,2,0"/>
                 </StackPanel>
             </Border>
             [ Legend ]
             <StackPanel Orientation="Horizontal" Spacing="8">
                 <StackPanel Orientation="Horizontal" Spacing="8" Padding="4" VerticalAlignment="Center">
                     <Border Width="16" Height="8" CornerRadius="3"
                             Background="{ThemeResource BackgroundSurfaceInverse}"/>
                     <TextBlock Text="System"
                                FontFamily="{StaticResource InterFont}"
                                FontSize="11" FontWeight="Medium"
                                Foreground="{ThemeResource TextTertiary}"/>
                 </StackPanel>
                 <StackPanel Orientation="Horizontal" Spacing="8" Padding="4" VerticalAlignment="Center">
                     <Border Width="16" Height="8" CornerRadius="3"
                             Background="{StaticResource ChartLevel1Blue}"
                             BorderBrush="#24000000" BorderThickness="1"/>
                     <TextBlock Text="Applications"
                                FontFamily="{StaticResource InterFont}"
                                FontSize="11" FontWeight="Medium"
                                Foreground="{ThemeResource TextTertiary}"/>
                 </StackPanel>
                 <StackPanel Orientation="Horizontal" Spacing="8" Padding="4" VerticalAlignment="Center">
                     <Border Width="16" Height="8" CornerRadius="3"
                             Background="{StaticResource ChartLevel2Sky}"
                             BorderBrush="#24000000" BorderThickness="1"/>
                     <TextBlock Text="Trash"
                                FontFamily="{StaticResource InterFont}"
                                FontSize="11" FontWeight="Medium"
                                Foreground="{ThemeResource TextTertiary}"/>
                 </StackPanel>
                 <StackPanel Orientation="Horizontal" Spacing="8" Padding="4" VerticalAlignment="Center">
                     <Border Width="16" Height="8" CornerRadius="3"
                             Background="{StaticResource ChartLevel3Cyan}"
                             BorderBrush="#24000000" BorderThickness="1"/>
                     <TextBlock Text="Etc"
                                FontFamily="{StaticResource InterFont}"
                                FontSize="11" FontWeight="Medium"
                                Foreground="{ThemeResource TextTertiary}"/>
                 </StackPanel>
             </StackPanel>
         </StackPanel>

         COPY TO HERE ?
    ============================================================== -->

    <!-- ===========================================================
         ? SINGLE BAR CHART THICK  (Intelligence gradient fill)
         =========================================================
         COPY FROM HERE ?

         <Border Background="{ThemeResource ActionTertiaryBgHover}"
                 Height="44" CornerRadius="{StaticResource RadiusControlSm}"
                 Padding="4" Width="547">
             <Border CornerRadius="{StaticResource RadiusControlSm}">
                 <Border.Background>
                     <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                         <GradientStop Color="#8FFFC3" Offset="0.00"/>
                         <GradientStop Color="#0EB2FF" Offset="0.09"/>
                         <GradientStop Color="#0015FF" Offset="0.92"/>
                         <GradientStop Color="#141414" Offset="1.05"/>
                     </LinearGradientBrush>
                 </Border.Background>
             </Border>
         </Border>

         COPY TO HERE ?
    ============================================================== -->

    <!-- ===========================================================
         ? SINGLE BAR CHART THIN  (Usage progress bar)
         =========================================================
         COPY FROM HERE ?

         <StackPanel Orientation="Vertical" Spacing="8" Width="298"
                     Padding="0,4,0,12">
             [ Header row: title + value ]
             <Grid>
                 <TextBlock Text="Cloud Repository"
                            FontFamily="{StaticResource InstrumentSans}"
                            FontSize="14" FontWeight="SemiBold"
                            Foreground="{ThemeResource BackgroundSurfaceInverse}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"/>
                 <TextBlock Text="4/10GB Used"
                            FontFamily="{StaticResource InterFont}"
                            FontSize="12" FontWeight="SemiBold"
                            Foreground="{ThemeResource TextSecondary}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"/>
             </Grid>
             [ Track + fill ]
             <Grid Height="4">
                 <Border Background="{ThemeResource BackgroundSurfaceMuted}"
                         CornerRadius="6" Height="4"/>
                 <Border Background="{StaticResource BackgroundBrand}"
                         CornerRadius="4" Height="4"
                         Width="200"
                         HorizontalAlignment="Left"/>
             </Grid>
         </StackPanel>

         COPY TO HERE ?
    ============================================================== -->

    <!-- ===========================================================
         ? DATA BLOCKS  (2×2 stat grid)
         =========================================================
         COPY FROM HERE ?

         <StackPanel Orientation="Vertical" Spacing="8" Width="306">
             [ Optional title ]
             <TextBlock Text="eMMC Health for ThinOS"
                        FontFamily="{StaticResource InstrumentSans}"
                        FontSize="14" FontWeight="SemiBold"
                        Foreground="{ThemeResource TextPrimary}"/>
             [ 2×2 block grid (use WrapPanel or ItemsControl) ]
             <ItemsControl>
                 <ItemsControl.ItemsPanel>
                     <ItemsPanelTemplate>
                         <WrapPanel Orientation="Horizontal"/>
                     </ItemsPanelTemplate>
                 </ItemsControl.ItemsPanel>
                 [ NEUTRAL block ]
                 <Border Background="{ThemeResource BackgroundSurfaceRaised}"
                         Width="151" CornerRadius="{StaticResource RadiusControl}"
                         Padding="16,13,16,13" Margin="0,0,4,4">
                     <StackPanel Orientation="Vertical" Spacing="12">
                         <TextBlock Text="0"
                                    FontFamily="{StaticResource InstrumentSans}"
                                    FontSize="24" FontWeight="SemiBold"
                                    Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                         <TextBlock Text="Urgent"
                                    FontFamily="{StaticResource InstrumentSans}"
                                    FontSize="14" FontWeight="SemiBold"
                                    Opacity="0.70"
                                    Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                     </StackPanel>
                 </Border>
                 [ WARNING block ]
                 <Border Background="{ThemeResource StatusWarningBg}"
                         Width="151" CornerRadius="{StaticResource RadiusControl}"
                         Padding="16,13,16,13" Margin="0,0,0,4">
                     <StackPanel Orientation="Vertical" Spacing="12">
                         <TextBlock Text="1"
                                    FontFamily="{StaticResource InstrumentSans}"
                                    FontSize="24" FontWeight="SemiBold"
                                    Foreground="{ThemeResource StatusWarningBorder}"/>
                         <TextBlock Text="Warning"
                                    FontFamily="{StaticResource InstrumentSans}"
                                    FontSize="14" FontWeight="SemiBold"
                                    Opacity="0.70"
                                    Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                     </StackPanel>
                 </Border>
                 [ NEUTRAL block ]
                 <Border Background="{ThemeResource BackgroundSurfaceRaised}"
                         Width="151" CornerRadius="{StaticResource RadiusControl}"
                         Padding="16,13,16,13" Margin="0,0,4,0">
                     <StackPanel Orientation="Vertical" Spacing="12">
                         <TextBlock Text="3"
                                    FontFamily="{StaticResource InstrumentSans}"
                                    FontSize="24" FontWeight="SemiBold"
                                    Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                         <TextBlock Text="Normal"
                                    FontFamily="{StaticResource InstrumentSans}"
                                    FontSize="14" FontWeight="SemiBold"
                                    Opacity="0.70"
                                    Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                     </StackPanel>
                 </Border>
                 [ NEUTRAL block ]
                 <Border Background="{ThemeResource BackgroundSurfaceRaised}"
                         Width="151" CornerRadius="{StaticResource RadiusControl}"
                         Padding="16,13,16,13">
                     <StackPanel Orientation="Vertical" Spacing="12">
                         <TextBlock Text="6"
                                    FontFamily="{StaticResource InstrumentSans}"
                                    FontSize="24" FontWeight="SemiBold"
                                    Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                         <TextBlock Text="Reserved"
                                    FontFamily="{StaticResource InstrumentSans}"
                                    FontSize="14" FontWeight="SemiBold"
                                    Opacity="0.70"
                                    Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                     </StackPanel>
                 </Border>
             </ItemsControl>
         </StackPanel>

         COPY TO HERE ?
    ============================================================== -->

    <!-- ===========================================================
         ? LINE CHART  (Y=axis + X=axis + image overlay + legend)
         =========================================================
         NOTE: The actual chart lines are rendered as a PNG/SVG image.
         Replace the Image Source with your chart rendering output.

         COPY FROM HERE ?

         <Grid Width="527" Padding="23,23,46,23">
             <StackPanel Orientation="Vertical" Spacing="23">
                 [ Y=axis rows (100 / 75 / 50 / 25 / 0) ]
                 [ Repeat this row 5 times with values 100, 75, 50, 25, 0 ]
                 <Grid>
                     <TextBlock Text="100"
                                FontFamily="{StaticResource InterFont}"
                                FontSize="12" FontWeight="SemiBold"
                                Foreground="{ThemeResource BackgroundSurfaceInverse}"
                                Width="39" VerticalAlignment="Center"/>
                     <Border HorizontalAlignment="Stretch" Margin="39,0,0,0"
                             BorderBrush="{ThemeResource BorderSubtle}"
                             BorderThickness="0,1,0,0" Height="1"
                             VerticalAlignment="Center"/>
                 </Grid>
                 <Grid>
                     <TextBlock Text="75" FontFamily="{StaticResource InterFont}"
                                FontSize="12" FontWeight="SemiBold"
                                Foreground="{ThemeResource BackgroundSurfaceInverse}"
                                Width="39" VerticalAlignment="Center"/>
                     <Border HorizontalAlignment="Stretch" Margin="39,0,0,0"
                             BorderBrush="{ThemeResource BorderSubtle}"
                             BorderThickness="0,1,0,0" Height="1"
                             VerticalAlignment="Center"/>
                 </Grid>
                 <Grid>
                     <TextBlock Text="50" FontFamily="{StaticResource InterFont}"
                                FontSize="12" FontWeight="SemiBold"
                                Foreground="{ThemeResource BackgroundSurfaceInverse}"
                                Width="39" VerticalAlignment="Center"/>
                     <Border HorizontalAlignment="Stretch" Margin="39,0,0,0"
                             BorderBrush="{ThemeResource BorderSubtle}"
                             BorderThickness="0,1,0,0" Height="1"
                             VerticalAlignment="Center"/>
                 </Grid>
                 <Grid>
                     <TextBlock Text="25" FontFamily="{StaticResource InterFont}"
                                FontSize="12" FontWeight="SemiBold"
                                Foreground="{ThemeResource BackgroundSurfaceInverse}"
                                Width="39" VerticalAlignment="Center"/>
                     <Border HorizontalAlignment="Stretch" Margin="39,0,0,0"
                             BorderBrush="{ThemeResource BorderSubtle}"
                             BorderThickness="0,1,0,0" Height="1"
                             VerticalAlignment="Center"/>
                 </Grid>
                 <StackPanel Orientation="Vertical" Spacing="12">
                     <Grid>
                         <TextBlock Text="0" FontFamily="{StaticResource InterFont}"
                                    FontSize="12" FontWeight="SemiBold"
                                    Foreground="{ThemeResource BackgroundSurfaceInverse}"
                                    Width="39" VerticalAlignment="Center"/>
                         <Border HorizontalAlignment="Stretch" Margin="39,0,0,0"
                                 BorderBrush="{ThemeResource BorderDefault}"
                                 BorderThickness="0,1,0,0" Height="1"
                                 VerticalAlignment="Center"/>
                     </Grid>
                     [ X=axis labels ]
                     <StackPanel Orientation="Horizontal" Spacing="101" Margin="60,0,0,0">
                         <TextBlock Text="Jan" FontFamily="{StaticResource InterFont}"
                                    FontSize="12" FontWeight="SemiBold"
                                    Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                         <TextBlock Text="Feb" FontFamily="{StaticResource InterFont}"
                                    FontSize="12" FontWeight="SemiBold"
                                    Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                         <TextBlock Text="Mar" FontFamily="{StaticResource InterFont}"
                                    FontSize="12" FontWeight="SemiBold"
                                    Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                         <TextBlock Text="Apr" FontFamily="{StaticResource InterFont}"
                                    FontSize="12" FontWeight="SemiBold"
                                    Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                         <TextBlock Text="May" FontFamily="{StaticResource InterFont}"
                                    FontSize="12" FontWeight="SemiBold"
                                    Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                         <TextBlock Text="Jun" FontFamily="{StaticResource InterFont}"
                                    FontSize="12" FontWeight="SemiBold"
                                    Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                     </StackPanel>
                 </StackPanel>
                 [ Legend ]
                 <StackPanel Orientation="Horizontal" Spacing="16">
                     <StackPanel Orientation="Horizontal" Spacing="8" Padding="4" VerticalAlignment="Center">
                         <Border Width="12" Height="4" CornerRadius="1"
                                 Background="{StaticResource ChartPurple}"/>
                         <TextBlock Text="Label" FontFamily="{StaticResource InterFont}"
                                    FontSize="12" FontWeight="SemiBold"
                                    Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                     </StackPanel>
                     <StackPanel Orientation="Horizontal" Spacing="8" Padding="4" VerticalAlignment="Center">
                         <Border Width="12" Height="4" CornerRadius="1"
                                 Background="{StaticResource ChartLevel2Sky}"/>
                         <TextBlock Text="Label" FontFamily="{StaticResource InterFont}"
                                    FontSize="12" FontWeight="SemiBold"
                                    Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                     </StackPanel>
                     <StackPanel Orientation="Horizontal" Spacing="8" Padding="4" VerticalAlignment="Center">
                         <Border Width="12" Height="4" CornerRadius="1"
                                 Background="{StaticResource ChartCyanBright}"/>
                         <TextBlock Text="Label" FontFamily="{StaticResource InterFont}"
                                    FontSize="12" FontWeight="SemiBold"
                                    Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                     </StackPanel>
                     <StackPanel Orientation="Horizontal" Spacing="8" Padding="4" VerticalAlignment="Center">
                         <Border Width="12" Height="4" CornerRadius="1"
                                 Background="{ThemeResource BackgroundSurfaceInverse}"/>
                         <TextBlock Text="Label" FontFamily="{StaticResource InterFont}"
                                    FontSize="12" FontWeight="SemiBold"
                                    Foreground="{ThemeResource BackgroundSurfaceInverse}"/>
                     </StackPanel>
                 </StackPanel>
             </StackPanel>
             [ Chart line image overlay = replace Source with actual chart PNG ]
             <Image Width="434" Height="184"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Stretch="Uniform"
                    Margin="14,=46,0,0"/>
         </Grid>

         COPY TO HERE ?
    ============================================================== -->

</ResourceDictionary>
