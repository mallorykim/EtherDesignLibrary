<Application
    x:Class="EtherSandbox.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:EtherSandbox.Converters"
    xmlns:controls="using:Ether.DesignSystem.Controls">

    <Application.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <ResourceDictionary.MergedDictionaries>
                <!-- Unpackaged WinUI 3 apps explicitly merge framework control resources. -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- The public Controls entry point owns the Foundation-to-Controls resource graph. -->
                <ResourceDictionary Source="ms-appx:///Ether.DesignSystem.Controls/Themes/DesignSystem.xaml" />
                <!-- Gallery-only visual helper; it deliberately remains outside the package assemblies. -->
                <ResourceDictionary Source="ms-appx:///Resources/Visuals/EtherPageTitleGradient.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
