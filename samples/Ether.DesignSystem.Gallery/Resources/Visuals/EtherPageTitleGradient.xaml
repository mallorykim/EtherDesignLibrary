<!--
    EtherPageTitleGradient.xaml = Ether Design System · Device Name Display Title
    ==============================================================================

    USAGE
      Paste the inline TextBlock block at the top of a device detail page.
      Set the Text property to match the device model name.

        <TextBlock Style="{StaticResource EtherDeviceTitle}" Text="Dell Pro&#x0a;Max 14"/>

      For single=line:
        <TextBlock Style="{StaticResource EtherDeviceTitle}" Text="Dell Pro Max 14"/>

    VISUAL
      Font:        Instrument Sans Bold 96 px · letter=spacing =3.84 px (~=0.04 em)
      Fill:        LinearGradientBrush approximation of Figma radial gradient
                   (navy #003DA7 ? mid=blue #1F72D3 ? near=black #212334)
      Line height: 80 px

    KEY MEASUREMENTS (Figma source: ursRC201v8IiVeafliI45F · node 58074:3150)
      Container   421×149 px (or let it size to content)
      Font size   96 px
      Letter spc  =3.84 px (set via CharacterSpacing in WinUI3)
      Line height 80 px (set via LineHeight)

    WinUI3 NOTES
      1. TextBlock.CharacterSpacing is in units of 1/1000 of an em.
         At 96 px, =0.04 em = CharacterSpacing = =40.
      2. LinearGradientBrush on TextBlock.Foreground is fully supported in WinUI3.
      3. The exact Figma radial gradient is simplified to a linear approximation
         here. The visual should be close; adjust GradientStops if needed.

    TOKENS
      Font:  InstrumentSans (StaticResource)
      Fill:  custom LinearGradientBrush = no semantic token (mode=invariant design element)
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Gradient brush matching Figma radial gradient approximation -->
    <LinearGradientBrush x:Key="EtherDeviceTitleGradient"
                         StartPoint="0.65,0" EndPoint="0,1">
        <GradientStop Color="#1F72D3" Offset="0.00"/>
        <GradientStop Color="#0054E5" Offset="0.09"/>
        <GradientStop Color="#3EA8FF" Offset="0.18"/>
        <GradientStop Color="#1F72D3" Offset="0.27"/>
        <GradientStop Color="#003DA7" Offset="0.36"/>
        <GradientStop Color="#08376A" Offset="0.44"/>
        <GradientStop Color="#21252C" Offset="0.60"/>
    </LinearGradientBrush>

    <Style x:Key="EtherDeviceTitle" TargetType="TextBlock">
        <Setter Property="FontFamily"        Value="{StaticResource InstrumentSans}"/>
        <Setter Property="FontSize"          Value="96"/>
        <Setter Property="FontWeight"        Value="Bold"/>
        <Setter Property="LineHeight"        Value="80"/>
        <Setter Property="CharacterSpacing"  Value="-40"/>
        <Setter Property="TextWrapping"      Value="Wrap"/>
        <Setter Property="Foreground">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0.65,0" EndPoint="0,1">
                    <GradientStop Color="#1F72D3" Offset="0.00"/>
                    <GradientStop Color="#0054E5" Offset="0.09"/>
                    <GradientStop Color="#3EA8FF" Offset="0.18"/>
                    <GradientStop Color="#1F72D3" Offset="0.27"/>
                    <GradientStop Color="#003DA7" Offset="0.36"/>
                    <GradientStop Color="#08376A" Offset="0.44"/>
                    <GradientStop Color="#21252C" Offset="0.60"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
