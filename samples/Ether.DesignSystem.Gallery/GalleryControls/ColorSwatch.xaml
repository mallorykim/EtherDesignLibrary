<UserControl
    x:Class="Ether.DesignSystem.Controls.ColorSwatch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" MaxWidth="560" ColumnSpacing="12" HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SampleColumn" Width="56"/>
            <ColumnDefinition x:Name="ContentColumn" Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="SampleRow" Height="Auto"/>
            <RowDefinition x:Name="ContentRow" Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="SampleBorder" Height="28" CornerRadius="6" VerticalAlignment="Center">
            <TextBlock x:Name="SampleText"
                       Text="Aa"
                       FontFamily="{StaticResource RobotoFont}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Border>

        <StackPanel x:Name="ContentPanel" Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock x:Name="LabelBlock"
                       FontFamily="{StaticResource RobotoFont}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource text/primary}"/>
            <TextBlock x:Name="ValueBlock"
                       FontFamily="{StaticResource RobotoFont}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextTertiary}"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</UserControl>
