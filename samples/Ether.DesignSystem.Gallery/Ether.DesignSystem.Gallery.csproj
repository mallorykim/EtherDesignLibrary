<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>Ether.DesignSystem.Gallery</AssemblyName>
    <RootNamespace>EtherSandbox</RootNamespace>
    <ApplicationManifest>..\..\app.manifest</ApplicationManifest>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Gallery remains unpackaged; no Package.appxmanifest is required. -->
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_BREAK_ON_UNHANDLED_EXCEPTION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ether.DesignSystem.Foundation\Ether.DesignSystem.Foundation.csproj" />
    <ProjectReference Include="..\..\src\Ether.DesignSystem.Controls\Ether.DesignSystem.Controls.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="..\..\src\App\MainWindow.xaml">
      <Link>MainWindow.xaml</Link>
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="..\..\src\Views\**\*.xaml">
      <Link>Views\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <!-- These are Gallery presentation helpers, not package controls. -->
    <Page Include="..\..\src\Controls\Internal\ColorSwatch.xaml;..\..\src\Controls\Internal\PrimitiveBadge.xaml;..\..\src\Controls\Internal\UpdatedBadge.xaml">
      <Link>GalleryControls\%(Filename)%(Extension)</Link>
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="..\..\src\Resources\Visuals\EtherPageTitleGradient.xaml">
      <Link>Resources\Visuals\EtherPageTitleGradient.xaml</Link>
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\App\App.xaml.cs;..\..\src\App\ComponentCatalog.cs;..\..\src\App\MainWindow.xaml.cs">
      <Link>App\%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="..\..\src\Views\**\*.cs">
      <Link>Views\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="..\..\src\Converters\BoolToVisibilityConverter.cs">
      <Link>Converters\BoolToVisibilityConverter.cs</Link>
    </Compile>
    <Compile Include="..\..\src\Controls\Internal\ColorSwatch.xaml.cs;..\..\src\Controls\Internal\HandRadioButton.cs;..\..\src\Controls\Internal\PrimitiveBadge.xaml.cs;..\..\src\Controls\Internal\UpdatedBadge.xaml.cs">
      <Link>GalleryControls\%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Update="App.xaml.cs">
      <DependentUpon>App.xaml</DependentUpon>
    </Compile>
    <Compile Update="MainWindow.xaml.cs">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!-- Preserve existing host-root URIs used by frozen tokens and current Gallery samples. -->
    <Content Include="..\..\Fonts\**\*">
      <Link>Fonts\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Assets\**\*">
      <Link>Assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
