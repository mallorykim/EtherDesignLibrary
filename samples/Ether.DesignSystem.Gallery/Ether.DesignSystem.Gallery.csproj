<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>Ether.DesignSystem.Gallery</AssemblyName>
    <RootNamespace>EtherSandbox</RootNamespace>
    <ApplicationManifest>..\..\app.manifest</ApplicationManifest>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Gallery remains unpackaged; no Package.appxmanifest is required. -->
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_BREAK_ON_UNHANDLED_EXCEPTION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ether.DesignSystem.Foundation\Ether.DesignSystem.Foundation.csproj" />
    <ProjectReference Include="..\..\src\Ether.DesignSystem.Controls\Ether.DesignSystem.Controls.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Preserve existing host-root URIs used by frozen tokens and current Gallery samples. -->
    <Content Include="..\..\Fonts\**\*">
      <Link>Fonts\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Assets\**\*">
      <Link>Assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
