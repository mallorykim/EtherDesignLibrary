<Page
    x:Class="EtherSandbox.Views.Foundations.ColorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:EtherSandbox.Views"
    xmlns:controls="using:Ether.DesignSystem.Controls"
    xmlns:local="using:EtherSandbox.Views.Foundations"
    Loaded="OnLoaded">

<views:ComponentPage x:Uid="GalleryViewsFoundationsColorsPage253"
        Title="Color Tokens"
        Description="Primitive color tokens from EtherPrimitives.xaml, listed by color series.">

        <views:ComponentPage.InteractiveContent>
            <ItemsControl x:Name="PrimitiveGroups">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" Spacing="24"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:PrimitiveColorGroup">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{x:Bind Header}"
                                       Style="{StaticResource headers/h4}"
                                       Foreground="{ThemeResource text/primary}"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          HorizontalScrollMode="Enabled"
                                          VerticalScrollBarVisibility="Disabled"
                                          VerticalScrollMode="Disabled"
                                          ZoomMode="Disabled">
                                <ItemsControl ItemsSource="{x:Bind Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:PrimitiveColorItem">
                                            <controls:ColorSwatch SampleBrush="{x:Bind Brush}"
                                                                  Label="{x:Bind Key}"
                                                                  ValueText="{x:Bind Hex}"
                                                                  Layout="Vertical"
                                                                  Width="56"
                                                                  VerticalAlignment="Top"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </views:ComponentPage.InteractiveContent>

    </views:ComponentPage>
</Page>
