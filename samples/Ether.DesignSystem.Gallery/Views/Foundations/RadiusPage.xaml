<Page
    x:Class="EtherSandbox.Views.Foundations.RadiusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:EtherSandbox.Views"
    xmlns:local="using:EtherSandbox.Views.Foundations"
    Loaded="OnLoaded">

    <views:ComponentPage
        Title="Radius Tokens"
        Description="Semantic radius tokens (aliased to the primitive scale) and the primitive radius tokens they link to. Units are epx.">

        <views:ComponentPage.InteractiveContent>
            <StackPanel Spacing="32">

                <!-- ============ SEMANTIC RADIUS ============ -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Radius (semantic)"
                               Style="{StaticResource headers/h3}"
                               Foreground="{ThemeResource text/primary}"/>
                    <ItemsControl x:Name="SemanticGroups">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Spacing="24"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:SpacingPrimitiveGroup">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{x:Bind Header}"
                                               Style="{StaticResource headers/h4}"
                                               Foreground="{ThemeResource text/primary}"/>
                                    <Border BorderBrush="{ThemeResource BorderSubtle}" BorderThickness="1"
                                            CornerRadius="{StaticResource radius/control-sm}">
                                        <ItemsControl ItemsSource="{x:Bind Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:SpacingPrimitiveItem">
                                                    <Grid Padding="12,10" ColumnSpacing="24">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="200"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{x:Bind Name}"
                                                                   HorizontalAlignment="Left"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{ThemeResource TextSecondary}"/>
                                                        <TextBlock Grid.Column="1" Text="{x:Bind Value}"
                                                                   HorizontalAlignment="Left"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{ThemeResource text/brand}"/>
                                                        <Border Grid.Column="2"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center"
                                                                Width="{x:Bind PreviewWidth}"
                                                                Height="{x:Bind PreviewHeight}"
                                                                CornerRadius="{x:Bind PreviewRadius}"
                                                                Background="{ThemeResource background/brand}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ============ PRIMITIVE SCALE ============ -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Primitives"
                               Style="{StaticResource headers/h3}"
                               Foreground="{ThemeResource text/primary}"/>
                    <ItemsControl x:Name="PrimitiveGroups">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Spacing="24"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:SpacingPrimitiveGroup">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{x:Bind Header}"
                                               Style="{StaticResource headers/h4}"
                                               Foreground="{ThemeResource text/primary}"/>
                                    <Border BorderBrush="{ThemeResource BorderSubtle}" BorderThickness="1"
                                            CornerRadius="{StaticResource radius/control-sm}">
                                        <ItemsControl ItemsSource="{x:Bind Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:SpacingPrimitiveItem">
                                                    <Grid Padding="12,10" ColumnSpacing="24">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="140"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{x:Bind Name}"
                                                                   HorizontalAlignment="Left"
                                                                   Foreground="{ThemeResource TextSecondary}"/>
                                                        <TextBlock Grid.Column="1" Text="{x:Bind Value}"
                                                                   HorizontalAlignment="Left"
                                                                   Foreground="{ThemeResource text/brand}"/>
                                                        <Border Grid.Column="2"
                                                                HorizontalAlignment="Left"
                                                                Width="{x:Bind PreviewWidth}"
                                                                Height="{x:Bind PreviewHeight}"
                                                                CornerRadius="{x:Bind PreviewRadius}"
                                                                Background="{ThemeResource background/brand}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </views:ComponentPage.InteractiveContent>

    </views:ComponentPage>
</Page>
