<Page
    x:Class="EtherSandbox.Views.Foundations.ScrollBarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:EtherSandbox.Views">

    <!--
        The global ScrollBar style in Controls/EtherScrollBar.xaml applies implicitly
        to every ScrollViewer in the app (see that file's header comment). INTERACTIVE
        shows the live bar against tall/wide content; STATES mirrors the Figma spec
        sheet's Default/Hover previews with static swatches drawn in the same two fills
        the live bar uses (so they cannot drift from the real thumb colours).
    -->
<views:ComponentPage x:Uid="GalleryViewsFoundationsScrollBarPage260"
        Title="Scroll Bar"
        Description="Updated 6 px scrollbar with a minimal thumb, no visible track, and no stepper arrows. The styling applies implicitly to every ScrollViewer in the sandbox.">

        <views:ComponentPage.InteractiveContent>
            <views:ControlExample SourceXaml="{x:Bind SpecimenXaml, Mode=OneTime}">
            <StackPanel Spacing="20">
                <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsFoundationsScrollBarPage261" Text="Vertical (drag or hover the thumb)"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"/>
                    <Border Width="320" Height="240"
                            BorderBrush="{ThemeResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource radius/control}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      AutomationProperties.Name="Vertical scroll viewer">
                            <StackPanel Padding="12" Spacing="12">
                                <TextBlock x:Uid="GalleryViewsFoundationsScrollBarPage262" Text="Battery" FontFamily="{StaticResource RobotoFont}" FontSize="13" Foreground="{ThemeResource text/primary}"/>
                                <TextBlock x:Uid="GalleryViewsFoundationsScrollBarPage263" Text="Display" FontFamily="{StaticResource RobotoFont}" FontSize="13" Foreground="{ThemeResource text/primary}"/>
                                <TextBlock x:Uid="GalleryViewsFoundationsScrollBarPage264" Text="Storage" FontFamily="{StaticResource RobotoFont}" FontSize="13" Foreground="{ThemeResource text/primary}"/>
                                <TextBlock x:Uid="GalleryViewsFoundationsScrollBarPage265" Text="Network" FontFamily="{StaticResource RobotoFont}" FontSize="13" Foreground="{ThemeResource text/primary}"/>
                                <TextBlock x:Uid="GalleryViewsFoundationsScrollBarPage266" Text="Devices" FontFamily="{StaticResource RobotoFont}" FontSize="13" Foreground="{ThemeResource text/primary}"/>
                                <TextBlock x:Uid="GalleryViewsFoundationsScrollBarPage267" Text="Updates" FontFamily="{StaticResource RobotoFont}" FontSize="13" Foreground="{ThemeResource text/primary}"/>
                                <TextBlock x:Uid="GalleryViewsFoundationsScrollBarPage268" Text="Security" FontFamily="{StaticResource RobotoFont}" FontSize="13" Foreground="{ThemeResource text/primary}"/>
                                <TextBlock x:Uid="GalleryViewsFoundationsScrollBarPage269" Text="Performance" FontFamily="{StaticResource RobotoFont}" FontSize="13" Foreground="{ThemeResource text/primary}"/>
                                <TextBlock x:Uid="GalleryViewsFoundationsScrollBarPage270" Text="Accessibility" FontFamily="{StaticResource RobotoFont}" FontSize="13" Foreground="{ThemeResource text/primary}"/>
                                <TextBlock x:Uid="GalleryViewsFoundationsScrollBarPage271" Text="Support" FontFamily="{StaticResource RobotoFont}" FontSize="13" Foreground="{ThemeResource text/primary}"/>
                                <TextBlock x:Uid="GalleryViewsFoundationsScrollBarPage272" Text="About" FontFamily="{StaticResource RobotoFont}" FontSize="13" Foreground="{ThemeResource text/primary}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsFoundationsScrollBarPage273" Text="Horizontal (drag or hover the thumb)"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"/>
                    <Border Width="420" Height="80"
                            BorderBrush="{ThemeResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource radius/control}">
                        <ScrollViewer VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollBarVisibility="Auto"
                                      AutomationProperties.Name="Horizontal scroll viewer">
                            <StackPanel Orientation="Horizontal" Padding="12" Spacing="12">
                                <Border Width="80" Height="48" CornerRadius="6" Background="{ThemeResource BackgroundSurfaceRaised}"/>
                                <Border Width="80" Height="48" CornerRadius="6" Background="{ThemeResource BackgroundSurfaceRaised}"/>
                                <Border Width="80" Height="48" CornerRadius="6" Background="{ThemeResource BackgroundSurfaceRaised}"/>
                                <Border Width="80" Height="48" CornerRadius="6" Background="{ThemeResource BackgroundSurfaceRaised}"/>
                                <Border Width="80" Height="48" CornerRadius="6" Background="{ThemeResource BackgroundSurfaceRaised}"/>
                                <Border Width="80" Height="48" CornerRadius="6" Background="{ThemeResource BackgroundSurfaceRaised}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </StackPanel>
            </views:ControlExample>
        </views:ComponentPage.InteractiveContent>

        <views:ComponentPage.StatesContent>
            <!-- Static swatches per the spec's STATE PREVIEWS: 6 x 150, radius 3, drawn
                 in the live bar's own two fills. -->
            <StackPanel Orientation="Horizontal" Spacing="80">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
<TextBlock x:Uid="GalleryViewsFoundationsScrollBarPage274" Text="Default"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                    <Border Width="6" Height="150"
                            CornerRadius="3"
                            Background="{ThemeResource EtherScrollBarThumbBrush}"/>
                </StackPanel>
                <StackPanel Spacing="8" HorizontalAlignment="Center">
<TextBlock x:Uid="GalleryViewsFoundationsScrollBarPage275" Text="Hover"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                    <Border Width="6" Height="150"
                            CornerRadius="3"
                            Background="{ThemeResource EtherScrollBarThumbHoverBrush}"/>
                </StackPanel>
            </StackPanel>
        </views:ComponentPage.StatesContent>

    </views:ComponentPage>
</Page>
