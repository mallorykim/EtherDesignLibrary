<UserControl
    x:Class="EtherSandbox.Views.ControlExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls"
    x:Name="Root">

    <!--
        WinUI Gallery-style specimen chrome for Gallery pages. Options stay on
        ComponentPage.InteractiveControls (right of the INTERACTIVE header). This
        control owns the live specimen, optional OUTPUT text, SOURCE snippet, and
        Copy. Narrow layouts stack SOURCE below the specimen (breakpoint: 720px
        of this control, not the window).
    -->
    <Grid x:Name="LayoutRoot">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="NarrowLayout"/>
                <VisualState x:Name="WideLayout">
                    <VisualState.Setters>
                        <Setter Target="ExamplePanel.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="SourcePanel.(Grid.Row)" Value="0"/>
                        <Setter Target="SourcePanel.(Grid.Column)" Value="1"/>
                        <Setter Target="SourcePanel.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="SourcePanel.Margin" Value="16,0,0,0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="ExamplePanel"
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Spacing="8">
            <TextBlock x:Uid="ControlExampleExampleLabel"
                       FontFamily="{StaticResource InterFont}"
                       FontSize="10" FontWeight="SemiBold"
                       CharacterSpacing="80"
                       Foreground="{ThemeResource TextTertiary}"/>
            <ContentControl x:Name="ExampleHost"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Top"
                            IsTabStop="False"
                            IsEnabled="{x:Bind IsExampleEnabled, Mode=OneWay}"
                            Content="{x:Bind Example, Mode=OneWay}"/>
        </StackPanel>

        <StackPanel x:Name="OutputPanel"
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,16,0,0"
                    Spacing="8"
                    Visibility="{x:Bind ConvertHasText(OutputText), Mode=OneWay}">
            <TextBlock x:Uid="ControlExampleOutputLabel"
                       FontFamily="{StaticResource InterFont}"
                       FontSize="10" FontWeight="SemiBold"
                       CharacterSpacing="80"
                       Foreground="{ThemeResource TextTertiary}"/>
            <TextBlock x:Name="OutputTextBlock"
                       Text="{x:Bind OutputText, Mode=OneWay}"
                       FontFamily="{StaticResource InterFont}"
                       FontSize="14"
                       Foreground="{ThemeResource text/primary}"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="Control example output"/>
        </StackPanel>

        <Border x:Name="SourcePanel"
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,16,0,0"
                Background="{ThemeResource BackgroundCanvas}"
                CornerRadius="{StaticResource radius/surface}"
                Padding="16"
                Visibility="{x:Bind ConvertHasText(SourceXaml), Mode=OneWay}"
                AutomationProperties.Name="Control example source">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="ControlExampleSourceLabel"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource InterFont}"
                           FontSize="10" FontWeight="SemiBold"
                           CharacterSpacing="80"
                           Foreground="{ThemeResource TextTertiary}"/>
                <controls:EtherButton x:Name="CopyButton"
                                      x:Uid="ControlExampleCopy"
                                      Grid.Column="1"
                                      Style="{StaticResource EtherButtonTertiarySmall}"
                                      Click="OnCopyClicked"
                                      AutomationProperties.Name="Copy source"/>
                <ScrollViewer Grid.Row="1"
                              Grid.ColumnSpan="2"
                              Margin="0,12,0,0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              MaxHeight="220">
                    <TextBlock Text="{x:Bind SourceXaml, Mode=OneWay}"
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="{ThemeResource text/primary}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
