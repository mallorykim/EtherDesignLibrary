<Page
    x:Class="EtherSandbox.Views.Controls.ButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls"
    xmlns:views="using:EtherSandbox.Views">

<views:ComponentPage x:Uid="GalleryViewsControlsButtonPage009"
        Title="Button"
        HasDisabledToggle="True"
        Description="Updated primary, secondary, and tertiary buttons in large and small sizes. Hover, pressed, and disabled treatments are shown side by side for quick comparison.">

        <views:ComponentPage.InteractiveControls>
            <!-- Trailing icon is optional; this checkbox adds / removes it on every specimen
                 (code-behind sets or clears each EtherButton.RightIcon). -->
<controls:EtherCheckbox x:Uid="GalleryViewsControlsButtonPage010" x:Name="IconToggle"
                      Content="Trailing icon"
                      IsChecked="True"
                      Checked="IconToggle_Changed"
                      Unchecked="IconToggle_Changed"/>
        </views:ComponentPage.InteractiveControls>

        <views:ComponentPage.InteractiveContent>
            <views:ControlExample x:Name="LiveExample"
                                  x:Uid="GalleryViewsControlsButtonPageOutput"
                                  OutputText="Clicked: —"
                                  SourceXaml="{x:Bind SpecimenXaml, Mode=OneTime}">
            <StackPanel Spacing="24">

                <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsButtonPage011" Text="PRIMARY"
                               Style="{StaticResource micro/semibold}"
                               Foreground="{ThemeResource TextTertiary}"/>
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsButtonPage012" Text="Large"
                                       Style="{StaticResource micro/regular}"
                                       Foreground="{ThemeResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
<controls:EtherButton x:Uid="GalleryViewsControlsButtonPage013" x:Name="PrimaryLargeDemo"
                                                 Content="Primary Action"
                                                 Style="{StaticResource EtherButtonPrimary}"
                                                 Click="InteractiveButton_Click"
                                                 AutomationProperties.Name="Primary large button"
                                                 HorizontalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsButtonPage014" Text="Small"
                                       Style="{StaticResource micro/regular}"
                                       Foreground="{ThemeResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
<controls:EtherButton x:Uid="GalleryViewsControlsButtonPage015" x:Name="PrimarySmallDemo"
                                                 Content="Primary Action"
                                                 Style="{StaticResource EtherButtonPrimarySmall}"
                                                 Click="InteractiveButton_Click"
                                                 AutomationProperties.Name="Primary small button"
                                                 HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsButtonPage016" Text="SECONDARY"
                               Style="{StaticResource micro/semibold}"
                               Foreground="{ThemeResource TextTertiary}"/>
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsButtonPage017" Text="Large"
                                       Style="{StaticResource micro/regular}"
                                       Foreground="{ThemeResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
<controls:EtherButton x:Uid="GalleryViewsControlsButtonPage018" x:Name="SecondaryLargeDemo"
                                                 Content="Secondary Action"
                                                 Style="{StaticResource EtherButtonSecondary}"
                                                 Click="InteractiveButton_Click"
                                                 AutomationProperties.Name="Secondary large button"
                                                 HorizontalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsButtonPage019" Text="Small"
                                       Style="{StaticResource micro/regular}"
                                       Foreground="{ThemeResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
<controls:EtherButton x:Uid="GalleryViewsControlsButtonPage020" x:Name="SecondarySmallDemo"
                                                 Content="Secondary Action"
                                                 Style="{StaticResource EtherButtonSecondarySmall}"
                                                 Click="InteractiveButton_Click"
                                                 AutomationProperties.Name="Secondary small button"
                                                 HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsButtonPage021" Text="TERTIARY"
                               Style="{StaticResource micro/semibold}"
                               Foreground="{ThemeResource TextTertiary}"/>
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsButtonPage022" Text="Large"
                                       Style="{StaticResource micro/regular}"
                                       Foreground="{ThemeResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
<controls:EtherButton x:Uid="GalleryViewsControlsButtonPage023" x:Name="TertiaryLargeDemo"
                                                 Content="Tertiary Action"
                                                 Style="{StaticResource EtherButtonTertiary}"
                                                 Click="InteractiveButton_Click"
                                                 AutomationProperties.Name="Tertiary large button"
                                                 HorizontalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsButtonPage024" Text="Small"
                                       Style="{StaticResource micro/regular}"
                                       Foreground="{ThemeResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
<controls:EtherButton x:Uid="GalleryViewsControlsButtonPage025" x:Name="TertiarySmallDemo"
                                                 Content="Tertiary Action"
                                                 Style="{StaticResource EtherButtonTertiarySmall}"
                                                 Click="InteractiveButton_Click"
                                                 AutomationProperties.Name="Tertiary small button"
                                                 HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsButtonPage026" Text="DEFAULT STYLE"
                               Style="{StaticResource micro/semibold}"
                               Foreground="{ThemeResource TextTertiary}"/>
<controls:EtherButton x:Uid="GalleryViewsControlsButtonPage027" x:Name="DefaultStyleDemo"
                                         Content="Primary Action"
                                         Click="InteractiveButton_Click"
                                         AutomationProperties.Name="Default style button"
                                         HorizontalContentAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            </views:ControlExample>
        </views:ComponentPage.InteractiveContent>

