<Page
    x:Class="EtherSandbox.Views.Controls.RadioButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:EtherSandbox.Views"
    xmlns:controls="using:EtherSandbox.Controls">

<views:ComponentPage x:Uid="GalleryViewsControlsRadioButtonPage165"
        Title="Radio Button"
        HasDisabledToggle="True"
        Description="Updated radio button styling for the single-select pattern, with theme-aware checked and unchecked treatments. The page shows default, hover, pressed, and disabled states where applicable.">

        <views:ComponentPage.InteractiveContent>
            <!-- One live group: pick exactly one. Shared GroupName makes them mutually exclusive. -->
            <views:ControlExample x:Name="LiveExample"
                                  x:Uid="GalleryViewsControlsRadioButtonPageOutput"
                                  OutputText="Selected: Option A"
                                  SourceXaml="{x:Bind SpecimenXaml, Mode=OneTime}">
                <StackPanel Spacing="12">
<controls:EtherRadioButton x:Uid="GalleryViewsControlsRadioButtonPage166" GroupName="Interactive" Content="Option A" IsChecked="True"
                                               AutomationProperties.Name="Interactive radio option A"
                                               Checked="InteractiveRadio_Checked"/>
<controls:EtherRadioButton x:Uid="GalleryViewsControlsRadioButtonPage167" GroupName="Interactive" Content="Option B"
                                               AutomationProperties.Name="Interactive radio option B"
                                               Checked="InteractiveRadio_Checked"/>
<controls:EtherRadioButton x:Uid="GalleryViewsControlsRadioButtonPage168" GroupName="Interactive" Content="Option C"
                                               AutomationProperties.Name="Interactive radio option C"
                                               Checked="InteractiveRadio_Checked"/>
                </StackPanel>
            </views:ControlExample>
        </views:ComponentPage.InteractiveContent>

        <views:ComponentPage.StatesContent>
            <StackPanel Spacing="{StaticResource space/lg}">

                <!-- UNCHECKED states. Each specimen is display-only (IsHitTestVisible=False) and
                     carries a unique GroupName so mutual exclusion never touches it. -->
                <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsRadioButtonPage169" Text="UNCHECKED"
                               Style="{StaticResource micro/semibold}"
                               Foreground="{ThemeResource TextTertiary}"/>
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsRadioButtonPage170" Text="Default"
                                       Style="{StaticResource micro/regular}"
                                       Foreground="{ThemeResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
<controls:EtherRadioButton x:Uid="GalleryViewsControlsRadioButtonPage171"
                                                      GroupName="u-default"
                                                      Content="Option"
                                                      IsChecked="False"
                                                      AutomationProperties.Name="Unchecked default radio button"
                                                      IsHitTestVisible="False" IsTabStop="False"/>
                        </StackPanel>
                        <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsRadioButtonPage172" Text="Hover"
                                       Style="{StaticResource micro/regular}"
                                       Foreground="{ThemeResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
<controls:EtherRadioButton x:Uid="GalleryViewsControlsRadioButtonPage173" x:Name="UncheckedHover"
                                                      GroupName="u-hover"
                                                      Content="Option"
                                                      IsChecked="False"
                                                      IsHitTestVisible="False" IsTabStop="False"/>
                        </StackPanel>
                        <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsRadioButtonPage174" Text="Pressed"
                                       Style="{StaticResource micro/regular}"
                                       Foreground="{ThemeResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
<controls:EtherRadioButton x:Uid="GalleryViewsControlsRadioButtonPage175" x:Name="UncheckedPressed"
                                                      GroupName="u-pressed"
                                                      Content="Option"
                                                      IsChecked="False"
                                                      IsHitTestVisible="False" IsTabStop="False"/>
                        </StackPanel>
                        <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsRadioButtonPage176" Text="Disabled"
                                       Style="{StaticResource micro/regular}"
                                       Foreground="{ThemeResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
<controls:EtherRadioButton x:Uid="GalleryViewsControlsRadioButtonPage177"
                                                      GroupName="u-disabled"
                                                      Content="Option"
                                                      IsChecked="False"
                                                      IsEnabled="False"
                                                      IsHitTestVisible="False" IsTabStop="False"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- CHECKED states -->
                <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsRadioButtonPage178" Text="CHECKED"
                               Style="{StaticResource micro/semibold}"
                               Foreground="{ThemeResource TextTertiary}"/>
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsRadioButtonPage179" Text="Default"
                                       Style="{StaticResource micro/regular}"
                                       Foreground="{ThemeResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
<controls:EtherRadioButton x:Uid="GalleryViewsControlsRadioButtonPage180"
                                                      GroupName="c-default"
                                                      Content="Option"
                                                      IsChecked="True"
                                                      AutomationProperties.Name="Checked default radio button"
                                                      IsHitTestVisible="False" IsTabStop="False"/>
                        </StackPanel>
                        <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsRadioButtonPage181" Text="Hover"
                                       Style="{StaticResource micro/regular}"
                                       Foreground="{ThemeResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
<controls:EtherRadioButton x:Uid="GalleryViewsControlsRadioButtonPage182" x:Name="CheckedHover"
                                                      GroupName="c-hover"
                                                      Content="Option"
                                                      IsChecked="True"
                                                      IsHitTestVisible="False" IsTabStop="False"/>
                        </StackPanel>
                        <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsRadioButtonPage183" Text="Disabled"
                                       Style="{StaticResource micro/regular}"
                                       Foreground="{ThemeResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
<controls:EtherRadioButton x:Uid="GalleryViewsControlsRadioButtonPage184"
                                                      GroupName="c-disabled"
                                                      Content="Option"
                                                      IsChecked="True"
                                                      IsEnabled="False"
                                                      IsHitTestVisible="False" IsTabStop="False"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </views:ComponentPage.StatesContent>

    </views:ComponentPage>
</Page>
