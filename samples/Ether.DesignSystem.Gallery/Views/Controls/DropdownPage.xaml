<Page
    x:Class="EtherSandbox.Views.Controls.DropdownPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ether.DesignSystem.Controls"
    xmlns:views="using:EtherSandbox.Views">

    <Page.Resources>
        <Style x:Key="DropdownMenuPreviewContainer" TargetType="Border">
            <Setter Property="Width" Value="130"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="{ThemeResource EtherDropdownMenuBackgroundBrush}"/>
        </Style>
        <!-- Mirrors EtherDropdownItem: 26 px tall, 6 px side padding. -->
        <Style x:Key="DropdownMenuPreviewItem" TargetType="Border">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="DropdownMenuPreviewText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource RobotoFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="{StaticResource WeightSemibold}"/>
            <Setter Property="CharacterSpacing" Value="20"/>
            <Setter Property="Foreground" Value="{ThemeResource EtherDropdownForegroundBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Left"/>
        </Style>
    </Page.Resources>

<views:ComponentPage x:Uid="GalleryViewsControlsDropdownPage103"
        Title="Dropdown"
        HasDisabledToggle="True"
        Description="Updated compact dropdown with content-hugging width, a theme-aware disclosure icon, and a gradient active stroke. Menu items are 26 px tall with a 4 px gap and 4 px container padding; past 6 items the menu scrolls.">

        <views:ComponentPage.InteractiveContent>
            <views:ControlExample x:Name="LiveExample"
                                  x:Uid="GalleryViewsControlsDropdownPageOutput"
                                  OutputText="Selected: 10 Minutes"
                                  SourceXaml="{x:Bind SpecimenXaml, Mode=OneTime}">
                <StackPanel Spacing="16">
                    <controls:EtherDropdown
                              x:Name="InteractiveDropdown"
                              SelectedIndex="0"
                              HorizontalAlignment="Left"
                              AutomationProperties.Name="Interactive dropdown"
                              SelectionChanged="InteractiveDropdown_SelectionChanged">
<ComboBoxItem x:Uid="GalleryViewsControlsDropdownPage104" Content="10 Minutes"/>
<ComboBoxItem x:Uid="GalleryViewsControlsDropdownPage105" Content="30 Minutes"/>
<ComboBoxItem x:Uid="GalleryViewsControlsDropdownPage106" Content="1 Hour"/>
<ComboBoxItem x:Uid="GalleryViewsControlsDropdownPage107" Content="2 Hours"/>
<ComboBoxItem x:Uid="GalleryViewsControlsDropdownPage108" Content="4 Hours"/>
<ComboBoxItem x:Uid="GalleryViewsControlsDropdownPage109" Content="8 Hours"/>
<ComboBoxItem x:Uid="GalleryViewsControlsDropdownPage110" Content="12 Hours"/>
<ComboBoxItem x:Uid="GalleryViewsControlsDropdownPage111" Content="1 Day"/>
<ComboBoxItem x:Uid="GalleryViewsControlsDropdownPage112" Content="Never"/>
                    </controls:EtherDropdown>
                    <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsDropdownPageDataBoundLabel" Text="Data-bound (ItemsSource)"
                                   Style="{StaticResource micro/regular}"
                                   Foreground="{ThemeResource TextTertiary}"/>
                        <controls:EtherDropdown
                                  HorizontalAlignment="Left"
                                  AutomationProperties.Name="Data-bound dropdown"
                                  ItemsSource="{x:Bind DurationOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Id"
                                  SelectedValue="{x:Bind SelectedDurationId, Mode=TwoWay}"/>
                    </StackPanel>
                </StackPanel>
            </views:ControlExample>
        </views:ComponentPage.InteractiveContent>

        <views:ComponentPage.StatesContent>
            <StackPanel Orientation="Horizontal" Spacing="24">
                <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsDropdownPage113" Text="Default"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                    <controls:EtherDropdown
                              SelectedIndex="0"
                              AutomationProperties.Name="Default dropdown"
                              IsHitTestVisible="False" IsTabStop="False">
<ComboBoxItem x:Uid="GalleryViewsControlsDropdownPage114" Content="10 Minutes"/>
                    </controls:EtherDropdown>
                </StackPanel>
                <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsDropdownPage115" Text="Hover"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                    <controls:EtherDropdown x:Name="DropdownHoverState"
                              SelectedIndex="0"
                              AutomationProperties.Name="Hover dropdown"
                              IsHitTestVisible="False" IsTabStop="False">
<ComboBoxItem x:Uid="GalleryViewsControlsDropdownPage116" Content="10 Minutes"/>
                    </controls:EtherDropdown>
                </StackPanel>
                <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsDropdownPage117" Text="Pressed"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                    <controls:EtherDropdown x:Name="DropdownPressedState"
                              SelectedIndex="0"
                              AutomationProperties.Name="Pressed dropdown"
                              IsHitTestVisible="False" IsTabStop="False">
<ComboBoxItem x:Uid="GalleryViewsControlsDropdownPage118" Content="10 Minutes"/>
                    </controls:EtherDropdown>
                </StackPanel>
                <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsDropdownPage119" Text="Open (active)"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                    <!-- Driven into the real Opened visual state from code-behind, so
                         this shows the actual gradient stroke and flipped arrow rather
                         than a hand-drawn imitation. -->
                    <controls:EtherDropdown x:Name="DropdownOpenState"
                              SelectedIndex="0"
                              AutomationProperties.Name="Open dropdown"
                              IsHitTestVisible="False" IsTabStop="False">
<ComboBoxItem x:Uid="GalleryViewsControlsDropdownPage120" Content="10 Minutes"/>
                    </controls:EtherDropdown>
                </StackPanel>
                <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsDropdownPage121" Text="Open / item hover"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                    <Border Style="{StaticResource DropdownMenuPreviewContainer}">
                        <StackPanel Spacing="4">
                            <Border Style="{StaticResource DropdownMenuPreviewItem}"
                                    Background="{ThemeResource EtherDropdownItemSelectedHoverBrush}">
<TextBlock x:Uid="GalleryViewsControlsDropdownPage122" Text="Item menu" Style="{StaticResource DropdownMenuPreviewText}"/>
                            </Border>
                            <Border Style="{StaticResource DropdownMenuPreviewItem}"><TextBlock x:Uid="GalleryViewsControlsDropdownPage123" Text="Item menu" Style="{StaticResource DropdownMenuPreviewText}"/></Border>
                            <Border Style="{StaticResource DropdownMenuPreviewItem}"><TextBlock x:Uid="GalleryViewsControlsDropdownPage124" Text="Item menu" Style="{StaticResource DropdownMenuPreviewText}"/></Border>
                            <Border Style="{StaticResource DropdownMenuPreviewItem}"><TextBlock x:Uid="GalleryViewsControlsDropdownPage125" Text="Item menu" Style="{StaticResource DropdownMenuPreviewText}"/></Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsDropdownPage126" Text="Open / item pressed"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                    <Border Style="{StaticResource DropdownMenuPreviewContainer}">
                        <StackPanel Spacing="4">
                            <Border Style="{StaticResource DropdownMenuPreviewItem}"
                                    Background="{ThemeResource EtherDropdownItemSelectedPressedBrush}">
<TextBlock x:Uid="GalleryViewsControlsDropdownPage123" Text="Item menu" Style="{StaticResource DropdownMenuPreviewText}"/>
                            </Border>
                            <Border Style="{StaticResource DropdownMenuPreviewItem}"><TextBlock x:Uid="GalleryViewsControlsDropdownPage128" Text="Item menu" Style="{StaticResource DropdownMenuPreviewText}"/></Border>
                            <Border Style="{StaticResource DropdownMenuPreviewItem}"><TextBlock x:Uid="GalleryViewsControlsDropdownPage129" Text="Item menu" Style="{StaticResource DropdownMenuPreviewText}"/></Border>
                            <Border Style="{StaticResource DropdownMenuPreviewItem}"><TextBlock x:Uid="GalleryViewsControlsDropdownPage130" Text="Item menu" Style="{StaticResource DropdownMenuPreviewText}"/></Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsDropdownPage131" Text="Open / scrollbar"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                    <!-- Six items: the menu's cap, which is the only point at which a
                         scroll bar can appear. Four would show no bar at all. -->
                    <Border Style="{StaticResource DropdownMenuPreviewContainer}">
                        <Grid>
                            <StackPanel Spacing="4">
                                <Border Style="{StaticResource DropdownMenuPreviewItem}"><TextBlock x:Uid="GalleryViewsControlsDropdownPage132" Text="Item menu" Style="{StaticResource DropdownMenuPreviewText}"/></Border>
                                <Border Style="{StaticResource DropdownMenuPreviewItem}"><TextBlock x:Uid="GalleryViewsControlsDropdownPage133" Text="Item menu" Style="{StaticResource DropdownMenuPreviewText}"/></Border>
                                <Border Style="{StaticResource DropdownMenuPreviewItem}"><TextBlock x:Uid="GalleryViewsControlsDropdownPage134" Text="Item menu" Style="{StaticResource DropdownMenuPreviewText}"/></Border>
                                <Border Style="{StaticResource DropdownMenuPreviewItem}"><TextBlock x:Uid="GalleryViewsControlsDropdownPage135" Text="Item menu" Style="{StaticResource DropdownMenuPreviewText}"/></Border>
                                <Border Style="{StaticResource DropdownMenuPreviewItem}"><TextBlock x:Uid="GalleryViewsControlsDropdownPage136" Text="Item menu" Style="{StaticResource DropdownMenuPreviewText}"/></Border>
                                <Border Style="{StaticResource DropdownMenuPreviewItem}"><TextBlock x:Uid="GalleryViewsControlsDropdownPage137" Text="Item menu" Style="{StaticResource DropdownMenuPreviewText}"/></Border>
                            </StackPanel>
                            <Border Width="4" Height="60"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource BackgroundDropdownScrollThumb}"
                                    CornerRadius="4"/>
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsDropdownPage138" Text="Disabled"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                    <controls:EtherDropdown
                              SelectedIndex="0"
                              IsEnabled="False"
                              AutomationProperties.Name="Disabled dropdown"
                              IsHitTestVisible="False" IsTabStop="False">
                        <ComboBoxItem x:Uid="GalleryViewsControlsDropdownPage139" Content="10 Minutes"/>
                    </controls:EtherDropdown>
                </StackPanel>
            </StackPanel>
        </views:ComponentPage.StatesContent>

    </views:ComponentPage>
</Page>
