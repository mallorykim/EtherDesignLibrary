<Page
    x:Class="EtherSandbox.Views.Controls.SegmentedControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EtherSandbox.Controls"
    xmlns:views="using:EtherSandbox.Views">

<views:ComponentPage x:Uid="GalleryViewsControlsSegmentedControlPage185"
        Title="Segmented Control"
        HasDisabledToggle="True"
        Description="Updated segmented control with a functional selection model plus specimen states for default, hover, pressed, and active treatments.">

        <views:ComponentPage.InteractiveContent>
            <views:ControlExample x:Name="LiveExample"
                                  x:Uid="GalleryViewsControlsSegmentedControlPageOutput"
                                  ExampleHorizontalContentAlignment="Stretch"
                                  OutputText="Selected: List"
                                  SourceXaml="{x:Bind SpecimenXaml, Mode=OneTime}">
            <StackPanel Spacing="16">
                <StackPanel Spacing="6">
<TextBlock x:Uid="GalleryViewsControlsSegmentedControlPage186" Text="2 SEGMENTS"
                               Style="{StaticResource micro/semibold}"
                               Foreground="{ThemeResource TextTertiary}"/>
                    <controls:EtherSegmentedControl AutomationProperties.Name="Two-segment control"
                                                    SelectedValue="list"
                                                    SelectionChanged="InteractiveSegmentedControl_SelectionChanged">
                        <controls:EtherSegmentPanel>
<controls:HandRadioButton x:Uid="GalleryViewsControlsSegmentedControlPage187" GroupName="SegmentedTwo" Content="List"
                                         Tag="list"
                                         Style="{StaticResource EtherSegment}"
                                         AutomationProperties.Name="Two-segment list"
                                         IsChecked="True"/>
<controls:HandRadioButton x:Uid="GalleryViewsControlsSegmentedControlPage188" GroupName="SegmentedTwo" Content="Grid"
                                         Tag="grid"
                                         Style="{StaticResource EtherSegment}"
                                         AutomationProperties.Name="Two-segment grid"/>
                        </controls:EtherSegmentPanel>
                    </controls:EtherSegmentedControl>
                </StackPanel>
                <StackPanel Spacing="6">
<TextBlock x:Uid="GalleryViewsControlsSegmentedControlPage189" Text="3 SEGMENTS"
                               Style="{StaticResource micro/semibold}"
                               Foreground="{ThemeResource TextTertiary}"/>
                    <controls:EtherSegmentedControl Style="{StaticResource EtherSegmentedTrack}"
                                                    AutomationProperties.Name="Three-segment control"
                                                    SelectedValue="overview"
                                                    SelectionChanged="InteractiveSegmentedControl_SelectionChanged">
                        <controls:EtherSegmentPanel>
<controls:HandRadioButton x:Uid="GalleryViewsControlsSegmentedControlPage190" GroupName="SegmentedThree" Content="Overview"
                                         Tag="overview"
                                         Style="{StaticResource EtherSegment}"
                                         AutomationProperties.Name="Three-segment overview"
                                         IsChecked="True"/>
<controls:HandRadioButton x:Uid="GalleryViewsControlsSegmentedControlPage191" GroupName="SegmentedThree" Content="Details"
                                         Tag="details"
                                         Style="{StaticResource EtherSegment}"
                                         AutomationProperties.Name="Three-segment details"/>
<controls:HandRadioButton x:Uid="GalleryViewsControlsSegmentedControlPage192" GroupName="SegmentedThree" Content="History"
                                         Tag="history"
                                         Style="{StaticResource EtherSegment}"
                                         AutomationProperties.Name="Three-segment history"/>
                        </controls:EtherSegmentPanel>
                    </controls:EtherSegmentedControl>
                </StackPanel>
                <StackPanel Spacing="6">
<TextBlock x:Uid="GalleryViewsControlsSegmentedControlPage193" Text="4 SEGMENTS"
                               Style="{StaticResource micro/semibold}"
                               Foreground="{ThemeResource TextTertiary}"/>
                    <controls:EtherSegmentedControl Style="{StaticResource EtherSegmentedTrack}"
                                                    AutomationProperties.Name="Four-segment control"
                                                    SelectedValue="day"
                                                    SelectionChanged="InteractiveSegmentedControl_SelectionChanged">
                        <controls:EtherSegmentPanel>
<controls:HandRadioButton x:Uid="GalleryViewsControlsSegmentedControlPage194" GroupName="SegmentedFour" Content="Day"
                                         Tag="day"
                                         Style="{StaticResource EtherSegment}"
                                         AutomationProperties.Name="Four-segment day"
                                         IsChecked="True"/>
<controls:HandRadioButton x:Uid="GalleryViewsControlsSegmentedControlPage195" GroupName="SegmentedFour" Content="Week"
                                         Tag="week"
                                         Style="{StaticResource EtherSegment}"
                                         AutomationProperties.Name="Four-segment week"/>
<controls:HandRadioButton x:Uid="GalleryViewsControlsSegmentedControlPage196" GroupName="SegmentedFour" Content="Month"
                                         Tag="month"
                                         Style="{StaticResource EtherSegment}"
                                         AutomationProperties.Name="Four-segment month"/>
<controls:HandRadioButton x:Uid="GalleryViewsControlsSegmentedControlPage197" GroupName="SegmentedFour" Content="Year"
                                         Tag="year"
                                         Style="{StaticResource EtherSegment}"
                                         AutomationProperties.Name="Four-segment year"/>
                        </controls:EtherSegmentPanel>
                    </controls:EtherSegmentedControl>
                </StackPanel>
            </StackPanel>
            </views:ControlExample>
        </views:ComponentPage.InteractiveContent>

        <views:ComponentPage.StatesContent>
            <StackPanel Orientation="Horizontal" Spacing="16">
                <StackPanel Width="130" Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsSegmentedControlPage198" Text="Default"
                               Style="{StaticResource micro/semibold}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
<controls:HandRadioButton x:Uid="GalleryViewsControlsSegmentedControlPage199" Content="Default"
                                 Style="{StaticResource EtherSegment}"
                                 AutomationProperties.Name="Default segment"
                                 IsHitTestVisible="False" IsTabStop="False"/>
                </StackPanel>
                <StackPanel Width="130" Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsSegmentedControlPage200" Text="Selected"
                               Style="{StaticResource micro/semibold}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
<controls:HandRadioButton x:Uid="GalleryViewsControlsSegmentedControlPage201" Content="Selected"
                                 Style="{StaticResource EtherSegment}"
                                 IsChecked="True"
                                 AutomationProperties.Name="Selected segment"
                                 IsHitTestVisible="False" IsTabStop="False"/>
                </StackPanel>
                <StackPanel Width="130" Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsSegmentedControlPage202" Text="Hover"
                               Style="{StaticResource micro/semibold}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
<controls:HandRadioButton x:Uid="GalleryViewsControlsSegmentedControlPage203" Content="Hover"
                                 Style="{StaticResource EtherSegment}"
                                 PreviewState="Hover"
                                 AutomationProperties.Name="Hover segment"
                                 IsHitTestVisible="False" IsTabStop="False"/>
                </StackPanel>
                <StackPanel Width="130" Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsSegmentedControlPage204" Text="Pressed"
                               Style="{StaticResource micro/semibold}"
                               Foreground="{ThemeResource TextTertiary}"
                               HorizontalAlignment="Center"/>
<controls:HandRadioButton x:Uid="GalleryViewsControlsSegmentedControlPage205" Content="Pressed"
                                 Style="{StaticResource EtherSegment}"
                                 PreviewState="Pressed"
                                 AutomationProperties.Name="Pressed segment"
                                 IsHitTestVisible="False" IsTabStop="False"/>
                </StackPanel>
            </StackPanel>
        </views:ComponentPage.StatesContent>

    </views:ComponentPage>
</Page>
