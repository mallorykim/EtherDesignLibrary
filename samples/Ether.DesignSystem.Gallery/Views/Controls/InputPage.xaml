<Page
    x:Class="EtherSandbox.Views.Controls.InputPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:EtherSandbox.Views"
    xmlns:controls="using:Ether.DesignSystem.Controls">

<views:ComponentPage x:Uid="GalleryViewsControlsInputPage140"
        Title="Input"
        HasDisabledToggle="True"
        Description="Updated single-line text field with theme-aware fill, brand-blue focus treatment, and disabled dimming. Default, hover, focused, and disabled states are all shown on the page.">

        <views:ComponentPage.InteractiveContent>
            <views:ControlExample x:Name="LiveExample"
                                  x:Uid="GalleryViewsControlsInputPageOutput"
                                  OutputText="Text: —"
                                  SourceXaml="{x:Bind SpecimenXaml, Mode=OneTime}">
<controls:EtherInput x:Uid="GalleryViewsControlsInputPage141" x:Name="InteractiveInput"
                                     PlaceholderText="Enter text"
                                     Width="280"
                                     AutomationProperties.Name="Interactive input"
                                     TextChanged="InteractiveInput_TextChanged"/>
            </views:ControlExample>
        </views:ComponentPage.InteractiveContent>

        <views:ComponentPage.StatesContent>
            <StackPanel Orientation="Horizontal" Spacing="24">

                <!-- DEFAULT -->
                <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsInputPage142" Text="Default"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"/>
<controls:EtherInput x:Uid="GalleryViewsControlsInputPage143" PlaceholderText="Default"
                                         Width="195"
                                         AutomationProperties.Name="Default input"
                                         IsHitTestVisible="False" IsTabStop="False"/>
                </StackPanel>

                <!-- HOVER -->
                <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsInputPage144" Text="Hover"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"/>
<controls:EtherInput x:Uid="GalleryViewsControlsInputPage145" x:Name="HoverInput"
                                         PlaceholderText="Default"
                                         Width="195"
                                         AutomationProperties.Name="Hover input"
                                         IsHitTestVisible="False" IsTabStop="False"/>
                </StackPanel>

                <!-- ACTIVE (focus) -->
                <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsInputPage146" Text="Active"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"/>
<controls:EtherInput x:Uid="GalleryViewsControlsInputPage147" x:Name="ActiveInput"
                                         PlaceholderText="Default"
                                         Width="195"
                                         AutomationProperties.Name="Active input"
                                         IsHitTestVisible="False" IsTabStop="False"/>
                </StackPanel>

                <!-- FILLED -->
                <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsInputPage148" Text="Filled"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"/>
<controls:EtherInput x:Uid="GalleryViewsControlsInputPage149" Text="Input text"
                                         Width="195"
                                         AutomationProperties.Name="Filled input"
                                         IsHitTestVisible="False" IsTabStop="False"/>
                </StackPanel>

                <!-- DISABLED -->
                <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsControlsInputPage150" Text="Disabled"
                               Style="{StaticResource micro/regular}"
                               Foreground="{ThemeResource TextTertiary}"/>
<controls:EtherInput x:Uid="GalleryViewsControlsInputPage151" PlaceholderText="Default"
                                         Width="195"
                                         IsEnabled="False"
                                         AutomationProperties.Name="Disabled input"
                                         IsHitTestVisible="False" IsTabStop="False"/>
                </StackPanel>

            </StackPanel>
        </views:ComponentPage.StatesContent>

    </views:ComponentPage>
</Page>
