<Page x:Class="EtherSandbox.Views.Navigation.TabNavigationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Ether.DesignSystem.Controls"
      xmlns:views="using:EtherSandbox.Views">
    <views:ComponentPage x:Uid="GalleryViewsNavigationTabNavigationPage" Title="Tab Navigation"
                         Description="Horizontal single-selection navigation for application-owned content."
                         HasDisabledToggle="True">
        <views:ComponentPage.InteractiveContent>
            <views:ControlExample x:Name="LiveExample" x:Uid="GalleryViewsNavigationTabNavigationPageOutput"
                                  OutputText="Selected: Overview" SourceXaml="{x:Bind SpecimenXaml, Mode=OneTime}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="2 TABS" Style="{StaticResource micro/semibold}" Foreground="{ThemeResource TextTertiary}"/>
                        <controls:EtherTabNavigation SelectedIndex="0" SelectionChanged="TabNavigation_SelectionChanged">
                            <controls:EtherTabItem Content="Overview"/><controls:EtherTabItem Content="Details"/>
                        </controls:EtherTabNavigation>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="3 TABS WITH ICON" Style="{StaticResource micro/semibold}" Foreground="{ThemeResource TextTertiary}"/>
                        <controls:EtherTabNavigation SelectedIndex="0" SelectionChanged="TabNavigation_SelectionChanged">
                            <controls:EtherTabItem Content="Overview" Icon="Home"/>
                            <controls:EtherTabItem Content="Details" Icon="Document"/>
                            <controls:EtherTabItem Content="History" Icon="Clock"/>
                        </controls:EtherTabNavigation>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="5 TABS" Style="{StaticResource micro/semibold}" Foreground="{ThemeResource TextTertiary}"/>
                        <controls:EtherTabNavigation SelectedIndex="0" SelectionChanged="TabNavigation_SelectionChanged">
                            <controls:EtherTabItem Content="Overview"/><controls:EtherTabItem Content="Details"/><controls:EtherTabItem Content="History"/><controls:EtherTabItem Content="Activity"/><controls:EtherTabItem Content="Settings"/>
                        </controls:EtherTabNavigation>
                    </StackPanel>
                </StackPanel>
            </views:ControlExample>
        </views:ComponentPage.InteractiveContent>
        <views:ComponentPage.StatesContent>
            <StackPanel Orientation="Horizontal" Spacing="16">
                <StackPanel Width="130" Spacing="8"><TextBlock Text="Default" Style="{StaticResource micro/semibold}" Foreground="{ThemeResource TextTertiary}" HorizontalAlignment="Center"/><controls:HandTabItem Content="Default" IsHitTestVisible="False" IsTabStop="False"/></StackPanel>
                <StackPanel Width="130" Spacing="8"><TextBlock Text="Selected" Style="{StaticResource micro/semibold}" Foreground="{ThemeResource TextTertiary}" HorizontalAlignment="Center"/><controls:HandTabItem Content="Selected" PreviewState="Selected" IsHitTestVisible="False" IsTabStop="False"/></StackPanel>
                <StackPanel Width="130" Spacing="8"><TextBlock Text="Hover" Style="{StaticResource micro/semibold}" Foreground="{ThemeResource TextTertiary}" HorizontalAlignment="Center"/><controls:HandTabItem Content="Hover" PreviewState="Hover" IsHitTestVisible="False" IsTabStop="False"/></StackPanel>
                <StackPanel Width="130" Spacing="8"><TextBlock Text="Pressed" Style="{StaticResource micro/semibold}" Foreground="{ThemeResource TextTertiary}" HorizontalAlignment="Center"/><controls:HandTabItem Content="Pressed" PreviewState="Pressed" IsHitTestVisible="False" IsTabStop="False"/></StackPanel>
            </StackPanel>
        </views:ComponentPage.StatesContent>
    </views:ComponentPage>
</Page>
