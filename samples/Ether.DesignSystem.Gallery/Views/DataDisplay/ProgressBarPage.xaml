<Page
    x:Class="EtherSandbox.Views.DataDisplay.ProgressBarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:EtherSandbox.Views"
    xmlns:controls="using:Ether.DesignSystem.Controls">

<views:ComponentPage x:Uid="GalleryViewsDataDisplayProgressBarPage242"
        Title="Progress Bar"
        Description="Determinate progress bar with a 4 epx rounded track, solid Light Blue700 / Dark Blue400 fill, and independently toggled title and value labels. The four content combinations below show the supported variants."
        StatesTitle="TYPES">

        <!-- INTERACTIVE is a little simulator: it plays once on open (Replay re-runs it) and
             drives the bar from a simulated data stream whose throughput varies over time, so
             the fill moves at the data's pace rather than a fixed duration; the value label
             counts up with it. See ProgressBarPage.xaml.cs. -->
        <views:ComponentPage.InteractiveContent>
            <views:ControlExample x:Name="LiveExample"
                                  x:Uid="GalleryViewsDataDisplayProgressBarPageOutput"
                                  OutputText="Value: 0%"
                                  SourceXaml="{x:Bind SpecimenXaml, Mode=OneTime}">
                <StackPanel Spacing="16" Width="480">
<controls:EtherProgressBar x:Uid="GalleryViewsDataDisplayProgressBarPage243" x:Name="SimBar"
                                               Title="Downloading"
                                               Maximum="100"
                                               Value="0"
                                               AutomationProperties.Name="Downloading progress" />
<Button x:Uid="GalleryViewsDataDisplayProgressBarPage244" x:Name="ReplayButton"
                            Click="Replay_Click"
                            Content="▶ Replay"
                            HorizontalAlignment="Left"
                            FontFamily="{StaticResource RobotoFont}"
                            FontSize="12"/>
                </StackPanel>
            </views:ControlExample>
        </views:ComponentPage.InteractiveContent>

        <views:ComponentPage.StatesContent>
            <StackPanel Spacing="24" Width="480">

                <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsDataDisplayProgressBarPage245" Text="TITLE + VALUE"
                               FontFamily="{StaticResource RobotoFont}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextTertiary}"/>
<controls:EtherProgressBar x:Uid="GalleryViewsDataDisplayProgressBarPage246" Title="Storage"
                                               Value="65"
                                               ShowTitle="True" ShowValue="True"
                                               AutomationProperties.Name="Storage progress, title and value" />
                </StackPanel>

                <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsDataDisplayProgressBarPage247" Text="TITLE ONLY"
                               FontFamily="{StaticResource RobotoFont}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextTertiary}"/>
<controls:EtherProgressBar x:Uid="GalleryViewsDataDisplayProgressBarPage248" Title="Storage"
                                               Value="65"
                                               ShowTitle="True" ShowValue="False"
                                               AutomationProperties.Name="Storage progress, title only" />
                </StackPanel>

                <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsDataDisplayProgressBarPage249" Text="VALUE ONLY"
                               FontFamily="{StaticResource RobotoFont}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextTertiary}"/>
<controls:EtherProgressBar x:Uid="GalleryViewsDataDisplayProgressBarPage250" Title="Storage"
                                               Value="65"
                                               ShowTitle="False" ShowValue="True"
                                               AutomationProperties.Name="Storage progress, value only" />
                </StackPanel>

                <StackPanel Spacing="8">
<TextBlock x:Uid="GalleryViewsDataDisplayProgressBarPage251" Text="BAR ONLY"
                               FontFamily="{StaticResource RobotoFont}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextTertiary}"/>
<controls:EtherProgressBar x:Uid="GalleryViewsDataDisplayProgressBarPage252" Title="Storage"
                                               Value="65"
                                               ShowTitle="False" ShowValue="False"
                                               AutomationProperties.Name="Storage progress, labels hidden" />
                </StackPanel>

            </StackPanel>
        </views:ComponentPage.StatesContent>

    </views:ComponentPage>
</Page>
