<Page
    x:Class="EtherSandbox.Views.Surfaces.TooltipPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ether.DesignSystem.Controls"
    xmlns:views="using:EtherSandbox.Views">

    <views:ComponentPage
        Title="Tooltip"
        Description="Inverse-surface tooltip - dark on light, light on dark. A static UI sample (a styled Border), no behavior. Text uses the body/s-regular style; it wraps at MaxWidth 240.">

        <views:ComponentPage.InteractiveContent>
            <views:ControlExample SourceXaml="{x:Bind SpecimenXaml, Mode=OneTime}">
                <StackPanel Width="1216" Spacing="24">

                    <TextBlock Text="SPECIMEN"
                               Style="{StaticResource micro/semibold}"
                               Foreground="{ThemeResource TextTertiary}"/>

                    <Border Style="{StaticResource EtherTooltip}">
                        <TextBlock Text="Tooltip"
                                   Style="{StaticResource body/s-regular}"
                                   Foreground="{ThemeResource EtherTooltipForegroundBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="LONG TEXT (WRAPS AT MAXWIDTH 240)"
                               Style="{StaticResource micro/semibold}"
                               Foreground="{ThemeResource TextTertiary}"/>

                    <Border Style="{StaticResource EtherTooltip}">
                        <TextBlock Text="This tooltip carries a longer description that wraps onto multiple lines once it reaches the 240-pixel maximum width."
                                   Style="{StaticResource body/s-regular}"
                                   Foreground="{ThemeResource EtherTooltipForegroundBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                </StackPanel>
            </views:ControlExample>
        </views:ComponentPage.InteractiveContent>
    </views:ComponentPage>
</Page>
