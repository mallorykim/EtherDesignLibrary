<Page
    x:Class="EtherSandbox.Views.Surfaces.CardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ether.DesignSystem.Controls"
    xmlns:views="using:EtherSandbox.Views">

<views:ComponentPage x:Uid="GalleryViewsSurfacesCardPage285"
        Title="Cards - Types"
        Description="Card component with gradient border effect, available in Normal, Intelligence (dark), and Callout (with header) types.">

        <views:ComponentPage.InteractiveContent>
            <views:ControlExample SourceXaml="{x:Bind SpecimenXaml, Mode=OneTime}">
            <StackPanel Width="1216" Spacing="24">
<TextBlock x:Uid="GalleryViewsSurfacesCardPage286" Text="TYPE PREVIEWS"
                           Style="{StaticResource micro/semibold}"
                           Foreground="{ThemeResource TextTertiary}"/>

                <!-- NOTE: the dashed Rectangle beneath each "Title" is an ILLUSTRATIVE content-slot
                     placeholder shown only in this gallery preview. The EtherCard styles contain no
                     placeholder of their own; a consumer nests their own content inside the card body
                     Border, so a real card renders that content with no dashed outline. -->
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="392"/>
                        <ColumnDefinition Width="392"/>
                        <ColumnDefinition Width="394"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="12">
<TextBlock x:Uid="GalleryViewsSurfacesCardPage287" Text="NORMAL"
                                   Style="{StaticResource micro/semibold}"
                                   Foreground="{ThemeResource TextSecondary}"/>
                        <Border Style="{StaticResource EtherCardNormal}">
                            <Border Style="{StaticResource EtherCardNormalBody}">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Uid="GalleryViewsSurfacesCardPage288" Grid.Row="0" Text="Title"
                                               Style="{StaticResource headers/h3}"
                                               Foreground="{ThemeResource text/primary}"/>
                                    <Rectangle Grid.Row="1" MinHeight="56"
                                               Stroke="{ThemeResource text/primary}" StrokeThickness="1"
                                               StrokeDashArray="4 3" RadiusX="6" RadiusY="6"
                                               Fill="Transparent" Opacity="0.3"/>
                                </Grid>
                            </Border>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="12">
<TextBlock x:Uid="GalleryViewsSurfacesCardPage289" Text="INTELLIGENCE"
                                   Style="{StaticResource micro/semibold}"
                                   Foreground="{ThemeResource TextSecondary}"/>
                        <Border Style="{StaticResource EtherCardIntelligence}">
                            <Border Style="{StaticResource EtherCardIntelligenceBody}">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Uid="GalleryViewsSurfacesCardPage290" Grid.Row="0" Text="Title"
                                               Style="{StaticResource headers/h3}"
                                               Foreground="{ThemeResource text/on-static-dark}"/>
                                    <Rectangle Grid.Row="1" MinHeight="36"
                                               Stroke="{ThemeResource text/on-static-dark}" StrokeThickness="1"
                                               StrokeDashArray="4 3" RadiusX="6" RadiusY="6"
                                               Fill="Transparent" Opacity="0.3"/>
                                </Grid>
                            </Border>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="12">
<TextBlock x:Uid="GalleryViewsSurfacesCardPage291" Text="CALLOUT"
                                   Style="{StaticResource micro/semibold}"
                                   Foreground="{ThemeResource TextSecondary}"/>
                        <Border Style="{StaticResource EtherCardCalloutShell}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Padding="12,8,12,8">
<TextBlock x:Uid="GalleryViewsSurfacesCardPage292" Text="Intelligence Insight"
                                               Style="{StaticResource headers/h6}"
                                               Foreground="{ThemeResource text/inverse}"
                                               VerticalAlignment="Center"/>
                                    <PathIcon Data="F1 M8.21 1.21001L7.51 2.01001L13.77 7.47001H0V8.53001H13.77L7.51 14L8.21 14.8L16 8.00001L8.21 1.21001Z"
                                              Width="16"
                                              Height="16"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource text/inverse}"
                                              AutomationProperties.AccessibilityView="Raw"/>
                                </Grid>

                                <Border Grid.Row="1"
                                        Style="{StaticResource EtherCardCalloutBody}">
                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Uid="GalleryViewsSurfacesCardPage293" Grid.Row="0" Text="Title"
                                                   Style="{StaticResource headers/h3}"
                                                   Foreground="{ThemeResource text/primary}"/>
                                        <Rectangle Grid.Row="1" MinHeight="56"
                                                   Stroke="{ThemeResource text/primary}" StrokeThickness="1"
                                                   StrokeDashArray="4 3" RadiusX="6" RadiusY="6"
                                                   Fill="Transparent" Opacity="0.3"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
            </views:ControlExample>
        </views:ComponentPage.InteractiveContent>

    </views:ComponentPage>
</Page>
